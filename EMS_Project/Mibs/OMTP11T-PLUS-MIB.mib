--*****************************************************************************
--			MIB FILE FOR THE OMTP11T-PLUS CARD
--*****************************************************************************

	OMTP11T-PLUS-MIB DEFINITIONS ::= BEGIN

	IMPORTS

	RowStatus                               FROM STANDARD-MIB
	DisplayString                           FROM RFC1213-MIB
	   
	OBJECT-IDENTITY, 
	NOTIFICATION-TYPE, 
	MODULE-IDENTITY, 
	Integer32, 
	Unsigned32,
	IpAddress,

	TimeTicks		                FROM SNMPv2-SMI
	OBJECT-TYPE                             FROM RFC-1212

	MODULE-COMPLIANCE, 
	OBJECT-GROUP, 
	NOTIFICATION-GROUP                      FROM SNMPv2-CONF

	node, 
	rack, 
	subRack, 
	slot                                    FROM SCC-MIB 

	enterprises                             FROM RFC1155-SMI		

	;

	utl   MODULE-IDENTITY
		LAST-UPDATED    	"1807130630Z"
		ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
		CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
		DESCRIPTION     	"MIB module for NFS."
		REVISION 	    	"1807130630Z"
		DESCRIPTION    	    	"MIB module for OMTP11T-PLUS Card."
		::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
		STATUS  current
		DESCRIPTION "UTL Research and Development."
		::= { utl 1 }

	dwdm OBJECT IDENTIFIER				::=	{ utlrnd 1 }
	indus OBJECT IDENTIFIER				::=	{ dwdm 1 }
	omtp11tPlus OBJECT IDENTIFIER 			::=	{ indus 72 }

	omtp11tPlusCardGeneralDetails OBJECT IDENTIFIER	::=	{ omtp11tPlus 1 }
	omtp11tPlusConfiguration OBJECT IDENTIFIER	::=	{ omtp11tPlus 2 }
	omtp11tPlusAlarm OBJECT IDENTIFIER		::=	{ omtp11tPlus 3 }
	omtp11tPlusPerformance OBJECT IDENTIFIER	::=	{ omtp11tPlus 4 }
	omtp11tPlusDiagnostics OBJECT IDENTIFIER 	::=	{ omtp11tPlus 5 }
	
	omtp11tPlusAlarmQuery OBJECT IDENTIFIER		::=	{ omtp11tPlusAlarm 1 }
	omtp11tPlusAlarmNotification OBJECT IDENTIFIER	::=	{ omtp11tPlusAlarm 2 }

--*****************************************************************************
--				   CARD GENERAL DETAILS
--*****************************************************************************

	omtp11tPlusCardGeneralDetailsTable OBJECT-TYPE
		SYNTAX SEQUENCE OF Omtp11tPlusCardGeneralDetailsEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			"Contains card general details' queries for the OMTP11T-PLUS card"
		::= { omtp11tPlusCardGeneralDetails 1 }

	omtp11tPlusCardGeneralDetailsEntry OBJECT-TYPE
		SYNTAX Omtp11tPlusCardGeneralDetailsEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			""				  	
		INDEX   { node, rack , subRack , slot , omtp11tPlusInterfaceNumber}
		::= { omtp11tPlusCardGeneralDetailsTable 1 }

	Omtp11tPlusCardGeneralDetailsEntry ::= 
		SEQUENCE { 
				omtp11tPlusInterfaceNumber					INTEGER,
				omtp11tPlusEepromCardId						INTEGER,
				omtp11tPlusEepromCardName					DisplayString,
				omtp11tPlusEepromPartCode					DisplayString,
				omtp11tPlusEepromCardSerialNumber				DisplayString,
				omtp11tPlusEepromHardwareExternalReleaseVersion			DisplayString,
				omtp11tPlusSoftwareExternalReleaseVersion			DisplayString,
				omtp11tPlusEepromHardwareInternalReleaseVersion			DisplayString,
				omtp11tPlusSoftwareInternalReleaseVersion			DisplayString,
				omtp11tPlusEepromCardUidNumber					DisplayString,
				omtp11tPlusEepromCardEui48Number				DisplayString,
				omtp11tPlusEepromCardEui64Number				DisplayString,
				omtp11tPlusCardRootFileSystemVersion				DisplayString,
				omtp11tPlusCardInstallationDate					DisplayString,
				omtp11tPlusCardCommissionDate					DisplayString,
				omtp11tPlusCardRunningTime					DisplayString,
				omtp11tPlusCardRestartCount					INTEGER,
				omtp11tPlusXfpReadyForOperation					INTEGER,
				omtp11tPlusXfpI2cCommunicationStatus				INTEGER,
				omtp11tPlusXfpEepromPage					INTEGER,
				omtp11tPlusCheckCodeOfXfpEepromPage				INTEGER,
				omtp11tPlusExtendedCheckCodeOfXfpEepromPage			INTEGER,
				omtp11tPlusXfpVendorName					DisplayString,
				omtp11tPlusXfpVendorIeeeId					DisplayString,
				omtp11tPlusXfpPartNumber					DisplayString,
				omtp11tPlusXfpSerialNumber					DisplayString,
				omtp11tPlusXfpRevisionNumber					DisplayString,
				omtp11tPlusXfpManufacturingDate					DisplayString,
				omtp11tPlusFixedXfpLaserWavelength				DisplayString,
				omtp11tPlusXfpLaserWavelengthTolerance				DisplayString,
				omtp11tPlusXfpWavelengthTunabilitySupported			INTEGER,
				omtp11tPlusTunableXfpLaserWavelengthError			DisplayString,
				omtp11tPlusTunableXfpLaserFrequencyError			DisplayString,
				omtp11tPlusTunableXfpLaserFirstFrequency			DisplayString,
				omtp11tPlusTunableXfpLaserLastFrequency				DisplayString,
				omtp11tPlusTunableXfpWavelengthGridSpacing			DisplayString,
				omtp11tPlusXfpConnectorType					DisplayString,
				omtp11tPlusXfpLinkLength					DisplayString,
				omtp11tPlusXfpCdrRateSupported					INTEGER,
				omtp11tPlusXfpSignalEncodingTypeSupported			INTEGER,
				omtp11tPlusXfpTransceiverCodesSupported				INTEGER,
				omtp11tPlusXfpMaximumBitrateSupported				DisplayString,
				omtp11tPlusXfpMinimumBitrateSupported				DisplayString,
				omtp11tPlusXfpMaximumCaseTemperatureSupported			INTEGER,
				omtp11tPlusXfpMaximumPowerDissipationSupported			INTEGER,
				omtp11tPlusXfpMaximumPowerDissipationSupportedAtPowerDownMode	INTEGER,
				omtp11tPlusXfpMaximumCurrentLimitSupportedAtPlus5vSupply	INTEGER,
				omtp11tPlusXfpMaximumCurrentLimitSupportedAtPlus3Point3vSupply	INTEGER,
				omtp11tPlusXfpMaximumCurrentLimitSupportedAtPlus1Point8vSupply	INTEGER,
				omtp11tPlusXfpMaximumCurrentLimitSupportedAtMinus5Point2vSupply	INTEGER,
				omtp11tPlusXfpLineLoopbackSupported				INTEGER,
				omtp11tPlusXfpXfiLoopbackSupported				INTEGER,
				omtp11tPlusXfpOptionalVpsSupported				INTEGER,
				omtp11tPlusXfpLaserDisableThroughI2cSupported			INTEGER,
				omtp11tPlusXfpPowerDownThroughI2cSupported			INTEGER,
				omtp11tPlusXfpVpsLvRegulatorModeSupported			INTEGER,
				omtp11tPlusXfpVpsBypassedRegulatorModeSupported			INTEGER,
				omtp11tPlusXfpActiveFecControlSupported				INTEGER,
				omtp11tPlusXfpOptionalCmuModeSupported				INTEGER,
				omtp11tPlusXfpFecBerSupported					INTEGER,
				omtp11tPlusXfpReceivePowerMeasurementIsInOmaOrAverage		INTEGER,
				omtp11tPlusXfpActiveWavelengthControlSupported			INTEGER,
				omtp11tPlusXfpTransmitterIsCooledOrUncooled			INTEGER,
				omtp11tPlusXfpReceiverTypeIsPinOrApd				INTEGER,
				omtp11tPlusCardGeneralDetailsTableRowStatus			RowStatus
		}

	omtp11tPlusInterfaceNumber OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			"Interface number represents the port number
			InterfaceNumber to port mapping is as follows:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			For properties which do not apply on any interface,
			the interface number must be passed as 0
			-----------------------------"

		::= { omtp11tPlusCardGeneralDetailsEntry 1 }
		
	omtp11tPlusEepromCardId OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the card ID of the OMTP11T-PLUS card, present in the EEPROM
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 2 }
		
	omtp11tPlusEepromCardName OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the card name of the OMTP11T-PLUS card, present in the EEPROM
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 3 }
		
	omtp11tPlusEepromPartCode OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the part code of the OMTP11T-PLUS card, present in the EEPROM
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 4 }
		
	omtp11tPlusEepromCardSerialNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property get / set the information about 
			OMTP11T-PLUS Card's Serial Number.
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 123456
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 5 }
		
	omtp11tPlusEepromHardwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the Card's Hardware External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are significant
			architectural changes in the product
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 0.1
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 6 }
		
	omtp11tPlusSoftwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the Card's Software External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are
			significant architectural changes in the product
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 0.1
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 7 }
		
	omtp11tPlusEepromHardwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the Card's Hardware Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external hardware version.
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 4.1
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 8 }
		
	omtp11tPlusSoftwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external software version.
		      	-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 5.1
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 9 }
		
	omtp11tPlusEepromCardUidNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the Card Unique IDentifier. It is a 4 byte
			address used to uniquely identify a card.
			----------------------------
			omtp11tPlusInterfaceNumber: 0
			------------------------------
			Values:
		      	eg: 12345678
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 10 }
		
	omtp11tPlusEepromCardEui48Number OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-48 Number. It’s a 6 byte address
			used to uniquely identify a card.
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 0004A3123456
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 11 }
		
	omtp11tPlusEepromCardEui64Number OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-64 Number. It’s a 8 byte address
			used to uniquely identify a card.
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 0004A31234567890
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 12 }
		
        omtp11tPlusCardRootFileSystemVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card's Root File System Version
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 8
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 13 }
		
	omtp11tPlusCardInstallationDate OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Get the card's installation date in
			dd/mm/yyyy format
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 12/03/2016
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 21 }

	omtp11tPlusCardCommissionDate OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Get the card's commission date in
			dd/mm/yyyy format
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 20/03/2016
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 22 }

	omtp11tPlusCardRunningTime OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the duration of time for which the card is
			operational/running
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 3d 2h 1m
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 23 }
		
	omtp11tPlusCardRestartCount OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the number of times the card has been soft reset.
			This value will get reset to 0 on factory reset.
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 10
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 24 }
		
	omtp11tPlusXfpReadyForOperation OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Module not ready indicates that the XFP
			has detected a condition that tells
			transmit or receive data is invalid.
			It shall consist of logical OR of the
			following signals:
			> Transmit Signal Conditioner Loss of Lock
			> Transmitter Laser Fault
			> Receiver Signal Conditioner Loss of Lock
			(Ref: INF-8077 2.4.1)
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:		
			1 - XFP is ready for operation 
			0 - XFP is not ready for operation
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 31 }
		
	omtp11tPlusXfpI2cCommunicationStatus OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Tells whether the XFP can be accessed
			on a single 2-wire interface bus or not.
			(Ref: INF-8077 2.4.2)
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			1 - Enable I2C communication for XFP
				i.e. the XFP responds to 2-wire serial
				communication commands.
			0 - Disable I2C communication for XFP
				i.e. the XFP will not respond to or
				acknowledge any 2-wire interface communication
				from the host.
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 32 }
		
	omtp11tPlusXfpEepromPage OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property sets/gets the XFP EEPROM page, 
			the value represents the XFP EEPROM page number.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 33 }
		
	omtp11tPlusCheckCodeOfXfpEepromPage OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides the XFP
			check code(checksum) value for bytes 128 to 190
			present in XFP EEPROM Page number 1. 
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 34 }
		
	omtp11tPlusExtendedCheckCodeOfXfpEepromPage OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides the XFP
			extended check code(checksum) value for bytes 192 to 222
			present in XFP EEPROM Page number 1. 
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 35 }
		
	omtp11tPlusXfpVendorName OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides Vendor Name for given XFP. 
			The vendor name shall be the full name of the 
			corporation, a commonly accepted abbreviation of 
			the name of the corporation, the SCSI company code
			for the corporation, or the stock exchange code for
			the corporation.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: WTD
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 36 }
		
	omtp11tPlusXfpVendorIeeeId OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the IEEE company Identifier for
			the vendor of XFP. A value of all zero in the 3-byte
			field indicates that the Vendor OUI is unspecified.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 010
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 37 }
		
	omtp11tPlusXfpPartNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the vendor part number or
			product name of the XFP. A value of all zero
			indicates that the vendor Part Number is unspecified.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: FTRX-1811-2D2
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 38 }
		
	omtp11tPlusXfpSerialNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides vendor serial number defining
			the vendor’s serial number for the XFP. A value of all
			zero in the 16-byte field indicates that the vendor
			serial number is unspecified.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: KBG02CU
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 39 }
		
	omtp11tPlusXfpRevisionNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"The vendor revision number defining the vendor’s
			 product revision number. A value of all zero indicates
			 that the vendor revision number is unspecified
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: RT
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 40 }
		
	omtp11tPlusXfpManufacturingDate OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the manufacturing date for 
			XFP. A value of 8-byte field in ASCII which represents
			year, month and date of each two bytes. 
			Extra two bytes may be blank
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 160224
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 41 }
		
	omtp11tPlusFixedXfpLaserWavelength OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides transmitter LASER wavelength(nm)
			of the XFP
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 1310
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 42 }
		
	omtp11tPlusXfpLaserWavelengthTolerance OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides XFP wavelength tolerance in GhZ
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 0.02
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 43 }
		
	omtp11tPlusXfpWavelengthTunabilitySupported OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides information whether the XFP
			supports wavelength tunability or not.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			1 - XFP supports wavelength tunability
			0 - XFP not supports wavelength tunability
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 44 }

	omtp11tPlusTunableXfpLaserWavelengthError OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides wavelength error in pm
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 0.02
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 45 }
		
	omtp11tPlusTunableXfpLaserFrequencyError OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the monitor of current frequency
			Error of XFP. Frequency error is reported in Ghz.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 0.03
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 46 }
		
	omtp11tPlusTunableXfpLaserFirstFrequency OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the first LASER frequency of XFP.
			The two byte value is specified in units of THz.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 1529.45
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 47 }
		
	omtp11tPlusTunableXfpLaserLastFrequency OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the last laser frequency of XFP.
		 	 The two byte value is specified in units of THz.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 1563.45
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 48 }
		
	omtp11tPlusTunableXfpWavelengthGridSpacing OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property gives difference in the wavelength
			between two channels In GhZ
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 50
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 49 }
		
	omtp11tPlusXfpConnectorType OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides information of the XFP
			connector, value indicates the external connector
			provided on the XFP.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			00h 	Unknown or unspecified
			01h 	SC
			02h 	Fibre Channel Style 1 copper connector
			03h 	Fibre Channel Style 2 copper connector
			04h 	BNC/TNC
			05h 	Fibre Channel coaxial headers
			06h 	FiberJack
			07h 	LC
			08h 	MT-RJ
			09h 	MU
			0Ah 	SG
			0Bh 	Optical pigtail
			0C-1Fh 	Reserved
			20h 	HSSDC II
			21h 	Copper Pigtail
			22h-7Fh Reserved
			80-FFh 	Vendor specific
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 50 }
		
	omtp11tPlusXfpLinkLength OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides link length suported by the XFP
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 80.00
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 51 }
		
	omtp11tPlusXfpCdrRateSupported OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property indicates which rates are supported by
			the CDR present in XFP.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:

			Return value 1-Byte represetation:
			Byte-1  CDR Rates
			Bit-7	9.95 Gb/s
			Bit-6	10.3 Gb/s
			Bit-5	10.5 Gb/s
			Bit-4	10.7 Gb/s
			Bit-3	11.1 Gb/s
			Bit-2	Reserved
			Bit-1	Dont care for this property
			Bit-0	Dont care for this property
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 52 }
		
	omtp11tPlusXfpSignalEncodingTypeSupported OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property indicates the serial encoding mechanisms
			that are supported by the XFP.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:

			Return value 1-Byte represetation:
			Byte-1  Encoding Type
			Bit-7	64B/66B          
			Bit-6	8B10B     	 	 
			Bit-5	SONET Scrambled  
			Bit-4	NRZ              
			Bit-3	RZ              
			Bit-2	Reserved        
			Bit-1	Reserved         
			Bit-0	Reserved 
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 53 }
		
	omtp11tPlusXfpTransceiverCodesSupported OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"The identifier value specifies which transceiver
			codes are supported by the XFP
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:

			Return value 8-Byte represetation:
			---------------------------------------------------------------------------------------------------------------------------------------
				  Byte-1	  Byte-2	          Byte-3	  Byte-4	          Byte-5    Byte-6    Byte-7	        Byte-8
			---------------------------------------------------------------------------------------------------------------------------------------
			Bit-7	 10GBASE-SR	 1200-MX-SN-I        	 Reserved	 1000BASE-SX/1xFC MMF	 I-64.1r   S-64.1    L-64.1	       V-64.2a
			Bit-6	 10GBASE-LR	 1200-SM-LL-L	         Reserved	 1000BASE-LX/1xFC-SMF	 I-64.1	   S-64.2a   L-64.2a	       V-64.2b
			Bit-5	 10GBASE-ER	 Extended 1550 nm	 Reserved	 2xFC-MMF/2xFC-SMF	 I-64.2r   S-64.2b   L-64.2b	       V-64.3
			Bit-4	 10GBASE-LRM	 Intermediate 1300 nm	 Reserved	 OC-48-SR	         I-64.2	   S-64.3a   L-64.2c	       Reserved
			Bit-3	 10GBASE-SW	 Reserved	         Reserved	 OC-48-IR	         I-64.3	   S-64.3b   L-64.3	       Reserved
			Bit-2	 10GBASE-LW	 Reserved	         Reserved	 OC-48-LR	         I-64.5	   S-64.5a   G.959.1 P1L1-2D2  Reserved
			Bit-1	 10GBASE-EW	 Reserved	         Reserved	 Reserved	         Reserved  S-64.5b   Reserved	       Reserved
			Bit-0	 Reserved	 Reserved	         Reserved	 Reserved	         Reserved  Reserved  Reserved	       Reserved
			-----------------------------"
		::= { omtp11tPlusCardGeneralDetailsEntry 54 }
		
	omtp11tPlusXfpMaximumBitrateSupported OBJECT-TYPE
		SYNTAX DisplayString

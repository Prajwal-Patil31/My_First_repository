				omtp11tPlusXfpOutputHighPowerAlarmInhibit				INTEGER,
				omtp11tPlusXfpOutputLowPowerAlarmInhibit				INTEGER,
				omtp11tPlusXfpOutputHighPowerWarningInhibit				INTEGER,
				omtp11tPlusXfpOutputLowPowerWarningInhibit				INTEGER,
				omtp11tPlusXfpHighSupplyVoltageAlarmInhibit				INTEGER,
				omtp11tPlusXfpLowSupplyVoltageAlarmInhibit				INTEGER,
				omtp11tPlusXfpHighSupplyVoltageWarningInhibit				INTEGER,
				omtp11tPlusXfpLowSupplyVoltageWarningInhibit				INTEGER,
				omtp11tPlusXfpPresenceAbsenceNotificationInhibit			INTEGER,

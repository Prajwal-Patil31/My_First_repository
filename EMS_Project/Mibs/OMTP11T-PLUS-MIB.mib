				omtp11tPlusXfpLowSupplyVoltageWarningThreshold				DisplayString,
				omtp11tPlusXfpInputPowerFailureAlarmInhibit				INTEGER,
				omtp11tPlusXfpOutputPowerFailureAlarmInhibit				INTEGER,

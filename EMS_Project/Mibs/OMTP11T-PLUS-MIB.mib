--*****************************************************************************
--				CONFIGURATION
--*****************************************************************************

        omtp11tPlusConfigurationTable OBJECT-TYPE
                SYNTAX SEQUENCE OF Omtp11tPlusConfigurationEntry
                MAX-ACCESS not-accessible
                STATUS current
                DESCRIPTION
                	"Contains configuration queries of the OMTP11T-PLUS card"
                ::= { omtp11tPlusConfiguration 1 }

	omtp11tPlusConfigurationEntry OBJECT-TYPE
		SYNTAX  Omtp11tPlusConfigurationEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION 
			""
		INDEX   { node, rack , subRack , slot , omtp11tPlusInterfaceNumber}
		::= { omtp11tPlusConfigurationTable 1 }

	Omtp11tPlusConfigurationEntry ::= 
		SEQUENCE { 
				omtp11tPlusCardSoftwareUpgrade						DisplayString,
				omtp11tPlusCardSignalMonitorState					INTEGER,
				omtp11tPlusCardOpticalMonitorState					INTEGER,
				omtp11tPlusCardSoftReset						INTEGER,
				omtp11tPlusCardFactoryReset						INTEGER,
				omtp11tPlusCardAccessStatus						INTEGER,
				omtp11tPlusSyncSystemTimeWithNtpServer				DisplayString,
				omtp11tPlusSyncRtcWithNtpServer						DisplayString,
				omtp11tPlusSyncRtcWithSystemTime					DisplayString,
				omtp11tPlusUpdateGivenTimeIntoSystem				DisplayString,
				omtp11tPlusUpdateGivenTimeIntoRtc					DisplayString,
				omtp11tPlusSystemTimeAndRtcTime						DisplayString,
				
				omtp11tPlusTrafficConfiguration						INTEGER,
				omtp11tPlusLoopbackState						INTEGER,
				omtp11tPlusPortSignalMonitorState					INTEGER,
				omtp11tPlusPortOpticalMonitorState					INTEGER,
				omtp11tPlusClearSignalPerformance					INTEGER,
				omtp11tPlusAlsState							INTEGER,
				omtp11tPlusAlsPulseRepetitionTime					INTEGER,
				omtp11tPlusOtuFecConfiguration						INTEGER,
				omtp11tPlusOtuSignalFailThreshold					INTEGER,
				omtp11tPlusOtuSignalDegradeThreshold					INTEGER,
				omtp11tPlusOtuAlarmIndicationSignalAlarmInsertion			INTEGER,
				omtp11tPlusOtuSapiTransmitTraceMessage					DisplayString,
				omtp11tPlusOtuDapiTransmitTraceMessage					DisplayString,
				omtp11tPlusOtuOperatorSpecificTransmitTraceMessage			DisplayString,
				omtp11tPlusOtuSapiExpectedTraceMessage					DisplayString,
				omtp11tPlusOtuDapiExpectedTraceMessage					DisplayString,
				omtp11tPlusOtuOperatorSpecificExpectedTraceMessage			DisplayString,
				omtp11tPlusOtuSapiReceivedTraceMessage					DisplayString,
				omtp11tPlusOtuDapiReceivedTraceMessage					DisplayString,
				omtp11tPlusOtuOperatorSpecificReceivedTraceMessage			DisplayString,
				omtp11tPlusOduSignalFailThreshold					INTEGER,
				omtp11tPlusOduSignalDegradeThreshold					INTEGER,
				omtp11tPlusOduAlarmIndicationSignalAlarmInsertion			INTEGER,
				omtp11tPlusOduLockedDefectAlarmInsertion				INTEGER,
				omtp11tPlusOduOpenConnectionIndicationAlarmInsertion			INTEGER,
				omtp11tPlusOduSapiTransmitTraceMessage					DisplayString,
				omtp11tPlusOduDapiTransmitTraceMessage					DisplayString,
				omtp11tPlusOduOperatorSpecificTransmitTraceMessage			DisplayString,
				omtp11tPlusOduSapiExpectedTraceMessage					DisplayString,
				omtp11tPlusOduDapiExpectedTraceMessage					DisplayString,
				omtp11tPlusOduOperatorSpecificExpectedTraceMessage			DisplayString,
				omtp11tPlusOduSapiReceivedTraceMessage					DisplayString,
				omtp11tPlusOduDapiReceivedTraceMessage					DisplayString,
				omtp11tPlusOduOperatorSpecificReceivedTraceMessage			DisplayString,
				omtp11tPlusOpuTransmitPayloadType					INTEGER,
				omtp11tPlusOpuReceivedPayloadType					INTEGER,
				omtp11tPlusTunableXfpLaserWavelength					INTEGER,
				omtp11tPlusTunableXfpLaserChannelNumber					INTEGER,
				omtp11tPlusXfpLaserState						INTEGER,
				omtp11tPlusXfpReset							INTEGER,

	omtp11tPlusAlarmQueryTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
                      "	This is MIB realted property,
			NOT to be considered as a card property"
              ::= { omtp11tPlusAlarmQueryEntry 165 }	


--*****************************************************************************
--				    PERFORMANCE
--***************************************************************************** 	
	omtp11tPlusPerformanceTable OBJECT-TYPE
		SYNTAX SEQUENCE OF Omtp11tPlusPerformanceEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			"we can get performance details of the OMTP11T-PLUS Card"
	
		::= { omtp11tPlusPerformance 1 }

	omtp11tPlusPerformanceEntry OBJECT-TYPE
		SYNTAX Omtp11tPlusPerformanceEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION 
			""
	
		INDEX   { node, rack , subRack , slot , omtp11tPlusInterfaceNumber}
	
		::= { omtp11tPlusPerformanceTable 1 }

		Omtp11tPlusPerformanceEntry ::= 
			SEQUENCE {
					omtp11tPlusXfpInputPower                                     		DisplayString,
				        omtp11tPlusXfpOutputPower                                    		DisplayString,
				        omtp11tPlusXfpBiasCurrent                                    		DisplayString,
				        omtp11tPlusXfpSupplyVoltage                                  		DisplayString,
				        omtp11tPlusXfpTemperature                                    		DisplayString,
				        omtp11tPlusOtnFecUncorrectedWords                            		DisplayString,
				        omtp11tPlusOtnFecCorrectedBits                              		DisplayString,       
				        omtp11tPlusOtnFecZerosCorrectedBits                          		DisplayString,
				        omtp11tPlusOtnFecOnesCorrectedBits                           		DisplayString,
				        omtp11tPlusOtuBitInterleavedParityErrors                     		DisplayString,
				        omtp11tPlusOtuIncomingAlignmentErrorSeconds                  		DisplayString,
				        omtp11tPlusOtuBackwardErrorIndicationErrorCount                  	DisplayString,
				        omtp11tPlusOtuBackwardIncomingAlignmentErrorSeconds          		DisplayString,
				        omtp11tPlusOtuErrorFreeSeconds						DisplayString,
				        omtp11tPlusOtuErrorSeconds						DisplayString,
				        omtp11tPlusOtuBackgroundBlockErrors					DisplayString,
				        omtp11tPlusOtuSevereErrorSeconds					DisplayString,
				        omtp11tPlusOtuUnavailableSeconds					DisplayString,
				        omtp11tPlusOtuBackgroundBlockErrorRatio					DisplayString,
				        omtp11tPlusOtuSevereErrorSecondsErrorRatio				DisplayString,
				        omtp11tPlusOtuFarEndErrorFreeSeconds					DisplayString,
				        omtp11tPlusOtuFarEndErrorSeconds					DisplayString,
				        omtp11tPlusOtuFarEndBackgroundBlockErrors				DisplayString,
				        omtp11tPlusOtuFarEndSevereErrorSeconds					DisplayString,
				        omtp11tPlusOtuFarEndUnavailableSeconds					DisplayString,
				        omtp11tPlusOtuFarEndBackgroundBlockErrorRatio				DisplayString,
				        omtp11tPlusOtuFarEndSevereErrorSecondsErrorRatio			DisplayString,
					omtp11tPlusOtuErrorRatio						DisplayString,
					omtp11tPlusOtuBitErrorRate						DisplayString,
					omtp11tPlusOtuFramesReceived						DisplayString,
				        omtp11tPlusOduBitInterleavedParityErrors				DisplayString,
				        omtp11tPlusOduTcm1BitInterleavedParityErrors				DisplayString,
				        omtp11tPlusOduTcm2BitInterleavedParityErrors				DisplayString,
				        omtp11tPlusOduTcm3BitInterleavedParityErrors				DisplayString,
				        omtp11tPlusOduTcm4BitInterleavedParityErrors				DisplayString,
				        omtp11tPlusOduTcm5BitInterleavedParityErrors				DisplayString,
				        omtp11tPlusOduTcm6BitInterleavedParityErrors				DisplayString,
				        omtp11tPlusOduTcm1IncomingAlignmentErrorSeconds				DisplayString,
				        omtp11tPlusOduBackwardErrorIndicationErrorCount				DisplayString,
				        omtp11tPlusOduTcm1BackwardErrorIndicationErrorCount			DisplayString,
				        omtp11tPlusOduTcm2BackwardErrorIndicationErrorCount			DisplayString,
				        omtp11tPlusOduTcm3BackwardErrorIndicationErrorCount			DisplayString,
				        omtp11tPlusOduTcm4BackwardErrorIndicationErrorCount			DisplayString,
				        omtp11tPlusOduTcm5BackwardErrorIndicationErrorCount			DisplayString,
				        omtp11tPlusOduTcm6BackwardErrorIndicationErrorCount			DisplayString,
				        omtp11tPlusOduTcm1BackwardIncomingAlignmentErrorSeconds			DisplayString,
				        omtp11tPlusOduDelayMeasurement						DisplayString,
				        omtp11tPlusOduErrorFreeSeconds						DisplayString,
				        omtp11tPlusOduErrorSeconds						DisplayString,
				        omtp11tPlusOduBackgroundBlockErrors					DisplayString,
				        omtp11tPlusOduSevereErrorSeconds					DisplayString,
				        omtp11tPlusOduUnavailableSeconds					DisplayString,
				        omtp11tPlusOduBackgroundBlockErrorRatio					DisplayString,
				        omtp11tPlusOduSevereErrorSecondsErrorRatio				DisplayString,
				        omtp11tPlusOduFarEndErrorFreeSeconds					DisplayString,
				        omtp11tPlusOduFarEndErrorSeconds					DisplayString,
				        omtp11tPlusOduFarEndBackgroundBlockErrors				DisplayString,
				        omtp11tPlusOduFarEndSevereErrorSeconds					DisplayString,
				        omtp11tPlusOduFarEndUnavailableSeconds					DisplayString,
				        omtp11tPlusOduFarEndBackgroundBlockErrorRatio				DisplayString,
				        omtp11tPlusOduFarEndSevereErrorSecondsErrorRatio			DisplayString,
					omtp11tPlusPerformanceTableRowStatus					RowStatus
			}
              
        omtp11tPlusXfpInputPower OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the current Input power(dbm) received at the port
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: -9.0
			-----------------------------"
        ::= { omtp11tPlusPerformanceEntry 1 }

        omtp11tPlusXfpOutputPower OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the current Output power(dbm) transmitted by the port
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: -0.6
			-----------------------------"
        ::= { omtp11tPlusPerformanceEntry 2 }


	omtp11tPlusXfpBiasCurrent OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the bias current(mA) thats transmitted at the port
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 55
			-----------------------------"
        ::= { omtp11tPlusPerformanceEntry 3 }

	omtp11tPlusXfpSupplyVoltage OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the Supply Voltage of the port
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 3.3
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 4 }

	omtp11tPlusXfpTemperature OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the temperature(degree celcius) of the transmitter at  the port
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 33.35
			-----------------------------"
        ::= { omtp11tPlusPerformanceEntry 5 }

        omtp11tPlusOtnFecUncorrectedWords OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Uncorrected Word Error Counter counts the number of
			FEC errored code words that could not be corrected.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
        ::= { omtp11tPlusPerformanceEntry 11 }

	omtp11tPlusOtnFecCorrectedBits OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Corrected Bit Error Counter counts the number of
			FEC error bits that could be corrected(sum of ones
			corrected and zeros corrected bits).
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
        ::= { omtp11tPlusPerformanceEntry 12 }

        omtp11tPlusOtnFecZerosCorrectedBits OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Zero Corrected Bits Error Counter counts the number
			of FEC error bits that could be corrected from
			one to zero value(Expected 0 but received as 1).
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 13 }

        omtp11tPlusOtnFecOnesCorrectedBits OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Ones Corrected Byte Error Counter counts the number
			of FEC error bytes that could be corrected from
			zero to one value(Expected 1 but received as 0).
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
		::= { omtp11tPlusPerformanceEntry 14 }

        omtp11tPlusOtuBitInterleavedParityErrors OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU-BIP Counter counts the Parity errors evaluated by
			SM field of an OTU2 frame.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 15 }

        omtp11tPlusOtuIncomingAlignmentErrorSeconds OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Incoming Alignment Error Count increases,
			when OTU IAE Alarm is detected in that particular second
			of the incoming OTU signal
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 16 }

        omtp11tPlusOtuBackwardErrorIndicationErrorCount OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU-BEI Counter increases when SM-BEI Alarm is 
			detected in that particular second
			of the incoming OTU signal
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 17 }

        omtp11tPlusOtuBackwardIncomingAlignmentErrorSeconds OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU-BIAE Counter increases when SM-BIAE Alarm is 
			detected in that particular second
			of the incoming OTU signal
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 18 }

        omtp11tPlusOtuErrorFreeSeconds OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Error Free Seconds increases when no BIP errors
			or defects are detected
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 19 }

        omtp11tPlusOtuErrorSeconds OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Error Seconds increases when any defects like 
			OTU-AIS, SM-TIM etc are detected at the
			section monitoring level
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 20 }

        omtp11tPlusOtuBackgroundBlockErrors OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Background Block Errors increases on defects 
			detected and when BIP errors are less than 15% errored
			blocks received 
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 21 }

        omtp11tPlusOtuSevereErrorSeconds OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Severe Error Seconds increases on defects
			detected and when BIP errors are greater than or
			equal to 15% errored blocks received 
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 22 }

        omtp11tPlusOtuUnavailableSeconds OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Unavailable Seconds increases,
			when 10 consecutive
			Severe OTU Error seconds are detected
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 23 }

        omtp11tPlusOtuBackgroundBlockErrorRatio OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			Gives OTU Background Block Error Seconds Error Ratio.
			The ratio of BBE in available time to total seconds
			in available time during a fixed measurement interval.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1e-3
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 25 }

        omtp11tPlusOtuSevereErrorSecondsErrorRatio OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			Gives OTU Severe Error Seconds Error Ratio.
			The ratio of SES in available time to total seconds
			in available time during a fixed measurement interval.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1e-3
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 26 }

        omtp11tPlusOtuFarEndErrorFreeSeconds OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Far end Error Free Seconds, increases when no
			 backward errors or defects like BDI or BEI
			are detected in the incoming OTU signal.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 27 }

        omtp11tPlusOtuFarEndErrorSeconds OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Far End Error Seconds increases on
			detection of defects like BDI in incoming
			OTU signal.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 28 }

        omtp11tPlusOtuFarEndBackgroundBlockErrors OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Far End Background Block Errors increases when BEI
			errors are less than 15% Errored Blocks in incoming
			OTU signal.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 29 }

        omtp11tPlusOtuFarEndSevereErrorSeconds OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Far End Severe Error Seconds increases on defects
			like BDI are detected and when BEI errors are greater
			than or equal to 15% Errored Blocks in incoming OTU 
			signal.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 30 }

        omtp11tPlusOtuFarEndUnavailableSeconds OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Unavailable Seconds increases, after 9 consecutive
			OTU Far End Severe Error seconds are detected
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 31 }

        omtp11tPlusOtuFarEndBackgroundBlockErrorRatio OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			Gives Otu Far End Background Block Error Ratio.
			The ratio of BBE in available time to total seconds
			in available time during a fixed measurement interval.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1e-3
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 33 }

        omtp11tPlusOtuFarEndSevereErrorSecondsErrorRatio OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic, 
			Gives Otu Far End Severe Error Seconds Error Ratio.
			The ratio of SES in available time to total seconds
			in available time during a fixed measurement interval.
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 1e-3
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 34 }

	omtp11tPlusOtuErrorRatio   OBJECT-TYPE
              SYNTAX  DisplayString
              MAX-ACCESS  read-only
              STATUS  current
              DESCRIPTION
			"For port configured with OTU2 traffic, 
			OTU Error Ratio for requested port. The ratio of 
			number of error bits to the number of bits received in
			a particular second
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------	
			Value:
			eg: 4.0
			-----------------------------"
	::= { omtp11tPlusPerformanceEntry 35 } 


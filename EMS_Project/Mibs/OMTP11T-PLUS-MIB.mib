				omtp11tPlusXfpLowTemperatureAlarmThreshold				DisplayString,
				omtp11tPlusXfpHighTemperatureWarningThreshold				DisplayString,
				omtp11tPlusXfpLowTemperatureWarningThreshold				DisplayString,
				omtp11tPlusXfpHighBiasCurrentAlarmThreshold				DisplayString,
				omtp11tPlusXfpLowBiasCurrentAlarmThreshold				DisplayString,
				omtp11tPlusXfpHighBiasCurrentWarningThreshold				DisplayString,
				omtp11tPlusXfpLowBiasCurrentWarningThreshold				DisplayString,
				omtp11tPlusXfpInputHighPowerAlarmThreshold				DisplayString,

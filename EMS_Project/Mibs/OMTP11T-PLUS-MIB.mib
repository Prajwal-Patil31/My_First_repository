--*****************************************************************************
--				    ALARMS
--*****************************************************************************

	omtp11tPlusAlarmQueryTable OBJECT-TYPE
		SYNTAX SEQUENCE OF Omtp11tPlusAlarmQueryEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			"Contains Alarm queries of the OMTP11T-PLUS card"
	
		::= { omtp11tPlusAlarmQuery 1 }

	omtp11tPlusAlarmQueryEntry OBJECT-TYPE
		SYNTAX Omtp11tPlusAlarmQueryEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION 
			""
		
		INDEX   { node, rack , subRack , slot , omtp11tPlusInterfaceNumber}
	
		::= { omtp11tPlusAlarmQueryTable 1 }
		
	Omtp11tPlusAlarmQueryEntry ::= 
		SEQUENCE {
				omtp11tPlusXfpInputPowerFailureAlarm				DisplayString,
				omtp11tPlusXfpOutputPowerFailureAlarm				DisplayString,
				omtp11tPlusXfpHighTemperatureAlarm				DisplayString, 
				omtp11tPlusXfpLowTemperatureAlarm				DisplayString, 
				omtp11tPlusXfpHighTemperatureWarning				DisplayString, 
				omtp11tPlusXfpLowTemperatureWarning				DisplayString, 
				omtp11tPlusXfpHighBiasCurrentAlarm				DisplayString, 
				omtp11tPlusXfpLowBiasCurrentAlarm				DisplayString, 
				omtp11tPlusXfpHighBiasCurrentWarning				DisplayString, 
				omtp11tPlusXfpLowBiasCurrentWarning				DisplayString, 
				omtp11tPlusXfpInputHighPowerAlarm				DisplayString, 
				omtp11tPlusXfpInputLowPowerAlarm				DisplayString, 
				omtp11tPlusXfpInputHighPowerWarning				DisplayString, 
				omtp11tPlusXfpInputLowPowerWarning				DisplayString, 
				omtp11tPlusXfpOutputHighPowerAlarm				DisplayString, 
				omtp11tPlusXfpOutputLowPowerAlarm				DisplayString, 
				omtp11tPlusXfpOutputHighPowerWarning				DisplayString, 
				omtp11tPlusXfpOutputLowPowerWarning				DisplayString, 
				omtp11tPlusXfpHighSupplyVoltageAlarm				DisplayString, 
				omtp11tPlusXfpLowSupplyVoltageAlarm				DisplayString, 
				omtp11tPlusXfpHighSupplyVoltageWarning				DisplayString, 
				omtp11tPlusXfpLowSupplyVoltageWarning				DisplayString, 
				omtp11tPlusXfpPresenceAbsenceNotification			DisplayString, 
				omtp11tPlusOtuLossOfSignalAlarm					DisplayString, 
				omtp11tPlusOtuLossOfFrameAlarm					DisplayString, 
				omtp11tPlusOtuOutOfFrameAlarm					DisplayString, 
				omtp11tPlusOtuLossOfMultiFrameAlarm				DisplayString, 
				omtp11tPlusOtuOutOfMultiFrameAlarm				DisplayString, 
				omtp11tPlusOtuSignalFailAlarm					DisplayString, 
				omtp11tPlusOtuSignalDegradeAlarm				DisplayString, 
				omtp11tPlusOtuAlarmIndicationSignalAlarm			DisplayString, 
				omtp11tPlusOtuIncomingAlignmentErrorAlarm			DisplayString, 
				omtp11tPlusOtuTraceIdentifierMismatchAlarm			DisplayString, 
				omtp11tPlusOtuBackwardIncomingAlignmentErrorAlarm		DisplayString, 
				omtp11tPlusOtuBackwardDefectIndicationAlarm			DisplayString, 
				omtp11tPlusOduSignalFailAlarm					DisplayString, 
				omtp11tPlusOduSignalDegradeAlarm				DisplayString, 
				omtp11tPlusOduAlarmIndicationSignalAlarm			DisplayString, 
				omtp11tPlusOduTcm1IncomingAlignmentErrorAlarm			DisplayString,
				omtp11tPlusOduTcm2IncomingAlignmentErrorAlarm			DisplayString, 
				omtp11tPlusOduTcm3IncomingAlignmentErrorAlarm			DisplayString, 
				omtp11tPlusOduTcm4IncomingAlignmentErrorAlarm			DisplayString, 
				omtp11tPlusOduTcm5IncomingAlignmentErrorAlarm			DisplayString, 
				omtp11tPlusOduTcm6IncomingAlignmentErrorAlarm			DisplayString, 
				omtp11tPlusOduTraceIdentifierMismatchAlarm			DisplayString, 
				omtp11tPlusOduLockedDefectAlarm					DisplayString, 
				omtp11tPlusOduOpenConnectionIndicationAlarm			DisplayString, 
				omtp11tPlusOduBackwardDefectIndicationAlarm			DisplayString, 
				omtp11tPlusOduTcm1BackwardIncomingAlignmentErrorAlarm		DisplayString, 
				omtp11tPlusOduTcm2BackwardIncomingAlignmentErrorAlarm		DisplayString, 
				omtp11tPlusOduTcm3BackwardIncomingAlignmentErrorAlarm		DisplayString, 
				omtp11tPlusOduTcm4BackwardIncomingAlignmentErrorAlarm		DisplayString,
				omtp11tPlusOduTcm5BackwardIncomingAlignmentErrorAlarm		DisplayString, 
				omtp11tPlusOduTcm6BackwardIncomingAlignmentErrorAlarm		DisplayString, 
				omtp11tPlusOpuPayloadMismatchAlarm				DisplayString, 
				omtp11tPlusOchLossOfPayloadAlarm				DisplayString, 
				omtp11tPlusAlarmQueryTableRowStatus				RowStatus
		}


	omtp11tPlusXfpInputPowerFailureAlarm OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"If optical input power at requested interface is less than
			-20dbm, this alarm will be generated
			-----------------------------
			omtp11tPlusInterfaceNumber:
			1 - LINE-1
			2 - LINE-2
			-----------------------------
			Values :
			If Alarm is Present - Date and Time Stamp
				eg:2017-5-18,9:47:20.0,+5:30
			If Alarm is Absent  - 0
			-----------------------------"
               ::= { omtp11tPlusAlarmQueryEntry 1 }

        omtp11tPlusXfpOutputPowerFailureAlarm OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION

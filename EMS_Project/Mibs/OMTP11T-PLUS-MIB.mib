--*****************************************************************************
--				    DIAGNOSTICS
--*****************************************************************************        

	omtp11tPlusDiagnosticsTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Omtp11tPlusDiagnosticsEntry
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Category contains properties that are used for debugging
                      card software"
		::= { omtp11tPlusDiagnostics 1 }	

	omtp11tPlusDiagnosticsEntry   OBJECT-TYPE
              SYNTAX  Omtp11tPlusDiagnosticsEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , omtp11tPlusInterfaceNumber }
		::= { omtp11tPlusDiagnosticsTable 1 }
	
	Omtp11tPlusDiagnosticsEntry ::= 
		SEQUENCE {
				omtp11tPlusAccessCortinaRegister			INTEGER,
				omtp11tPlusCollectCortinaRegisterDump			INTEGER,
				omtp11tPlusCollectCortinaModulebGpllRxLockStatus	DisplayString,
				omtp11tPlusCollectCortinaModulebGpllTxLockStatus	DisplayString,
				omtp11tPlusCollectCortinaModulebTxSerdesLockStatus	DisplayString,
				omtp11tPlusCollectCortinaModulebTxSerdesVcoTunedValue	DisplayString,
				omtp11tPlusCollectCortinaModulebXfiCupllLockStatus	DisplayString,
				omtp11tPlusCollectCortinaModulebAllClockLockStatus	OCTET STRING,
				omtp11tPlusDiagnosticTableRowStatus			RowStatus
			}
			
	omtp11tPlusAccessCortinaRegister OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
			"Sets/gets the value of any cortina register
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg:
			example of cortina register - 76071076
			value - 1
			-----------------------------"
	::= { omtp11tPlusDiagnosticsEntry 1 }	
	
	omtp11tPlusCollectCortinaRegisterDump OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"create register dump of all cortina register
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------
                     	This query will create registe dump in card's 
			root directory
			-----------------------------"
	::= { omtp11tPlusDiagnosticsEntry 2 }	

	omtp11tPlusCollectCortinaModulebGpllRxLockStatus OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads GPLL Rx clock lock status for all slices
			 of module B
			 Expected value : should be 0x00049 to indicate 
			 Value is locked
			 The following register will be read:
			 0x00c59, 0x00c99, 0x00cd9, 0x00d19
			 The register that will be read is GPLLX1_SDS_COMMON_TXLOCKD0_INTSTATUS
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp11tPlusDiagnosticsEntry 3 }	
	
	omtp11tPlusCollectCortinaModulebGpllTxLockStatus OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads GPLL Tx clock lock status for all slices
			 of module B
			 Expected value : should be 0x00049 to indicate 
			 Value is locked
			 The following register will be read:
			 0x00d59, 0x00d99, 0x00dd9, 0x00e19
			 The register that will be read is GPLLX1_SDS_COMMON_TXLOCKD0_INTSTATUS
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp11tPlusDiagnosticsEntry 4 }

	omtp11tPlusCollectCortinaModulebTxSerdesLockStatus OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads Tx serdes clock lock status for all slices
			 of module B
			 Expected value : should be 0x00049 to indicate 
			 Value is locked
			 The following register will be read:
			 0x0303d, 0x0343d, 0x0383d, 0x03c3d
			 The register that will be read is 
			 XFI32X1_SDS_XFI32X1_SDS_COMMON_TXLOCKD0_INTSTATUS
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp11tPlusDiagnosticsEntry 5 }	
	
	omtp11tPlusCollectCortinaModulebTxSerdesVcoTunedValue OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads Tx serdes VCO tuning value for all slices
			 of module B
			 Expected value : Value when correctly tuned should not 
			 be near extremes of 0x3F or 0x00
			 The following register will be read:
			 0x03031, 0x03431, 0x03831, 0x03c31
			 The register that will be read is XFI32X1_SDS_XFI32X1_SDS_COMMON_TXVCO0_STATUS
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp11tPlusDiagnosticsEntry 6 }	

	omtp11tPlusCollectCortinaModulebXfiCupllLockStatus OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads XFI CUPLL Lock status for all slices
			 of module B
			 Expected value : should be 0x00049 to indicate Value is locked 
			 The following register will be read:
			 0x1b438, 0x1b478, 0x1b4b8, 0x1b4f8
			 The register that will be read is XFI_CUPLL_LOCKDET_INTSTATUS
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp11tPlusDiagnosticsEntry 7 }	

	omtp11tPlusCollectCortinaModulebAllClockLockStatus OBJECT-TYPE
		SYNTAX  OCTET STRING
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads Lock status of following clocks:
			 GPLL Rx/Tx, Tx serdes, Tx Serdes VCO tuned value and XFI CUPLLfor all slices
			 of module B.
			 Expected value : should be 0x00049 to indicate Value is locked 
			 The following register will be read:
			 0x1b438, 0x1b478, 0x1b4b8, 0x1b4f8
			 The register that will be read is XFI_CUPLL_LOCKDET_INTSTATUS
			-----------------------------
			omtp11tPlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp11tPlusDiagnosticsEntry 8 }	

	omtp11tPlusDiagnosticTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
			"*****************************
			This is MIB realted property,
			NOT to be considered as a card property
			*****************************"
	::= { omtp11tPlusDiagnosticsEntry 9 }
        

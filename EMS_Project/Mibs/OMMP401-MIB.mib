--*****************************************************************************
--				    ALARMS
--*****************************************************************************
                 
	ommp401AlarmQueryTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Ommp401AlarmQueryEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Gives Optical and Signal Alarms status of the OMMP401 card"
		::= { ommp401AlarmQuery 1 }	

	ommp401AlarmQueryEntry   OBJECT-TYPE
              SYNTAX  Ommp401AlarmQueryEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , ommp401InterfaceNumber }
		::= { ommp401AlarmQueryTable 1 }
	
	Ommp401AlarmQueryEntry ::= 
			SEQUENCE {					
					ommp401Cfp2InputPowerFailureAlarm					DisplayString,
					ommp401Cfp2OutputPowerFailureAlarm					DisplayString,
					ommp401Cfp2HighTemperatureAlarm					DisplayString,
					ommp401Cfp2LowTemperatureAlarm					DisplayString,
					ommp401Cfp2HighTemperatureWarning					DisplayString,
					ommp401Cfp2LowTemperatureWarning					DisplayString,
					ommp401Cfp2InputHighPowerAlarm					DisplayString,
					ommp401Cfp2InputLowPowerAlarm						DisplayString,
					ommp401Cfp2InputHighPowerWarning					DisplayString,
					ommp401Cfp2InputLowPowerWarning					DisplayString,
					ommp401Cfp2OutputHighPowerAlarm					DisplayString,
					ommp401Cfp2OutputLowPowerAlarm					DisplayString,
					ommp401Cfp2OutputHighPowerWarning					DisplayString,
					ommp401Cfp2OutputLowPowerWarning					DisplayString,
					ommp401Cfp2HighSupplyVoltageAlarm					DisplayString,
					ommp401Cfp2LowSupplyVoltageAlarm					DisplayString,
					ommp401Cfp2HighSupplyVoltageWarning					DisplayString,
					ommp401Cfp2LowSupplyVoltageWarning					DisplayString,
					ommp401Cfp2PresenceAbsenceNotification				DisplayString,
					ommp401Qsfp28InputPowerFailureAlarm					DisplayString,
					ommp401Qsfp28OutputPowerFailureAlarm					DisplayString,
					ommp401Qsfp28HighTemperatureAlarm					DisplayString,
					ommp401Qsfp28LowTemperatureAlarm					DisplayString,
					ommp401Qsfp28HighTemperatureWarning					DisplayString,
					ommp401Qsfp28LowTemperatureWarning					DisplayString,
					ommp401Qsfp28HighBiasCurrentAlarm					DisplayString,
					ommp401Qsfp28LowBiasCurrentAlarm					DisplayString,
					ommp401Qsfp28HighBiasCurrentWarning					DisplayString,
					ommp401Qsfp28LowBiasCurrentWarning					DisplayString,
					ommp401Qsfp28InputHighPowerAlarm					DisplayString,
					ommp401Qsfp28InputLowPowerAlarm						DisplayString,
					ommp401Qsfp28InputHighPowerWarning					DisplayString,
					ommp401Qsfp28InputLowPowerWarning					DisplayString,
					ommp401Qsfp28OutputHighPowerAlarm					DisplayString,
					ommp401Qsfp28OutputLowPowerAlarm					DisplayString,
					ommp401Qsfp28OutputHighPowerWarning					DisplayString,
					ommp401Qsfp28OutputLowPowerWarning					DisplayString,
					ommp401Qsfp28HighSupplyVoltageAlarm					DisplayString,
					ommp401Qsfp28LowSupplyVoltageAlarm					DisplayString,
					ommp401Qsfp28HighSupplyVoltageWarning					DisplayString,
					ommp401Qsfp28LowSupplyVoltageWarning					DisplayString,
					ommp401Qsfp28PresenceAbsenceNotification				DisplayString,
					ommp401OtuLossOfSignalAlarm				DisplayString,
					ommp401OtuLossOfFrameAlarm				DisplayString,
					ommp401OtuOutOfFrameAlarm				DisplayString,
					ommp401OtuLossOfMultiFrameAlarm			DisplayString,
					ommp401OtuOutOfMultiFrameAlarm			DisplayString,
					ommp401OtuSignalFailAlarm				DisplayString,
					ommp401OtuSignalDegradeAlarm				DisplayString,
					ommp401OtuAlarmIndicationSignalAlarm			DisplayString,
					ommp401OtuIncomingAlignmentErrorAlarm			DisplayString,
					ommp401OtuTrailTraceIdentifierMismatchAlarm		DisplayString,
					ommp401OtuBackwardIncomingAlignmentErrorAlarm		DisplayString,
					ommp401OtuBackwardDefectIndicationAlarm		DisplayString,

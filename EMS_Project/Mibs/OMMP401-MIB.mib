	ommp401CardSoftwareUpgrade OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as SET command.
			This property upgrades the software of the OMMP401 card
			It takes the path of the software release as
			a value
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Values:
			eg: /root/home/rel-2.0.0.tar.gz
			-----------------------------"
		::= { ommp401ConfigurationEntry 1 }

	ommp401CardSignalMonitorState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property sets or gets the card's signal
			monitoring state. Disabling card signal monitoring 
			will not provide any signal alarms and performances
			information to the user.
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Values:
			1 - Card Signal Monitoring is enabled
			0 - Card Signal Monitoring is disabled
			-----------------------------"
		::= { ommp401ConfigurationEntry 2 }

	ommp401CardOpticalMonitorState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property sets or gets the card's optical
			monitoring state. Disabling card signal monitoring 
			will not provide any signal alarms and performances
			information to the user.
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Values:
			1 - Card Optical Monitoring is enabled
			0 - Card Optical Monitoring is disabled
			-----------------------------"
		::= { ommp401ConfigurationEntry 3 }

	ommp401CardSoftReset OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as a SET command.
			Reboots the Card, Reconfigures the Card 
			i.e All Configuration Parameter	like Laser State,
			Traffic configuration, Loopback, FEC, optical and 
			signal thresholds, switching mode,
			user choice of line path, auto-negotiation, 
			TTI messages will be restored to previous state
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Values:
			Dont care, any value
			eg: 0
			-----------------------------"
		::= { ommp401ConfigurationEntry 4 }

	ommp401CardFactoryReset OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as a SET command.
			Sets the Card To Factory Default State
			i.e All User Configuration Parameters like Laser State,
			Traffic configuration, Loopback, FEC, optical and 
			signal thresholds, switching mode,
			user choice of line path, auto-negotiation, TTI messages
			will be set to default state
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Values:
			Dont care, any value
			eg: 0
			-----------------------------"
		::= { ommp401ConfigurationEntry 5 }
		
	ommp401SyncSystemTimeWithNtpServer	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
					present in linux kernel with the NTP server
					we can use this OID. We can provide NTP server
					ip address as a value to this OID and the time
					will be synced to that ilarticular server. 
					If we are not providing NTP server IP address 
					then the system will be synced with the NTP server 
					which is already been registered with card. 
					If both are absent then error message will be returned
					-----------------------------
						Interface : 0
					-----------------------------
						If we want to provide NTP server IP address then
						Value should be a valid IP address as shown below
						: 192.168.21.25
						
						If we don't want to provide NTP server address then no
						need to pass any value. 
					---------------------------"
  						
  		::= { ommp401ConfigurationEntry 6 }
  		
  	ommp401SyncRtcWithNtpServer	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
  						present in RTC with the NTP server
  						we can use this OID. We can provide NTP server
  						ip address as a value to this OID and the time
  						will be synced to that particular server. 
  						If we are not providing NTP server IP address 
  						then the system will be synced with the NTP server 
  						which is already been registered with card. 
  						If both are absent then error message will be returned.
  						-----------------------------
						Interface : 0
						-----------------------------
						If we want to provide NTP server IP address then
						Value should be a valid IP address as shown below
						: 192.168.21.25
							
						If we don't want to provide NTP server address, then no
						need to ilass any value. 
						---------------------------"
  						
  		::= { ommp401ConfigurationEntry 7 }
  		
  	ommp401SyncRtcWithSystemTime	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
  						present in RTC with the time value in linux kernel
  						we can use this OID. With this set operation, 
  						the time available with linux kernel will be updated
  						into RTC. It is not required to provide any value for 
  						this operation"
  						
  		::= { ommp401ConfigurationEntry 8 }
  		
  	ommp401UpdateGivenTimeIntoSystem	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually update system time
  						with the user provided time, we can use this OID.
  						With OID we need to provide time value which we
  						want to update in the system.
  						-----------------------------
						Interface : 0
						-----------------------------
						Value should be of given format:
						YYYY-MM-DD H:M:S
						
						Example: 2017-10-31 15:20:44
						---------------------------"
						
  		::= { ommp401ConfigurationEntry 9 }
  		
  	ommp401UpdateGivenTimeIntoRtc	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually update RTC time
  						with the user provided time, we can use this OID.
  						With OID we need to provide time value which we
  						want to update in RTC.
  						-----------------------------
						Interface : 0
						-----------------------------
						Value should be of given format:
						YYYY-MM-DD H:M:S
						
						Example: 2017-10-31 15:20:44
						---------------------------"
						
  		::= { ommp401ConfigurationEntry 10 }
  		
  	ommp401SystemTimeAndRtcTime	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-only
  		STATUS  		current
  		DESCRIPTION	 	" get the system time and time value present in RTC.
  						-----------------------------
						Interface : 0
						-----------------------------"
						
  		::= { ommp401ConfigurationEntry 11 }
		
	ommp401TrafficConfiguration OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or get Traffic configuration for all ports.
			The line port must be configured with traffic:
			Taclink - 100G
			Lumentum - 100G/200G
			NEC - 100G/200/400G.
			The client ports supports traffic:
			OTU4/100GbE
			To Unconfigure traffic on line port, all client ports
			should be unconfigured first.			
			----------------------------------------
			If line side module is Taclink CFP2:
			100G mode: supported clients ports are port3/port4.
			----------------------------------------
			If line side module is Lumentum CFP2-DCO:
			In 100G mode: supported client ports are 1/2/3/4.
			In 200G mode: supported client ports are 1/2 and 3/4(configure any two ports eg: port1 and port3).
			----------------------------------------
			If line side module is NEC CFP2:
			In 100G mode: supported client ports are port3/port4.
			In 200G mode: supported client ports are port3 and port4.
			In 400G mode: supported client ports are 1,2,3 and 4.
			----------------------------------------
			ommp401InterfaceNumber:
			1 to 5 - CLIENT-1 to CLIENT-4 and LINE-5
			----------------------------------------			
			Value: 
			For client
			00 - Un-configure 
			01 - OTU4
			02 - 100GbE
			For line
			00 - Un-configure
			01 - OTU4  (100G Line) 			
			03 - OTUC2 (200G Line)
			04 - OTUC4 (400G Line)
			-----------------------------"
		::= { ommp401ConfigurationEntry 12 }

	ommp401LoopbackState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or get the loopback state for the
			requested port
			----------------------------------------
			If line side module is CFP2(Taclink,etc)
			Client Near end loopback can be configured
			Client Far end loopback is not supported
			Line near end loopback is not supported
			Line far end loopback can be configured
			----------------------------------------
			If line side module is CFP2-DCO(Lumentum,etc)
			Both near end loopback and far end loopback can be configured on client
			Both near end loopback and far end loopback can be configured on line			----------------------------------------
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			5 - LINE-1
			-----------------------------
			Values: 
			00 - No Loopback   
			01 - Near End Loopback
			02 - Far End Loopback
			-----------------------------"
		::= { ommp401ConfigurationEntry 13 }

	ommp401PortSignalMonitorState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property sets or gets the port's signal
			monitoring state. Disabling port signal monitoring 
			will not provide any signal alarms and performances
			information to the user.
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			5 - LINE-1
			-----------------------------
			Values:
			1 - Port Signal Monitoring is enabled
			0 - Port Signal Monitoring is disabled
			-----------------------------"
		::= { ommp401ConfigurationEntry 14 }

	ommp401PortOpticalMonitorState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property sets or gets the port's optical
			monitoring state. Disabling port optical monitoring 
			will not provide any optical alarms and performances
			information to the user.
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			5 - LINE-1
			-----------------------------
			Values:
			1 - Port Optical Monitoring is enabled
			0 - Port Optical Monitoring is disabled
			-----------------------------"
		::= { ommp401ConfigurationEntry 15 }

	ommp401ClearSignalPerformance OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as a SET command.
			Clears signal performance for the requested port
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			5 - LINE-1
			-----------------------------
			Values:
			Dont care, any value
			eg: 0
			-----------------------------"
		::= { ommp401ConfigurationEntry 16 }

	ommp401AlsState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set the Automatic Laser Switching(ALS) mode for
			for requested port. Based on the RX LOS state of the
			port, the transmit LASER state will be controlled
			according to the algorithm defined for ALS in
			ITUT 664 Standard
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			5 - LINE-1
			-----------------------------
			Values: 
			1 - Enable ALS state
			0 - Disable ALS state
			-----------------------------" 
		::= { ommp401ConfigurationEntry 17 }

	ommp401AlsPulseRepetitionTime OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Pulse repetition time is the time for automatic 
			restart of CFP2 LASER once the ALS algorithm starts.
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			5 - LINE-1
			-----------------------------
			Values: 
			1 seconds to 300 seconds
			-----------------------------"
		::= { ommp401ConfigurationEntry 18 }

	ommp401OtuFecConfiguration OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or Get FEC type for requested port configured with
			 OTU4/OTUC4 traffic.  
			----------------------------------------
			If line side module is CFP2(Taclink,etc)
			Fec does not supported
			----------------------------------------
			If line side module is CFP2-DCO(Lumentum,etc)
			If line is OTU4(100G), Zero FEC and OTU-4 G.709 FEC are supported
			If line is OTUC2(200G), only 15% Denali Compatible is supported
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			5 - LINE-1
			-----------------------------
			Values: 
			00 - Zero FEC 
			01 - OTU-4 G.709 FEC
			03 - 15% Denali Compatible
			-----------------------------"
		::= { ommp401ConfigurationEntry 19 }

	ommp401OtuSignalFailThreshold OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or Get SM Signal Failure 
			Threshold value for the requested port configured with 
			OTU4/OTUC4 traffic.
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values: 
			03 - 1.E -03
			04 - 1.E -04
			05 - 1.E -05
			-----------------------------" 
		::= { ommp401ConfigurationEntry 20 }

	ommp401OtuSignalDegradeThreshold OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or Get SM Signal Degrade 
			Threshold value for the requested port configured with 
			OTU4/OTUC4 traffic.
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:
			06 - 1.E -06
			07 - 1.E -07
			08 - 1.E -08
			09 - 1.E -09
			10 - 1.E -10(for line only)
			-----------------------------"
		::= { ommp401ConfigurationEntry 21 }

	ommp401OtuSapiTransmitTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or get the 15 characters SAPI Transmit TTI message
			which is put into the outgoing OTU4/OTUC4 frame. 
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp401ConfigurationEntry 22 }

	ommp401OtuDapiTransmitTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or get the 15 characters DAPI Transmit TTI message
			which is put into the outgoing OTU4/OTUC4 frame. 
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp401ConfigurationEntry 23 }
		
	ommp401OtuOperatorSpecificTransmitTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or get the 32 characters Operator Specific Transmit
			TTI message which is put into the outgoing OTU4/OTUC4
			frame. 
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:
			eg: 12345123451234512345123451234500
			-----------------------------" 
		::= { ommp401ConfigurationEntry 24 }
		
	ommp401OtuSapiExpectedTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION

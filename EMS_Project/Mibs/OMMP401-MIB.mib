	ommp401PerformanceTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Ommp401PerformanceEntry
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Gives Optical and Signal performance status of the OMMP401 card"
		::= { ommp401Performance 1 }	

	ommp401PerformanceEntry   OBJECT-TYPE
              SYNTAX  Ommp401PerformanceEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , ommp401InterfaceNumber}
		::= { ommp401PerformanceTable 1 }
	

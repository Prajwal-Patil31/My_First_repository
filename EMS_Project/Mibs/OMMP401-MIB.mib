	ommp401Cfp2InputPower OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the current Input power(dbm) received at the port
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:
			eg: -9.0
			-----------------------------"
	::= { ommp401PerformanceEntry 1 }

	ommp401Cfp2OutputPower OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the current Output power(dbm) transmitted at the port
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:
			eg: -0.6
			-----------------------------"
	::= { ommp401PerformanceEntry 2 }

	ommp401Cfp2SupplyVoltage OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the Supply Voltage of the port
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:
			eg: 3.3
			-----------------------------"
	::= { ommp401PerformanceEntry 3 }

	ommp401Cfp2Temperature OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the temperature(degree celcius) of the transmitter
			at  the port
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:
			eg: 33.35
			-----------------------------"
	::= { ommp401PerformanceEntry 4 }


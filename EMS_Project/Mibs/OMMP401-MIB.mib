--*****************************************************************************
--			MIB FILE FOR THE OMMP401 CARD
--*****************************************************************************

OMMP401-MIB DEFINITIONS ::= BEGIN
 
          IMPORTS
        	
		RowStatus      			FROM STANDARD-MIB
			
		DisplayString  			FROM RFC1213-MIB       
    	
    		OBJECT-IDENTITY,
    		NOTIFICATION-TYPE,
    		MODULE-IDENTITY,
    		Integer32,
    		Unsigned32,
    		IpAddress,
    		TimeTicks			FROM SNMPv2-SMI
	 
	 	OBJECT-TYPE    			FROM RFC-1212
	 		
		MODULE-COMPLIANCE,
		OBJECT-GROUP,
		NOTIFICATION-GROUP		FROM SNMPv2-CONF
	
		node,
		rack,
		subRack,
		slot				FROM SCC-MIB
    
		enterprises			FROM RFC1155-SMI
	;

 

	utl   MODULE-IDENTITY
            LAST-UPDATED    	"1807130630Z"
            ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
            CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
            DESCRIPTION     	"MIB module for UTL 40/80 channel DWDM."
            REVISION 	    	"1807130630Z"
            DESCRIPTION    	"MIB module for OMMP401 Card."
            ::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
            STATUS  current
            DESCRIPTION "UTL Research and Development."
            ::= { utl 1 }

	dwdm 	OBJECT IDENTIFIER				::=	{ utlrnd 1 }
	indus 	OBJECT IDENTIFIER				::=	{ dwdm 1 }
	ommp401 	OBJECT IDENTIFIER 			::=	{ indus 90 }

	ommp401CardGeneralDetails OBJECT IDENTIFIER		::=	{ ommp401 1 }
	ommp401Configuration OBJECT IDENTIFIER 		::=	{ ommp401 2 }
	ommp401Alarm OBJECT IDENTIFIER 			::=	{ ommp401 3 }
	ommp401Performance OBJECT IDENTIFIER 		::=	{ ommp401 4 }
	ommp401Diagnostics OBJECT IDENTIFIER 		::=	{ ommp401 5 }

	ommp401AlarmQuery OBJECT IDENTIFIER			::=	{ ommp401Alarm 1 }
	ommp401AlarmNotification OBJECT IDENTIFIER		::=	{ ommp401Alarm 2 }

--*****************************************************************************
--				CARD GENERAL DETAILS
--*****************************************************************************

	ommp401CardGeneralDetailsTable OBJECT-TYPE
		SYNTAX  SEQUENCE OF Ommp401CardGeneralDetailsEntry 
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
                     "Contains card general details' queries for the OMMP401 card"
		::= { ommp401CardGeneralDetails 1 }

	ommp401CardGeneralDetailsEntry  OBJECT-TYPE
		SYNTAX  Ommp401CardGeneralDetailsEntry 
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION 
              	""
		INDEX   { node, rack, subRack, slot, ommp401InterfaceNumber }
		::= { ommp401CardGeneralDetailsTable 1 }

	Ommp401CardGeneralDetailsEntry  ::= 
		SEQUENCE {
				ommp401InterfaceNumber					INTEGER,
				ommp401EepromCardId					        INTEGER,
				ommp401EepromCardName					DisplayString,
				ommp401EepromPartCode					DisplayString,
				ommp401EepromCardSerialNumber				DisplayString,
				ommp401EepromHardwareExternalReleaseVersion		        DisplayString,
				ommp401SoftwareExternalReleaseVersion		        DisplayString,
				ommp401EepromHardwareInternalReleaseVersion		        DisplayString,
				ommp401SoftwareInternalReleaseVersion		        DisplayString,
				ommp401EepromCardUidNumber			                DisplayString,
				ommp401EepromCardEui48Number				        DisplayString,
				ommp401EepromCardEui64Number				        DisplayString,
				ommp401CardInstallationDate				        DisplayString,
				ommp401CardCommissionDate				        DisplayString,
				ommp401CardRunningTime					DisplayString,
				ommp401CardRestartCount					INTEGER,
				ommp401Cfp2ReadyForOperation				        INTEGER,
				ommp401Cfp2VendorName					        DisplayString,
				ommp401Cfp2VendorIeeeId					INTEGER,
				ommp401Cfp2PartNumber					        DisplayString,
				ommp401Cfp2SerialNumber					DisplayString,
				ommp401Cfp2ManufacturingDate				        DisplayString,
				ommp401Cfp2HardwareVersionNumber			 DisplayString,
				ommp401Cfp2FirmwareVersionNumber			 DisplayString,
				ommp401Cfp2MediaType					 DisplayString,
				ommp401NumberOfNetworkLanesInCfp2			 INTEGER,
				ommp401NumberOfHostLanesInCfp2				 INTEGER,
				ommp401Cfp2ModuleId					 DisplayString,
				ommp401Cfp2PowerClass					 INTEGER,
				ommp401Cfp2ProductCodeValue				 INTEGER,
				ommp401Cfp2WavelengthTunabilitySupported			INTEGER,
				ommp401TunableCfp2LaserFirstFrequency			        DisplayString,
				ommp401TunableCfp2LaserLastFrequency			        DisplayString,
				ommp401Cfp2ConnectorType					DisplayString,
				ommp401Cfp2SignalEncodingTypeSupported			DisplayString,
				ommp401Cfp2MaximumBitrateSupported			        DisplayString,
				ommp401Cfp2MaximumCaseTemperatureSupported		        INTEGER,
				ommp401Cfp2MinimumCaseTemperatureSupported		        DisplayString,
				ommp401Cfp2ActiveWavelengthControlSupported			INTEGER,
				ommp401Cfp2TransmitterIsCooledOrUncooled			INTEGER,
				ommp401Qsfp28EepromPage						INTEGER,
				ommp401Qsfp28VendorName						DisplayString,
				ommp401Qsfp28VendorIeeeId					DisplayString,
				ommp401Qsfp28PartNumber						DisplayString,
				ommp401Qsfp28SerialNumber					DisplayString,
				ommp401Qsfp28RevisionNumber					DisplayString,
				ommp401Qsfp28ManufacturingDate					DisplayString,
				ommp401FixedQsfp28LaserWavelength				DisplayString,
				ommp401Qsfp28ConnectorType					DisplayString,
				ommp401Qsfp28LinkLength						DisplayString,
				ommp401Qsfp28SignalEncodingTypeSupported			INTEGER,
				ommp401Qsfp28TransceiverCodesSupported				DisplayString,
				ommp401Qsfp28NominalBitrateSupported				DisplayString,
				ommp401Cfp2ModuleInfo						INTEGER,
				ommp401CardGeneralDetailsTableRowStatus			RowStatus
			 }
	

	ommp401InterfaceNumber OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
			"Interface number represents the port number.
			InterfaceNumber to port mapping is as follows:
			1 - CLIENT-1,
			2 - CLIENT-2,
			3 - CLIENT-3,
			4 - CLIENT-4,
			5 - LINE-1
			-----------------------------
			For properties which do not apply on any interface,
			the interface number must be passed as 0
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 1 }
	
	ommp401EepromCardId OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the card ID of the OMMP401 card, present in the EEPROM
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 2 }

	ommp401EepromCardName OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the card name of the OMMP401 card, present in the EEPROM
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 3 }

	ommp401EepromPartCode OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the part code of the OMMP401 card, present in the EEPROM
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 4 }

	ommp401EepromCardSerialNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property get / set the information about 
			OMMP401 Card's Serial Number.
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Values:
			eg: 123456
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 5 }

	ommp401EepromHardwareExternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Hardware External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are significant
			architectural changes in the product
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Value:
			eg: 0.1
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 6 }

	ommp401SoftwareExternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are
			significant architectural changes in the product
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Value:
			eg: 0.1
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 7 }

	ommp401EepromHardwareInternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Hardware Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external hardware version.
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Value:
			eg: 4.1
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 8 }

	ommp401SoftwareInternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external software version.
		      	-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Value:
			eg: 5.1
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 9 }

	ommp401EepromCardUidNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card Unique IDentifier. It is a 4 byte
			address used to uniquely identify a card.
			----------------------------
			ommp401InterfaceNumber: 0
			------------------------------
			Value:
		      	eg: 12345678
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 10 }

	ommp401EepromCardEui48Number OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-48 Number. It is a 6 byte address
			used to uniquely identify a card.
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 0004A3123456
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 11 }

	ommp401EepromCardEui64Number OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-64 Number. It is a 8 byte address
			used to uniquely identify a card.
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 0004A31234567890
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 12 }
		
	ommp401CardInstallationDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Gets the card's installation date in
			dd/mm/yyyy format
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 12/02/2023
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 13 }

	ommp401CardCommissionDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Gets the card's commission date in
			dd/mm/yyyy format
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 12/02/2023
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 14 }

	ommp401CardRunningTime OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Get the duration of time for which the card is
			operational/running
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 4d:3h:2m:1s
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 15 }

	ommp401CardRestartCount OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Get the number of times the card has been soft reset.
			This value will get reset to 0 on factory reset.
			-----------------------------
			ommp401InterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 10
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 16 }

	ommp401Cfp2ReadyForOperation OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Module not ready indicates that the CFP2
			has detected a condition that tells
			transmit or receive data is invalid.
			It shall consist of logical OR of the
			following signals:
			> Transmit Signal Conditioner Loss of Lock
			> Transmitter Laser Fault
			> Receiver Signal Conditioner Loss of Lock
			(Ref: INF-8077 2.4.1)
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:		
			0 - CFP2 is ready for operation 
			1 - CFP2 is not ready for operation
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 17 }

	ommp401Cfp2VendorName OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides Vendor Name for given CFP2. 
			The vendor name shall be the full name of the 
			corporation, a commonly accepted abbreviation of 
			the name of the corporation, the SCSI company code
			for the corporation, or the stock exchange code for
			the corporation.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: Lumentum
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 18 }

	ommp401Cfp2VendorIeeeId OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the IEEE company Identifier for
			the vendor of CFP2. A value of all zero in the 3-byte
			field indicates that the Vendor OUI is unspecified.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: 010
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 19 }

	ommp401Cfp2PartNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the vendor part number or
			product name of the CFP2. A value of all zero
			indicates that the vendor Part Number is unspecified.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: FTRX-1811-2D2
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 20 }

	ommp401Cfp2SerialNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides vendor serial number defining
			the vendor’s serial number for the CFP2. A value of all
			zero in the 16-byte field indicates that the vendor
			serial number is unspecified.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: KBG02CU
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 21 }

	ommp401Cfp2ManufacturingDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the manufacturing date for 
			CFP2. A value of 8-byte field in ASCII which represents
			year, month and date of each two bytes. 
			Extra two bytes may be blank
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: 07292020
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 22 }

	ommp401Cfp2HardwareVersionNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the hardware version number for 
			CFP2. A value of 2-byte field which represents
			hardware version number in x.y format. 
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: 1.1
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 23 }

	ommp401Cfp2FirmwareVersionNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Firmware version number for 
			CFP2. A value of 2-byte field which represents
			firmware version number in x.y format. 
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: 1.1
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 24 }

	ommp401Cfp2MediaType OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Media type for 
			CFP2. A value of 2-Bit field which represents
			media type. 
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: SMF
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 25 }

	ommp401NumberOfNetworkLanesInCfp2 OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Number of Network Lanes for 
			CFP2. A value of 4-Bits field which represents
			Number of Network Lanes. 
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: 1
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 26 }

	ommp401NumberOfHostLanesInCfp2 OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Number of Network Host for 
			CFP2. A value of 4-Bits field which represents
			Number of Host Lanes.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: 1
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 27 }
		
	ommp401Cfp2ModuleId OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Module ID for 
			CFP2. A value of 1-Byte field which represents
			Module identifier.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: CFP2
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 28 }

	ommp401Cfp2PowerClass OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Power Class for 
			CFP2. A value of 2-Bits field which represents
			Power class.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			0 - <= 9Watts
			1 - <= 12Watts
			2 - <= 15Watts
			3 - > 15Watts
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 29 }

	ommp401Cfp2ProductCodeValue OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Product code value for 
			CFP2. A value of 7-Bits field which represents
			Product code value.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: 50h
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 30 }
		
	ommp401Cfp2WavelengthTunabilitySupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides information whether the CFP2
			supports wavelength tunability or not.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			1 - CFP2 supports wavelength tunability
			0 - CFP2 does not supports wavelength tunability
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 31 }

	ommp401TunableCfp2LaserFirstFrequency OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the first LASER frequency of CFP2.
			The two byte value is specified in units of THz.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: 191
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 32 }

	ommp401TunableCfp2LaserLastFrequency OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the last laser frequency of CFP2.
		 	 The two byte value is specified in units of THz.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: 196
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 33 }

	ommp401Cfp2ConnectorType OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides information of the CFP2
			connector, value indicates the external connector
			provided on the CFP2.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:
			eg: LC
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 34 }

	ommp401Cfp2SignalEncodingTypeSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property indicates the serial encoding mechanisms
			that are supported by the CFP2.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:
			eg: 16QAM
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 35 }

	ommp401Cfp2MaximumBitrateSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides maximum bit rate(Gbps) value
			supported by CFP2
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values: 9.5
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 36 }

	ommp401Cfp2MaximumCaseTemperatureSupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides the maximum case temperature
			(degree celcius) supported by CFP2.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:
			eg: 70
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 37 }

	ommp401Cfp2MinimumCaseTemperatureSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides the manimum case temperature
			(degree celcius) supported by CFP2.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:
			eg: 70
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 38 }

	ommp401Cfp2ActiveWavelengthControlSupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides whether the CFP2 wavelength 
			controlling state is active or not
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:
			1 - Supported
			0 - Not supported
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 39 }

	ommp401Cfp2TransmitterIsCooledOrUncooled OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provide information on which type of
			diode used in transmitter of the CFP2
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:
			1 - Cooling circuit supported for CFP2 transmitter. 
			0 - Cooling circuit not supported for CFP2 transmitter.
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 40 }

	ommp401Qsfp28EepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property sets/gets the QSFP28 EEPROM page, 
			the value represents the QSFP28 EEPROM page number.
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 41 }

	ommp401Qsfp28VendorName OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides Vendor Name for given QSFP28. 
			The vendor name shall be the full name of the 
			corporation, a commonly accepted abbreviation of 
			the name of the corporation, the SCSI company code
			for the corporation, or the stock exchange code for
			the corporation.
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:			
			eg: Lumentum
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 42 }

	ommp401Qsfp28VendorIeeeId OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the IEEE company Identifier for
			the vendor of QSFP28. A value of all zero in the 3-byte
			field indicates that the Vendor OUI is unspecified.
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:			
			eg: 010
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 43 }

	ommp401Qsfp28PartNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the vendor part number or
			product name of the QSFP28. A value of all zero
			indicates that the vendor Part Number is unspecified.
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:			
			eg: WXTR15101000427
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 44 }

	ommp401Qsfp28SerialNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides vendor serial number defining
			the vendor’s serial number for the QSFP28. A value of all
			zero in the 16-byte field indicates that the vendor
			serial number is unspecified.
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:			
			eg: WXTRRPGEAS1
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 45 }

	ommp401Qsfp28RevisionNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"The vendor revision number defining the vendor’s
			product revision number. A value of all zero indicates
			that the vendor revision number is unspecified
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:			
			eg: A0
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 46 }

	ommp401Qsfp28ManufacturingDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the manufacturing date for 
			QSFP28. A value of 8-byte field in ASCII which represents
			year, month and date of each two bytes. 
			Extra two bytes may be blank
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:			
			eg: 160223
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 47 }

	ommp401FixedQsfp28LaserWavelength OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides transmitter LASER wavelength(nm)
			of the QSFP28
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:			
			eg: 1310.0
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 48 }

	ommp401Qsfp28ConnectorType OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides information of the QSFP28
			connector, value indicates the external connector
			provided on the QSFP28.
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:
			eg: LC
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 49 }

	ommp401Qsfp28LinkLength OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides link length suported by the QSFP28
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:
			eg: 80.00
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 50 }

	ommp401Qsfp28SignalEncodingTypeSupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property indicates the serial encoding mechanisms
			that are supported by the QSFP28.
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:
			1 - RZ
			2 - 8B10B
			3 - SONET Scrambled
			4 - NRZ
			5 - 64B/66B
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 51 }

	ommp401Qsfp28TransceiverCodesSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"The identifier value specifies which transceiver
			codes are supported by the QSFP28
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values:
			0   - 1000BASE-SX
			1   - 1000BASE-LX
			2   - 1000BASE-CX
			3   - 1000BASE-T
			4-7 - Reserved
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 52 }

	ommp401Qsfp28NominalBitrateSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides Nominal bit rate value(Gbps)
			supported by the QSFP28
			-----------------------------
			ommp401InterfaceNumber:
			1 to 4 - CLIENT-1 to CLIENT-4
			-----------------------------
			Values: 2.0
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 53 }
		
	ommp401Cfp2ModuleInfo OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Module Information for 
			CFP2. A value of 1-Byte field which represents
			Module identifier.
			-----------------------------
			ommp401InterfaceNumber:
			5 - LINE-1
			-----------------------------
			Values:			
			eg: 1-> 100G-CFP2
			    2-> 200G-CFP2
			    3-> 400G-CFP2
			    4-> UNKNOWN-CFP2
			-----------------------------"
		::= { ommp401CardGeneralDetailsEntry 54 }

	ommp401CardGeneralDetailsTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
			"*****************************
			This is MIB realted property,
			NOT to be considered as a card property
			*****************************"
              ::= { ommp401CardGeneralDetailsEntry 55 }


        ::= { neutronAlarmQueryEntry 3 }

	neutronHighTemperatureAlarm	OBJECT-TYPE
        SYNTAX 			DisplayString
		MAX-ACCESS  	read-only
		STATUS  		current
		DESCRIPTION		"This alarm is generated when Neutron card's Temperature
						 Goes Above High Temperature Alarm Threshold
						 ----------------------------------
						 	Port Number : 0 
						 ----------------------------------		
							Values 
								0	-> No alarm
								
								If Time stamp comes as a reply for the get alarm query,
								it indicates the presence of the alarm and the time is 
								alarm generated time ( Eg : 2017-5-25,10:42:0.0,+5:30 )
						----------------------------------"
		::= { neutronAlarmQueryEntry 11 }
		

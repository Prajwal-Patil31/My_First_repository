	neutronSyncSystemTimeWithNtpServer	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
  						present in linux kernel with the NTP server
  						we can use this OID. We can provide NTP server
  						ip address as a value to this OID and the time
  						will be synced to that particular server. 
  						If we are not providing NTP server IP address 
  						then the system will be synced with the NTP server 
  						which is already been registered with Neutron. 
  						If both are absent then error message will be returned
  						-----------------------------
							Port Number : 0
						-----------------------------
							If we want to provide NTP server IP address then
							Value should be a valid IP address as shown below
							: 192.168.21.25
							
							If we don't want to provide NTP server address then no
							need to pass any value. 
						---------------------------"
  						
  		::= { neutronConfigurationEntry 165 }
  		
  	neutronSyncRtcWithNtpServer	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
  						present in RTC with the NTP server
  						we can use this OID. We can provide NTP server
  						ip address as a value to this OID and the time
  						will be synced to that particular server. 
  						If we are not providing NTP server IP address 
  						then the system will be synced with the NTP server 
  						which is already been registered with Neutron. 
  						If both are absent then error message will be returned.
  						-----------------------------
						Port Number : 0
						-----------------------------
						If we want to provide NTP server IP address then
						Value should be a valid IP address as shown below
						: 192.168.21.25
							
						If we don't want to provide NTP server address, then no
						need to pass any value. 
						---------------------------"
  						
  		::= { neutronConfigurationEntry 166 }
  		
  	neutronSyncRtcWithSystemTime	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
  						present in RTC with the time value in linux kernel
  						we can use this OID. With this set operation, 
  						the time available with linux kernel will be updated
  						into RTC. It is not required to provide any value for 
  						this operation"
  						
  		::= { neutronConfigurationEntry 167 }
  		
  	neutronUpdateGivenTimeIntoSystem	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually update system time
  						with the user provided time, we can use this OID.
  						With OID we need to provide time value which we
  						want to update in the system.
  						-----------------------------
						Port Number : 0
						-----------------------------
						Value should be of given format:
						YYYY-MM-DD H:M:S
						
						Example: 2017-10-31 15:20:44
						---------------------------"
						
  		::= { neutronConfigurationEntry 168 }
  		
  	neutronUpdateGivenTimeIntoRtc	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually update RTC time
  						with the user provided time, we can use this OID.
  						With OID we need to provide time value which we
  						want to update in RTC.
  						-----------------------------
						Port Number : 0
						-----------------------------
						Value should be of given format:
						YYYY-MM-DD H:M:S
						
						Example: 2017-10-31 15:20:44
						---------------------------"
						
  		::= { neutronConfigurationEntry 169 }
  		
  	neutronSystemTimeAndRtcTime	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-only
  		STATUS  		current
  		DESCRIPTION	 	" get the system time and time value present in RTC.
  						-----------------------------
						Port Number : 0
						-----------------------------"
						
  		::= { neutronConfigurationEntry 170 }
  		
  	listNeutronSoftwareReleases	 OBJECT-TYPE
		SYNTAX  		OCTET STRING
  		MAX-ACCESS  	read-only
  		STATUS  		current
  		DESCRIPTION	 	" Gives what are the different versions
  						of software releases for Neutron is available in SCC. 
  						This OID can be used by EMS to list all available 
  						neutron software releases present in SCC
  						-----------------------------
						Port Number : 0
						-----------------------------"
  						
  		::= { neutronConfigurationEntry 171 }
  		
  	deleteNeutronSoftwareRelease	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" This OID can be used to delete any unwanted
  						software release of Neutron present in SCC.
  						-----------------------------
						Port Number : 0
						-----------------------------
						Example for values:
						
						rel-1.0.0.130.tar.gz
						---------------------------"
  						
  		::= { neutronConfigurationEntry 172 }
  		
  	listGalaxySoftwareReleases	 OBJECT-TYPE
		SYNTAX  		OCTET STRING
  		MAX-ACCESS  	read-only
  		STATUS  		current
  		DESCRIPTION	 	" Gives what are the different versions
  						of Galaxy software releases are available in SCC. 
  						This OID can be used by EMS to list all available 
  						Galaxy software releases present in SCC
  						-----------------------------
						Port Number : 0
						-----------------------------"
  						
  		::= { neutronConfigurationEntry 173 }
  		
  	deleteGalaxySoftwareRelease	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" This OID can be used to delete any unwanted
  						Galaxy software release present in SCC.
  						-----------------------------
						Port Number : 0
						-----------------------------
						Example for values:
						
						rel-1.0.0.180.tar.gz
						---------------------------"
						
  		::= { neutronConfigurationEntry 174 }
  		
 neutronDisableOrEnableEmsAndLctPorts	 OBJECT-TYPE
	SYNTAX  		DisplayString
	MAX-ACCESS  	read-write
	STATUS  		current
	DESCRIPTION	 	" This OID can be used to Enable/Disable the EMS/LCT
					Ethernet ports present in SCC.
					-----------------------------
					Port Number : 5 ( For EMS )
					Port Number : 6 ( For LCT )
					-----------------------------
					Values: 
					1 - Enable EMS/LCT port
					0 - Disable EMS/LCT port
					-----------------------------"
			
	::= { neutronConfigurationEntry 175 }
	
neutronPortInterfaceReset	OBJECT-TYPE
			SYNTAX  		DisplayString
			MAX-ACCESS 		read-write
			STATUS 			current
			DESCRIPTION		"Valid only as a SET command.
							This OID can be used to Reset Given Interface of SCC
							- Resets EMS/LCT/OSC port interfaces
							-----------------------------
							Port Number should be interface number i.e, 0 to 7
							eg: 
								OSC1 -> 1
								OSC2 -> 2
								OSC3 -> 3
								OSC4 -> 4
								EMS/LCT -> 5
								VoIP -> 7 
							-----------------------------
							Values: should be given 0
							returns success, operation succeful tuple
							-----------------------------"
	::= { neutronConfigurationEntry 176 }
	
neutronPortInterfaceMacAddress		OBJECT-TYPE
			SYNTAX  		DisplayString
			MAX-ACCESS 		read-only
			STATUS 			current
			DESCRIPTION		"Valid only as a GET command.
							This OID can be used to get Given Interface mac address
							-----------------------------
							Port Number should be interface number i.e, 0 to 7
							eg: 
								OSC1 -> 1
								OSC2 -> 2
								OSC3 -> 3
								OSC4 -> 4
								EMS/LCT -> 5
								VoIP -> 7 
							-----------------------------
							Values: returns mac address for the interface
							-----------------------------"
	::= { neutronConfigurationEntry 177 }

		
--*****************************************************************************
--				   ALARM
--*****************************************************************************

	neutronAlarmQueryTable OBJECT-TYPE
  		SYNTAX  		SEQUENCE OF NeutronAlarmQueryEntry
  		MAX-ACCESS  	not-accessible
  		STATUS  		current
  		DESCRIPTION		""
  		::= { neutronAlarmQuery  1 }

	neutronAlarmQueryEntry OBJECT-TYPE
		SYNTAX  		NeutronAlarmQueryEntry
      	MAX-ACCESS  	not-accessible
      	STATUS  		current
      	DESCRIPTION 	""
		INDEX   		{ node, rack , subRack , slot, port }
      	::= { neutronAlarmQueryTable 1 }

	NeutronAlarmQueryEntry ::= 
		SEQUENCE {
		
					cardJackIn			DisplayString,
					cardJackOut 		DisplayString,
					cardRegistered 		DisplayString,
					 
					neutronHighTemperatureAlarm			DisplayString,
					neutronHighTemperatureWarning		DisplayString,
					neutronLowTemperatureAlarm			DisplayString,
					
					neutronOscSfpHighBiasCurrentAlarm			DisplayString,
					neutronOscSfpHighBiasCurrentWarning			DisplayString,
					neutronOscSfpLowBiasCurrentAlarm			DisplayString,
					neutronOscSfpLowBiasCurrentWarning			DisplayString,
					neutronOscSfpHighSupplyVoltageAlarm			DisplayString,
					neutronOscSfpHighSupplyVoltageWarning		DisplayString,
					neutronOscSfpLowSupplyVoltageAlarm			DisplayString,
					neutronOscSfpLowSupplyVoltageWarning		DisplayString,
					neutronOscSfpHighOutputPowerAlarm			DisplayString,
					neutronOscSfpHighOutputPowerWarning			DisplayString,
					neutronOscSfpLowOutputPowerAlarm			DisplayString,
					neutronOscSfpLowOutputPowerWarning			DisplayString,
					neutronOscSfpHighInputPowerAlarm			DisplayString,
					neutronOscSfpHighInputPowerWarning			DisplayString,
					neutronOscSfpLowInputPowerAlarm				DisplayString,
					neutronOscSfpLowInputPowerWarning			DisplayString,
					neutronOscSfpLowTemperatureAlarm			DisplayString,
					neutronOscSfpLowTemperatureWarning			DisplayString,
					neutronOscSfpHighTemperatureAlarm			DisplayString,
					neutronOscSfpHighTemperatureWarning			DisplayString,
					neutronOscSfpPresenceAbsenceNotification	DisplayString,
					neutronOscSfpOutputPowerFailureAlarm		DisplayString,
					neutronOscSfpInputPowerFailureAlarm			DisplayString,
					

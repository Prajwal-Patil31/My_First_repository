	neutronBmuAlarmSeverityIndicationStatus		OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS  	read-only
  		STATUS  		current
  		DESCRIPTION	 	"This notification is Generated when BMU's LED indication is 
  						changed with respect to Alarm Present in system.
  						----------------------------------
						 	Port Number ( BMU Rack Number ): 
						 		1 - Rack 1 BMU
						 		2 - Rack 2 BMU
						----------------------------------		
							Values 
								major 		- Major Alarm LED is ON
								minor 		- Minor Alarm LED is ON
								major+minor - Major and Minor Alarm LED is ON
								normal 		- Normal Alarm LED is ON
						----------------------------------"
  		::= { neutronAlarmQueryEntry 61 }
	

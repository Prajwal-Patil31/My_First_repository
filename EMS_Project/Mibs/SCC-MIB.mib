--*****************************************************************************
--				PERFORMANCE	
--*****************************************************************************

	neutronPerformanceTable OBJECT-TYPE
  		SYNTAX  		SEQUENCE OF NeutronPerformanceEntry
  		MAX-ACCESS  	not-accessible
  		STATUS  		current
  		DESCRIPTION		""
  		::= { neutronPerformance  1 }

	neutronPerformanceEntry OBJECT-TYPE
		SYNTAX  		NeutronPerformanceEntry
      	MAX-ACCESS  	not-accessible
      	STATUS  		current
      	DESCRIPTION 	""
		INDEX   		{ node, rack , subRack , slot, port }
      	::= { neutronPerformanceTable 1 }

	NeutronPerformanceEntry ::= 
		SEQUENCE {
					neutronOscSfpInputPower			DisplayString,
					neutronOscSfpOutputPower		DisplayString,
					neutronOscSfpTemperature		DisplayString,
					neutronOscSfpBiasCurrent		DisplayString,
					neutronOscSfpSupplyVoltage		DisplayString,
					neutronTemperature				DisplayString	
			}
			
	neutronOscSfpInputPower	OBJECT-TYPE
		SYNTAX  		DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS  		current
		DESCRIPTION		"Gives the current Input power(dbm) received at the port
						-----------------------------
							Port Number :
  						 			1 - OSC 1
  						 			2 - OSC 2
  						 			3 - OSC 3
  						 			4 - OSC 4
						-----------------------------
						Values:
						eg: -9.0
						-----------------------------"
  		::= { neutronPerformanceEntry 1 }
  		
	neutronOscSfpOutputPower 	OBJECT-TYPE
		SYNTAX  		DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS  		current
		DESCRIPTION		"Gives the current Output power(dbm) transmitted at the port
						-----------------------------
							Port Number :
  						 			1 - OSC 1
  						 			2 - OSC 2
  						 			3 - OSC 3
  						 			4 - OSC 4
						-----------------------------
						Values:
						eg: -6.0
						-----------------------------"
  		::= { neutronPerformanceEntry 2 }
  		
	neutronOscSfpTemperature 	OBJECT-TYPE
		SYNTAX  		DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS  		current
		DESCRIPTION		"Gives the temperature(degree celcius) of the transmitter
						at  the port
						-----------------------------
							Port Number :
  						 			1 - OSC 1
  						 			2 - OSC 2
  						 			3 - OSC 3
  						 			4 - OSC 4
						-----------------------------
						Values:
						eg: 33.35
						-----------------------------"
  		::= { neutronPerformanceEntry 3 }
  		
	neutronOscSfpBiasCurrent 	OBJECT-TYPE
		SYNTAX  		DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS  		current
		DESCRIPTION		"Gives the bias current(mA) thats transmitted at the port
						-----------------------------
							Port Number :
  						 			1 - OSC 1
  						 			2 - OSC 2
  						 			3 - OSC 3
  						 			4 - OSC 4
						-----------------------------
							Values:
								eg: 55
						-----------------------------"
  		::= { neutronPerformanceEntry 4 }
  		
	neutronOscSfpSupplyVoltage 	OBJECT-TYPE
		SYNTAX  		DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS  		current
		DESCRIPTION		"Gives the Supply Voltage of the port
						-----------------------------
							Port Number :
  						 			1 - OSC 1
  						 			2 - OSC 2
  						 			3 - OSC 3
  						 			4 - OSC 4
						-----------------------------
							Values:
								eg: 3.3
						-----------------------------"
  		::= { neutronPerformanceEntry 5 }
  		
	neutronTemperature 	OBJECT-TYPE
		SYNTAX  		DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS  		current
		DESCRIPTION		"Gives the Current temperature of Neutron Card
						-----------------------------
							Port Number : 0
						-----------------------------
							Values:
								eg: 37.0
						-----------------------------"
  		::= { neutronPerformanceEntry 21 }
  	
--*****************************************************************************
	

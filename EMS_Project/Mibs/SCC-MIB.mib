						----------------------------------"
  		::= { neutronAlarmQueryEntry 69 }

	demuxDirectionConflictAlarm	 OBJECT-TYPE
		SYNTAX 			DisplayString
		MAX-ACCESS  	read-only
		STATUS  		current
		DESCRIPTION		"This alarm is Generated when two Same direction 
						DEMUX cards are present in the same terminal
						----------------------------------
						 	Port Number :
  						 			1 - Direction 1
  						 			2 - Direction 2
  						 			3 - Direction 3
  						 			4 - Direction 4
						----------------------------------		
							Values 
								0	-> No alarm
								
								If Time stamp comes as a reply for the get alarm query,
								it indicates the presence of the alarm and the time is 
								alarm generated time ( Eg : 2017-5-25,10:42:0.0,+5:30 )
						----------------------------------"
  		::= { neutronAlarmQueryEntry 70 }
					

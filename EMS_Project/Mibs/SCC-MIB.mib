	neutronTrapReceiverIpAddress  OBJECT-TYPE
		SYNTAX  		OCTET STRING
		MAX-ACCESS  	read-write
		STATUS  		current
		DESCRIPTION		"To Set/Get Trap Receiver IP address.
						 -----------------------------
						 Port Number : 0
						 ----------------------------- "
  		::= { neutronConfigurationEntry 1 }	
		
	neutronDeleteTrapReceiverIpAddress	OBJECT-TYPE
		SYNTAX  		DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS  		current
		DESCRIPTION		"To delete Trap Receiver IP address"
  		::= { neutronConfigurationEntry 2}

	neutronPortIpAddress OBJECT-TYPE
      	SYNTAX  		DisplayString (SIZE (0..255))
      	MAX-ACCESS  	read-write
     	STATUS  		current
     	DESCRIPTION		"To Change Ems OSC Ports and VoIP Ip address,
			              the IP should be provided along with it's 
			              net mask and gateway address separated by /
			              ----------------------------------------------
			              eg : 192.168.21.2/255.255.255.0/192.168.21.254
			              ----------------------------------------------
			              Port Number : 
				              1 -> set/get OSC1 ip address
				              2 -> set/get OSC2 ip address
				              3 -> set/get OSC3 ip address
				              4 -> set/get OSC4 ip address
				              5 -> set/get EMS  ip address
				              7 -> set/get VoIP ip address"
		::= { neutronConfigurationEntry 3 }

	neutronAddRoute OBJECT-TYPE
    	SYNTAX  		DisplayString (SIZE (0..255))
	    MAX-ACCESS  	read-write
	    STATUS  		current
	    DESCRIPTION		"To set/get Routing table entry"
	    ::= { neutronConfigurationEntry 4 }

	neutronDeleteRoute OBJECT-TYPE
		SYNTAX  		DisplayString (SIZE (0..255))
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	"To Delete Routing table entry"
  		::= { neutronConfigurationEntry 5 }			
					
	neutronAddNtpServer	OBJECT-TYPE
		SYNTAX  		DisplayString (SIZE (0..255))
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	"To Add NTP Server."
  		::= { neutronConfigurationEntry 6 }
  		
	neutronDeleteNtpServer	OBJECT-TYPE
		SYNTAX  		DisplayString (SIZE (0..255))
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	"To Delete NTP Server."
  		::= { neutronConfigurationEntry 7 }
	
	neutronRestartCard	OBJECT-TYPE
		SYNTAX  		INTEGER
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	"To restart Card."
  		::= { neutronConfigurationEntry 8 }
	
	neutronCardSoftwareUpgrade 	OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	"Valid only as SET command.
						This property upgrades the software.
						-----------------------------
						Port Number : 0
						-----------------------------
						value - File path
							For Eg. 
								/home/root/rel-1.tar.gz "
  		::= { neutronConfigurationEntry 9 }			
	
	neutronOscSfpLaserState	OBJECT-TYPE
		SYNTAX  		DisplayString (SIZE (0..255))
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	"To Get Laser Status. and Turn On/Off OSC SFP Laser.
  						 -----------------------------
  						 	Port Number :
  						 			1 - OSC 1
  						 			2 - OSC 2
  						 			3 - OSC 3
  						 			4 - OSC 4
  						-----------------------------
  						 NOTE : If Automatic Laser Shutdown(ALSD) is enable than 
  						 		Laser cann't be contol( ie. Can't ON/OFF Laser ). "
  		::= { neutronConfigurationEntry 10 }
  		
	neutronAutomaticLaserShutdownStatus	OBJECT-TYPE
		SYNTAX  		INTEGER
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	"Set the Automatic Laser Switching(ALS) mode for
						for requested port. Based on the RX LOS state of the
						port, the transmit LASER state will be controlled
						according to the algorithm defined for ALS in
						ITUT 664 Standard
						-----------------------------
						 Port Number :
  						 			1 - OSC 1
  						 			2 - OSC 2
  						 			3 - OSC 3
  						 			4 - OSC 4
						-----------------------------
						 Values: 
							1 - Enable ALS state
							0 - Disable ALS state "
  		::= { neutronConfigurationEntry 11 }
  
  	neutronAlsPulseRepetitionTime OBJECT-TYPE
      	SYNTAX  		INTEGER
      	MAX-ACCESS  	read-write
     	STATUS  		current
     	DESCRIPTION		"Pulse repetition time is the time for automatic
						restart of OSC SFP LASER once the ALS algorithm starts.
						-----------------------------
						Values:
						100 seconds to 300 seconds
						-----------------------------  "
		::= { neutronConfigurationEntry 12 }
  		
  	neutronDeletePortIpAddress OBJECT-TYPE
      	SYNTAX  		DisplayString (SIZE (0..255))
      	MAX-ACCESS  	read-write
     	STATUS  		current
     	DESCRIPTION		"To Remove IP assigned to SCC's Ethernet Ports
			              Port Number : 
				              1 ->  OSC1 ip address
				              2 ->  OSC2 ip address
				              3 ->  OSC3 ip address
				              4 ->  OSC4 ip address
				              5 ->  EMS  ip address
				              7 ->  VoIP ip address"
		::= { neutronConfigurationEntry 13 }
		
  	mdroadmDirectionBoxInterconnection OBJECT-TYPE
      	SYNTAX  		DisplayString (SIZE (0..255))
      	MAX-ACCESS  	read-write
     	STATUS  		current
     	DESCRIPTION		"To set the Interconnection information between 
     					two direction boxes of MDROADM node.
     					
     					Value: Direction-Port-Direction-Port
     					
     					Example: if we want to make connection between
     					Direction1 port1 to direction2 port1, then the connection
     					information should be provided as: 1-1-2-1
     					-----------------------------
						Port Number should be : 0 "
						
		::= { neutronConfigurationEntry 14 }
		
	deleteMdroadmDirectionBoxInterconnection OBJECT-TYPE
      	SYNTAX  		DisplayString (SIZE (0..255))
      	MAX-ACCESS  	read-write
     	STATUS  		current
     	DESCRIPTION		"To delete the Interconnection information between 
     					two direction boxes of MDROADM node.
     					
     					Value: Direction-Port-Direction-Port
     					
     					Example: if we want to delete connection between
     					Direction1 port1 to direction2 port1, then the connection
     					information should be provided as: 1-1-2-1
     					-----------------------------
						Port Number should be : 0 "
						
		::= { neutronConfigurationEntry 15 }
		
	mdroadmAllDirectionBoxInterconnection OBJECT-TYPE
      	SYNTAX  		DisplayString (SIZE (0..255))
      	MAX-ACCESS  	read-write
     	STATUS  		current
     	DESCRIPTION		"To set and get Interconnection information of 
     					all direction box present in MDROADM node.
     					
     					Here the connection information between direction boxes should be
     					provided with comma separated.
     					Value: Direction-Port-Direction-Port,Direction-Port-Direction-Port ..
     					
     					Example: 1-1-2-1,1-2-3-2,1-3-4-1,2-2-3-1,2-3-4-3,4-2-3-3
     					-----------------------------
						Port Number should be : 0 "
						
		::= { neutronConfigurationEntry 16 }
						
	deleteMdroadmAllDirectionBoxInterconnection OBJECT-TYPE
      	SYNTAX  		DisplayString (SIZE (0..255))
      	MAX-ACCESS  	read-write
     	STATUS  		current
     	DESCRIPTION		"To delete Interconnection information of 
     					all direction box present in MDROADM node.
     					
     					Value: 0
     					-----------------------------
						Port Number should be : 0 "
						
		::= { neutronConfigurationEntry 17 }
		
	channelConfigurationsOfDirectionBoxes OBJECT-TYPE
      	SYNTAX  		DisplayString (SIZE (0..255))
      	MAX-ACCESS  	read-write
     	STATUS  		current
     	DESCRIPTION		"This OID can be used to:
     					set channel port
     					set channel attenuation 
     					set channel to block state
     					of direction box present in MDROADM node.
     					
     					Value: Direction-Port-Channel-Attenuation - for setting attenuation
						Value: Direction-Port-Channel-Attenuation,Direction-Port-Channel-Attenuation - 
								for setting channel port or channel state to block
     					
     					-----------------------------
						Port Number should be : 0 "
		::= { neutronConfigurationEntry 18 }
						
	blockAllChannelsOfDirectionBoxPort OBJECT-TYPE
      	SYNTAX  		DisplayString (SIZE (0..255))
      	MAX-ACCESS  	read-write
     	STATUS  		current
     	DESCRIPTION		"This OID can be used to block all channels of the given port and 
     					all channels mapped between two direction boxes present in MDROADM node.
     					
						Value: Direction-Port - for blocking all channels mapped through the given port and direction
						Value: Direction-Port,Direction-Port,Direction-Port - for blocking all mapped channels for multiple directions 
     					-----------------------------
						Port Number should be : 0 "
		::= { neutronConfigurationEntry 19 }
		
	neutronCardFactoryReset	OBJECT-TYPE		 
		SYNTAX  		INTEGER
		MAX-ACCESS 		read-write
		STATUS 			current
		DESCRIPTION		"Valid only as a SET command.
						This OID can be used to Sets SCC To Factory Default State
						Following changes has been done,
						- Deletes EMS/LCT Ip address and Set 192.168.21.46 IP address to EMS port
						- Deletes All OSC Port IP address
						- Deletes VoIP Port IP address
						- Deletes NTP Sever IP address
						- Deletes Trap Receiver IP address
						- Deletes All log files.
						- Deletes Datbase Tables
						- All Defaults Thresholds and Severity will be loaded into Database Table.
						- At last will Reboot Card.
						-----------------------------
						Port Number should be : 0 
						-----------------------------
						Values:
						Dont care, any value
						eg: 0
						-----------------------------"
		::= { neutronConfigurationEntry 20 }

	generateAlarmHistoryLogFile OBJECT-TYPE		 
			SYNTAX  		DisplayString
			MAX-ACCESS  	read-write
			STATUS 			current
			DESCRIPTION		"Writes the complete alarm history logs in to a file
							and returns the file path.
							-----------------------------
							Port : 0
							-----------------------------
							Values:
						      	eg: /home/root/neutron/alarm_log_dump
							-----------------------------"
			::= { neutronConfigurationEntry 21 }

	allActiveAlarmsOfTerminal OBJECT-TYPE
      	SYNTAX  		DisplayString (SIZE (0..255))
      	MAX-ACCESS  	read-only
     	STATUS  		current
     	DESCRIPTION		"Writes all active alarms in to a file
						and returns the file path.
						-----------------------------
						Port : 0
						-----------------------------
						Values:
					      	eg: /home/root/neutron/active_alarms.txt
						-----------------------------"
		::= { neutronConfigurationEntry 22 }
	

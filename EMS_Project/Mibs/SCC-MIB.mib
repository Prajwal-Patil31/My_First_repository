					cardSoftwareUpgradeStatus					DisplayString,
					neutronDatabaseFailureAlarm 				DisplayString,
					amplifierDirectionConflictAlarm				DisplayString,
					mdroadmDirectionConflictAlarm				DisplayString,
					muxDirectionConflictAlarm					DisplayString,
					demuxDirectionConflictAlarm					DisplayString
					
			}

	cardJackIn OBJECT-TYPE
    	SYNTAX 			DisplayString
        MAX-ACCESS  	read-only
        STATUS  		current
        DESCRIPTION		"This alarm generates when card detects through Hardware pin"
        ::= { neutronAlarmQueryEntry 1 }


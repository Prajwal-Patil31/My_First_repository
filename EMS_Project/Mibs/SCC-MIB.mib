--*****************************************************************************
--			MIB FILE FOR THE Neutron System Contol Card
--*****************************************************************************

SCC-MIB DEFINITIONS ::= BEGIN
 
      IMPORTS
        	
		RowStatus      			FROM STANDARD-MIB
			
		DisplayString  			FROM RFC1213-MIB       
    	
		OBJECT-IDENTITY,
		NOTIFICATION-TYPE,
		MODULE-IDENTITY,
		Integer32,
		Unsigned32,
		IpAddress,
		TimeTicks				FROM SNMPv2-SMI
	 
	 	OBJECT-TYPE    			FROM RFC-1212
	 		
		MODULE-COMPLIANCE,
		OBJECT-GROUP,
		NOTIFICATION-GROUP		FROM SNMPv2-CONF
    
		enterprises				FROM RFC1155-SMI
	;

	utl   MODULE-IDENTITY
        LAST-UPDATED    	"1807130630Z"
        ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
        CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
        DESCRIPTION     	"MIB module for UTL 40/80 channel DWDM."
        REVISION 	    	"1807130630Z"
        DESCRIPTION    		"MIB module for NEUTRON SCC."
        ::= { enterprises 18036 }
        
	utlrnd  OBJECT-IDENTITY
        STATUS  current
        DESCRIPTION "UTL Research and Development."
        ::= { utl 1 }

	dwdm 			OBJECT IDENTIFIER				::=	{ utlrnd 	1 }
	indus 			OBJECT IDENTIFIER				::=	{ dwdm 		1 }
	neutron 		OBJECT IDENTIFIER 				::= { indus 	1 }
	
	neutronCardGeneralDetails 	OBJECT IDENTIFIER	::=	{ neutron 1 }
	neutronConfiguration 		OBJECT IDENTIFIER 	::=	{ neutron 2 }
	neutronAlarm 				OBJECT IDENTIFIER 	::=	{ neutron 3 }
	neutronPerformance 			OBJECT IDENTIFIER 	::=	{ neutron 4 }

	neutronAlarmQuery 			OBJECT IDENTIFIER	::=	{ neutronAlarm 1 }
	neutronAlarmNotification 	OBJECT IDENTIFIER	::=	{ neutronAlarm 2 }

--*****************************************************************************
--				CARD GENERAL DETAILS
--*****************************************************************************

	neutronCardGeneralDetailsTable	OBJECT-TYPE
		SYNTAX  	SEQUENCE OF NeutronCardGeneralDetailsEntry
      	MAX-ACCESS  not-accessible
      	STATUS  	current
        DESCRIPTION	"Contains card general details' queries for the Neutron card"
		::= { neutronCardGeneralDetails 1 }

	neutronCardGeneralDetailsEntry OBJECT-TYPE
 		SYNTAX  	NeutronCardGeneralDetailsEntry
        MAX-ACCESS  not-accessible
        STATUS  	current
        DESCRIPTION ""
		INDEX   	{ node, rack, subRack, slot, port }
      	::= { neutronCardGeneralDetailsTable 1 }
      	
	NeutronCardGeneralDetailsEntry ::= 
		SEQUENCE {
					node		INTEGER,
					rack		INTEGER,
					subRack		INTEGER,
					slot		INTEGER,
					port		INTEGER,
					
					racksPresentInSystem		DisplayString,
					subracksPresentInRack		DisplayString,
					cardsPresentInSubrack		OCTET STRING,
					
					neutronSystemName		DisplayString,
					neutronSystemType		DisplayString,
					
					neutronEepromCardId 							INTEGER,
					neutronEepromCardName 							DisplayString,
					neutronEepromPartCode 							DisplayString,
					neutronEepromCardSerialNumber 					DisplayString,
					neutronEepromHardwareExternalReleaseVersion 	DisplayString,
					neutronEepromSoftwareExternalReleaseVersion 	DisplayString,
					neutronEepromHardwareInternalReleaseVersion 	DisplayString,
					neutronEepromSoftwareInternalReleaseVersion 	DisplayString,
					neutronEepromCardUidNumber						DisplayString,
					neutronEepromCardEui48Number					DisplayString,
					neutronEepromCardEui64Number					DisplayString,
					neutronEepromBackplaneUidNumber					DisplayString,
					neutronEepromBackplaneEui48Number				DisplayString,
					neutronEepromBackplaneEui64Number				DisplayString,
					neutronInstallationDate 						DisplayString,
					neutronCommissionDate 							DisplayString,
					neutronApplicationRunningTime					DisplayString,
					neutronApplicationRestartCount 						INTEGER,
					
					neutronOscSfpVendorName							DisplayString,
					neutronOscSfpSerialNumber						DisplayString,
					neutronOscSfpPartNumber							DisplayString,
					neutronOscSfpVendorIeeeId						DisplayString,
					neutronOscSfpRevisionNumber						DisplayString,
					neutronOscSfpManufacturingDate					DisplayString,
					neutronOscSfpLaserWavelength					DisplayString,
					neutronOscSfpLinkLength							DisplayString,
					neutronOscSfpEepromPage							INTEGER,
					neutronCheckCodeOfSfpEepromPage					INTEGER,
					neutronExtendedCheckCodeOfSfpEepromPage			INTEGER,
					neutronOscSfpConnectorType						DisplayString,
					neutronOscSfpSignalEncodingTypesSupported		INTEGER,
					neutronOscSfpTransceiverCodesSupported			INTEGER,
					neutronOscSfpMaximumBitrateSupported			DisplayString,
					neutronOscSfpMinimumBitrateSupported			DisplayString,
					neutronOscSfpNominalBitrateSupported			DisplayString
		}
		
		node	OBJECT-TYPE
			SYNTAX  		INTEGER
			MAX-ACCESS  	not-accessible
			STATUS  		current
			DESCRIPTION		"Node Number"
			::= { neutronCardGeneralDetailsEntry 1 }
  
    	rack OBJECT-TYPE
			SYNTAX  		INTEGER
			MAX-ACCESS  	not-accessible
			STATUS  		current
			DESCRIPTION 	"Rack number"
			::= { neutronCardGeneralDetailsEntry 2 }
              
    	subRack OBJECT-TYPE
			SYNTAX  		INTEGER
			MAX-ACCESS  	not-accessible
			STATUS  		current
			DESCRIPTION 	"Subrack number"
			::= { neutronCardGeneralDetailsEntry 3 }   
              
    	slot OBJECT-TYPE
			SYNTAX  		INTEGER
			MAX-ACCESS  	not-accessible
			STATUS  		current
			DESCRIPTION 	"Slot number"
			::= { neutronCardGeneralDetailsEntry 4 }
		
		port OBJECT-TYPE
			SYNTAX  		INTEGER
			MAX-ACCESS  	not-accessible
			STATUS  		current
			DESCRIPTION 	"Port number"
			::= { neutronCardGeneralDetailsEntry 5 }
			
		racksPresentInSystem OBJECT-TYPE
            SYNTAX  		DisplayString (SIZE (0..255))
            MAX-ACCESS  	read-only
            STATUS  		current
            DESCRIPTION		"To Get Racks Present in the node,
            				 For Eg. To get Racks present in Node number - 1
            				         Index will be : 1.0.0.0.0 "
            ::= { neutronCardGeneralDetailsEntry 6}
              
    	subracksPresentInRack OBJECT-TYPE
            SYNTAX  		DisplayString (SIZE (0..255))
            MAX-ACCESS  	read-only
            STATUS  		current
            DESCRIPTION		"To Get Subracks Present in the Rack,
            				 For Eg. To get Subracks present in Node - 1 and Rack - 1
            				         Index will be : 1.1.0.0.0 "
            ::= { neutronCardGeneralDetailsEntry 7 }        
              
    	cardsPresentInSubrack OBJECT-TYPE
            SYNTAX  		OCTET STRING
            MAX-ACCESS  	read-only
            STATUS  		current
            DESCRIPTION		"To Get Cards Present in the Subrack,
            				 For Eg. To get Card Present in
            				  		 Node - 1, Rack - 1 and Subrack - 1
            				         Index will be : 1.1.1.0.0 "
            ::= { neutronCardGeneralDetailsEntry 8 }
            
		neutronSystemName	OBJECT-TYPE
            SYNTAX  		DisplayString (SIZE (0..255))
            MAX-ACCESS  	read-write
            STATUS  		current
            DESCRIPTION		"To Set/Get System Name."
            ::= { neutronCardGeneralDetailsEntry 9 }	
       
		neutronSystemType	OBJECT-TYPE
            SYNTAX  		DisplayString (SIZE (0..255))
            MAX-ACCESS  	read-write
            STATUS  		current
            DESCRIPTION		"To Set/Get System Type."
            ::= { neutronCardGeneralDetailsEntry 10 }
            
		neutronEepromCardId OBJECT-TYPE
			SYNTAX  		INTEGER
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To get card ID present in the EEPROM"
			::= { neutronCardGeneralDetailsEntry 11 }
		
		neutronEepromCardName OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To get Card Name present in the EEPROM"
			::= { neutronCardGeneralDetailsEntry 12 }
		
		neutronEepromPartCode OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To get Part Code present in the EEPROM"
			::= { neutronCardGeneralDetailsEntry 13 }
			
		neutronEepromCardSerialNumber	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-write
			STATUS 			current
			DESCRIPTION		"To Get Serial Number present in the EEPROM"
			::= { neutronCardGeneralDetailsEntry 14 }
			
		neutronEepromHardwareExternalReleaseVersion	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To get Hardware External Release Version 
							 present in the EEPROM"
			::= { neutronCardGeneralDetailsEntry 15 }
		
		neutronEepromSoftwareExternalReleaseVersion OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To get Software External Release Version 
							 present in the EEPROM"
			::= { neutronCardGeneralDetailsEntry 16 }
			
		neutronEepromHardwareInternalReleaseVersion	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To get Hardware Internal Release Version 
							 present in the EEPROM"
			::= { neutronCardGeneralDetailsEntry 17 }
			
		neutronEepromSoftwareInternalReleaseVersion OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To get Software Release Version 
							 present in the EEPROM"
			::= { neutronCardGeneralDetailsEntry 18 }
			
		neutronEepromCardUidNumber	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To get card Unique IDentification number."
			::= { neutronCardGeneralDetailsEntry 19 }
			
		neutronEepromCardEui48Number	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To Get Card EUI-48 Number. 
							 It is a 6 byte number."
			::= { neutronCardGeneralDetailsEntry 20 }
			
		neutronEepromCardEui64Number	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To Get Card EUI-64 Number. 
							 It is a 8 byte number."
			::= { neutronCardGeneralDetailsEntry 21 }
			
		neutronEepromBackplaneUidNumber	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To get Backplane Unique IDentification number."
			::= { neutronCardGeneralDetailsEntry 22 }
			
		neutronEepromBackplaneEui48Number	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To Get Backplane EUI-48 Number. 
							 It is a 6 byte number."
			::= { neutronCardGeneralDetailsEntry 23 }
			
		neutronEepromBackplaneEui64Number	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To Get Backplane EUI-64 Number. 
							 It is a 8 byte number."
			::= { neutronCardGeneralDetailsEntry 24 }
			
		neutronInstallationDate	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-write
			STATUS 			current
			DESCRIPTION		"To Set/Get the card's installation date in
							dd/mm/yyyy format
							-----------------------------
							Port: 0
							-----------------------------
							Value:
						      	eg: 10/10/2016
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 25 }
			
		neutronCommissionDate OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-write
			STATUS 			current
			DESCRIPTION		"To Set/Get the card's Commision date in
							dd/mm/yyyy format
							-----------------------------
							Port: 0
							-----------------------------
							Value:
						      	eg: 10/10/2016
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 26 }
		
		neutronApplicationRunningTime OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"To get Neutron Application up Time
							-----------------------------
							Port : 0
							-----------------------------
							Values:
						      	eg: 2d:0h:0m:0s
							-----------------------------
							NOTE: This OID won't give card running Time."
			::= { neutronCardGeneralDetailsEntry 27 }
			
		neutronApplicationRestartCount OBJECT-TYPE		 
			SYNTAX  		INTEGER
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"Get the number of times the Neutron application 
							has been restarted.
							NOTE : This wont give you the count for how many times
							the card is restarted.
							-----------------------------
							Port : 0
							-----------------------------
							Values:
						      	eg: 10
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 28 }
			
		neutronOscSfpVendorName	OBJECT-TYPE		 
			SYNTAX  		DisplayString
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property provides Vendor Name for given SFP. 
							The vendor name shall be the full name of the 
							corporation, a commonly accepted abbreviation of 
							the name of the corporation, the SCSI company code
							for the corporation, or the stock exchange code for
							the corporation.
							-----------------------------
							Port:
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:			
							eg: WTD
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 41 }
		
		neutronOscSfpSerialNumber	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property provides vendor serial number defining
							the vendor’s serial number for the SFP. A value of all
							zero in the 16-byte field indicates that the vendor
							serial number is unspecified.
							-----------------------------
							Port Number -
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:			
							eg: WXTRRPGEAS1
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 42 }
			
		neutronOscSfpPartNumber	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property defines the vendor part number or
							product name of the SFP. A value of all zero
							indicates that the vendor Part Number is unspecified.
							-----------------------------
							Port Number -
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:			
							eg: WXTR15101000427
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 43 }
			
		neutronOscSfpVendorIeeeId	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property defines the IEEE company Identifier for
							the vendor of SFP. A value of all zero in the 3-byte
							field indicates that the Vendor OUI is unspecified.
							-----------------------------
							Port Number -
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:			
							eg: 010
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 44 }
			
		neutronOscSfpRevisionNumber	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"The vendor revision number defining the vendor’s
							product revision number. A value of all zero indicates
							that the vendor revision number is unspecified
							-----------------------------
							Port Number -
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:			
							eg: RT
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 45 }
			
		neutronOscSfpManufacturingDate	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property defines the manufacturing date for 
							SFP. A value of 8-byte field in ASCII which represents
							year, month and date of each two bytes. 
							Extra two bytes may be blank
							-----------------------------
							Port Number -
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:			
							eg: 160224
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 46 }
			
		neutronOscSfpLaserWavelength	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property provides transmitter LASER wavelength(nm)
							of the SFP
							-----------------------------
							Port Number -
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:			
							eg: 1310.0
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 47 }
			
		neutronOscSfpLinkLength	OBJECT-TYPE		 
			SYNTAX  		DisplayString (SIZE (0..255))
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property provides link length suported by the SFP
							-----------------------------
							Port Number -
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:
							eg: 80.00
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 48 }
			
		neutronOscSfpEepromPage	OBJECT-TYPE	
			SYNTAX  		INTEGER
			MAX-ACCESS  	read-write
			STATUS 			current
			DESCRIPTION		"This property sets/gets the SFP EEPROM page, 
							the value represents the SFP EEPROM page number.
							-----------------------------
							Port Number -
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:			
							eg: 1(EEPROM Page number)
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 49 }
			
		neutronCheckCodeOfSfpEepromPage	OBJECT-TYPE		 
			SYNTAX  		INTEGER
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property provides the SFP
							check code(checksum) value for bytes 128 to 190
							present in SFP EEPROM Page number 1. 
							-----------------------------
							Port Number -
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:			
							eg: 1(EEPROM Page number)
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 50 }
			
		neutronExtendedCheckCodeOfSfpEepromPage	OBJECT-TYPE		 
			SYNTAX  		INTEGER
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property provides the SFP
							extended check code(checksum) value for bytes 192 to 222
							present in SFP EEPROM Page number 1. 
							-----------------------------
							Port Number -
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:			
							eg: 1(EEPROM Page number)
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 51 }
			
		neutronOscSfpConnectorType	OBJECT-TYPE		 
			SYNTAX  		DisplayString
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property provides information of the SFP
							connector, value indicates the external connector
							provided on the SFP.
							-----------------------------
							Port:
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:
							eg: SC, LC etc.
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 52 }
			
		neutronOscSfpSignalEncodingTypesSupported OBJECT-TYPE		 
			SYNTAX  		INTEGER
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property indicates the serial encoding mechanisms
							that are supported by the SFP.
							-----------------------------
							Port:
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values:
								1 - 64B/66B
								2 - 8B10B
								3 - SONET Scrambled
								4 - NRZ
								5 - RZ
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 53 }
			
		neutronOscSfpTransceiverCodesSupported OBJECT-TYPE		 
			SYNTAX  		INTEGER
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"The identifier value specifies which transceiver
							codes are supported by the SFP
							-----------------------------
							Port:
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values: Reserved for further study
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 54 }			
							
		neutronOscSfpMaximumBitrateSupported	 OBJECT-TYPE		 
			SYNTAX  		DisplayString
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property provides maximum bit rate value(Gbps)
							supported by the SFP
							-----------------------------
							Port:
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values: 4.5
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 55 }
			
		neutronOscSfpMinimumBitrateSupported	 OBJECT-TYPE		 
			SYNTAX  		DisplayString
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property provides minimum bit rate value(Gbps)
							supported by the SFP
							-----------------------------
							Port:
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values: 5.5
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 56 }
			
		neutronOscSfpNominalBitrateSupported	 OBJECT-TYPE		 
			SYNTAX  		DisplayString
			MAX-ACCESS  	read-only
			STATUS 			current
			DESCRIPTION		"This property provides nominal bit rate value(Gbps)
							supported by the SFP
							-----------------------------
							Port:
									1 :	OSC-1 
									2 :	OSC-2 
									3 :	OSC-3 
									4 :	OSC-4 
							-----------------------------
							Values: 1.25
							-----------------------------"
			::= { neutronCardGeneralDetailsEntry 57 }
			
			
--*****************************************************************************
--				   CONFIGURATION
--*****************************************************************************

	neutronConfigurationTable OBJECT-TYPE
		SYNTAX  		SEQUENCE OF NeutronConfigurationEntry 
		MAX-ACCESS  	not-accessible
		STATUS  		current
		DESCRIPTION		"Contains configuration queries"
		::= { neutronConfiguration 1 }

	neutronConfigurationEntry  OBJECT-TYPE
      	SYNTAX  		NeutronConfigurationEntry 
      	MAX-ACCESS  	not-accessible
     	STATUS  		current
      	DESCRIPTION		""
		INDEX   		{ node, rack , subRack , slot , port}
		::= { neutronConfigurationTable 1 }
	
	NeutronConfigurationEntry  ::= 
		SEQUENCE {
					neutronTrapReceiverIpAddress			OCTET STRING,
					neutronDeleteTrapReceiverIpAddress		DisplayString,
					
					neutronPortIpAddress					DisplayString,
					
					neutronAddRoute							DisplayString,
					neutronDeleteRoute						DisplayString,
					
					neutronAddNtpServer						DisplayString,
					neutronDeleteNtpServer					DisplayString,
					
					neutronRestartCard						INTEGER,
					neutronCardSoftwareUpgrade 				DisplayString,
					
					neutronOscSfpLaserState					DisplayString,
					neutronAutomaticLaserShutdownStatus		INTEGER,
					neutronAlsPulseRepetitionTime			INTEGER,
					neutronDeletePortIpAddress				DisplayString,
					
					mdroadmDirectionBoxInterconnection				DisplayString,

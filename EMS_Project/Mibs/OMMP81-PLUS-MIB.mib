	ommp81PlusAlarmQueryTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Ommp81PlusAlarmQueryEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Gives Optical and Signal Alarms status of the OMMP81-PLUS card"
		::= { ommp81PlusAlarmQuery 1 }	

	ommp81PlusAlarmQueryEntry   OBJECT-TYPE
              SYNTAX  Ommp81PlusAlarmQueryEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , ommp81PlusInterfaceNumber }
		::= { ommp81PlusAlarmQueryTable 1 }
	
	Ommp81PlusAlarmQueryEntry ::= 

--*****************************************************************************
--			MIB FILE FOR THE OMMP81-PLUS CARD
--*****************************************************************************

OMMP81-PLUS-MIB DEFINITIONS ::= BEGIN
 
          IMPORTS
        	
		RowStatus      			FROM STANDARD-MIB
			
		DisplayString  			FROM RFC1213-MIB       
    	
    		OBJECT-IDENTITY,
    		NOTIFICATION-TYPE,
    		MODULE-IDENTITY,
    		Integer32,
    		Unsigned32,
    		IpAddress,
    		TimeTicks			FROM SNMPv2-SMI
	 
	 	OBJECT-TYPE    			FROM RFC-1212
	 		
		MODULE-COMPLIANCE,
		OBJECT-GROUP,
		NOTIFICATION-GROUP		FROM SNMPv2-CONF
	
		node,
		rack,
		subRack,
		slot				FROM SCC-MIB
    
		enterprises			FROM RFC1155-SMI
	;

 

	utl   MODULE-IDENTITY
            LAST-UPDATED    	"1807130630Z"
            ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
            CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
            DESCRIPTION     	"MIB module for UTL 40/80 channel DWDM."
            REVISION 	    	"1807130630Z"
            DESCRIPTION    	"MIB module for OMMP81-PLUS Card."
            ::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
            STATUS  current
            DESCRIPTION "UTL Research and Development."
            ::= { utl 1 }

	dwdm 	OBJECT IDENTIFIER				::=	{ utlrnd 1 }
	indus 	OBJECT IDENTIFIER				::=	{ dwdm 1 }
	ommp81Plus 	OBJECT IDENTIFIER 			::=	{ indus 86 }

	ommp81PlusCardGeneralDetails OBJECT IDENTIFIER		::=	{ ommp81Plus 1 }
	ommp81PlusConfiguration OBJECT IDENTIFIER 		::=	{ ommp81Plus 2 }
	ommp81PlusAlarm OBJECT IDENTIFIER 			::=	{ ommp81Plus 3 }
	ommp81PlusPerformance OBJECT IDENTIFIER 		::=	{ ommp81Plus 4 }
	ommp81PlusDiagnostics OBJECT IDENTIFIER 		::=	{ ommp81Plus 5 }

	ommp81PlusAlarmQuery OBJECT IDENTIFIER			::=	{ ommp81PlusAlarm 1 }
	ommp81PlusAlarmNotification OBJECT IDENTIFIER		::=	{ ommp81PlusAlarm 2 }

--*****************************************************************************
--				CARD GENERAL DETAILS
--*****************************************************************************

	ommp81PlusCardGeneralDetailsTable OBJECT-TYPE
		SYNTAX  SEQUENCE OF Ommp81PlusCardGeneralDetailsEntry 
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
                     "Contains card general details' queries for the OMMP81-PLUS card"
		::= { ommp81PlusCardGeneralDetails 1 }

	ommp81PlusCardGeneralDetailsEntry  OBJECT-TYPE
		SYNTAX  Ommp81PlusCardGeneralDetailsEntry 
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION 
              	""
		INDEX   { node, rack, subRack, slot, ommp81PlusInterfaceNumber }
		::= { ommp81PlusCardGeneralDetailsTable 1 }

	Ommp81PlusCardGeneralDetailsEntry  ::= 
		SEQUENCE {
				ommp81PlusInterfaceNumber					INTEGER,
				ommp81PlusEepromCardId					        INTEGER,
				ommp81PlusEepromCardName					DisplayString,
				ommp81PlusEepromPartCode					DisplayString,
				ommp81PlusEepromCardSerialNumber				DisplayString,
				ommp81PlusEepromHardwareExternalReleaseVersion		        DisplayString,
				ommp81PlusSoftwareExternalReleaseVersion		        DisplayString,
				ommp81PlusEepromHardwareInternalReleaseVersion		        DisplayString,
				ommp81PlusSoftwareInternalReleaseVersion		        DisplayString,
				ommp81PlusEepromCardUidNumber			                DisplayString,
				ommp81PlusEepromCardEui48Number				        DisplayString,
				ommp81PlusEepromCardEui64Number				        DisplayString,
				ommp81PlusCardRootFileSystemVersion				DisplayString,
				ommp81PlusCardInstallationDate				        DisplayString,
				ommp81PlusCardCommissionDate				        DisplayString,
				ommp81PlusCardRunningTime					DisplayString,
				ommp81PlusCardRestartCount					INTEGER,
				ommp81PlusXfpReadyForOperation				        INTEGER,
				ommp81PlusXfpI2cCommunicationStatus				INTEGER,
				ommp81PlusXfpEepromPage					        INTEGER,
				ommp81PlusCheckCodeOfXfpEepromPage				INTEGER,
				ommp81PlusExtendedCheckCodeOfXfpEepromPage			INTEGER,
				ommp81PlusXfpVendorName					        DisplayString,
				ommp81PlusXfpVendorIeeeId					DisplayString,
				ommp81PlusXfpPartNumber					        DisplayString,
				ommp81PlusXfpSerialNumber					DisplayString,
				ommp81PlusXfpRevisionNumber					DisplayString,
				ommp81PlusXfpManufacturingDate				        DisplayString,
				ommp81PlusFixedXfpLaserWavelength				DisplayString,
				ommp81PlusXfpLaserWavelengthTolerance				DisplayString,
				ommp81PlusXfpWavelengthTunabilitySupported			INTEGER,
				ommp81PlusTunableXfpLaserWavelengthError			DisplayString,
				ommp81PlusTunableXfpLaserFrequencyError			        DisplayString,
				ommp81PlusTunableXfpLaserFirstFrequency			        DisplayString,
				ommp81PlusTunableXfpLaserLastFrequency			        DisplayString,
				ommp81PlusTunableXfpWavelengthGridSpacing			DisplayString,
				ommp81PlusXfpConnectorType					DisplayString,
				ommp81PlusXfpLinkLength					        DisplayString,
				ommp81PlusXfpCdrRateSupported				        INTEGER,
				ommp81PlusXfpSignalEncodingTypeSupported			INTEGER,
				ommp81PlusXfpTransceiverCodesSupported			        DisplayString,
				ommp81PlusXfpMaximumBitrateSupported			        DisplayString,
				ommp81PlusXfpMinimumBitrateSupported			        DisplayString,
				ommp81PlusXfpMaximumCaseTemperatureSupported		        INTEGER,
				ommp81PlusXfpMaximumPowerDissipationSupported			INTEGER,
				ommp81PlusXfpMaximumPowerDissipationSupportedAtPowerDownMode	INTEGER,
				ommp81PlusXfpMaximumCurrentLimitSupportedAtPlus5vSupply		INTEGER,
				ommp81PlusXfpMaximumCurrentLimitSupportedAtPlus3Point3vSupply	INTEGER,
				ommp81PlusXfpMaximumCurrentLimitSupportedAtPlus1Point8vSupply	INTEGER,
				ommp81PlusXfpMaximumCurrentLimitSupportedAtMinus5Point2vSupply	INTEGER,
				ommp81PlusXfpLineLoopbackSupported				INTEGER,
				ommp81PlusXfpXfiLoopbackSupported				INTEGER,
				ommp81PlusXfpOptionalVpsSupported				INTEGER,
				ommp81PlusXfpLaserDisableThroughI2cSupported			INTEGER,
				ommp81PlusXfpPowerDownThroughI2cSupported			INTEGER,
				ommp81PlusXfpVpsLvRegulatorModeSupported			INTEGER,
				ommp81PlusXfpVpsBypassedRegulatorModeSupported			INTEGER,
				ommp81PlusXfpActiveFecControlSupported				INTEGER,
				ommp81PlusXfpOptionalCmuModeSupported				INTEGER,
				ommp81PlusXfpFecBerSupported					INTEGER,
				ommp81PlusXfpReceivePowerMeasurementIsInOmaOrAverage		INTEGER,
				ommp81PlusXfpActiveWavelengthControlSupported			INTEGER,
				ommp81PlusXfpTransmitterIsCooledOrUncooled			INTEGER,
				ommp81PlusXfpReceiverTypeIsPinOrApd                             INTEGER,
				ommp81PlusSfpEepromPage						INTEGER,
				ommp81PlusCheckCodeOfSfpEepromPage				INTEGER,
				ommp81PlusExtendedCheckCodeOfSfpEepromPage			INTEGER,
				ommp81PlusSfpVendorName						DisplayString,
				ommp81PlusSfpVendorIeeeId					DisplayString,
				ommp81PlusSfpPartNumber						DisplayString,
				ommp81PlusSfpSerialNumber					DisplayString,
				ommp81PlusSfpRevisionNumber					DisplayString,
				ommp81PlusSfpManufacturingDate					DisplayString,
				ommp81PlusFixedSfpLaserWavelength				DisplayString,
				ommp81PlusSfpConnectorType					DisplayString,
				ommp81PlusSfpLinkLength						DisplayString,
				ommp81PlusSfpSignalEncodingTypeSupported			INTEGER,
				ommp81PlusSfpTransceiverCodesSupported				INTEGER,
				ommp81PlusSfpMaximumBitrateSupported				DisplayString,
				ommp81PlusSfpNominalBitrateSupported				DisplayString,
				ommp81PlusSfpMinimumBitrateSupported				DisplayString,
				ommp81PlusCardGeneralDetailsTableRowStatus			RowStatus
			 }
	

	ommp81PlusInterfaceNumber OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
			"Interface number represents the port number.
			InterfaceNumber to port mapping is as follows:
			1 - CLIENT-1,
			2 - CLIENT-2,
			3 - CLIENT-3,
			4 - CLIENT-4,
			5 - CLIENT-5,
			6 - CLIENT-6,
			7 - CLIENT-7,
			8 - CLIENT-8,
			9 - LINE-1
			-----------------------------
			Values of the demultiplexing properties can be accessed
			with respect to slice number.  In such cases the
			InterfaceNumber will represent the slice number.
			1 - Slice-1
			2 - Slice-2
			3 - Slice-3
			4 - Slice-4
			-----------------------------
			For properties which do not apply on any interface,
			the interface number must be passed as 0
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 1 }
	
	ommp81PlusEepromCardId OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the card ID of the OMMP81-PLUS card, present in the EEPROM
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 2 }

	ommp81PlusEepromCardName OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the card name of the OMMP81-PLUS card, present in the EEPROM
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 3 }

	ommp81PlusEepromPartCode OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the part code of the OMMP81-PLUS card, present in the EEPROM
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 4 }

	ommp81PlusEepromCardSerialNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property get / set the information about 
			OMMP81-PLUS Card's Serial Number.
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 123456
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 5 }

	ommp81PlusEepromHardwareExternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Hardware External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are significant
			architectural changes in the product
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Value:
			eg: 0.1
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 6 }

	ommp81PlusSoftwareExternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are
			significant architectural changes in the product
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Value:
			eg: 0.1
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 7 }

	ommp81PlusEepromHardwareInternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Hardware Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external hardware version.
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Value:
			eg: 4.1
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 8 }

	ommp81PlusSoftwareInternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external software version.
		      	-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Value:
			eg: 5.1
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 9 }

	ommp81PlusEepromCardUidNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card Unique IDentifier. It is a 4 byte
			address used to uniquely identify a card.
			----------------------------
			ommp81PlusInterfaceNumber: 0
			------------------------------
			Value:
		      	eg: 12345678
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 10 }

	ommp81PlusEepromCardEui48Number OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-48 Number. It is a 6 byte address
			used to uniquely identify a card.
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 0004A3123456
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 11 }

	ommp81PlusEepromCardEui64Number OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-64 Number. It is a 8 byte address
			used to uniquely identify a card.
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 0004A31234567890
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 12 }
		
        ommp81PlusCardRootFileSystemVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card's Root File System Version
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 8
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 13 }

	ommp81PlusCardInstallationDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Gets the card's installation date in
			dd/mm/yyyy format
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 12/03/2016
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 21 }

	ommp81PlusCardCommissionDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Gets the card's commission date in
			dd/mm/yyyy format
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 20/03/2016
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 22 }

	ommp81PlusCardRunningTime OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Get the duration of time for which the card is
			operational/running
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 4d:3h:2m:1s
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 23 }

	ommp81PlusCardRestartCount OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Get the number of times the card has been soft reset.
			This value will get reset to 0 on factory reset.
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 10
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 24 }

	ommp81PlusXfpReadyForOperation OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Module not ready indicates that the XFP
			has detected a condition that tells
			transmit or receive data is invalid.
			It shall consist of logical OR of the
			following signals:
			> Transmit Signal Conditioner Loss of Lock
			> Transmitter Laser Fault
			> Receiver Signal Conditioner Loss of Lock
			(Ref: INF-8077 2.4.1)
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:		
			1 - XFP is ready for operation 
			0 - XFP is not ready for operation
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 31 }

	ommp81PlusXfpI2cCommunicationStatus OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Tells whether the XFP can be accessed
			on a single 2-wire interface bus or not.
			(Ref: INF-8077 2.4.2)
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			1 - Enable I2C communication for XFP
				i.e. the XFP responds to 2-wire serial
				communication commands.
			0 - Disable I2C communication for XFP
				i.e. the XFP will not respond to or
				acknowledge any 2-wire interface communication
				from the host.
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 32 }

	ommp81PlusXfpEepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property sets/gets the XFP EEPROM page, 
			the value represents the XFP EEPROM page number.
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 33 }

	ommp81PlusCheckCodeOfXfpEepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides the XFP
			check code(checksum) value for bytes 128 to 190
			present in XFP EEPROM Page number 1. 
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 34 }

	ommp81PlusExtendedCheckCodeOfXfpEepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides the XFP
			extended check code(checksum) value for bytes 192 to 222
			present in XFP EEPROM Page number 1. 
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 35 }

	ommp81PlusXfpVendorName OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides Vendor Name for given XFP. 
			The vendor name shall be the full name of the 
			corporation, a commonly accepted abbreviation of 
			the name of the corporation, the SCSI company code
			for the corporation, or the stock exchange code for
			the corporation.
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: WTD
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 36 }

	ommp81PlusXfpVendorIeeeId OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the IEEE company Identifier for
			the vendor of XFP. A value of all zero in the 3-byte
			field indicates that the Vendor OUI is unspecified.
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: 010
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 37 }

	ommp81PlusXfpPartNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the vendor part number or
			product name of the XFP. A value of all zero
			indicates that the vendor Part Number is unspecified.
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: FTRX-1811-2D2
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 38 }

	ommp81PlusXfpSerialNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides vendor serial number defining
			the vendor’s serial number for the XFP. A value of all
			zero in the 16-byte field indicates that the vendor
			serial number is unspecified.
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: KBG02CU
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 39 }

	ommp81PlusXfpRevisionNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"The vendor revision number defining the vendor’s
			product revision number. A value of all zero indicates
			that the vendor revision number is unspecified
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: RT
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 40 }

	ommp81PlusXfpManufacturingDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the manufacturing date for 
			XFP. A value of 8-byte field in ASCII which represents
			year, month and date of each two bytes. 
			Extra two bytes may be blank
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: 160224
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 41 }

	ommp81PlusFixedXfpLaserWavelength OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides transmitter LASER wavelength(nm)
			of the XFP
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: 1310
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 42 }

	ommp81PlusXfpLaserWavelengthTolerance OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides XFP wavelength tolerance in GhZ
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: 0.02
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 43 }

	ommp81PlusXfpWavelengthTunabilitySupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides information whether the XFP
			supports wavelength tunability or not.
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			1 - XFP supports wavelength tunability
			0 - XFP does not supports wavelength tunability
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 44 }

	ommp81PlusTunableXfpLaserWavelengthError OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides wavelength error in picometer(pm)
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: 0.02
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 45 }

	ommp81PlusTunableXfpLaserFrequencyError OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides frequency error in Ghz.
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: 0.03
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 46 }

	ommp81PlusTunableXfpLaserFirstFrequency OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the first LASER frequency of XFP.
			The two byte value is specified in units of THz.
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: 1529.45
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 47 }

	ommp81PlusTunableXfpLaserLastFrequency OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the last laser frequency of XFP.
		 	 The two byte value is specified in units of THz.
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:			
			eg: 1563.45
			-----------------------------"
		::= { ommp81PlusCardGeneralDetailsEntry 48 }

	ommp81PlusTunableXfpWavelengthGridSpacing OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION

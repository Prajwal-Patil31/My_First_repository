	ommp81PlusCardSoftwareUpgrade OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as SET command.
			This property upgrades the software of the OMMP81-PLUS card
			It takes the path of the software release as
			a value
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: /root/home/rel-2.0.0.tar.gz
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 1 }

	ommp81PlusCardSignalMonitorState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property sets or gets the card's signal
			monitoring state. Disabling card signal monitoring 
			will not provide any signal alarms and performances
			information to the user.
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Values:
			1 - Card Signal Monitoring is enabled
			0 - Card Signal Monitoring is disabled
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 2 }

	ommp81PlusCardOpticalMonitorState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property sets or gets the card's optical
			monitoring state. Disabling card signal monitoring 
			will not provide any signal alarms and performances
			information to the user.
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Values:
			1 - Card Optical Monitoring is enabled
			0 - Card Optical Monitoring is disabled
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 3 }

	ommp81PlusCardSoftReset OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as a SET command.
			Reboots the Card, Reconfigures the Card 
			i.e All Configuration Parameter	like Laser State,
			Traffic configuration, Loopback, FEC, optical and 
			signal thresholds, switching mode,
			user choice of line path, auto-negotiation, 
			TTI messages will be restored to previous state
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Values:
			Dont care, any value
			eg: 0
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 4 }

	ommp81PlusCardFactoryReset OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as a SET command.
			Sets the Card To Factory Default State
			i.e All User Configuration Parameters like Laser State,
			Traffic configuration, Loopback, FEC, optical and 
			signal thresholds, switching mode,
			user choice of line path, auto-negotiation, TTI messages
			will be set to default state
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Values:
			Dont care, any value
			eg: 0
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 5 }

	ommp81PlusCardAccessStatus OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property will tell whether the card is 
			accessible from EMS/LCT or not. Turning off the
			accessbility to the card, will not allow the user
			to access any configuration, alarm or performance
			of the card and also turns off fast alarm
			triggering, global alarm led indication
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Values:
			1 - Card is accessible from EMS/LCT
			0 - Card is inaccessible from EMS/LCT
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 6 }
		
	ommp81PlusSyncSystemTimeWithNtpServer	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
					present in linux kernel with the NTP server
					we can use this OID. We can provide NTP server
					ip address as a value to this OID and the time
					will be synced to that ilarticular server. 
					If we are not providing NTP server IP address 
					then the system will be synced with the NTP server 
					which is already been registered with card. 
					If both are absent then error message will be returned
					-----------------------------
						Interface : 0
					-----------------------------
						If we want to provide NTP server IP address then
						Value should be a valid IP address as shown below
						: 192.168.21.25
						
						If we don't want to provide NTP server address then no
						need to pass any value. 
					---------------------------"
  						
  		::= { ommp81PlusConfigurationEntry 7 }
  		
  	ommp81PlusSyncRtcWithNtpServer	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
  						present in RTC with the NTP server
  						we can use this OID. We can provide NTP server
  						ip address as a value to this OID and the time
  						will be synced to that particular server. 
  						If we are not providing NTP server IP address 
  						then the system will be synced with the NTP server 
  						which is already been registered with card. 
  						If both are absent then error message will be returned.
  						-----------------------------
						Interface : 0
						-----------------------------
						If we want to provide NTP server IP address then
						Value should be a valid IP address as shown below
						: 192.168.21.25
							
						If we don't want to provide NTP server address, then no
						need to ilass any value. 
						---------------------------"
  						
  		::= { ommp81PlusConfigurationEntry 8 }
  		
  	ommp81PlusSyncRtcWithSystemTime	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
  						present in RTC with the time value in linux kernel
  						we can use this OID. With this set operation, 
  						the time available with linux kernel will be updated
  						into RTC. It is not required to provide any value for 
  						this operation"
  						
  		::= { ommp81PlusConfigurationEntry 9 }
  		
  	ommp81PlusUpdateGivenTimeIntoSystem	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually update system time
  						with the user provided time, we can use this OID.
  						With OID we need to provide time value which we
  						want to update in the system.
  						-----------------------------
						Interface : 0
						-----------------------------
						Value should be of given format:
						YYYY-MM-DD H:M:S
						
						Example: 2017-10-31 15:20:44
						---------------------------"
						
  		::= { ommp81PlusConfigurationEntry 10 }
  		
  	ommp81PlusUpdateGivenTimeIntoRtc	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually update RTC time
  						with the user provided time, we can use this OID.
  						With OID we need to provide time value which we
  						want to update in RTC.
  						-----------------------------
						Interface : 0
						-----------------------------
						Value should be of given format:
						YYYY-MM-DD H:M:S
						
						Example: 2017-10-31 15:20:44
						---------------------------"
						
  		::= { ommp81PlusConfigurationEntry 11 }
  		
  	ommp81PlusSystemTimeAndRtcTime	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-only
  		STATUS  		current
  		DESCRIPTION	 	" get the system time and time value present in RTC.
  						-----------------------------
						Interface : 0
						-----------------------------"
						
  		::= { ommp81PlusConfigurationEntry 12 }

--	ommp81PlusTrafficConfiguration OBJECT-TYPE		 
--		SYNTAX  DisplayString
--		MAX-ACCESS read-write
--		STATUS current
--		DESCRIPTION
--			"Set or get Traffic configuration for all ports
--			-----------------------------
--			ommp81PlusInterfaceNumber: 0
--			-----------------------------			
--			Value: 
--			At any instant to perform traffic configuration operation,
--			the traffic configuration values need to be passed for
--			all 8 client ports. The following are the traffic
--			configuration values, followed by an example:
--			00 - Un-configure 
--			01 - STM16
--			02 - STM4
--			03 - STM1
--			04 - GE-GFP-T
--			05 - GE-GFP-F
--			06 - FE-GFP-T
--			07 - FE-GFP-F
--			08 - FC-100
--			09 - FC-200
--			10 - OTU-1
--			eg: To set STM16, GE-GFP-F for CLIENT-1, CLIENT-2
--			repectively, the following value needs to be passed,
--			1,2,0,0,0,0,0,0 as a string in which the position
--			represents the port number
--			-----------------------------"
--		::= { ommp81PlusConfigurationEntry 41 }
		
	ommp81PlusTrafficConfiguration OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or get Traffic configuration for all ports
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------			
			Value: 
			00 - Un-configure 
			01 - STM16
			02 - STM4
			03 - STM1
			04 - GE-GFP-T
			05 - GE-GFP-F
			06 - FE-GFP-T
			07 - FE-GFP-F
			08 - FC-100
			09 - FC-200
			10 - OTU-1
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 41 }

	ommp81PlusLoopbackState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or get the loopback state for the
			requested port
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values: 
			00 - No Loopback   
			01 - Near End Loopback
			02 - Far End Loopback
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 42 }

	ommp81PlusPortSignalMonitorState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property sets or gets the port's signal
			monitoring state. Disabling port signal monitoring 
			will not provide any signal alarms and performances
			information to the user.
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			1 - Port Signal Monitoring is enabled
			0 - Port Signal Monitoring is disabled
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 43 }

	ommp81PlusPortOpticalMonitorState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property sets or gets the port's optical
			monitoring state. Disabling port optical monitoring 
			will not provide any optical alarms and performances
			information to the user.
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			1 - Port Optical Monitoring is enabled
			0 - Port Optical Monitoring is disabled
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 44 }

	ommp81PlusClearSignalPerformance OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as a SET command.
			Clears signal performance for the requested port
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			Dont care, any value
			eg: 0
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 45 }

	ommp81PlusAlsState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set the Automatic Laser Switching(ALS) mode for
			for requested port. Based on the RX LOS state of the
			port, the transmit LASER state will be controlled
			according to the algorithm defined for ALS in
			ITUT 664 Standard
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values: 
			1 - Enable ALS state
			0 - Disable ALS state
			-----------------------------" 
		::= { ommp81PlusConfigurationEntry 46 }

	ommp81PlusAlsPulseRepetitionTime OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Pulse repetition time is the time for automatic 
			restart of XFP LASER once the ALS algorithm starts.
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values: 
			100 seconds to 300 seconds
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 47 }

	ommp81PlusOtuFecConfiguration OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or Get FEC type for requested port configured with
			 OTU2/OTU1 traffic.  
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values: 
			00 - Zero FEC 
			01 - Reed-Solomon GFEC
			03 - UFEC(I.7 FEC, applicable for line port only)
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 61 }

	ommp81PlusOtuSignalFailThreshold OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or Get SM Signal Failure 
			Threshold value for the requested port configured with 
			OTU2/OTU1 traffic.
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values: 
			03 - 1.E -03
			04 - 1.E -04
			05 - 1.E -05
			-----------------------------" 
		::= { ommp81PlusConfigurationEntry 62 }

	ommp81PlusOtuSignalDegradeThreshold OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or Get SM Signal Degrade 
			Threshold value for the requested port configured with 
			OTU2/OTU1 traffic.
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			06 - 1.E -06
			07 - 1.E -07
			08 - 1.E -08
			09 - 1.E -09
			10 - 1.E -10(for line only)
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 63 }

	ommp81PlusOtuAlarmIndicationSignalAlarmInsertion OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Inserts OTU-AIS maitainance signal for the requested
			port configured with OTU2/OTU1 traffic.
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values: 
			1 - Enable Insertion
			0 - Disable Insertion  
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 64 }

	ommp81PlusOtuSapiTransmitTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or get the 15 characters SAPI Transmit TTI message
			which is put into the outgoing OTU2/OTU1 frame. 
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp81PlusConfigurationEntry 65 }

	ommp81PlusOtuDapiTransmitTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or get the 15 characters DAPI Transmit TTI message
			which is put into the outgoing OTU2/OTU1 frame. 
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp81PlusConfigurationEntry 66 }
		
	ommp81PlusOtuOperatorSpecificTransmitTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or get the 32 characters Operator Specific Transmit
			TTI message which is put into the outgoing OTU2/OTU1
			frame. 
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			eg: 12345123451234512345123451234500
			-----------------------------" 
		::= { ommp81PlusConfigurationEntry 67 }
		
	ommp81PlusOtuSapiExpectedTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"15 characters SM SAPI Expected TTI message - Message
			set here is used for comparison with the message present
			in SM SAPI field of the incoming OTU2/OTU1 frames.
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp81PlusConfigurationEntry 68 }
		
	ommp81PlusOtuDapiExpectedTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"15 characters SM DAPI Expected TTI message - Message
			set here is used for comparison with the message present
			in SM DAPI field of the incoming OTU2/OTU1 frames.
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp81PlusConfigurationEntry 69 }

	ommp81PlusOtuOperatorSpecificExpectedTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"32 characters SM Operator Specific Expected TTI 
			message - Message set here is used for comparison with 
			the message present in SM Operator Specific field of 
			the incoming OTU2/OTU1 frames.
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			eg: 12345123451234512345123451234500
			-----------------------------" 
		::= { ommp81PlusConfigurationEntry 70 }

	ommp81PlusOtuSapiReceivedTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Gets the 15 characters SAPI TTI message
			which is extracted from the incoming OTU2/OTU1
			data stream.
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp81PlusConfigurationEntry 71 }

	ommp81PlusOtuDapiReceivedTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Gets the 15 characters DAPI TTI message
			which is extracted from the incoming OTU2/OTU1 data
			stream.
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp81PlusConfigurationEntry 72 }
		
	ommp81PlusOtuOperatorSpecificReceivedTraceMessage OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Gets the 32 characters DAPI TTI message
			which is extracted from the incoming OTU2/OTU1 data
			stream. 
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			-----------------------------
			Values:
			eg: 12345123451234512345123451234500
			-----------------------------" 
		::= { ommp81PlusConfigurationEntry 73 }

	ommp81PlusOduSignalFailThreshold OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or Get PM Signal Failure 

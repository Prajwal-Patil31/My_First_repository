		::= { ommp81PlusAlarmQueryEntry 212 }

	ommp81PlusGfpCoreHeaderErrorAlarm OBJECT-TYPE
              SYNTAX  DisplayString
              MAX-ACCESS  read-only
              STATUS  current
              DESCRIPTION
			"This alarm is generated if the core header error
			count is found to be greater than 50 for a particular
			instance. i.e. for a particular second
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values :
			If Alarm is Present - Date and Time Stamp
				    eg:2017-5-18,9:47:20.0,+5:30
			If Alarm is Absent  - 0
			-----------------------------"
		::= { ommp81PlusAlarmQueryEntry 213 }

	ommp81PlusGfpExtentionHeaderErrorAlarm OBJECT-TYPE
              SYNTAX  DisplayString
              MAX-ACCESS  read-only
              STATUS  current
              DESCRIPTION
			"This alarm is generated if the extention header error
			count is found to be greater than 50 for a particular
			instance. i.e. for a particular second
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values :
			If Alarm is Present - Date and Time Stamp
				    eg:2017-5-18,9:47:20.0,+5:30
			If Alarm is Absent  - 0
			-----------------------------"
		::= { ommp81PlusAlarmQueryEntry 214 }

	ommp81PlusAlarmQueryTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
			"*****************************
			This is MIB realted property,
			NOT to be considered as a card property
			*****************************"
              ::= { ommp81PlusAlarmQueryEntry 215 }	                                


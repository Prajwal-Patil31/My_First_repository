--*****************************************************************************
--				    DIAGNOSTICS
--*****************************************************************************        

	ommp81PlusDiagnosticsTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Ommp81PlusDiagnosticsEntry
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Category contains properties that are used for debugging
                      card software"
		::= { ommp81PlusDiagnostics 1 }	

	ommp81PlusDiagnosticsEntry   OBJECT-TYPE
              SYNTAX  Ommp81PlusDiagnosticsEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , ommp81PlusInterfaceNumber }
		::= { ommp81PlusDiagnosticsTable 1 }
	
	Ommp81PlusDiagnosticsEntry ::= 
		SEQUENCE {
				ommp81PlusAccessHyphyRegister			INTEGER,
				ommp81PlusCnodeCrashCount			INTEGER,
				ommp81PlusKernelState				DisplayString,
				ommp81PlusDiagnosticTableRowStatus		RowStatus
			}
			
	ommp81PlusAccessHyphyRegister OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
			"Sets/gets the value of any hyphy register
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg:
			example of hyphy register - 76071076
			value - 1
			-----------------------------"
	::= { ommp81PlusDiagnosticsEntry 1 }

	ommp81PlusCnodeCrashCount OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gets the count of number of times the hyphy_cnode has
			crashed
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Values: 
			eg: 0, 1, 4, 7 etc.
			-----------------------------"
	::= { ommp81PlusDiagnosticsEntry 2 }

	ommp81PlusKernelState OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gets the state of the kernel
			-----------------------------
			ommp81PlusInterfaceNumber: 0
			-----------------------------
			Values:
			non-tainted - kernel is working fine
			tainted - kernel panic has occured
			-----------------------------"
	::= { ommp81PlusDiagnosticsEntry 3 }
	
	ommp81PlusDiagnosticTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
			"*****************************
			This is MIB realted property,
			NOT to be considered as a card property
			*****************************"
	::= { ommp81PlusDiagnosticsEntry 4 }


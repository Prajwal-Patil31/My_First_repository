	ommp81PlusPerformanceTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Ommp81PlusPerformanceEntry
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Gives Optical and Signal performance status of the OMMP81-PLUS card"
		::= { ommp81PlusPerformance 1 }	

	ommp81PlusPerformanceEntry   OBJECT-TYPE
              SYNTAX  Ommp81PlusPerformanceEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , ommp81PlusInterfaceNumber}
		::= { ommp81PlusPerformanceTable 1 }
	

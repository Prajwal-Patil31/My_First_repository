	ommp81PlusXfpInputPower OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the current Input power(dbm) received at the port
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:
			eg: -9.0
			-----------------------------"
	::= { ommp81PlusPerformanceEntry 1 }

	ommp81PlusXfpOutputPower OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the current Output power(dbm) transmitted at the port
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:
			eg: -0.6
			-----------------------------"
	::= { ommp81PlusPerformanceEntry 2 }

	ommp81PlusXfpBiasCurrent OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the bias current(mA) thats transmitted at the port
			-----------------------------
			ommp81PlusInterfaceNumber:
			9 - LINE-1
			-----------------------------
			Values:
			eg: 55
			-----------------------------"
	::= { ommp81PlusPerformanceEntry 3 }

	ommp81PlusXfpSupplyVoltage OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current

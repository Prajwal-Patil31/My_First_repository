	ommp81PlusEthernetAutoNegotiation OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or Get the Auto-negotiation mode for the
			requested port configured with GE-GFP-F/GE-GFP-T traffic.
			Enabling auto negotiation will automatically establish
			the link between link-partners on basis of speed,
			flow-control and duplexity.
			If disabled, the link status between the link-partners
			cannot be restored after the link is broken.
			-----------------------------
			ommp81PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Value:
			1 - Enable Auto-Negotiation
			0 - Disable Auto-negotiation
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 111 }
		
	ommp81PlusCalibrateHyphyXfiSerdes OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as SET command.
			For every card which is come freshly manufactured from
			the factory, the XFI serdes of the line ports need to
			be calibrated in hyphy w.r.t to OTU2 signal, since the
			serdes in all the mapper chips will not be the same.
			-----------------------------
			ommp81PlusInterfaceNumber:0
			-----------------------------
			Values:
			9 - LINE-1
			-----------------------------"
		::= { ommp81PlusConfigurationEntry 121 }			


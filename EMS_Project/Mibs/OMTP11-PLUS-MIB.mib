				omtp11PlusLoopbackState							INTEGER,
				omtp11PlusPortSignalMonitorState					INTEGER,
				omtp11PlusPortOpticalMonitorState					INTEGER,
				omtp11PlusClearSignalPerformance					INTEGER,
				omtp11PlusAlsState							INTEGER,
				omtp11PlusAlsPulseRepetitionTime					INTEGER,
				omtp11PlusOtuFecConfiguration						INTEGER,

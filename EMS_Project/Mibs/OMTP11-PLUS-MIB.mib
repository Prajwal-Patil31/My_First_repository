        omtp11PlusConfigurationTable OBJECT-TYPE
                SYNTAX SEQUENCE OF Omtp11PlusConfigurationEntry
                MAX-ACCESS not-accessible
                STATUS current
                DESCRIPTION
                	"Contains configuration queries of the OMTP11-PLUS card"
                ::= { omtp11PlusConfiguration 1 }

	omtp11PlusConfigurationEntry OBJECT-TYPE
		SYNTAX  Omtp11PlusConfigurationEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION 
			""
		INDEX   { node, rack , subRack , slot , omtp11PlusInterfaceNumber}
		::= { omtp11PlusConfigurationTable 1 }

	Omtp11PlusConfigurationEntry ::= 
		SEQUENCE { 
				omtp11PlusCardSoftwareUpgrade						DisplayString,
				omtp11PlusCardSignalMonitorState					INTEGER,
				omtp11PlusCardOpticalMonitorState					INTEGER,
				omtp11PlusCardSoftReset							INTEGER,

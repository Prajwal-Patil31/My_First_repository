				        omtp11PlusOtuBackgroundBlockErrors					DisplayString,
				        omtp11PlusOtuSevereErrorSeconds						DisplayString,
				        omtp11PlusOtuUnavailableSeconds						DisplayString,
				        omtp11PlusOtuBackgroundBlockErrorRatio					DisplayString,
				        omtp11PlusOtuSevereErrorSecondsErrorRatio				DisplayString,

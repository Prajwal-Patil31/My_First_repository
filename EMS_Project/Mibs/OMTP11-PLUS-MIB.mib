				        omtp11PlusWan10gErrorSecondsErrorRatio					DisplayString,
				        omtp11PlusWan10gBackgroundBlockErrorRatio				DisplayString,
				        omtp11PlusWan10gSevereErrorSecondsErrorRatio				DisplayString,
				        omtp11PlusLan10gMacTerminatedFramesTransmitted				DisplayString,
				        omtp11PlusLan10gMacTerminatedFramesReceived				DisplayString,

					omtp11PlusOtuFramesReceived						DisplayString,
				        omtp11PlusOduBitInterleavedParityErrors					DisplayString,
				        omtp11PlusOduTcm1BitInterleavedParityErrors				DisplayString,
				        omtp11PlusOduTcm2BitInterleavedParityErrors				DisplayString,
				        omtp11PlusOduTcm3BitInterleavedParityErrors				DisplayString,
				        omtp11PlusOduTcm4BitInterleavedParityErrors				DisplayString,
				        omtp11PlusOduTcm5BitInterleavedParityErrors				DisplayString,
				        omtp11PlusOduTcm6BitInterleavedParityErrors				DisplayString,

--*****************************************************************************
--			MIB FILE FOR THE OMTP11-PLUS CARD
--*****************************************************************************

	OMTP11-PLUS-MIB DEFINITIONS ::= BEGIN

	IMPORTS

	RowStatus                               FROM STANDARD-MIB
	DisplayString                           FROM RFC1213-MIB
	   
	OBJECT-IDENTITY, 
	NOTIFICATION-TYPE, 
	MODULE-IDENTITY, 
	Integer32, 
	Unsigned32,
	IpAddress,

	TimeTicks		                FROM SNMPv2-SMI
	OBJECT-TYPE                             FROM RFC-1212

	MODULE-COMPLIANCE, 
	OBJECT-GROUP, 
	NOTIFICATION-GROUP                      FROM SNMPv2-CONF

	node, 
	rack, 
	subRack, 
	slot                                    FROM SCC-MIB 

	enterprises                             FROM RFC1155-SMI		

	;

	utl   MODULE-IDENTITY
		LAST-UPDATED    	"1807130630Z"
		ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
		CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
		DESCRIPTION     	"MIB module for NFS."
		REVISION 	    	"1807130630Z"
		DESCRIPTION    	    	"MIB module for OMTP11-PLUS Card."
		::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
		STATUS  current
		DESCRIPTION "UTL Research and Development."
		::= { utl 1 }

	dwdm OBJECT IDENTIFIER				::=	{ utlrnd 1 }
	indus OBJECT IDENTIFIER				::=	{ dwdm 1 }
	omtp11Plus OBJECT IDENTIFIER 			::=	{ indus 71 }

	omtp11PlusCardGeneralDetails OBJECT IDENTIFIER	::=	{ omtp11Plus 1 }
	omtp11PlusConfiguration OBJECT IDENTIFIER	::=	{ omtp11Plus 2 }
	omtp11PlusAlarm OBJECT IDENTIFIER		::=	{ omtp11Plus 3 }
	omtp11PlusPerformance OBJECT IDENTIFIER		::=	{ omtp11Plus 4 }
	omtp11PlusDiagnostics OBJECT IDENTIFIER 	::=	{ omtp11Plus 5 }
	
	omtp11PlusAlarmQuery OBJECT IDENTIFIER		::=	{ omtp11PlusAlarm 1 }
	omtp11PlusAlarmNotification OBJECT IDENTIFIER	::=	{ omtp11PlusAlarm 2 }

--*****************************************************************************
--				   CARD GENERAL DETAILS
--*****************************************************************************

	omtp11PlusCardGeneralDetailsTable OBJECT-TYPE
		SYNTAX SEQUENCE OF Omtp11PlusCardGeneralDetailsEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			"Contains card general details' queries for the OMTP11-PLUS card"
		::= { omtp11PlusCardGeneralDetails 1 }

	omtp11PlusCardGeneralDetailsEntry OBJECT-TYPE
		SYNTAX Omtp11PlusCardGeneralDetailsEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			""				  	
		INDEX   { node, rack , subRack , slot , omtp11PlusInterfaceNumber}
		::= { omtp11PlusCardGeneralDetailsTable 1 }

	Omtp11PlusCardGeneralDetailsEntry ::= 
		SEQUENCE { 
				omtp11PlusInterfaceNumber					INTEGER,
				omtp11PlusEepromCardId					        INTEGER,
				omtp11PlusEepromCardName					DisplayString,
				omtp11PlusEepromPartCode					DisplayString,
				omtp11PlusEepromCardSerialNumber				DisplayString,
				omtp11PlusEepromHardwareExternalReleaseVersion		        DisplayString,
				omtp11PlusSoftwareExternalReleaseVersion		        DisplayString,
				omtp11PlusEepromHardwareInternalReleaseVersion		        DisplayString,
				omtp11PlusSoftwareInternalReleaseVersion		        DisplayString,
				omtp11PlusEepromCardUidNumber			                DisplayString,
				omtp11PlusEepromCardEui48Number				        DisplayString,
				omtp11PlusEepromCardEui64Number				        DisplayString,
				omtp11PlusCardRootFileSystemVersion				DisplayString,
				omtp11PlusCardInstallationDate				        DisplayString,
				omtp11PlusCardCommissionDate				        DisplayString,
				omtp11PlusCardRunningTime					DisplayString,
				omtp11PlusCardRestartCount					INTEGER,
				omtp11PlusXfpReadyForOperation				        INTEGER,
				omtp11PlusXfpI2cCommunicationStatus				INTEGER,
				omtp11PlusXfpEepromPage					        INTEGER,
				omtp11PlusCheckCodeOfXfpEepromPage				INTEGER,
				omtp11PlusExtendedCheckCodeOfXfpEepromPage			INTEGER,
				omtp11PlusXfpVendorName					        DisplayString,
				omtp11PlusXfpVendorIeeeId					DisplayString,
				omtp11PlusXfpPartNumber					        DisplayString,
				omtp11PlusXfpSerialNumber					DisplayString,
				omtp11PlusXfpRevisionNumber					DisplayString,
				omtp11PlusXfpManufacturingDate				        DisplayString,
				omtp11PlusFixedXfpLaserWavelength				DisplayString,
				omtp11PlusXfpLaserWavelengthTolerance				DisplayString,
				omtp11PlusXfpWavelengthTunabilitySupported			INTEGER,
				omtp11PlusTunableXfpLaserWavelengthError			DisplayString,
				omtp11PlusTunableXfpLaserFrequencyError			        DisplayString,
				omtp11PlusTunableXfpLaserFirstFrequency			        DisplayString,
				omtp11PlusTunableXfpLaserLastFrequency			        DisplayString,
				omtp11PlusTunableXfpWavelengthGridSpacing			DisplayString,
				omtp11PlusXfpConnectorType					DisplayString,
				omtp11PlusXfpLinkLength					        DisplayString,
				omtp11PlusXfpCdrRateSupported				        INTEGER,
				omtp11PlusXfpSignalEncodingTypeSupported			INTEGER,
				omtp11PlusXfpTransceiverCodesSupported			        INTEGER,
				omtp11PlusXfpMaximumBitrateSupported			        DisplayString,
				omtp11PlusXfpMinimumBitrateSupported			        DisplayString,
				omtp11PlusXfpMaximumCaseTemperatureSupported		        INTEGER,
				omtp11PlusXfpMaximumPowerDissipationSupported			INTEGER,
				omtp11PlusXfpMaximumPowerDissipationSupportedAtPowerDownMode	INTEGER,
				omtp11PlusXfpMaximumCurrentLimitSupportedAtPlus5vSupply		INTEGER,
				omtp11PlusXfpMaximumCurrentLimitSupportedAtPlus3Point3vSupply	INTEGER,
				omtp11PlusXfpMaximumCurrentLimitSupportedAtPlus1Point8vSupply	INTEGER,
				omtp11PlusXfpMaximumCurrentLimitSupportedAtMinus5Point2vSupply	INTEGER,
				omtp11PlusXfpLineLoopbackSupported				INTEGER,
				omtp11PlusXfpXfiLoopbackSupported				INTEGER,
				omtp11PlusXfpOptionalVpsSupported				INTEGER,
				omtp11PlusXfpLaserDisableThroughI2cSupported			INTEGER,
				omtp11PlusXfpPowerDownThroughI2cSupported			INTEGER,
				omtp11PlusXfpVpsLvRegulatorModeSupported			INTEGER,
				omtp11PlusXfpVpsBypassedRegulatorModeSupported			INTEGER,
				omtp11PlusXfpActiveFecControlSupported				INTEGER,
				omtp11PlusXfpOptionalCmuModeSupported				INTEGER,
				omtp11PlusXfpFecBerSupported					INTEGER,
				omtp11PlusXfpReceivePowerMeasurementIsInOmaOrAverage		INTEGER,
				omtp11PlusXfpActiveWavelengthControlSupported			INTEGER,
				omtp11PlusXfpTransmitterIsCooledOrUncooled			INTEGER,
				omtp11PlusXfpReceiverTypeIsPinOrApd				INTEGER,
				omtp11PlusCardGeneralDetailsTableRowStatus			RowStatus
		}

	omtp11PlusInterfaceNumber OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			"Interface number represents the port number
			InterfaceNumber to port mapping is as follows:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			For properties which do not apply on any interface,
			the interface number must be passed as 0
			-----------------------------"

		::= { omtp11PlusCardGeneralDetailsEntry 1 }
		
	omtp11PlusEepromCardId OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the card ID of the OMTP11-PLUS card, present in the EEPROM
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 2 }
		
	omtp11PlusEepromCardName OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the card name of the OMTP11-PLUS card, present in the EEPROM
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 3 }
		
	omtp11PlusEepromPartCode OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the part code of the OMTP11-PLUS card, present in the EEPROM
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 4 }
		
	omtp11PlusEepromCardSerialNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property get / set the information about 
			OMTP11-PLUS Card's Serial Number.
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 123456
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 5 }
		
	omtp11PlusEepromHardwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the Card's Hardware External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are significant
			architectural changes in the product
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 0.1
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 6 }
		
	omtp11PlusSoftwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the Card's Software External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are
			significant architectural changes in the product
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 0.1
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 7 }
		
	omtp11PlusEepromHardwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the Card's Hardware Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external hardware version.
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 4.1
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 8 }
		
	omtp11PlusSoftwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external software version.
		      	-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 5.1
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 9 }
		
	omtp11PlusEepromCardUidNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the Card Unique IDentifier. It is a 4 byte
			address used to uniquely identify a card.
			----------------------------
			omtp11PlusInterfaceNumber: 0
			------------------------------
			Values:
		      	eg: 12345678
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 10 }
		
	omtp11PlusEepromCardEui48Number OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-48 Number. It’s a 6 byte address
			used to uniquely identify a card.
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 0004A3123456
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 11 }
		
	omtp11PlusEepromCardEui64Number OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-64 Number. It’s a 8 byte address
			used to uniquely identify a card.
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 0004A31234567890
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 12 }
		
        omtp11PlusCardRootFileSystemVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card's Root File System Version
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 8
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 13 }
		
	omtp11PlusCardInstallationDate OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Get the card's installation date in
			dd/mm/yyyy format
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 12/03/2016
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 21 }

	omtp11PlusCardCommissionDate OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Get the card's commission date in
			dd/mm/yyyy format
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 20/03/2016
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 22 }

	omtp11PlusCardRunningTime OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the duration of time for which the card is
			operational/running
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 3d 2h 1m
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 23 }
		
	omtp11PlusCardRestartCount OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the number of times the card has been soft reset.
			This value will get reset to 0 on factory reset.
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 10
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 24 }
		
	omtp11PlusXfpReadyForOperation OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Module not ready indicates that the XFP
			has detected a condition that tells
			transmit or receive data is invalid.
			It shall consist of logical OR of the
			following signals:
			> Transmit Signal Conditioner Loss of Lock
			> Transmitter Laser Fault
			> Receiver Signal Conditioner Loss of Lock
			(Ref: INF-8077 2.4.1)
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:		
			1 - XFP is ready for operation 
			0 - XFP is not ready for operation
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 31 }
		
	omtp11PlusXfpI2cCommunicationStatus OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Tells whether the XFP can be accessed
			on a single 2-wire interface bus or not.
			(Ref: INF-8077 2.4.2)
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			1 - Enable I2C communication for XFP
				i.e. the XFP responds to 2-wire serial
				communication commands.
			0 - Disable I2C communication for XFP
				i.e. the XFP will not respond to or
				acknowledge any 2-wire interface communication
				from the host.
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 32 }
		
	omtp11PlusXfpEepromPage OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property sets/gets the XFP EEPROM page, 
			the value represents the XFP EEPROM page number.
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 33 }
		
	omtp11PlusCheckCodeOfXfpEepromPage OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides the XFP
			check code(checksum) value for bytes 128 to 190
			present in XFP EEPROM Page number 1. 
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 34 }
		
	omtp11PlusExtendedCheckCodeOfXfpEepromPage OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides the XFP
			extended check code(checksum) value for bytes 192 to 222
			present in XFP EEPROM Page number 1. 
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 35 }
		
	omtp11PlusXfpVendorName OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides Vendor Name for given XFP. 
			The vendor name shall be the full name of the 
			corporation, a commonly accepted abbreviation of 
			the name of the corporation, the SCSI company code
			for the corporation, or the stock exchange code for
			the corporation.
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: WTD
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 36 }
		
	omtp11PlusXfpVendorIeeeId OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the IEEE company Identifier for
			the vendor of XFP. A value of all zero in the 3-byte
			field indicates that the Vendor OUI is unspecified.
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 010
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 37 }
		
	omtp11PlusXfpPartNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the vendor part number or
			product name of the XFP. A value of all zero
			indicates that the vendor Part Number is unspecified.
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: FTRX-1811-2D2
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 38 }
		
	omtp11PlusXfpSerialNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides vendor serial number defining
			the vendor’s serial number for the XFP. A value of all
			zero in the 16-byte field indicates that the vendor
			serial number is unspecified.
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: KBG02CU
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 39 }
		
	omtp11PlusXfpRevisionNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"The vendor revision number defining the vendor’s
			 product revision number. A value of all zero indicates
			 that the vendor revision number is unspecified
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: RT
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 40 }
		
	omtp11PlusXfpManufacturingDate OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the manufacturing date for 
			XFP. A value of 8-byte field in ASCII which represents
			year, month and date of each two bytes. 
			Extra two bytes may be blank
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 160224
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 41 }
		
	omtp11PlusFixedXfpLaserWavelength OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides transmitter LASER wavelength(nm)
			of the XFP
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 1310
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 42 }
		
	omtp11PlusXfpLaserWavelengthTolerance OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides XFP wavelength tolerance in GhZ
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 0.02
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 43 }
		
	omtp11PlusXfpWavelengthTunabilitySupported OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides information whether the XFP
			supports wavelength tunability or not.
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			1 - XFP supports wavelength tunability
			0 - XFP not supports wavelength tunability
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 44 }

	omtp11PlusTunableXfpLaserWavelengthError OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides wavelength error in pm
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 0.02
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 45 }
		
	omtp11PlusTunableXfpLaserFrequencyError OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the monitor of current frequency
			Error of XFP. Frequency error is reported in Ghz.
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 0.03
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 46 }
		
	omtp11PlusTunableXfpLaserFirstFrequency OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the first LASER frequency of XFP.
			The two byte value is specified in units of THz.
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 1529.45
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 47 }
		
	omtp11PlusTunableXfpLaserLastFrequency OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the last laser frequency of XFP.
		 	 The two byte value is specified in units of THz.
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:			
			eg: 1563.45
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 48 }
		
	omtp11PlusTunableXfpWavelengthGridSpacing OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property gives difference in the wavelength
			between two channels In GhZ
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 50
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 49 }
		
	omtp11PlusXfpConnectorType OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides information of the XFP
			connector, value indicates the external connector
			provided on the XFP.
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			00h 	Unknown or unspecified
			01h 	SC
			02h 	Fibre Channel Style 1 copper connector
			03h 	Fibre Channel Style 2 copper connector
			04h 	BNC/TNC
			05h 	Fibre Channel coaxial headers
			06h 	FiberJack
			07h 	LC
			08h 	MT-RJ
			09h 	MU
			0Ah 	SG
			0Bh 	Optical pigtail
			0C-1Fh 	Reserved
			20h 	HSSDC II
			21h 	Copper Pigtail
			22h-7Fh Reserved
			80-FFh 	Vendor specific
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 50 }
		
	omtp11PlusXfpLinkLength OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides link length suported by the XFP
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:
			eg: 80.00
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 51 }
		
	omtp11PlusXfpCdrRateSupported OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property indicates which rates are supported by
			the CDR present in XFP.
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:

			Return value 1-Byte represetation:
			Byte-1  CDR Rates
			Bit-7	9.95 Gb/s
			Bit-6	10.3 Gb/s
			Bit-5	10.5 Gb/s
			Bit-4	10.7 Gb/s
			Bit-3	11.1 Gb/s
			Bit-2	Reserved
			Bit-1	Dont care for this property
			Bit-0	Dont care for this property
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 52 }
		
	omtp11PlusXfpSignalEncodingTypeSupported OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property indicates the serial encoding mechanisms
			that are supported by the XFP.
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:

			Return value 1-Byte represetation:
			Byte-1  Encoding Type
			Bit-7	64B/66B          
			Bit-6	8B10B     	 	 
			Bit-5	SONET Scrambled  
			Bit-4	NRZ              
			Bit-3	RZ              
			Bit-2	Reserved        
			Bit-1	Reserved         
			Bit-0	Reserved 
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 53 }
		
	omtp11PlusXfpTransceiverCodesSupported OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"The identifier value specifies which transceiver
			codes are supported by the XFP
			-----------------------------
			omtp11PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			-----------------------------
			Values:

			Return value 8-Byte represetation:
			---------------------------------------------------------------------------------------------------------------------------------------
				  Byte-1	  Byte-2	          Byte-3	  Byte-4	          Byte-5    Byte-6    Byte-7	        Byte-8
			---------------------------------------------------------------------------------------------------------------------------------------
			Bit-7	 10GBASE-SR	 1200-MX-SN-I        	 Reserved	 1000BASE-SX/1xFC MMF	 I-64.1r   S-64.1    L-64.1	       V-64.2a
			Bit-6	 10GBASE-LR	 1200-SM-LL-L	         Reserved	 1000BASE-LX/1xFC-SMF	 I-64.1	   S-64.2a   L-64.2a	       V-64.2b
			Bit-5	 10GBASE-ER	 Extended 1550 nm	 Reserved	 2xFC-MMF/2xFC-SMF	 I-64.2r   S-64.2b   L-64.2b	       V-64.3
			Bit-4	 10GBASE-LRM	 Intermediate 1300 nm	 Reserved	 OC-48-SR	         I-64.2	   S-64.3a   L-64.2c	       Reserved
			Bit-3	 10GBASE-SW	 Reserved	         Reserved	 OC-48-IR	         I-64.3	   S-64.3b   L-64.3	       Reserved
			Bit-2	 10GBASE-LW	 Reserved	         Reserved	 OC-48-LR	         I-64.5	   S-64.5a   G.959.1 P1L1-2D2  Reserved
			Bit-1	 10GBASE-EW	 Reserved	         Reserved	 Reserved	         Reserved  S-64.5b   Reserved	       Reserved
			Bit-0	 Reserved	 Reserved	         Reserved	 Reserved	         Reserved  Reserved  Reserved	       Reserved
			-----------------------------"
		::= { omtp11PlusCardGeneralDetailsEntry 54 }
		
	omtp11PlusXfpMaximumBitrateSupported OBJECT-TYPE

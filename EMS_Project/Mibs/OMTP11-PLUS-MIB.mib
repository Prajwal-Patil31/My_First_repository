				        omtp11PlusWan10gMsB2BitInterleavedParityErrors				DisplayString,
				        omtp11PlusWan10gMsB3BitInterleavedParityErrors				DisplayString,
				        omtp11PlusWan10gMsRemoteErrorIndicationErrorCount			DisplayString,
				        omtp11PlusWan10gMsRemoteDefectIndicationErrorCount			DisplayString,
				        omtp11PlusWan10gErrorFreeSeconds					DisplayString,

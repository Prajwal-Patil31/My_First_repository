				        omtp11PlusOduFarEndSevereErrorSeconds					DisplayString,
				        omtp11PlusOduFarEndUnavailableSeconds					DisplayString,
				        omtp11PlusOduFarEndBackgroundBlockErrorRatio				DisplayString,
				        omtp11PlusOduFarEndSevereErrorSecondsErrorRatio				DisplayString,
				        omtp11PlusSdhRsB1BitInterleavedParityErrors				DisplayString,
				        omtp11PlusSdhMsB2BitInterleavedParityErrors				DisplayString,
				        omtp11PlusSdhMsB3BitInterleavedParityErrors				DisplayString,
				        omtp11PlusSdhMsRemoteErrorIndicationErrorCount				DisplayString,
				        omtp11PlusSdhMsRemoteDefectIndicationErrorCount				DisplayString,
				        omtp11PlusSdhErrorFreeSeconds						DisplayString,
				        omtp11PlusSdhErrorSeconds						DisplayString,
				        omtp11PlusSdhBackgroundBlockErrors					DisplayString,
				        omtp11PlusSdhSevereErrorSeconds						DisplayString,
				        omtp11PlusSdhUnavailableSeconds						DisplayString,
				        omtp11PlusSdhErrorSecondsErrorRatio					DisplayString,
				        omtp11PlusSdhBackgroundBlockErrorRatio					DisplayString,

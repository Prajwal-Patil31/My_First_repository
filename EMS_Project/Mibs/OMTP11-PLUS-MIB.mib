				        omtp11PlusLan10gMacTerminatedUnicastFramesReceived			DisplayString,
				        omtp11PlusLan10gMacTerminatedMulticastFramesTransmitted			DisplayString,
				        omtp11PlusLan10gMacTerminatedMulticastFramesReceived			DisplayString,
				        omtp11PlusLan10gMacTerminatedBroadcastFramesTransmitted			DisplayString,
				        omtp11PlusLan10gMacTerminatedBroadcastFramesReceived			DisplayString,
				        omtp11PlusLan10gMacTerminatedUnderSizeFramesTransmitted			DisplayString,
				        omtp11PlusLan10gMacTerminatedUnderSizeFramesReceived			DisplayString,
				        omtp11PlusLan10gMacTerminatedOverSizeFramesTransmitted			DisplayString,
				        omtp11PlusLan10gMacTerminatedOverSizeFramesReceived			DisplayString,
				        omtp11PlusLan10gMacTerminatedVlanTaggedFramesTransmitted		DisplayString,
				        omtp11PlusLan10gMacTerminatedVlanTaggedFramesReceived			DisplayString,
				        omtp11PlusLan10gMacTerminatedFrameSymbolErrorsReceived			DisplayString,
				        omtp11PlusLan10gMacTerminatedFragmentFramesReceived			DisplayString,
				        omtp11PlusLan10gMacTerminatedFrameCheckSequenceErrorsReceived		DisplayString,
					omtp11PlusLan10gMacTerminatedFramesReceivedWithNoDefect			DisplayString,
					omtp11PlusLan10gMacTerminatedBytesTransmitted				DisplayString,
					omtp11PlusLan10gMacTerminatedBytesReceived				DisplayString,	
					omtp11PlusLan10gMacTerminatedControlFramesTransmitted			DisplayString,
					omtp11PlusLan10gMacTerminatedControlFramesReceived			DisplayString,
				        omtp11PlusLan10gTransparentTransmitLcvCount				DisplayString,
				        omtp11PlusLan10gTransparentTransmitPropagationErrorDeletionCount	DisplayString,
				        omtp11PlusLan10gTransparentTransmitIdleDeletionCount			DisplayString,
				        omtp11PlusLan10gTransparentTransmitConfDeletionCount			DisplayString,
				        omtp11PlusLan10gTransparentTransmitPropagationInsertionCount		DisplayString,
				        omtp11PlusLan10gTransparentTransmitIdleInsertionCount			DisplayString,
				        omtp11PlusLan10gTransparentTransmitConfInsertionCount			DisplayString,
				        omtp11PlusLan10gTransparentReceiveLcvCount				DisplayString,
				        omtp11PlusLan10gTransparentReceivePropagationErrorDeletionCount		DisplayString,
				        omtp11PlusLan10gTransparentReceiveIdleDeletionCount			DisplayString,
				        omtp11PlusLan10gTransparentReceiveConfDeletionCount			DisplayString,
				        omtp11PlusLan10gTransparentReceivePacketDeletionCount			DisplayString,
				        omtp11PlusGfpCoreHeaderErrorCount					DisplayString,
				        omtp11PlusGfpExtentionHeaderErrorCount					DisplayString,
				        omtp11PlusGfpFrameCountWithSingleBitError				DisplayString,
					omtp11PlusGfpTypeHeaderErrorCount					DisplayString,
					omtp11PlusGfpReceiveDropFrameCount					DisplayString,
					omtp11PlusGfpReceiveExtensionHeaderIdentifierFilterDropCount		DisplayString,
				        omtp11PlusFcTransmitWordCount						DisplayString,
				        omtp11PlusFcTransmitBadCrc						DisplayString,
				        omtp11PlusFcTransmitTotalPackets					DisplayString,
				        omtp11PlusFcTransmitLcvCount						DisplayString,
				        omtp11PlusFcReceiveWordCount						DisplayString,
				        omtp11PlusFcReceiveBadCrc						DisplayString,
				        omtp11PlusFcReceiveTotalPackets						DisplayString,

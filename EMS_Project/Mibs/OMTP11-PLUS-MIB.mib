				        omtp11PlusOduTcm3BackwardErrorIndicationErrorCount			DisplayString,
				        omtp11PlusOduTcm4BackwardErrorIndicationErrorCount			DisplayString,
				        omtp11PlusOduTcm5BackwardErrorIndicationErrorCount			DisplayString,
				        omtp11PlusOduTcm6BackwardErrorIndicationErrorCount			DisplayString,
				        omtp11PlusOduTcm1BackwardIncomingAlignmentErrorSeconds			DisplayString,
				        omtp11PlusOduDelayMeasurement						DisplayString,
				        omtp11PlusOduErrorFreeSeconds						DisplayString,
				        omtp11PlusOduErrorSeconds						DisplayString,
				        omtp11PlusOduBackgroundBlockErrors					DisplayString,
				        omtp11PlusOduSevereErrorSeconds						DisplayString,
				        omtp11PlusOduUnavailableSeconds						DisplayString,
				        omtp11PlusOduBackgroundBlockErrorRatio					DisplayString,
				        omtp11PlusOduSevereErrorSecondsErrorRatio				DisplayString,
				        omtp11PlusOduFarEndErrorFreeSeconds					DisplayString,

--*****************************************************************************
--				    DIAGNOSTICS
--*****************************************************************************        

	omtp11PlusDiagnosticsTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Omtp11PlusDiagnosticsEntry
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Category contains properties that are used for debugging
                      card software"
		::= { omtp11PlusDiagnostics 1 }	

	omtp11PlusDiagnosticsEntry   OBJECT-TYPE
              SYNTAX  Omtp11PlusDiagnosticsEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , omtp11PlusInterfaceNumber }
		::= { omtp11PlusDiagnosticsTable 1 }
	
	Omtp11PlusDiagnosticsEntry ::= 
		SEQUENCE {
				omtp11PlusAccessCortinaRegister				INTEGER,
				omtp11PlusCollectCortinaRegisterDump			INTEGER,
				omtp11PlusCollectCortinaModulebGpllRxLockStatus		DisplayString,
				omtp11PlusCollectCortinaModulebGpllTxLockStatus		DisplayString,
				omtp11PlusCollectCortinaModulebTxSerdesLockStatus	DisplayString,
				omtp11PlusCollectCortinaModulebTxSerdesVcoTunedValue	DisplayString,
				omtp11PlusCollectCortinaModulebXfiCupllLockStatus	DisplayString,
				omtp11PlusCollectCortinaModulebAllClockLockStatus	OCTET STRING,
				omtp11PlusDiagnosticTableRowStatus			RowStatus
			}
			
	omtp11PlusAccessCortinaRegister OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
			"Sets/gets the value of any cortina register
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg:
			example of cortina register - 76071076
			value - 1
			-----------------------------"
	::= { omtp11PlusDiagnosticsEntry 1 }	

	omtp11PlusCollectCortinaRegisterDump OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"create register dump of all cortina register
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------
                     	This query will create registe dump in card's 
			root directory
			-----------------------------"
	::= { omtp11PlusDiagnosticsEntry 2 }	

	omtp11PlusCollectCortinaModulebGpllRxLockStatus OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads GPLL Rx clock lock status for all slices
			 of module B
			 Expected value : should be 0x00049 to indicate 
			 Value is locked
			 The following register will be read:
			 0x00c59, 0x00c99, 0x00cd9, 0x00d19
			 The register that will be read is GPLLX1_SDS_COMMON_TXLOCKD0_INTSTATUS
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp11PlusDiagnosticsEntry 3 }	
	
	omtp11PlusCollectCortinaModulebGpllTxLockStatus OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads GPLL Tx clock lock status for all slices
			 of module B
			 Expected value : should be 0x00049 to indicate 
			 Value is locked
			 The following register will be read:
			 0x00d59, 0x00d99, 0x00dd9, 0x00e19
			 The register that will be read is GPLLX1_SDS_COMMON_TXLOCKD0_INTSTATUS
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp11PlusDiagnosticsEntry 4 }

	omtp11PlusCollectCortinaModulebTxSerdesLockStatus OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads Tx serdes clock lock status for all slices
			 of module B
			 Expected value : should be 0x00049 to indicate 
			 Value is locked
			 The following register will be read:
			 0x0303d, 0x0343d, 0x0383d, 0x03c3d
			 The register that will be read is 
			 XFI32X1_SDS_XFI32X1_SDS_COMMON_TXLOCKD0_INTSTATUS
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp11PlusDiagnosticsEntry 5 }	
	
	omtp11PlusCollectCortinaModulebTxSerdesVcoTunedValue OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads Tx serdes VCO tuning value for all slices
			 of module B
			 Expected value : Value when correctly tuned should not 
			 be near extremes of 0x3F or 0x00
			 The following register will be read:
			 0x03031, 0x03431, 0x03831, 0x03c31
			 The register that will be read is XFI32X1_SDS_XFI32X1_SDS_COMMON_TXVCO0_STATUS
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp11PlusDiagnosticsEntry 6 }	

	omtp11PlusCollectCortinaModulebXfiCupllLockStatus OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads XFI CUPLL Lock status for all slices
			 of module B
			 Expected value : should be 0x00049 to indicate Value is locked 
			 The following register will be read:
			 0x1b438, 0x1b478, 0x1b4b8, 0x1b4f8
			 The register that will be read is XFI_CUPLL_LOCKDET_INTSTATUS
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp11PlusDiagnosticsEntry 7 }	

	omtp11PlusCollectCortinaModulebAllClockLockStatus OBJECT-TYPE
		SYNTAX  OCTET STRING
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads Lock status of following clocks:
			 GPLL Rx/Tx, Tx serdes, Tx Serdes VCO tuned value and XFI CUPLLfor all slices
			 of module B.
			 Expected value : should be 0x00049 to indicate Value is locked 
			 The following register will be read:
			 0x1b438, 0x1b478, 0x1b4b8, 0x1b4f8
			 The register that will be read is XFI_CUPLL_LOCKDET_INTSTATUS
			-----------------------------
			omtp11PlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp11PlusDiagnosticsEntry 8 }	

	omtp11PlusDiagnosticTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
			"*****************************
			This is MIB realted property,
			NOT to be considered as a card property
			*****************************"
	::= { omtp11PlusDiagnosticsEntry 9 }
        

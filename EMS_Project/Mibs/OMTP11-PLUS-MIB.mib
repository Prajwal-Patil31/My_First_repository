	omtp11PlusAlarmQueryTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
                      "	This is MIB realted property,
			NOT to be considered as a card property"
              ::= { omtp11PlusAlarmQueryEntry 165 }	


--*****************************************************************************
--				    PERFORMANCE
--***************************************************************************** 	
	omtp11PlusPerformanceTable OBJECT-TYPE
		SYNTAX SEQUENCE OF Omtp11PlusPerformanceEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			"we can get performance details of the OMTP11-PLUS Card"
	
		::= { omtp11PlusPerformance 1 }

	omtp11PlusPerformanceEntry OBJECT-TYPE
		SYNTAX Omtp11PlusPerformanceEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION 
			""
	
		INDEX   { node, rack , subRack , slot , omtp11PlusInterfaceNumber}
	
		::= { omtp11PlusPerformanceTable 1 }

		Omtp11PlusPerformanceEntry ::= 
			SEQUENCE {
					omtp11PlusXfpInputPower                                     		DisplayString,
				        omtp11PlusXfpOutputPower                                    		DisplayString,
				        omtp11PlusXfpBiasCurrent                                    		DisplayString,
				        omtp11PlusXfpSupplyVoltage                                  		DisplayString,
				        omtp11PlusXfpTemperature                                    		DisplayString,
				        omtp11PlusOtnFecUncorrectedWords                            		DisplayString,

--*****************************************************************************
--			MIB FILE FOR THE OMMP021 CARD
--*****************************************************************************

OMMP021-MIB DEFINITIONS ::= BEGIN
 
          IMPORTS
        	
		RowStatus      			FROM STANDARD-MIB
			
		DisplayString  			FROM RFC1213-MIB       
    	
    		OBJECT-IDENTITY,
    		NOTIFICATION-TYPE,
    		MODULE-IDENTITY,
    		Integer32,
    		Unsigned32,
    		IpAddress,
    		TimeTicks			FROM SNMPv2-SMI
	 
	 	OBJECT-TYPE    			FROM RFC-1212
	 		
		MODULE-COMPLIANCE,
		OBJECT-GROUP,
		NOTIFICATION-GROUP		FROM SNMPv2-CONF
	
		node,
		rack,
		subRack,
		slot				FROM SCC-MIB
    
		enterprises			FROM RFC1155-SMI
	;

 

	utl   MODULE-IDENTITY
            LAST-UPDATED    	"1807130630Z"
            ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
            CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
            DESCRIPTION     	"MIB module for UTL 40/80 channel DWDM."
            REVISION 	    	"1807130630Z"
            DESCRIPTION    	"MIB module for OMMP021 Card."
            ::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
            STATUS  current
            DESCRIPTION "UTL Research and Development."
            ::= { utl 1 }

	dwdm 	OBJECT IDENTIFIER				::=	{ utlrnd 1 }
	indus 	OBJECT IDENTIFIER				::=	{ dwdm 1 }
	ommp021 	OBJECT IDENTIFIER 			::=	{ indus 91 }

	ommp021CardGeneralDetails OBJECT IDENTIFIER		::=	{ ommp021 1 }
	ommp021Configuration OBJECT IDENTIFIER 		::=	{ ommp021 2 }
	ommp021Alarm OBJECT IDENTIFIER 			::=	{ ommp021 3 }
	ommp021Performance OBJECT IDENTIFIER 		::=	{ ommp021 4 }
	ommp021Diagnostics OBJECT IDENTIFIER 		::=	{ ommp021 5 }

	ommp021AlarmQuery OBJECT IDENTIFIER			::=	{ ommp021Alarm 1 }
	ommp021AlarmNotification OBJECT IDENTIFIER		::=	{ ommp021Alarm 2 }

--*****************************************************************************
--				CARD GENERAL DETAILS
--*****************************************************************************

	ommp021CardGeneralDetailsTable OBJECT-TYPE
		SYNTAX  SEQUENCE OF Ommp021CardGeneralDetailsEntry 
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
                     "Contains card general details' queries for the OMMP021 card"
		::= { ommp021CardGeneralDetails 1 }

	ommp021CardGeneralDetailsEntry  OBJECT-TYPE
		SYNTAX  Ommp021CardGeneralDetailsEntry 
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION 
              	""
		INDEX   { node, rack, subRack, slot, ommp021InterfaceNumber }
		::= { ommp021CardGeneralDetailsTable 1 }

	Ommp021CardGeneralDetailsEntry  ::= 
		SEQUENCE {
				ommp021InterfaceNumber					INTEGER,
				ommp021EepromCardId					        INTEGER,
				ommp021EepromCardName					DisplayString,
				ommp021EepromCardSerialNumber				DisplayString,
				ommp021EepromHardwareExternalReleaseVersion		        DisplayString,
				ommp021EepromHardwareInternalReleaseVersion		        DisplayString,
				ommp021SoftwareExternalReleaseVersion		        DisplayString,
				ommp021SoftwareInternalReleaseVersion		        DisplayString,
				ommp021CardGeneralDetailsTableRowStatus			RowStatus
			 }
	

	ommp021InterfaceNumber OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
			"Interface number represents the port number.
			InterfaceNumber to port mapping is as follows:
			1 - CLIENT-1,
			2 - CLIENT-2,
			3 - CLIENT-3,
			4 - CLIENT-4,
			3 - LINE-
			-----------------------------
			For properties which do not apply on any interface,
			the interface number must be passed as 0
			-----------------------------"
		::= { ommp021CardGeneralDetailsEntry 1 }
	
	ommp021EepromCardId OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the card ID of the OMMP021 card, present in the EEPROM
			-----------------------------
			ommp021InterfaceNumber: 0
			-----------------------------"
		::= { ommp021CardGeneralDetailsEntry 2 }

	ommp021EepromCardName OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the card name of the OMMP021 card, present in the EEPROM
			-----------------------------
			ommp021InterfaceNumber: 0
			-----------------------------"
		::= { ommp021CardGeneralDetailsEntry 3 }

	ommp021EepromCardSerialNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property get / set the information about 
			OMMP021 Card's Serial Number.
			-----------------------------
			ommp021InterfaceNumber: 0
			-----------------------------
			Values:
			eg: 123456
			-----------------------------"
		::= { ommp021CardGeneralDetailsEntry 4 }

	ommp021EepromHardwareExternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Hardware External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are significant
			architectural changes in the product
			-----------------------------
			ommp021InterfaceNumber: 0
			-----------------------------
			Value:
			eg: 0.1
			-----------------------------"
		::= { ommp021CardGeneralDetailsEntry 5 }
	
	ommp021EepromHardwareInternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Hardware Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external hardware version.
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Value:
			eg: 4.1
			-----------------------------"
		::= { ommp021CardGeneralDetailsEntry 6 }

	ommp021SoftwareExternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are
			significant architectural changes in the product
			-----------------------------
			ommp021InterfaceNumber: 0
			-----------------------------
			Value:
			eg: 0.1
			-----------------------------"
		::= { ommp021CardGeneralDetailsEntry 7 }
		
	ommp021SoftwareInternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external software version.
		      	-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Value:
			eg: 5.1
			-----------------------------"
		::= { ommp021CardGeneralDetailsEntry 8 }

	ommp021CardGeneralDetailsTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
			"*****************************
			This is MIB realted property,
			NOT to be considered as a card property
			*****************************"
              ::= { ommp021CardGeneralDetailsEntry 9 }

--*****************************************************************************
--				   CONFIGURATION
--*****************************************************************************

	ommp021ConfigurationTable OBJECT-TYPE
		SYNTAX  SEQUENCE OF Ommp021ConfigurationEntry 
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
		      "Contains configuration queries of the OMMP021 card"
		::= { ommp021Configuration 1 }

	ommp021ConfigurationEntry  OBJECT-TYPE
              SYNTAX  Ommp021ConfigurationEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack, subRack, slot, ommp021InterfaceNumber }
		::= { ommp021ConfigurationTable 1 }
	
	Ommp021ConfigurationEntry  ::= 
		SEQUENCE {
				ommp021CardSoftwareUpgrade					DisplayString,
				ommp021CardSoftReset						INTEGER,

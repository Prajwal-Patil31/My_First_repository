					ommp021Qsfp28PresenceAbsenceNotification				DisplayString,
					ommp021OtuLossOfSignalAlarm				DisplayString,
					ommp021OtuLossOfFrameAlarm				DisplayString,
					ommp021OtuOutOfFrameAlarm				DisplayString,
					ommp021OtuLossOfMultiFrameAlarm			DisplayString,
					ommp021OtuOutOfMultiFrameAlarm			DisplayString,
					ommp021OtuSignalFailAlarm				DisplayString,
					ommp021OtuSignalDegradeAlarm				DisplayString,
					ommp021OtuAlarmIndicationSignalAlarm			DisplayString,
					ommp021OtuIncomingAlignmentErrorAlarm			DisplayString,
					ommp021OtuTrailTraceIdentifierMismatchAlarm		DisplayString,

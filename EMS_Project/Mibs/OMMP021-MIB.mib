	ommp021AlarmQueryTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Ommp021AlarmQueryEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Gives Optical and Signal Alarms status of the OMMP021 card"
		::= { ommp021AlarmQuery 1 }	

	ommp021AlarmQueryEntry   OBJECT-TYPE
              SYNTAX  Ommp021AlarmQueryEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , ommp021InterfaceNumber }
		::= { ommp021AlarmQueryTable 1 }
	
	Ommp021AlarmQueryEntry ::= 
			SEQUENCE {					
					ommp021Cfp2InputPowerFailureAlarm					DisplayString,
					ommp021Cfp2OutputPowerFailureAlarm					DisplayString,
					ommp021Cfp2HighTemperatureAlarm					DisplayString,

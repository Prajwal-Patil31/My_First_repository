--*****************************************************************************
--				    PERFORMANCE
--*****************************************************************************        

	ommp021PerformanceTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Ommp021PerformanceEntry
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Gives Optical and Signal performance status of the OMMP021 card"
		::= { ommp021Performance 1 }	

	ommp021PerformanceEntry   OBJECT-TYPE
              SYNTAX  Ommp021PerformanceEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , ommp021InterfaceNumber}
		::= { ommp021PerformanceTable 1 }
	
	Ommp021PerformanceEntry ::= 
		SEQUENCE {
				ommp021Cfp2InputPower							DisplayString,
				ommp021Cfp2OutputPower						DisplayString,
				ommp021Cfp2SupplyVoltage						DisplayString,
				ommp021Cfp2Temperature						DisplayString,
				ommp021Qsfp28InputPower							DisplayString,
				ommp021Qsfp28OutputPower						DisplayString,
				ommp021Qsfp28BiasCurrent						DisplayString,
				ommp021Qsfp28SupplyVoltage						DisplayString,
				ommp021Qsfp28Temperature						DisplayString,
				ommp021OtnFecUncorrectedWords					DisplayString,
				ommp021OtnFecCorrectedBits					DisplayString,
				ommp021OtuBitInterleavedParityErrors					DisplayString,
				ommp021OtuBackwardErrorIndicationErrorCount					DisplayString,
				ommp021OtuErrorFreeSeconds					DisplayString,
				ommp021OtuErrorSeconds					DisplayString,
				ommp021OtuBackgroundBlockErrors					DisplayString,
				ommp021OtuSevereErrorSeconds					DisplayString,
				ommp021OtuUnavailableSeconds					DisplayString,

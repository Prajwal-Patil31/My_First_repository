				ommp021LineOduOpenConnectionIndicationAlarmSeverity		DisplayString,
				ommp021LineOduBackwardDefectIndicationAlarmSeverity		DisplayString,
				ommp021LineOpuPayloadMismatchAlarmSeverity			DisplayString,
				ommp021ConfigurationTableRowStatus				RowStatus
			}
		
	ommp021CardSoftwareUpgrade OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as SET command.
			This property upgrades the software of the OMMP021 card
			It takes the path of the software release as
			a value
			-----------------------------
			ommp021InterfaceNumber: 0
			-----------------------------
			Values:
			eg: /root/home/rel-2.0.0.tar.gz
			-----------------------------"
		::= { ommp021ConfigurationEntry 1 }

	ommp021CardSoftReset OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as a SET command.
			Reboots the Card, Reconfigures the Card 
			i.e All Configuration Parameter	like Laser State,
			Traffic configuration, Loopback, FEC, optical and 
			signal thresholds, switching mode,
			user choice of line path, auto-negotiation, 
			TTI messages will be restored to previous state
			-----------------------------
			ommp021InterfaceNumber: 0
			-----------------------------
			Values:
			Dont care, any value
			eg: 0
			-----------------------------"
		::= { ommp021ConfigurationEntry 2 }

	ommp021CardFactoryReset OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as a SET command.
			Sets the Card To Factory Default State
			i.e All User Configuration Parameters like Laser State,
			Traffic configuration, Loopback, FEC, optical and 
			signal thresholds, switching mode,
			user choice of line path, auto-negotiation, TTI messages
			will be set to default state
			-----------------------------
			ommp021InterfaceNumber: 0
			-----------------------------
			Values:
			Dont care, any value
			eg: 0
			-----------------------------"
		::= { ommp021ConfigurationEntry 3 }
		
	ommp021SyncSystemTimeWithNtpServer OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			" when we want to manually sync the time value
			present in linux kernel with the NTP server
			we can use this OID. We can provide NTP server
			ip address as a value to this OID and the time
			will be synced to that ilarticular server. 
			If we are not providing NTP server IP address 
			then the system will be synced with the NTP server 
			which is already been registered with card. 
			If both are absent then error message will be returned
			-----------------------------
			Interface : 0
			-----------------------------
			If we want to provide NTP server IP address then
			Value should be a valid IP address as shown below
			: 192.168.021.25
			
			If we don't want to provide NTP server address then no
			need to pass any value. 
			---------------------------"
		::= { ommp021ConfigurationEntry 4 }

	ommp021SyncRtcWithNtpServer OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			" when we want to manually sync the time value
			present in RTC with the NTP server
			we can use this OID. We can provide NTP server
			ip address as a value to this OID and the time
			will be synced to that particular server. 
			If we are not providing NTP server IP address 
			then the system will be synced with the NTP server 
			which is already been registered with card. 
			If both are absent then error message will be returned.
			-----------------------------
			Interface : 0
			-----------------------------
			If we want to provide NTP server IP address then
			Value should be a valid IP address as shown below
			: 192.168.021.25
			
			If we don't want to provide NTP server address, then no
			need to ilass any value. 
			---------------------------"
		::= { ommp021ConfigurationEntry 5 }

	ommp021SyncRtcWithSystemTime OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			" when we want to manually sync the time value
			present in RTC with the time value in linux kernel
			we can use this OID. With this set operation, 
			the time available with linux kernel will be updated
			into RTC. It is not required to provide any value for 
			this operation"
		::= { ommp021ConfigurationEntry 6 }

	ommp021UpdateGivenTimeIntoSystem OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			" when we want to manually update system time
			with the user provided time, we can use this OID.
			With OID we need to provide time value which we
			want to update in the system.
			-----------------------------
			Interface : 0
			-----------------------------
			Value should be of given format:
			YYYY-MM-DD H:M:S
			
			Example: 2017-10-31 15:20:44
			---------------------------"
		::= { ommp021ConfigurationEntry 7 }

	ommp021UpdateGivenTimeIntoRtc OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			" when we want to manually update RTC time
			with the user provided time, we can use this OID.
			With OID we need to provide time value which we
			want to update in RTC.
			-----------------------------
			Interface : 0
			-----------------------------
			Value should be of given format:
			YYYY-MM-DD H:M:S
			
			Example: 2017-10-31 15:20:44
			---------------------------"
		::= { ommp021ConfigurationEntry 8 }

	ommp021SystemTimeAndRtcTime OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			" get the system time and time value present in RTC.
			-----------------------------
			Interface : 0
			-----------------------------"
		::= { ommp021ConfigurationEntry 9 }

		
	ommp021TrafficConfiguration OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or get the traffic for the
			requested port
			----------------------------------------
			ommp021InterfaceNumber:
			CLIENT-1
			CLIENT-2
			LINE-3
			----------------------------------------			
			Value: 
			For client
			00 - Un-configure 
			01 - OTU4
			02 - 100GbE
			For line
			03 - OTUC2 (200G Line)
			-----------------------------"
		::= { ommp021ConfigurationEntry 10 }

	ommp021LoopbackState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or get the loopback state for the
			requested port
			----------------------------------------
			If line side module is CFP2(Finisar-200G)
			Client Near end loopback can be configured
			Client Far end loopback is not supported
			Line near end loopback is not supported
			Line far end loopback can be configured
			----------------------------------------
			If line side module is CFP2-DCO(Lumentum,etc)
			Both near end loopback and far end loopback can be configured on client
			Both near end loopback and far end loopback can be configured on line			
			-----------------------------
			ommp021InterfaceNumber:
			CLIENT-1
			CLIENT-2
			LINE-3
			-----------------------------
			Values: 
			00 - No Loopback   
			01 - Near End Loopback
			02 - Far End Loopback
			-----------------------------"
		::= { ommp021ConfigurationEntry 11 }

	ommp021ClearSignalPerformance OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Valid only as a SET command.
			Clears signal performance for the requested port
			-----------------------------
			ommp021InterfaceNumber:
			CLIENT-1
			CLIENT-2
			LINE-3
			-----------------------------
			Values:
			Dont care, any value
			eg: 0
			-----------------------------"
		::= { ommp021ConfigurationEntry 12 }

	ommp021AlsState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set the Automatic Laser Switching(ALS) mode for
			for requested port. Based on the RX LOS state of the
			port, the transmit LASER state will be controlled
			according to the algorithm defined for ALS in
			ITUT 664 Standard
			-----------------------------
			ommp021InterfaceNumber:
			CLIENT-1
			CLIENT-2
			LINE-3
			-----------------------------
			Values: 
			1 - Enable ALS state
			0 - Disable ALS state
			-----------------------------" 
		::= { ommp021ConfigurationEntry 13 }

	ommp021AlsPulseRepetitionTime OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Pulse repetition time is the time for automatic 
			restart of CFP2 LASER once the ALS algorithm starts.
			-----------------------------
			ommp021InterfaceNumber:
			CLIENT-1
			CLIENT-2
			LINE-3
			-----------------------------
			Values: 
			1 seconds to 300 seconds
			-----------------------------"
		::= { ommp021ConfigurationEntry 14 }

	ommp021OtuFecConfiguration OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or Get FEC type for requested port configured with
			 OTU4/OTUC2 traffic.  
			----------------------------------------
			If line side module is CFP2(Finisar-200G)
			Fec O-FEC supported on line side(OpenRoadm)
			Fec G-FEC supported on client side
			-----------------------------
			ommp021InterfaceNumber:
			CLIENT-1
			CLIENT-2
			LINE-3
			-----------------------------
			Values: 
			01 - OTU-4 G.709 FEC
			02 - O-FEC
			-----------------------------"
		::= { ommp021ConfigurationEntry 15 }

	ommp021OtuSignalFailThreshold OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Set or Get SM Signal Failure 
			Threshold value for the requested port configured with 
			OTU4/OTUC2 traffic.
			-----------------------------
			ommp021InterfaceNumber:
			CLIENT-1

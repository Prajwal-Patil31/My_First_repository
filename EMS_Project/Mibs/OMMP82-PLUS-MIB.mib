--*****************************************************************************
--				    PERFORMANCE
--*****************************************************************************        

	ommp82PlusPerformanceTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Ommp82PlusPerformanceEntry
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Gives Optical and Signal performance status of the OMMP82-PLUS card"
		::= { ommp82PlusPerformance 1 }	

	ommp82PlusPerformanceEntry   OBJECT-TYPE
              SYNTAX  Ommp82PlusPerformanceEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , ommp82PlusInterfaceNumber}
		::= { ommp82PlusPerformanceTable 1 }
	
	Ommp82PlusPerformanceEntry ::= 
		SEQUENCE {
				ommp82PlusXfpInputPower							DisplayString,
				ommp82PlusXfpOutputPower						DisplayString,
				ommp82PlusXfpBiasCurrent						DisplayString,
				ommp82PlusXfpSupplyVoltage						DisplayString,
				ommp82PlusXfpTemperature						DisplayString,
				ommp82PlusSfpInputPower							DisplayString,
				ommp82PlusSfpOutputPower						DisplayString,
				ommp82PlusSfpBiasCurrent						DisplayString,
				ommp82PlusSfpSupplyVoltage						DisplayString,
				ommp82PlusSfpTemperature						DisplayString,
				ommp82PlusOtnFecUncorrectedWords					DisplayString,
				ommp82PlusOtnFecCorrectedBits						DisplayString,
				ommp82PlusOtnFecZerosCorrectedBits					DisplayString,
				ommp82PlusOtnFecOnesCorrectedBits					DisplayString,
				ommp82PlusOtuBitInterleavedParityErrors					DisplayString,
				ommp82PlusOtuIncomingAlignmentErrorSeconds				DisplayString,
				ommp82PlusOtuBackwardErrorIndicationErrorCount				DisplayString,
				ommp82PlusOtuBackwardIncomingAlignmentErrorSeconds			DisplayString,
				ommp82PlusOtuErrorFreeSeconds						DisplayString,
				ommp82PlusOtuErrorSeconds						DisplayString,
				ommp82PlusOtuBackgroundBlockErrors					DisplayString,
				ommp82PlusOtuSevereErrorSeconds						DisplayString,
				ommp82PlusOtuUnavailableSeconds						DisplayString,
				ommp82PlusOtuBackgroundBlockErrorRatio					DisplayString,
				ommp82PlusOtuSevereErrorSecondsErrorRatio				DisplayString,
				ommp82PlusOtuFarEndErrorFreeSeconds					DisplayString,
				ommp82PlusOtuFarEndErrorSeconds						DisplayString,
				ommp82PlusOtuFarEndBackgroundBlockErrors				DisplayString,
				ommp82PlusOtuFarEndSevereErrorSeconds					DisplayString,
				ommp82PlusOtuFarEndUnavailableSeconds					DisplayString,
				ommp82PlusOtuFarEndBackgroundBlockErrorRatio				DisplayString,
				ommp82PlusOtuFarEndSevereErrorSecondsErrorRatio				DisplayString,
				ommp82PlusOtuErrorRatio							DisplayString,
				ommp82PlusOtuBitErrorRate						DisplayString,
				ommp82PlusOtuFramesReceived						DisplayString,
				ommp82PlusOduBitInterleavedParityErrors					DisplayString,
				ommp82PlusOduTcm1BitInterleavedParityErrors				DisplayString,
				ommp82PlusOduTcm2BitInterleavedParityErrors				DisplayString,
				ommp82PlusOduTcm3BitInterleavedParityErrors				DisplayString,
				ommp82PlusOduTcm4BitInterleavedParityErrors				DisplayString,
				ommp82PlusOduTcm5BitInterleavedParityErrors				DisplayString,
				ommp82PlusOduTcm6BitInterleavedParityErrors				DisplayString,
				ommp82PlusOduTcm1IncomingAlignmentErrorSeconds				DisplayString,
				ommp82PlusOduBackwardErrorIndicationErrorCount				DisplayString,
				ommp82PlusOduTcm1BackwardErrorIndicationErrorCount			DisplayString,

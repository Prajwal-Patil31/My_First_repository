	ommp82PlusSfpEepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property sets/gets the SFP EEPROM page, 
			the value represents the SFP EEPROM page number.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 101 }

	ommp82PlusCheckCodeOfSfpEepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides the SFP
			check code(checksum) value for bytes 128 to 190
			present in SFP EEPROM Page number 1. 
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 102 }

	ommp82PlusExtendedCheckCodeOfSfpEepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides the SFP
			extended check code(checksum) value for bytes 192 to 222
			present in SFP EEPROM Page number 1. 
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 103 }

	ommp82PlusSfpVendorName OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides Vendor Name for given SFP. 
			The vendor name shall be the full name of the 
			corporation, a commonly accepted abbreviation of 
			the name of the corporation, the SCSI company code
			for the corporation, or the stock exchange code for
			the corporation.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:			
			eg: WTD
			-----------------------------"

		::= { ommp82PlusCardGeneralDetailsEntry 104 }

	ommp82PlusSfpVendorIeeeId OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the IEEE company Identifier for
			the vendor of SFP. A value of all zero in the 3-byte
			field indicates that the Vendor OUI is unspecified.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:			
			eg: 010
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 105 }

	ommp82PlusSfpPartNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the vendor part number or
			product name of the SFP. A value of all zero
			indicates that the vendor Part Number is unspecified.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:			
			eg: WXTR15101000427
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 106 }

	ommp82PlusSfpSerialNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides vendor serial number defining
			the vendor’s serial number for the SFP. A value of all
			zero in the 16-byte field indicates that the vendor
			serial number is unspecified.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:			
			eg: WXTRRPGEAS1
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 107 }

	ommp82PlusSfpRevisionNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"The vendor revision number defining the vendor’s
			product revision number. A value of all zero indicates
			that the vendor revision number is unspecified
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:			
			eg: RT
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 108 }

	ommp82PlusSfpManufacturingDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the manufacturing date for 
			SFP. A value of 8-byte field in ASCII which represents
			year, month and date of each two bytes. 
			Extra two bytes may be blank
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:			
			eg: 160224
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 109 }

	ommp82PlusFixedSfpLaserWavelength OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides transmitter LASER wavelength(nm)
			of the SFP
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:			
			eg: 1310.0
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 110 }

	ommp82PlusSfpConnectorType OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides information of the SFP
			connector, value indicates the external connector
			provided on the SFP.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			00h 	Unknown or unspecified
			01h 	SC (Subscriber Connector)
			02h 	Fibre Channel Style 1 copper connector
			03h 	Fibre Channel Style 2 copper connector
			04h 	BNC/TNC (Bayonet/Threaded Neill-Concelman)
			05h 	Fibre Channel coax headers
			06h 	Fiber Jack
			07h 	LC (Lucent Connector)
			08h 	MT-RJ (Mechanical Transfer - Registered Jack)
			09h 	MU (Multiple Optical)
			0Ah 	SG
			0Bh 	Optical Pigtail
			0Ch 	MPO 1x12 (Multifiber Parallel Optic)
			0Dh 	MPO 2x16
			0E-1Fh 	Reserved
			20h 	HSSDC II (High Speed Serial Data Connector)
			21h 	Copper pigtail
			22h 	RJ45 (Registered Jack)
			23h 	No separable connector
			24h 	MXC 2x16
			25h-7Fh Reserved
			80h-FFh Vendor specific
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 111 }

	ommp82PlusSfpLinkLength OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides link length suported by the SFP
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			eg: 80.00
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 112 }

	ommp82PlusSfpSignalEncodingTypeSupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property indicates the serial encoding mechanisms
			that are supported by the SFP.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			1 - 64B/66B
			2 - 8B10B
			3 - SONET Scrambled
			4 - NRZ
			5 - RZ
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 113 }

	ommp82PlusSfpTransceiverCodesSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"The identifier value specifies which transceiver
			codes are supported by the SFP
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:

			Return value 8-Byte represetation:
				  			 Byte-1	 Byte-2	 Byte-3	 Byte-4	 Byte-5  Byte-6  Byte-7	Byte-8
			100-M5-SN-I and 100-M6-SN-I	 0x00	 0x00   0x00	 0x00	 0x20    0x40    0x0C   0x01
			200-SM-LC-L and 100-SM-LC-L	 0x00	 0x00	 0x00	 0x00	 0x12	 0x00    0x01	0x05
			400-M5-SN-I and 400-M6-SN-I	 0x00	 0x00	 0x00	 0x00	 0x20    0x40    0x0C   0x15
			800-M5-SN-I and 800-M6-SN-I	 0x00	 0x00	 0x00	 0x00	 0x20    0x40    0x0C   0x54
			400-SM-LC-M	 		 0x00	 0x00	 0x00	 0x00	 0x0A    0x00    0x01   0x15
			400-SM-LC-L	 		 0x00	 0x00	 0x00	 0x00	 0x12    0x00    0x01   0x15
			200-SM-LL-V and 100-SM-LL-V	 0x00	 0x00	 0x00	 0x00	 0x80    0x10    0x01   0x05
			1000BASE-T	 		 0x00	 0x00	 0x00	 0x08    0x00    0x00    0x00   0x00
			1000BASE-SX	 		 0x00	 0x00	 0x00	 0x01    0x00    0x00    0x00   0x00
			1000BASE-LX	 		 0x00	 0x00	 0x00	 0x02    0x00    0x00    0x00   0x00
			1000BASE-LX10	 		 0x00	 0x00	 0x00	 0x02    0x00    0x00    0x00   0x00
			10GBASE-SR	 		 0x10h	 0x00	 0x00    0x00	 0x00	 0x00    0x00	0x00
			10GBASE-LR	 		 0x20h	 0x00	 0x00    0x00	 0x00	 0x00    0x00	0x00
			OC3/STM1 SR-1	 		 0x00	 0x00	 0x01h   0x00	 0x00	 0x00    0x00	0x00
			OC12/STM4 LR-1	 		 0x00	 0x10h	 0x40h   0x00	 0x00	 0x00    0x00	0x00
			OC48/STM16 LR-2	 		 0x00	 0x0Ch	 0x00    0x00	 0x00	 0x00    0x00	0x00
			10GE Passive copper cable	 0x00	 0x00	 0x00    0x00	 0x00	 0x04h   0x00	0x00
			10GE Active cable		 0x00	 0x00	 0x00    0x00	 0x00	 0x08h   0x00	0x00
			8/4/2G Passive copper cable	 0x00	 0x00	 0x00    0x00	 0x00	 0x04h   0x00	0x54h
			8/4/2G Active cable		 0x00	 0x00	 0x00    0x00	 0x00	 0x08h   0x00	0x54h
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 114 }


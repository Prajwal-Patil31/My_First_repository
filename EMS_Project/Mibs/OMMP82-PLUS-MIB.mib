--*****************************************************************************
--			MIB FILE FOR THE OMMP82-PLUS CARD
--*****************************************************************************

OMMP82-PLUS-MIB DEFINITIONS ::= BEGIN
 
          IMPORTS
        	
		RowStatus      			FROM STANDARD-MIB
			
		DisplayString  			FROM RFC1213-MIB       
    	
    		OBJECT-IDENTITY,
    		NOTIFICATION-TYPE,
    		MODULE-IDENTITY,
    		Integer32,
    		Unsigned32,
    		IpAddress,
    		TimeTicks			FROM SNMPv2-SMI
	 
	 	OBJECT-TYPE    			FROM RFC-1212
	 		
		MODULE-COMPLIANCE,
		OBJECT-GROUP,
		NOTIFICATION-GROUP		FROM SNMPv2-CONF
	
		node,
		rack,
		subRack,
		slot				FROM SCC-MIB
    
		enterprises			FROM RFC1155-SMI
	;

 

	utl   MODULE-IDENTITY
            LAST-UPDATED    	"1807130630Z"
            ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
            CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
            DESCRIPTION     	"MIB module for UTL 40/80 channel DWDM."
            REVISION 	    	"1807130630Z"
            DESCRIPTION    	"MIB module for OMMP82-PLUS Card."
            ::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
            STATUS  current
            DESCRIPTION "UTL Research and Development."
            ::= { utl 1 }

	dwdm 	OBJECT IDENTIFIER				::=	{ utlrnd 1 }
	indus 	OBJECT IDENTIFIER				::=	{ dwdm 1 }
	ommp82Plus 	OBJECT IDENTIFIER 			::=	{ indus 87 }

	ommp82PlusCardGeneralDetails OBJECT IDENTIFIER		::=	{ ommp82Plus 1 }
	ommp82PlusConfiguration OBJECT IDENTIFIER 		::=	{ ommp82Plus 2 }
	ommp82PlusAlarm OBJECT IDENTIFIER 			::=	{ ommp82Plus 3 }
	ommp82PlusPerformance OBJECT IDENTIFIER 		::=	{ ommp82Plus 4 }
	ommp82PlusDiagnostics OBJECT IDENTIFIER 		::=	{ ommp82Plus 5 }

	ommp82PlusAlarmQuery OBJECT IDENTIFIER			::=	{ ommp82PlusAlarm 1 }
	ommp82PlusAlarmNotification OBJECT IDENTIFIER		::=	{ ommp82PlusAlarm 2 }

--******************************************************************************
--				CARD GENERAL DETAILS
--******************************************************************************

	ommp82PlusCardGeneralDetailsTable OBJECT-TYPE
		SYNTAX  SEQUENCE OF Ommp82PlusCardGeneralDetailsEntry 
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
                     "Contains card general details' queries for the OMMP82-PLUS card"
		::= { ommp82PlusCardGeneralDetails 1 }

	ommp82PlusCardGeneralDetailsEntry  OBJECT-TYPE
		SYNTAX  Ommp82PlusCardGeneralDetailsEntry 
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION 
              	""
		INDEX   { node, rack, subRack, slot, ommp82PlusInterfaceNumber }
		::= { ommp82PlusCardGeneralDetailsTable 1 }

	Ommp82PlusCardGeneralDetailsEntry  ::= 
		SEQUENCE {
				ommp82PlusInterfaceNumber					INTEGER,
				ommp82PlusEepromCardId					        INTEGER,
				ommp82PlusEepromCardName					DisplayString,
				ommp82PlusEepromPartCode					DisplayString,
				ommp82PlusEepromCardSerialNumber				DisplayString,
				ommp82PlusEepromHardwareExternalReleaseVersion		        DisplayString,
				ommp82PlusSoftwareExternalReleaseVersion		        DisplayString,
				ommp82PlusEepromHardwareInternalReleaseVersion		        DisplayString,
				ommp82PlusSoftwareInternalReleaseVersion		        DisplayString,
				ommp82PlusEepromCardUidNumber			                DisplayString,
				ommp82PlusEepromCardEui48Number				        DisplayString,
				ommp82PlusEepromCardEui64Number				        DisplayString,
				ommp82PlusCardRootFileSystemVersion				DisplayString,
				ommp82PlusCardInstallationDate				        DisplayString,
				ommp82PlusCardCommissionDate				        DisplayString,
				ommp82PlusCardRunningTime					DisplayString,
				ommp82PlusCardRestartCount					INTEGER,
				ommp82PlusXfpReadyForOperation				        INTEGER,
				ommp82PlusXfpI2cCommunicationStatus				INTEGER,
				ommp82PlusXfpEepromPage					        INTEGER,
				ommp82PlusCheckCodeOfXfpEepromPage				INTEGER,
				ommp82PlusExtendedCheckCodeOfXfpEepromPage			INTEGER,
				ommp82PlusXfpVendorName					        DisplayString,
				ommp82PlusXfpVendorIeeeId					DisplayString,
				ommp82PlusXfpPartNumber					        DisplayString,
				ommp82PlusXfpSerialNumber					DisplayString,
				ommp82PlusXfpRevisionNumber					DisplayString,
				ommp82PlusXfpManufacturingDate				        DisplayString,
				ommp82PlusFixedXfpLaserWavelength				DisplayString,
				ommp82PlusXfpLaserWavelengthTolerance				DisplayString,
				ommp82PlusXfpWavelengthTunabilitySupported			INTEGER,
				ommp82PlusTunableXfpLaserWavelengthError			DisplayString,
				ommp82PlusTunableXfpLaserFrequencyError			        DisplayString,
				ommp82PlusTunableXfpLaserFirstFrequency			        DisplayString,
				ommp82PlusTunableXfpLaserLastFrequency			        DisplayString,
				ommp82PlusTunableXfpWavelengthGridSpacing			DisplayString,
				ommp82PlusXfpConnectorType					DisplayString,
				ommp82PlusXfpLinkLength					        DisplayString,
				ommp82PlusXfpCdrRateSupported				        INTEGER,
				ommp82PlusXfpSignalEncodingTypeSupported			INTEGER,
				ommp82PlusXfpTransceiverCodesSupported			        DisplayString,
				ommp82PlusXfpMaximumBitrateSupported			        DisplayString,
				ommp82PlusXfpMinimumBitrateSupported			        DisplayString,
				ommp82PlusXfpMaximumCaseTemperatureSupported		        INTEGER,
				ommp82PlusXfpMaximumPowerDissipationSupported			INTEGER,
				ommp82PlusXfpMaximumPowerDissipationSupportedAtPowerDownMode	INTEGER,
				ommp82PlusXfpMaximumCurrentLimitSupportedAtPlus5vSupply		INTEGER,
				ommp82PlusXfpMaximumCurrentLimitSupportedAtPlus3Point3vSupply	INTEGER,
				ommp82PlusXfpMaximumCurrentLimitSupportedAtPlus1Point8vSupply	INTEGER,
				ommp82PlusXfpMaximumCurrentLimitSupportedAtMinus5Point2vSupply	INTEGER,
				ommp82PlusXfpLineLoopbackSupported				INTEGER,
				ommp82PlusXfpXfiLoopbackSupported				INTEGER,
				ommp82PlusXfpOptionalVpsSupported				INTEGER,
				ommp82PlusXfpLaserDisableThroughI2cSupported			INTEGER,
				ommp82PlusXfpPowerDownThroughI2cSupported			INTEGER,
				ommp82PlusXfpVpsLvRegulatorModeSupported			INTEGER,
				ommp82PlusXfpVpsBypassedRegulatorModeSupported			INTEGER,
				ommp82PlusXfpActiveFecControlSupported				INTEGER,
				ommp82PlusXfpOptionalCmuModeSupported				INTEGER,
				ommp82PlusXfpFecBerSupported					INTEGER,
				ommp82PlusXfpReceivePowerMeasurementIsInOmaOrAverage		INTEGER,
				ommp82PlusXfpActiveWavelengthControlSupported			INTEGER,
				ommp82PlusXfpTransmitterIsCooledOrUncooled			INTEGER,
				ommp82PlusXfpReceiverTypeIsPinOrApd                             INTEGER,
				ommp82PlusSfpEepromPage						INTEGER,
				ommp82PlusCheckCodeOfSfpEepromPage				INTEGER,
				ommp82PlusExtendedCheckCodeOfSfpEepromPage			INTEGER,
				ommp82PlusSfpVendorName						DisplayString,
				ommp82PlusSfpVendorIeeeId					DisplayString,
				ommp82PlusSfpPartNumber						DisplayString,
				ommp82PlusSfpSerialNumber					DisplayString,
				ommp82PlusSfpRevisionNumber					DisplayString,
				ommp82PlusSfpManufacturingDate					DisplayString,
				ommp82PlusFixedSfpLaserWavelength				DisplayString,
				ommp82PlusSfpConnectorType					DisplayString,
				ommp82PlusSfpLinkLength						DisplayString,
				ommp82PlusSfpSignalEncodingTypeSupported			INTEGER,
				ommp82PlusSfpTransceiverCodesSupported				DisplayString,
				ommp82PlusSfpMaximumBitrateSupported				DisplayString,
				ommp82PlusSfpNominalBitrateSupported				DisplayString,
				ommp82PlusSfpMinimumBitrateSupported				DisplayString,
				ommp82PlusCardGeneralDetailsTableRowStatus			RowStatus
			 }
	

	ommp82PlusInterfaceNumber OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
			"Interface number represents the port number.
			InterfaceNumber to port mapping is as follows:
			1 - CLIENT-1,
			2 - CLIENT-2,
			3 - CLIENT-3,
			4 - CLIENT-4,
			5 - CLIENT-5,
			6 - CLIENT-6,
			7 - CLIENT-7,
			8 - CLIENT-8,
			9 - LINE-1(Primary),
			10 - LINE-2(Secondary)
			-----------------------------
			Values of the demultiplexing properties can be accessed
			with respect to slice number.  In such cases the
			InterfaceNumber will represent the slice number.
			1 - Slice-1
			2 - Slice-2
			3 - Slice-3
			4 - Slice-4
			-----------------------------
			For properties which do not apply on any interface,
			the interface number must be passed as 0
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 1 }
	
	ommp82PlusEepromCardId OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the card ID of the OMMP82-PLUS card, present in the EEPROM
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 2 }

	ommp82PlusEepromCardName OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the card name of the OMMP82-PLUS card, present in the EEPROM
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 3 }

	ommp82PlusEepromPartCode OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the part code of the OMMP82-PLUS card, present in the EEPROM
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 4 }

	ommp82PlusEepromCardSerialNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property get / set the information about 
			OMMP82-PLUS Card's Serial Number.
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 123456
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 5 }

	ommp82PlusEepromHardwareExternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Hardware External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are significant
			architectural changes in the product
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Value:
			eg: 0.1
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 6 }

	ommp82PlusSoftwareExternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are
			significant architectural changes in the product
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Value:
			eg: 0.1
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 7 }

	ommp82PlusEepromHardwareInternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Hardware Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external hardware version.
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Value:
			eg: 4.1
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 8 }

	ommp82PlusSoftwareInternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external software version.
		      	-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Value:
			eg: 5.1
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 9 }

	ommp82PlusEepromCardUidNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card Unique IDentifier. It is a 4 byte
			address used to uniquely identify a card.
			----------------------------
			ommp82PlusInterfaceNumber: 0
			------------------------------
			Value:
		      	eg: 12345678
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 10 }

	ommp82PlusEepromCardEui48Number OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-48 Number. It is a 6 byte address
			used to uniquely identify a card.
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 0004A3123456
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 11 }

	ommp82PlusEepromCardEui64Number OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-64 Number. It is a 8 byte address
			used to uniquely identify a card.
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 0004A31234567890
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 12 }
		
        ommp82PlusCardRootFileSystemVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card's Root File System Version
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 8
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 13 }

	ommp82PlusCardInstallationDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Gets the card's installation date in
			dd/mm/yyyy format
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 12/03/2016
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 21 }

	ommp82PlusCardCommissionDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Gets the card's commission date in
			dd/mm/yyyy format
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 20/03/2016
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 22 }

	ommp82PlusCardRunningTime OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Get the duration of time for which the card is
			operational/running
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 4d:3h:2m:1s
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 23 }

	ommp82PlusCardRestartCount OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Get the number of times the card has been soft reset.
			This value will get reset to 0 on factory reset.
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 10
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 24 }

	ommp82PlusXfpReadyForOperation OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Module not ready indicates that the XFP
			has detected a condition that tells
			transmit or receive data is invalid.
			It shall consist of logical OR of the
			following signals:
			> Transmit Signal Conditioner Loss of Lock
			> Transmitter Laser Fault
			> Receiver Signal Conditioner Loss of Lock
			(Ref: INF-8077 2.4.1)
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:		
			1 - XFP is ready for operation 
			0 - XFP is not ready for operation
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 31 }

	ommp82PlusXfpI2cCommunicationStatus OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Tells whether the XFP can be accessed
			on a single 2-wire interface bus or not.
			(Ref: INF-8077 2.4.2)
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			1 - Enable I2C communication for XFP
				i.e. the XFP responds to 2-wire serial
				communication commands.
			0 - Disable I2C communication for XFP
				i.e. the XFP will not respond to or
				acknowledge any 2-wire interface communication
				from the host.
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 32 }

	ommp82PlusXfpEepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property sets/gets the XFP EEPROM page, 
			the value represents the XFP EEPROM page number.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 33 }

	ommp82PlusCheckCodeOfXfpEepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides the XFP
			check code(checksum) value for bytes 128 to 190
			present in XFP EEPROM Page number 1. 
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 34 }

	ommp82PlusExtendedCheckCodeOfXfpEepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides the XFP
			extended check code(checksum) value for bytes 192 to 222
			present in XFP EEPROM Page number 1. 
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 35 }

	ommp82PlusXfpVendorName OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides Vendor Name for given XFP. 
			The vendor name shall be the full name of the 
			corporation, a commonly accepted abbreviation of 
			the name of the corporation, the SCSI company code
			for the corporation, or the stock exchange code for
			the corporation.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: WTD
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 36 }

	ommp82PlusXfpVendorIeeeId OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the IEEE company Identifier for
			the vendor of XFP. A value of all zero in the 3-byte
			field indicates that the Vendor OUI is unspecified.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: 010
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 37 }

	ommp82PlusXfpPartNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the vendor part number or
			product name of the XFP. A value of all zero
			indicates that the vendor Part Number is unspecified.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: FTRX-1811-2D2
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 38 }

	ommp82PlusXfpSerialNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides vendor serial number defining
			the vendor’s serial number for the XFP. A value of all
			zero in the 16-byte field indicates that the vendor
			serial number is unspecified.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: KBG02CU
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 39 }

	ommp82PlusXfpRevisionNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"The vendor revision number defining the vendor’s
			product revision number. A value of all zero indicates
			that the vendor revision number is unspecified
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: RT
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 40 }

	ommp82PlusXfpManufacturingDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the manufacturing date for 
			XFP. A value of 8-byte field in ASCII which represents
			year, month and date of each two bytes. 
			Extra two bytes may be blank
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: 160224
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 41 }

	ommp82PlusFixedXfpLaserWavelength OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides transmitter LASER wavelength(nm)
			of the XFP
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: 1310
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 42 }

	ommp82PlusXfpLaserWavelengthTolerance OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides XFP wavelength tolerance in GhZ
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: 0.02
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 43 }

	ommp82PlusXfpWavelengthTunabilitySupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides information whether the XFP
			supports wavelength tunability or not.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			1 - XFP supports wavelength tunability
			0 - XFP does not supports wavelength tunability
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 44 }

	ommp82PlusTunableXfpLaserWavelengthError OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides wavelength error in picometer(pm)
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: 0.02
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 45 }

	ommp82PlusTunableXfpLaserFrequencyError OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides frequency error in Ghz.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: 0.03
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 46 }

	ommp82PlusTunableXfpLaserFirstFrequency OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the first LASER frequency of XFP.
			The two byte value is specified in units of THz.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: 1529.45
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 47 }

	ommp82PlusTunableXfpLaserLastFrequency OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the last laser frequency of XFP.
		 	 The two byte value is specified in units of THz.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:			
			eg: 1563.45
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 48 }

	ommp82PlusTunableXfpWavelengthGridSpacing OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property gives difference in the wavelength
			between two channels In GHz.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:
			eg: 50
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 49 }

	ommp82PlusXfpConnectorType OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides information of the XFP
			connector, value indicates the external connector
			provided on the XFP.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:
			00h 	Unknown or unspecified
			01h 	SC
			02h 	Fibre Channel Style 1 copper connector
			03h 	Fibre Channel Style 2 copper connector
			04h 	BNC/TNC
			05h 	Fibre Channel coaxial headers
			06h 	FiberJack
			07h 	LC
			08h 	MT-RJ
			09h 	MU
			0Ah 	SG
			0Bh 	Optical pigtail
			0C-1Fh 	Reserved
			20h 	HSSDC II
			21h 	Copper Pigtail
			22h-7Fh Reserved
			80-FFh 	Vendor specific
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 50 }

	ommp82PlusXfpLinkLength OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides link length suported by the XFP
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:
			eg: 80.00
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 51 }

	ommp82PlusXfpCdrRateSupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property indicates which rates are supported by
			the CDR present in XFP.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:
			Return value 1-Byte represetation:
			Byte-1  CDR Rates
			Bit-7	9.95 Gb/s
			Bit-6	10.3 Gb/s
			Bit-5	10.5 Gb/s
			Bit-4	10.7 Gb/s
			Bit-3	11.1 Gb/s
			Bit-2	Reserved
			Bit-1	Dont care for this property
			Bit-0	Dont care for this property
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 52 }

	ommp82PlusXfpSignalEncodingTypeSupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property indicates the serial encoding mechanisms
			that are supported by the XFP.
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:
			Return value 1-Byte represetation:
			Byte-1  Encoding Type
			Bit-7	64B/66B          
			Bit-6	8B10B     	 	 
			Bit-5	SONET Scrambled  
			Bit-4	NRZ              
			Bit-3	RZ              
			Bit-2	Reserved        
			Bit-1	Reserved         
			Bit-0	Reserved 
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 53 }

	ommp82PlusXfpTransceiverCodesSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"The identifier value specifies which transceiver
			codes are supported by the XFP
			-----------------------------
			ommp82PlusInterfaceNumber:
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:
			Return value 8-Byte represetation:
			---------------------------------------------------------------------------------------------------------------------------------------
				  Byte-1	  Byte-2	          Byte-3	  Byte-4	          Byte-5    Byte-6    Byte-7	        Byte-8
			---------------------------------------------------------------------------------------------------------------------------------------
			Bit-7	 10GBASE-SR	 1200-MX-SN-I        	 Reserved	 1000BASE-SX/1xFC MMF	 I-64.1r   S-64.1    L-64.1	       V-64.2a
			Bit-6	 10GBASE-LR	 1200-SM-LL-L	         Reserved	 1000BASE-LX/1xFC-SMF	 I-64.1	   S-64.2a   L-64.2a	       V-64.2b
			Bit-5	 10GBASE-ER	 Extended 1550 nm	 Reserved	 2xFC-MMF/2xFC-SMF	 I-64.2r   S-64.2b   L-64.2b	       V-64.3
			Bit-4	 10GBASE-LRM	 Intermediate 1300 nm	 Reserved	 OC-48-SR	         I-64.2	   S-64.3a   L-64.2c	       Reserved
			Bit-3	 10GBASE-SW	 Reserved	         Reserved	 OC-48-IR	         I-64.3	   S-64.3b   L-64.3	       Reserved
			Bit-2	 10GBASE-LW	 Reserved	         Reserved	 OC-48-LR	         I-64.5	   S-64.5a   G.959.1 P1L1-2D2  Reserved
			Bit-1	 10GBASE-EW	 Reserved	         Reserved	 Reserved	         Reserved  S-64.5b   Reserved	       Reserved
			Bit-0	 Reserved	 Reserved	         Reserved	 Reserved	         Reserved  Reserved  Reserved	       Reserved
			-----------------------------"
		::= { ommp82PlusCardGeneralDetailsEntry 54 }

	ommp82PlusXfpMaximumBitrateSupported OBJECT-TYPE		 

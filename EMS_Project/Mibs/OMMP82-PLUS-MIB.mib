	ommp82PlusOtuErrorRatio   OBJECT-TYPE
              SYNTAX  DisplayString
              MAX-ACCESS  read-only
              STATUS  current
              DESCRIPTION
			"For port configured with OTU2/OTU1 traffic,
			gives the OTU Error Ratio for requested port. The ratio  
			of number of error bits to the number of bits received in
			a particular second
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			10 - LINE-2
			-----------------------------	
			Value:
			eg: 4.0
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 65 } 

	ommp82PlusOtuBitErrorRate  OBJECT-TYPE
              SYNTAX  DisplayString
              MAX-ACCESS  read-only
              STATUS  current
              DESCRIPTION
			"For port configured with OTU2/OTU1 traffic, gives the 
			Bit Error Rate. Bit error rate is the Error ratio 
			multiplied by the OTU2 standard signal 
			data-rate( 10.709225316 Gbps )
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			10 - LINE-2
			-----------------------------	

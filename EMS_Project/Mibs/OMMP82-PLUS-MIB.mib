			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 48 }


			9 - LINE-1
			10 - LINE-2
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 47 }

	ommp82PlusOtuBackwardIncomingAlignmentErrorSeconds OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2/OTU1 traffic,
			OTU-BIAE Counter increases when SM-BIAE Alarm is 

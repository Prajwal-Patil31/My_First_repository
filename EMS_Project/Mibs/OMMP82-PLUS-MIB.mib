--*****************************************************************************
--				    ALARMS
--*****************************************************************************
                 
	ommp82PlusAlarmQueryTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Ommp82PlusAlarmQueryEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Gives Optical Alarms status of the OMMP82-PLUS card"
		::= { ommp82PlusAlarmQuery 1 }	

	ommp82PlusAlarmQueryEntry   OBJECT-TYPE
              SYNTAX  Ommp82PlusAlarmQueryEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , ommp82PlusInterfaceNumber }
		::= { ommp82PlusAlarmQueryTable 1 }
	
	Ommp82PlusAlarmQueryEntry ::= 
			SEQUENCE {					
					ommp82PlusXfpInputPowerFailureAlarm					DisplayString,
					ommp82PlusXfpOutputPowerFailureAlarm					DisplayString,
					ommp82PlusXfpHighTemperatureAlarm					DisplayString,
					ommp82PlusXfpLowTemperatureAlarm					DisplayString,
					ommp82PlusXfpHighTemperatureWarning					DisplayString,
					ommp82PlusXfpLowTemperatureWarning					DisplayString,
					ommp82PlusXfpHighBiasCurrentAlarm					DisplayString,
					ommp82PlusXfpLowBiasCurrentAlarm					DisplayString,
					ommp82PlusXfpHighBiasCurrentWarning					DisplayString,
					ommp82PlusXfpLowBiasCurrentWarning					DisplayString,
					ommp82PlusXfpInputHighPowerAlarm					DisplayString,
					ommp82PlusXfpInputLowPowerAlarm						DisplayString,
					ommp82PlusXfpInputHighPowerWarning					DisplayString,
					ommp82PlusXfpInputLowPowerWarning					DisplayString,
					ommp82PlusXfpOutputHighPowerAlarm					DisplayString,
					ommp82PlusXfpOutputLowPowerAlarm					DisplayString,
					ommp82PlusXfpOutputHighPowerWarning					DisplayString,
					ommp82PlusXfpOutputLowPowerWarning					DisplayString,
					ommp82PlusXfpHighSupplyVoltageAlarm					DisplayString,
					ommp82PlusXfpLowSupplyVoltageAlarm					DisplayString,
					ommp82PlusXfpHighSupplyVoltageWarning					DisplayString,
					ommp82PlusXfpLowSupplyVoltageWarning					DisplayString,
					ommp82PlusXfpPresenceAbsenceNotification				DisplayString,
					ommp82PlusSfpInputPowerFailureAlarm					DisplayString,
					ommp82PlusSfpOutputPowerFailureAlarm					DisplayString,
					ommp82PlusSfpHighTemperatureAlarm					DisplayString,
					ommp82PlusSfpLowTemperatureAlarm					DisplayString,
					ommp82PlusSfpHighTemperatureWarning					DisplayString,
					ommp82PlusSfpLowTemperatureWarning					DisplayString,
					ommp82PlusSfpHighBiasCurrentAlarm					DisplayString,
					ommp82PlusSfpLowBiasCurrentAlarm					DisplayString,
					ommp82PlusSfpHighBiasCurrentWarning					DisplayString,
					ommp82PlusSfpLowBiasCurrentWarning					DisplayString,
					ommp82PlusSfpInputHighPowerAlarm					DisplayString,
					ommp82PlusSfpInputLowPowerAlarm						DisplayString,
					ommp82PlusSfpInputHighPowerWarning					DisplayString,
					ommp82PlusSfpInputLowPowerWarning					DisplayString,
					ommp82PlusSfpOutputHighPowerAlarm					DisplayString,
					ommp82PlusSfpOutputLowPowerAlarm					DisplayString,
					ommp82PlusSfpOutputHighPowerWarning					DisplayString,

		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with FC-100/FC-200 traffic,
			gives the count of total packets that are tranmsitted.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 213 }

	ommp82PlusFcReceiveTotalPackets OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with FC-100/FC-200 traffic,
			gives the count of total packets that are received.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 214 }

	ommp82PlusFcTransmitBadCrc OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with FC-100/FC-200 traffic,
			gives the count of bad CRCs that are tranmsitted.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 215 }

	ommp82PlusFcReceiveBadCrc OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with FC-100/FC-200 traffic,
			gives the frame count of that
			had CRC32 mismatch, invalid/abort end-of-frame or
			line code violations.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 216 }

	ommp82PlusFcTransmitLcvCount OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with FC-100/FC-200 traffic,
			reports the number of 8B/10B line-code violations
			(invalid characters or incorrect running
			disparity) that occurred on the data from upstream
			block.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 217 }

	ommp82PlusFcReceiveLcvCount OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with FC-100/FC-200 traffic,
			reports the number of 8B/10B line-code violations
			(invalid characters or incorrect running disparity) that
			occurred on the data from line interface.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 218 }

	ommp82PlusFcTransmitFillWordInsertionCount OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with FC-100/FC-200 traffic,
			gives the count of FW Insertion count. It
			reports number of fill words that were inserted
			for rate adaptation. For fibre channel, each increment
			indicates the number of 4-character IDLE
			(or ARBs - when enabled) ordered set that were inserted.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 219 }

	ommp82PlusFcTransmitPrimitiveSequenceInsertionCount OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with FC-100/FC-200 traffic,
			gives the count of Primitive Sequence Insertions. It
			reports number of primitive sequences or sequence
			functions that were inserted for rate adaptation.
			For fibre channel, each increment indicates the number
			of 4-character Primitive Sequences that
			were inserted.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 220 }

	ommp82PlusFcTransmitFillWordDeletionCount OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with FC-100/FC-200 traffic,
			gives the count of number of fill words that were
			deleted for rate adaptation.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 221 }

	ommp82PlusFcTransmitPrimitiveSequenceDeletionCount OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with FC-100/FC-200 traffic,
			reports number of Primitive Signals or Sequence
			Functions that were deleted for rate adaptation.
			For fibre channel, each increment indicates the
			number of 4-character Primitive Sequences that were
			deleted.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp82PlusPerformanceEntry 222 }

	ommp82PlusPerformanceTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
			"*****************************
			This is MIB realted property,
			NOT to be considered as a card property
			*****************************"
              ::= { ommp82PlusPerformanceEntry 223 }
              
--*****************************************************************************
--				    DIAGNOSTICS
--*****************************************************************************        

	ommp82PlusDiagnosticsTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Ommp82PlusDiagnosticsEntry
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Category contains properties that are used for debugging
                      card software"
		::= { ommp82PlusDiagnostics 1 }	

	ommp82PlusDiagnosticsEntry   OBJECT-TYPE
              SYNTAX  Ommp82PlusDiagnosticsEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , ommp82PlusInterfaceNumber }
		::= { ommp82PlusDiagnosticsTable 1 }
	
	Ommp82PlusDiagnosticsEntry ::= 
		SEQUENCE {
				ommp82PlusAccessHyphyRegister			INTEGER,
				ommp82PlusCnodeCrashCount			INTEGER,
				ommp82PlusKernelState				DisplayString,
				ommp82PlusDiagnosticTableRowStatus		RowStatus
			}
			
	ommp82PlusAccessHyphyRegister OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
			"Sets/gets the value of any hyphy register
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg:
			example of hyphy register - 76071076
			value - 1
			-----------------------------"
	::= { ommp82PlusDiagnosticsEntry 1 }

	ommp82PlusCnodeCrashCount OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gets the count of number of times the hyphy_cnode has
			crashed
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Values: 
			eg: 0, 1, 4, 7 etc.
			-----------------------------"
	::= { ommp82PlusDiagnosticsEntry 2 }

	ommp82PlusKernelState OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gets the state of the kernel
			-----------------------------
			ommp82PlusInterfaceNumber: 0
			-----------------------------
			Values:
			non-tainted - kernel is working fine
			tainted - kernel panic has occured
			-----------------------------"
	::= { ommp82PlusDiagnosticsEntry 3 }
	
	ommp82PlusDiagnosticTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
			"*****************************
			This is MIB realted property,
			NOT to be considered as a card property
			*****************************"
	::= { ommp82PlusDiagnosticsEntry 4 }

--*****************************************************************************

--*****************************************************************************


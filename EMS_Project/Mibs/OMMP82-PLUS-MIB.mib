              SYNTAX  DisplayString
              MAX-ACCESS  read-only
              STATUS  current
              DESCRIPTION
			"For port configured with 
			GE-GFP-F/GE-GFP-T traffic,
			if auto-negotiation is failed to establish between 
			link-partners, this alarm will get generated
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values :
			If Alarm is Present - Date and Time Stamp
				    eg:2017-5-18,9:47:20.0,+5:30
			If Alarm is Absent  - 0
			-----------------------------"
		::= { ommp82PlusAlarmQueryEntry 174 }

	ommp82PlusEthernetFrameCheckSequenceAlarm OBJECT-TYPE
              SYNTAX  DisplayString
              MAX-ACCESS  read-only
              STATUS  current
              DESCRIPTION
			"For port configured with 
			GE-GFP-F/FE-GFP-F/GE-GFP-T/FE-GFP-T traffic,
			in the incoming ethernet frame, if the FCS value in the
			FCS byte and the FCS value calculated for the payload
			of the frame doesnt match, then number of FCS errors
			is incremented. If in one second, 50 such FCS errors
			are got, then FCS this alarm will be generated. 
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values :
			If Alarm is Present - Date and Time Stamp
				    eg:2017-5-18,9:47:20.0,+5:30
			If Alarm is Absent  - 0
			-----------------------------"
		::= { ommp82PlusAlarmQueryEntry 175 }

	ommp82PlusEthernetCarrierStatusAlarm OBJECT-TYPE
              SYNTAX  DisplayString
              MAX-ACCESS  read-only
              STATUS  current
              DESCRIPTION
			"For port configured with 
			GE-GFP-F/FE-GFP-F/GE-GFP-T/FE-GFP-T traffic,
			whenever there is an absence of the carrier signal
			i.e. carrier sense loss occurs this alarm is generated.
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values :
			If Alarm is Present - Date and Time Stamp
				    eg:2017-5-18,9:47:20.0,+5:30
			If Alarm is Absent  - 0
			-----------------------------"
		::= { ommp82PlusAlarmQueryEntry 176 }

	ommp82PlusEthernetHighBerAlarm OBJECT-TYPE
              SYNTAX  DisplayString
              MAX-ACCESS  read-only
              STATUS  current
              DESCRIPTION
			"For port configured with 
			GE-GFP-F/FE-GFP-F/GE-GFP-T/FE-GFP-T traffic,
			this alarm is generated when signal BER is
			greater than 1e−4. 
			-----------------------------
			ommp82PlusInterfaceNumber:
			1 to 8 - CLIENT-1 to CLIENT-8
			-----------------------------
			Values :
			If Alarm is Present - Date and Time Stamp
				    eg:2017-5-18,9:47:20.0,+5:30
			If Alarm is Absent  - 0
			-----------------------------"
		::= { ommp82PlusAlarmQueryEntry 177 }


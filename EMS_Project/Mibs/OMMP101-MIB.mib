	ommp101CardSoftwareUpgrade OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Valid only as SET command.
			This property upgrades the software of the OMMP101 card
			It takes the path of the software release as
			a value
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Values:
			eg: /root/home/rel-2.0.0.tar.gz
			-----------------------------"
		::= { ommp101ConfigurationEntry 1 }

	ommp101CardSignalMonitorState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property sets or gets the card's signal
			monitoring state. Disabling card signal monitoring 
			will not provide any signal alarms and performances
			information to the user.
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Values:
			1 - Card Signal Monitoring is enabled
			0 - Card Signal Monitoring is disabled
			-----------------------------"
		::= { ommp101ConfigurationEntry 2 }

	ommp101CardOpticalMonitorState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property sets or gets the card's optical
			monitoring state. Disabling card signal monitoring 
			will not provide any signal alarms and performances
			information to the user.
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Values:
			1 - Card Optical Monitoring is enabled
			0 - Card Optical Monitoring is disabled
			-----------------------------"
		::= { ommp101ConfigurationEntry 3 }

	ommp101CardSoftReset OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Valid only as a SET command.
			Reboots the Card, Reconfigures the Card 
			i.e All Configuration Parameter	like Laser State,
			Traffic configuration, Loopback, FEC, optical and 
			signal thresholds, switching mode,
			user choice of line path, auto-negotiation, 
			TTI messages will be restored to previous state
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Values:
			Dont care, any value
			eg: 0
			-----------------------------"
		::= { ommp101ConfigurationEntry 4 }

	ommp101CardFactoryReset OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Valid only as a SET command.
			Sets the Card To Factory Default State
			i.e All User Configuration Parameters like Laser State,
			Traffic configuration, Loopback, FEC, optical and 
			signal thresholds, switching mode,
			user choice of line path, auto-negotiation, TTI messages
			will be set to default state
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Values:
			Dont care, any value
			eg: 0
			-----------------------------"
		::= { ommp101ConfigurationEntry 5 }

	ommp101SyncSystemTimeWithNtpServer OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			" when we want to manually sync the time value
			present in linux kernel with the NTP server
			we can use this OID. We can provide NTP server
			ip address as a value to this OID and the time
			will be synced to that ilarticular server. 
			If we are not providing NTP server IP address 
			then the system will be synced with the NTP server 
			which is already been registered with card. 
			If both are absent then error message will be returned
			-----------------------------
			Interface : 0
			-----------------------------
			If we want to provide NTP server IP address then
			Value should be a valid IP address as shown below
			: 192.168.21.25
			
			If we don't want to provide NTP server address then no
			need to pass any value. 
			---------------------------"
		::= { ommp101ConfigurationEntry 6 }

	ommp101SyncRtcWithNtpServer OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			" when we want to manually sync the time value
			present in RTC with the NTP server
			we can use this OID. We can provide NTP server
			ip address as a value to this OID and the time
			will be synced to that particular server. 
			If we are not providing NTP server IP address 
			then the system will be synced with the NTP server 
			which is already been registered with card. 
			If both are absent then error message will be returned.
			-----------------------------
			Interface : 0
			-----------------------------
			If we want to provide NTP server IP address then
			Value should be a valid IP address as shown below
			: 192.168.21.25
			
			If we don't want to provide NTP server address, then no
			need to ilass any value. 
			---------------------------"
		::= { ommp101ConfigurationEntry 7 }

	ommp101SyncRtcWithSystemTime OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			" when we want to manually sync the time value
			present in RTC with the time value in linux kernel
			we can use this OID. With this set operation, 
			the time available with linux kernel will be updated
			into RTC. It is not required to provide any value for 
			this operation"
		::= { ommp101ConfigurationEntry 8 }

	ommp101UpdateGivenTimeIntoSystem OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			" when we want to manually update system time
			with the user provided time, we can use this OID.
			With OID we need to provide time value which we
			want to update in the system.
			-----------------------------
			Interface : 0
			-----------------------------
			Value should be of given format:
			YYYY-MM-DD H:M:S
			
			Example: 2017-10-31 15:20:44
			---------------------------"
		::= { ommp101ConfigurationEntry 9 }

	ommp101UpdateGivenTimeIntoRtc OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			" when we want to manually update RTC time
			with the user provided time, we can use this OID.
			With OID we need to provide time value which we
			want to update in RTC.
			-----------------------------
			Interface : 0
			-----------------------------
			Value should be of given format:
			YYYY-MM-DD H:M:S
			
			Example: 2017-10-31 15:20:44
			---------------------------"
		::= { ommp101ConfigurationEntry 10 }

	ommp101SystemTimeAndRtcTime OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			" get the system time and time value present in RTC.
			-----------------------------
			Interface : 0
			-----------------------------"
		::= { ommp101ConfigurationEntry 11 }

	ommp101TrafficConfiguration OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set or get Traffic configuration for all ports
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Value: 
			00 - Un-configure 
			01 - STM64
			02 - LAN10G
			03 - OTU2
			04 - OTU4
			-----------------------------"
		::= { ommp101ConfigurationEntry 12 }

	ommp101LoopbackState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set or get the loopback state for the
			requested port
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values: 
			00 - No Loopback   
			01 - Near End Loopback
			02 - Far End Loopback
			-----------------------------"
		::= { ommp101ConfigurationEntry 13 }

	ommp101PortSignalMonitorState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property sets or gets the port's signal
			monitoring state. Disabling port signal monitoring 
			will not provide any signal alarms and performances
			information to the user.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			1 - Port Signal Monitoring is enabled
			0 - Port Signal Monitoring is disabled
			-----------------------------"
		::= { ommp101ConfigurationEntry 14 }

	ommp101PortOpticalMonitorState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property sets or gets the port's optical
			monitoring state. Disabling port optical monitoring 
			will not provide any optical alarms and performances
			information to the user.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			1 - Port Optical Monitoring is enabled
			0 - Port Optical Monitoring is disabled
			-----------------------------"
		::= { ommp101ConfigurationEntry 15 }

	ommp101ClearSignalPerformance OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Valid only as a SET command.
			Clears signal performance for the requested port
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			Dont care, any value
			eg: 0
			-----------------------------"
		::= { ommp101ConfigurationEntry 16 }

	ommp101AlsState OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set the Automatic Laser Switching(ALS) mode for
			for requested port. Based on the RX LOS state of the
			port, the transmit LASER state will be controlled
			according to the algorithm defined for ALS in
			ITUT 664 Standard
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values: 
			1 - Enable ALS state
			0 - Disable ALS state
			-----------------------------" 
		::= { ommp101ConfigurationEntry 17 }

	ommp101AlsPulseRepetitionTime OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Pulse repetition time is the time for automatic 
			restart of CFP2 LASER once the ALS algorithm starts.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values: 
			100 seconds to 300 seconds
			-----------------------------"
		::= { ommp101ConfigurationEntry 18 }

	ommp101OtuFecConfiguration OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set or Get FEC type for requested port configured with
			 OTU2 traffic.  
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values: 
			00 - Zero FEC 
			01 - Reed-Solomon GFEC
			-----------------------------"
		::= { ommp101ConfigurationEntry 19 }

	ommp101OtuSignalFailThreshold OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set or Get SM Signal Failure 
			Threshold value for the requested port configured with 
			OTU2/OTU4 traffic.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values: 
			03 - 1.E -03
			04 - 1.E -04
			05 - 1.E -05
			-----------------------------" 
		::= { ommp101ConfigurationEntry 20 }

	ommp101OtuSignalDegradeThreshold OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set or Get SM Signal Degrade 
			Threshold value for the requested port configured with 
			OTU2/OTU4 traffic.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			06 - 1.E -06
			07 - 1.E -07
			08 - 1.E -08
			09 - 1.E -09
			10 - 1.E -10(for line only)
			-----------------------------"
		::= { ommp101ConfigurationEntry 21 }

	ommp101OtuSapiTransmitTraceMessage OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set or get the 15 characters SAPI Transmit TTI message
			which is put into the outgoing OTU2 frame. 
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp101ConfigurationEntry 22 }

	ommp101OtuDapiTransmitTraceMessage OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set or get the 15 characters DAPI Transmit TTI message
			which is put into the outgoing OTU2 frame. 
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp101ConfigurationEntry 23 }

	ommp101OtuOperatorSpecificTransmitTraceMessage OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set or get the 32 characters Operator Specific Transmit
			TTI message which is put into the outgoing OTU2
			frame. 
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 12345123451234512345123451234500
			-----------------------------" 
		::= { ommp101ConfigurationEntry 24 }

	ommp101OtuSapiExpectedTraceMessage OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"15 characters SM SAPI Expected TTI message - Message
			set here is used for comparison with the message present
			in SM SAPI field of the incoming OTU2 frames.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp101ConfigurationEntry 25 }

	ommp101OtuDapiExpectedTraceMessage OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"15 characters SM DAPI Expected TTI message - Message
			set here is used for comparison with the message present
			in SM DAPI field of the incoming OTU2 frames.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp101ConfigurationEntry 26 }

	ommp101OtuOperatorSpecificExpectedTraceMessage OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"32 characters SM Operator Specific Expected TTI 
			message - Message set here is used for comparison with 
			the message present in SM Operator Specific field of 
			the incoming OTU2 frames.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 12345123451234512345123451234500
			-----------------------------" 
		::= { ommp101ConfigurationEntry 27 }

	ommp101OduSignalFailThreshold OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set or Get PM Signal Failure 
			Threshold value for the requested port configured with 
			OTU2/OTU4 traffic.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values: 
			03 - 1.E -03
			04 - 1.E -04
			05 - 1.E -05
			-----------------------------" 
		::= { ommp101ConfigurationEntry 28 }

	ommp101OduSignalDegradeThreshold OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set or Get PM Signal Degrade 
			Threshold value for the requested port configured with 
			OTU2/OTU4 traffic.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values: 
			06 - 1.E -06
			07 - 1.E -07
			08 - 1.E -08
			09 - 1.E -09
			10 - 1.E -10(for line only)
			-----------------------------" 
		::= { ommp101ConfigurationEntry 29 }

	ommp101OduSapiTransmitTraceMessage OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set or get the 15 characters SAPI Transmit TTI message
			which is put into the outgoing OTU2
			frame at the PM level. 
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 123451234512345
			-----------------------------" 
		::= { ommp101ConfigurationEntry 30 }

	ommp101OduDapiTransmitTraceMessage OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Set or get the 15 characters DAPI Transmit TTI message
			which is put into the outgoing OTU2
			frame at the PM level. 
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 123451234512345

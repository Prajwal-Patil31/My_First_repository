--*****************************************************************************
--				    ALARMS
--*****************************************************************************
                 
	ommp101AlarmQueryTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Ommp101AlarmQueryEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Gives Optical and Signal Alarms status of the OMMP101 card"
		::= { ommp101AlarmQuery 1 }	

	ommp101AlarmQueryEntry   OBJECT-TYPE
              SYNTAX  Ommp101AlarmQueryEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , ommp101InterfaceNumber }
		::= { ommp101AlarmQueryTable 1 }
	
	Ommp101AlarmQueryEntry ::= 
			SEQUENCE {					
					ommp101Cfp2InputPowerFailureAlarm					DisplayString,
					ommp101Cfp2OutputPowerFailureAlarm					DisplayString,
					ommp101Cfp2HighTemperatureAlarm					DisplayString,
					ommp101Cfp2LowTemperatureAlarm					DisplayString,
					ommp101Cfp2HighTemperatureWarning					DisplayString,
					ommp101Cfp2LowTemperatureWarning					DisplayString,
					ommp101Cfp2InputHighPowerAlarm					DisplayString,
					ommp101Cfp2InputLowPowerAlarm						DisplayString,
					ommp101Cfp2InputHighPowerWarning					DisplayString,
					ommp101Cfp2InputLowPowerWarning					DisplayString,
					ommp101Cfp2OutputHighPowerAlarm					DisplayString,
					ommp101Cfp2OutputLowPowerAlarm					DisplayString,
					ommp101Cfp2OutputHighPowerWarning					DisplayString,
					ommp101Cfp2OutputLowPowerWarning					DisplayString,
					ommp101Cfp2HighSupplyVoltageAlarm					DisplayString,
					ommp101Cfp2LowSupplyVoltageAlarm					DisplayString,
					ommp101Cfp2HighSupplyVoltageWarning					DisplayString,
					ommp101Cfp2LowSupplyVoltageWarning					DisplayString,
					ommp101Cfp2PresenceAbsenceNotification				DisplayString,
					ommp101SfpPlusInputPowerFailureAlarm					DisplayString,
					ommp101SfpPlusOutputPowerFailureAlarm					DisplayString,
					ommp101SfpPlusHighTemperatureAlarm					DisplayString,
					ommp101SfpPlusLowTemperatureAlarm					DisplayString,
					ommp101SfpPlusHighTemperatureWarning					DisplayString,
					ommp101SfpPlusLowTemperatureWarning					DisplayString,
					ommp101SfpPlusHighBiasCurrentAlarm					DisplayString,
					ommp101SfpPlusLowBiasCurrentAlarm					DisplayString,
					ommp101SfpPlusHighBiasCurrentWarning					DisplayString,
					ommp101SfpPlusLowBiasCurrentWarning					DisplayString,
					ommp101SfpPlusInputHighPowerAlarm					DisplayString,
					ommp101SfpPlusInputLowPowerAlarm						DisplayString,
					ommp101SfpPlusInputHighPowerWarning					DisplayString,
					ommp101SfpPlusInputLowPowerWarning					DisplayString,
					ommp101SfpPlusOutputHighPowerAlarm					DisplayString,
					ommp101SfpPlusOutputLowPowerAlarm					DisplayString,
					ommp101SfpPlusOutputHighPowerWarning					DisplayString,
					ommp101SfpPlusOutputLowPowerWarning					DisplayString,
					ommp101SfpPlusHighSupplyVoltageAlarm					DisplayString,
					ommp101SfpPlusLowSupplyVoltageAlarm					DisplayString,
					ommp101SfpPlusHighSupplyVoltageWarning					DisplayString,
					ommp101SfpPlusLowSupplyVoltageWarning					DisplayString,
					ommp101SfpPlusPresenceAbsenceNotification				DisplayString,
					ommp101SfpPlusTransmitFaultPresenceAlarm					DisplayString,
					ommp101OtuLossOfSignalAlarm						DisplayString,
					ommp101OtuLossOfFrameAlarm						DisplayString,
					ommp101OtuOutOfFrameAlarm						DisplayString,
					ommp101OtuLossOfMultiFrameAlarm					DisplayString,
					ommp101OtuOutOfMultiFrameAlarm					DisplayString,
					ommp101OtuSignalFailAlarm						DisplayString,
					ommp101OtuSignalDegradeAlarm						DisplayString,
					ommp101OtuAlarmIndicationSignalAlarm					DisplayString,
					ommp101OtuIncomingAlignmentErrorAlarm				DisplayString,
					ommp101OtuBackwardIncomingAlignmentErrorAlarm			DisplayString,
					ommp101OtuBackwardDefectIndicationAlarm				DisplayString,
					ommp101OduSignalFailAlarm						DisplayString,
					ommp101OduSignalDegradeAlarm						DisplayString,
					ommp101OduAlarmIndicationSignalAlarm					DisplayString,
					ommp101OduTcm1IncomingAlignmentErrorAlarm				DisplayString,
					ommp101OduTcm2IncomingAlignmentErrorAlarm				DisplayString,
					ommp101OduTcm3IncomingAlignmentErrorAlarm				DisplayString,
					ommp101OduTcm4IncomingAlignmentErrorAlarm				DisplayString,
					ommp101OduTcm5IncomingAlignmentErrorAlarm				DisplayString,
					ommp101OduTcm6IncomingAlignmentErrorAlarm				DisplayString,
					ommp101OduLockedDefectAlarm						DisplayString,
					ommp101OduOpenConnectionIndicationAlarm				DisplayString,
					ommp101OduBackwardDefectIndicationAlarm				DisplayString,
					ommp101OduTcm1BackwardIncomingAlignmentErrorAlarm			DisplayString,
					ommp101OduTcm2BackwardIncomingAlignmentErrorAlarm			DisplayString,
					ommp101OduTcm3BackwardIncomingAlignmentErrorAlarm			DisplayString,

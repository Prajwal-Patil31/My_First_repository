--*****************************************************************************
--			MIB FILE FOR THE OMMP101 CARD
--*****************************************************************************

OMMP101-MIB DEFINITIONS ::= BEGIN
 
          IMPORTS
        	
		RowStatus      			FROM STANDARD-MIB
			
		DisplayString  			FROM RFC1213-MIB       
    	
    		OBJECT-IDENTITY,
    		NOTIFICATION-TYPE,
    		MODULE-IDENTITY,
    		Integer32,
    		Unsigned32,
    		IpAddress,
    		TimeTicks			FROM SNMPv2-SMI
	 
	 	OBJECT-TYPE    			FROM RFC-1212
	 		
		MODULE-COMPLIANCE,
		OBJECT-GROUP,
		NOTIFICATION-GROUP		FROM SNMPv2-CONF
	
		node,
		rack,
		subRack,
		slot				FROM SCC-MIB
    
		enterprises			FROM RFC1155-SMI
	;

 

	utl   MODULE-IDENTITY
            LAST-UPDATED    	"1807130630Z"
            ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
            CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
            DESCRIPTION     	"MIB module for UTL 40/80 channel DWDM."
            REVISION 	    	"1807130630Z"
            DESCRIPTION    	"MIB module for OMMP101 Card."
            ::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
            STATUS  current
            DESCRIPTION "UTL Research and Development."
            ::= { utl 1 }

	dwdm 	OBJECT IDENTIFIER				::=	{ utlrnd 1 }
	indus 	OBJECT IDENTIFIER				::=	{ dwdm 1 }
	ommp101 	OBJECT IDENTIFIER 			::=	{ indus 88 }

	ommp101CardGeneralDetails OBJECT IDENTIFIER		::=	{ ommp101 1 }
	ommp101Configuration OBJECT IDENTIFIER 		::=	{ ommp101 2 }
	ommp101Alarm OBJECT IDENTIFIER 			::=	{ ommp101 3 }
	ommp101Performance OBJECT IDENTIFIER 		::=	{ ommp101 4 }
	ommp101Diagnostics OBJECT IDENTIFIER 		::=	{ ommp101 5 }

	ommp101AlarmQuery OBJECT IDENTIFIER			::=	{ ommp101Alarm 1 }
	ommp101AlarmNotification OBJECT IDENTIFIER		::=	{ ommp101Alarm 2 }

--*****************************************************************************
--				CARD GENERAL DETAILS
--*****************************************************************************

	ommp101CardGeneralDetailsTable OBJECT-TYPE
		SYNTAX  SEQUENCE OF Ommp101CardGeneralDetailsEntry 
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
                     "Contains card general details' queries for the OMMP101 card"
		::= { ommp101CardGeneralDetails 1 }

	ommp101CardGeneralDetailsEntry  OBJECT-TYPE
		SYNTAX  Ommp101CardGeneralDetailsEntry 
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION 
              	""
		INDEX   { node, rack, subRack, slot, ommp101InterfaceNumber }
		::= { ommp101CardGeneralDetailsTable 1 }

	Ommp101CardGeneralDetailsEntry  ::= 
		SEQUENCE {
				ommp101InterfaceNumber					INTEGER,
				ommp101EepromCardId					        INTEGER,
				ommp101EepromCardName					DisplayString,
				ommp101EepromPartCode					DisplayString,
				ommp101EepromCardSerialNumber				DisplayString,
				ommp101EepromHardwareExternalReleaseVersion		        DisplayString,
				ommp101SoftwareExternalReleaseVersion		        DisplayString,
				ommp101EepromHardwareInternalReleaseVersion		        DisplayString,
				ommp101SoftwareInternalReleaseVersion		        DisplayString,
				ommp101EepromCardUidNumber			                DisplayString,
				ommp101EepromCardEui48Number				        DisplayString,
				ommp101EepromCardEui64Number				        DisplayString,
				ommp101CardInstallationDate				        DisplayString,
				ommp101CardCommissionDate				        DisplayString,
				ommp101CardRunningTime					DisplayString,
				ommp101CardRestartCount					INTEGER,
				ommp101Cfp2ReadyForOperation				        INTEGER,
				ommp101Cfp2VendorName					        DisplayString,
				ommp101Cfp2VendorIeeeId					DisplayString,
				ommp101Cfp2PartNumber					        DisplayString,
				ommp101Cfp2SerialNumber					DisplayString,
				ommp101Cfp2ManufacturingDate				        DisplayString,
				ommp101Cfp2HardwareVersionNumber			 DisplayString,
				ommp101Cfp2FirmwareVersionNumber			 DisplayString,
				ommp101Cfp2MediaType					 DisplayString,
				ommp101NumberOfNetworkLanesInCfp2			 INTEGER,
				ommp101NumberOfHostLanesInCfp2				 INTEGER,
				ommp101Cfp2ModuleId					 DisplayString,
				ommp101Cfp2PowerClass					 INTEGER,
				ommp101Cfp2ProductCodeValue				 INTEGER,
				ommp101Cfp2WavelengthTunabilitySupported			INTEGER,
				ommp101TunableCfp2LaserFirstFrequency			        DisplayString,
				ommp101TunableCfp2LaserLastFrequency			        DisplayString,
				ommp101Cfp2ConnectorType					DisplayString,
				ommp101Cfp2SignalEncodingTypeSupported			DisplayString,
				ommp101Cfp2MaximumBitrateSupported			        DisplayString,
				ommp101Cfp2MaximumCaseTemperatureSupported		        INTEGER,
				ommp101Cfp2MinimumCaseTemperatureSupported		        DisplayString,
				ommp101Cfp2ActiveWavelengthControlSupported			INTEGER,
				ommp101Cfp2TransmitterIsCooledOrUncooled			INTEGER,
				ommp101SfpPlusEepromPage						INTEGER,
				ommp101CheckCodeOfSfpPlusEepromPage				INTEGER,
				ommp101ExtendedCheckCodeOfSfpPlusEepromPage			INTEGER,
				ommp101SfpPlusVendorName						DisplayString,
				ommp101SfpPlusVendorIeeeId					DisplayString,
				ommp101SfpPlusPartNumber						DisplayString,
				ommp101SfpPlusSerialNumber					DisplayString,
				ommp101SfpPlusRevisionNumber					DisplayString,
				ommp101SfpPlusManufacturingDate					DisplayString,
				ommp101FixedSfpPlusLaserWavelength				DisplayString,
				ommp101SfpPlusConnectorType					DisplayString,
				ommp101SfpPlusLinkLength						DisplayString,
				ommp101SfpPlusSignalEncodingTypeSupported			INTEGER,
				ommp101SfpPlusTransceiverCodesSupported				DisplayString,
				ommp101SfpPlusMaximumBitrateSupported				DisplayString,
				ommp101SfpPlusNominalBitrateSupported				DisplayString,
				ommp101SfpPlusMinimumBitrateSupported				DisplayString,
				ommp101CardGeneralDetailsTableRowStatus			RowStatus
			 }
	

	ommp101InterfaceNumber OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
			"Interface number represents the port number.
			InterfaceNumber to port mapping is as follows:
			1 - CLIENT-1,
			2 - CLIENT-2,
			3 - CLIENT-3,
			4 - CLIENT-4,
			5 - CLIENT-5,
			6 - CLIENT-6,
			7 - CLIENT-7,
			8 - CLIENT-8,
			9 - CLIENT-9,
			10 - CLIENT-10,
			11 - LINE PORT
			-----------------------------
			Values of the demultiplexing properties can be accessed
			with respect to slice number.  In such cases the
			InterfaceNumber will represent the slice number.
			1 - Slice-1
			2 - Slice-2
			3 - Slice-3
			4 - Slice-4
			-----------------------------
			For properties which do not apply on any interface,
			the interface number must be passed as 0
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 1 }
	
	ommp101EepromCardId OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the card ID of the OMMP101 card, present in the EEPROM
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 2 }

	ommp101EepromCardName OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the card name of the OMMP101 card, present in the EEPROM
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 3 }

	ommp101EepromPartCode OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the part code of the OMMP101 card, present in the EEPROM
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 4 }

	ommp101EepromCardSerialNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property get / set the information about 
			OMMP101 Card's Serial Number.
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Values:
			eg: 123456
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 5 }

	ommp101EepromHardwareExternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Hardware External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are significant
			architectural changes in the product
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Value:
			eg: 0.1
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 6 }

	ommp101SoftwareExternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are
			significant architectural changes in the product
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Value:
			eg: 0.1
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 7 }

	ommp101EepromHardwareInternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Hardware Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external hardware version.
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Value:
			eg: 4.1
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 8 }

	ommp101SoftwareInternalReleaseVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external software version.
		      	-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Value:
			eg: 5.1
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 9 }

	ommp101EepromCardUidNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card Unique IDentifier. It is a 4 byte
			address used to uniquely identify a card.
			----------------------------
			ommp101InterfaceNumber: 0
			------------------------------
			Value:
		      	eg: 12345678
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 10 }

	ommp101EepromCardEui48Number OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-48 Number. It is a 6 byte address
			used to uniquely identify a card.
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 0004A3123456
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 11 }

	ommp101EepromCardEui64Number OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-64 Number. It is a 8 byte address
			used to uniquely identify a card.
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 0004A31234567890
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 12 }

	ommp101CardInstallationDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Gets the card's installation date in
			dd/mm/yyyy format
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 12/03/2016
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 13 }

	ommp101CardCommissionDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"Gets the card's commission date in
			dd/mm/yyyy format
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 20/03/2016
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 14 }

	ommp101CardRunningTime OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Get the duration of time for which the card is
			operational/running
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 4d:3h:2m:1s
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 15 }

	ommp101CardRestartCount OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Get the number of times the card has been soft reset.
			This value will get reset to 0 on factory reset.
			-----------------------------
			ommp101InterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 10
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 16 }

	ommp101Cfp2ReadyForOperation OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Module not ready indicates that the CFP2
			has detected a condition that tells
			transmit or receive data is invalid.
			It shall consist of logical OR of the
			following signals:
			> Transmit Signal Conditioner Loss of Lock
			> Transmitter Laser Fault
			> Receiver Signal Conditioner Loss of Lock
			(Ref: INF-8077 2.4.1)
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:		
			1 - CFP2 is ready for operation 
			0 - CFP2 is not ready for operation
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 17 }

	ommp101Cfp2VendorName OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides Vendor Name for given CFP2. 
			The vendor name shall be the full name of the 
			corporation, a commonly accepted abbreviation of 
			the name of the corporation, the SCSI company code
			for the corporation, or the stock exchange code for
			the corporation.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: WTD
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 18 }

	ommp101Cfp2VendorIeeeId OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the IEEE company Identifier for
			the vendor of CFP2. A value of all zero in the 3-byte
			field indicates that the Vendor OUI is unspecified.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: 010
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 19 }

	ommp101Cfp2PartNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the vendor part number or
			product name of the CFP2. A value of all zero
			indicates that the vendor Part Number is unspecified.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: FTRX-1811-2D2
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 20 }

	ommp101Cfp2SerialNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides vendor serial number defining
			the vendors serial number for the CFP2. A value of all
			zero in the 16-byte field indicates that the vendor
			serial number is unspecified.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: KBG02CU
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 21 }

	ommp101Cfp2ManufacturingDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the manufacturing date for 
			CFP2. A value of 8-byte field in ASCII which represents
			year, month and date of each two bytes. 
			Extra two bytes may be blank
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: 160224
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 22 }

	ommp101Cfp2HardwareVersionNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the hardware version number for 
			CFP2. A value of 2-byte field which represents
			hardware version number in x.y format. 
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: 1.1
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 23 }

	ommp101Cfp2FirmwareVersionNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Firmware version number for 
			CFP2. A value of 2-byte field which represents
			firmware version number in x.y format. 
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: 1.1
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 24 }

	ommp101Cfp2MediaType OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Media type for 
			CFP2. A value of 2-Bit field which represents
			media type number. 
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: 1
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 25 }

	ommp101NumberOfNetworkLanesInCfp2 OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Number of Network Lanes for 
			CFP2. A value of 4-Bits field which represents
			Number of Network Lanes. 
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: 1
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 26 }

	ommp101NumberOfHostLanesInCfp2 OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Number of Network Host for 
			CFP2. A value of 4-Bits field which represents
			Number of Host Lanes.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: 1
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 27 }

	ommp101Cfp2ModuleId OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Module ID for 
			CFP2. A value of 1-Byte field which represents
			Module identifier.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: CFP2-DCO
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 28 }

	ommp101Cfp2PowerClass OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Power Class for 
			CFP2. A value of 2-Bits field which represents
			Power class.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: 1
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 29 }

	ommp101Cfp2ProductCodeValue OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the Product code value for 
			CFP2. A value of 7-Bits field which represents
			Product code value.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: 50h
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 30 }

	ommp101Cfp2WavelengthTunabilitySupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides information whether the CFP2
			supports wavelength tunability or not.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			1 - CFP2 supports wavelength tunability
			0 - CFP2 does not supports wavelength tunability
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 31 }

	ommp101TunableCfp2LaserFirstFrequency OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the first LASER frequency of CFP2.
			The two byte value is specified in units of THz.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: 1529.45
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 32 }

	ommp101TunableCfp2LaserLastFrequency OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the last laser frequency of CFP2.
		 	 The two byte value is specified in units of THz.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:			
			eg: 1563.45
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 33 }

	ommp101Cfp2ConnectorType OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides information of the CFP2
			connector, value indicates the external connector
			provided on the CFP2.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:
			00h 	Unknown or unspecified
			01h 	SC
			02h 	Fibre Channel Style 1 copper connector
			03h 	Fibre Channel Style 2 copper connector
			04h 	BNC/TNC
			05h 	Fibre Channel coaxial headers
			06h 	FiberJack
			07h 	LC
			08h 	MT-RJ
			09h 	MU
			0Ah 	SG
			0Bh 	Optical pigtail
			0C-1Fh 	Reserved
			20h 	HSSDC II
			21h 	Copper Pigtail
			22h-7Fh Reserved
			80-FFh 	Vendor specific
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 35 }

	ommp101Cfp2SignalEncodingTypeSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property indicates the serial encoding mechanisms
			that are supported by the CFP2.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:16QAM:
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 36 }

	ommp101Cfp2MaximumBitrateSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides maximum bit rate(Gbps) value
			supported by CFP2
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values: 28
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 37 }

	ommp101Cfp2MaximumCaseTemperatureSupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides the maximum case temperature
			(degree celcius) supported by CFP2.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 70
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 38 }

	ommp101Cfp2MinimumCaseTemperatureSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides the minimum case temperature
			(degree celcius) supported by CFP2.
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 70
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 39 }

	ommp101Cfp2ActiveWavelengthControlSupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides whether the CFP2 wavelength 
			controlling state is active or not
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:
			1 - Active
			0 - Inactive
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 40 }

	ommp101Cfp2TransmitterIsCooledOrUncooled OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provide information on which type of
			diode used in transmitter of the CFP2
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:
			1 - Cooling circuit supported for CFP2 transmitter. 
			0 - Cooling circuit not supported for CFP2 transmitter.
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 41 }

	ommp101SfpPlusEepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS current
		DESCRIPTION
			"This property sets/gets the SFP PLUS EEPROM page, 
			the value represents the SFP PLUS EEPROM page number.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 42 }

	ommp101CheckCodeOfSfpPlusEepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides the SFP PLUS
			check code(checksum) value for bytes 128 to 190
			present in SFP PLUS EEPROM Page number 1. 
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 43 }

	ommp101ExtendedCheckCodeOfSfpPlusEepromPage OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides the SFP PLUS
			extended check code(checksum) value for bytes 192 to 222
			present in SFP PLUS EEPROM Page number 1. 
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 44 }

	ommp101SfpPlusVendorName OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides Vendor Name for given SFP PLUS. 
			The vendor name shall be the full name of the 
			corporation, a commonly accepted abbreviation of 
			the name of the corporation, the SCSI company code
			for the corporation, or the stock exchange code for
			the corporation.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:			
			eg: Gigalight
			-----------------------------"

		::= { ommp101CardGeneralDetailsEntry 45 }

	ommp101SfpPlusVendorIeeeId OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the IEEE company Identifier for
			the vendor of SFP PLUS. A value of all zero in the 3-byte
			field indicates that the Vendor OUI is unspecified.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:			
			eg: 010
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 46 }

	ommp101SfpPlusPartNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the vendor part number or
			product name of the SFP PLUS. A value of all zero
			indicates that the vendor Part Number is unspecified.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:			
			eg: WXTR15101000427
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 47 }

	ommp101SfpPlusSerialNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides vendor serial number defining
			the vendor’s serial number for the SFP PLUS. A value of all
			zero in the 16-byte field indicates that the vendor
			serial number is unspecified.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:			
			eg: WXTRRPGEAS1
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 48 }

	ommp101SfpPlusRevisionNumber OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"The vendor revision number defining the vendor’s
			product revision number. A value of all zero indicates
			that the vendor revision number is unspecified
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:			
			eg: RT
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 49 }

	ommp101SfpPlusManufacturingDate OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property defines the manufacturing date for 
			SFP PLUS. A value of 8-byte field in ASCII which represents
			year, month and date of each two bytes. 
			Extra two bytes may be blank
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:			
			eg: 160224
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 50 }

	ommp101FixedSfpPlusLaserWavelength OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides transmitter LASER wavelength(nm)
			of the SFP PLUS
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:			
			eg: 1310.0
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 51 }

	ommp101SfpPlusConnectorType OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides information of the SFP PLUS
			connector, value indicates the external connector
			provided on the SFP PLUS.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:

			00h 	Unknown or unspecified
			01h 	SC (Subscriber Connector)
			02h 	Fibre Channel Style 1 copper connector
			03h 	Fibre Channel Style 2 copper connector
			04h 	BNC/TNC (Bayonet/Threaded Neill-Concelman)
			05h 	Fibre Channel coax headers
			06h 	Fiber Jack
			07h 	LC (Lucent Connector)
			08h 	MT-RJ (Mechanical Transfer - Registered Jack)
			09h 	MU (Multiple Optical)
			0Ah 	SG
			0Bh 	Optical Pigtail
			0Ch 	MPO 1x12 (Multifiber Parallel Optic)
			0Dh 	MPO 2x16
			0E-1Fh 	Reserved
			20h 	HSSDC II (High Speed Serial Data Connector)
			21h 	Copper pigtail
			22h 	RJ45 (Registered Jack)
			23h 	No separable connector
			24h 	MXC 2x16
			25h-7Fh Reserved
			80h-FFh Vendor specific
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 52 }

	ommp101SfpPlusLinkLength OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides link length suported by the SFP PLUS
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:
			eg: 80.00
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 53 }

	ommp101SfpPlusSignalEncodingTypeSupported OBJECT-TYPE		 
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property indicates the serial encoding mechanisms
			that are supported by the SFP PLUS.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:
			1 - 64B/66B
			2 - 8B10B
			3 - SONET Scrambled
			4 - NRZ
			5 - RZ
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 54 }

	ommp101SfpPlusTransceiverCodesSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"The identifier value specifies which transceiver
			codes are supported by the SFP PLUS
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:

			Return value 8-Byte represetation:
				  			 Byte-1	 Byte-2	 Byte-3	 Byte-4	 Byte-5  Byte-6  Byte-7	Byte-8
			100-M5-SN-I and 100-M6-SN-I	 0x00	 0x00   0x00	 0x00	 0x20    0x40    0x0C   0x01
			200-SM-LC-L and 100-SM-LC-L	 0x00	 0x00	 0x00	 0x00	 0x12	 0x00    0x01	0x05
			400-M5-SN-I and 400-M6-SN-I	 0x00	 0x00	 0x00	 0x00	 0x20    0x40    0x0C   0x15
			800-M5-SN-I and 800-M6-SN-I	 0x00	 0x00	 0x00	 0x00	 0x20    0x40    0x0C   0x54
			400-SM-LC-M	 		 0x00	 0x00	 0x00	 0x00	 0x0A    0x00    0x01   0x15
			400-SM-LC-L	 		 0x00	 0x00	 0x00	 0x00	 0x12    0x00    0x01   0x15
			200-SM-LL-V and 100-SM-LL-V	 0x00	 0x00	 0x00	 0x00	 0x80    0x10    0x01   0x05
			1000BASE-T	 		 0x00	 0x00	 0x00	 0x08    0x00    0x00    0x00   0x00
			1000BASE-SX	 		 0x00	 0x00	 0x00	 0x01    0x00    0x00    0x00   0x00
			1000BASE-LX	 		 0x00	 0x00	 0x00	 0x02    0x00    0x00    0x00   0x00
			1000BASE-LX10	 		 0x00	 0x00	 0x00	 0x02    0x00    0x00    0x00   0x00
			10GBASE-SR	 		 0x10h	 0x00	 0x00    0x00	 0x00	 0x00    0x00	0x00
			10GBASE-LR	 		 0x20h	 0x00	 0x00    0x00	 0x00	 0x00    0x00	0x00
			OC3/STM1 SR-1	 		 0x00	 0x00	 0x01h   0x00	 0x00	 0x00    0x00	0x00
			OC12/STM4 LR-1	 		 0x00	 0x10h	 0x40h   0x00	 0x00	 0x00    0x00	0x00
			OC48/STM16 LR-2	 		 0x00	 0x0Ch	 0x00    0x00	 0x00	 0x00    0x00	0x00
			10GE Passive copper cable	 0x00	 0x00	 0x00    0x00	 0x00	 0x04h   0x00	0x00
			10GE Active cable		 0x00	 0x00	 0x00    0x00	 0x00	 0x08h   0x00	0x00
			8/4/2G Passive copper cable	 0x00	 0x00	 0x00    0x00	 0x00	 0x04h   0x00	0x54h
			8/4/2G Active cable		 0x00	 0x00	 0x00    0x00	 0x00	 0x08h   0x00	0x54h
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 55 }

	ommp101SfpPlusMaximumBitrateSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides maximum bit rate value(Gbps)
			supported by the SFP PLUS
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values: 2.7
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 56 }

	ommp101SfpPlusNominalBitrateSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides maximum bit rate value(Gbps)
			supported by the SFP PLUS
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values: 2.5
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 57 }

	ommp101SfpPlusMinimumBitrateSupported OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"This property provides minimum bit rate value(Gbps)
			supported by the SFP PLUS
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values: 2.3
			-----------------------------"
		::= { ommp101CardGeneralDetailsEntry 58 }

	ommp101CardGeneralDetailsTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
			"*****************************
			This is MIB realted property,
			NOT to be considered as a card property
			*****************************"
              ::= { ommp101CardGeneralDetailsEntry 59 }


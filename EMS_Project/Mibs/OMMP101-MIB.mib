--*****************************************************************************
--				    PERFORMANCE
--*****************************************************************************        

	ommp101PerformanceTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Ommp101PerformanceEntry
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Gives Optical and Signal performance status of the OMMP101 card"
		::= { ommp101Performance 1 }	

	ommp101PerformanceEntry   OBJECT-TYPE
              SYNTAX  Ommp101PerformanceEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , ommp101InterfaceNumber}
		::= { ommp101PerformanceTable 1 }
	
	Ommp101PerformanceEntry ::= 
		SEQUENCE {
				ommp101Cfp2InputPower							DisplayString,
				ommp101Cfp2OutputPower						DisplayString,
				ommp101Cfp2SupplyVoltage						DisplayString,
				ommp101Cfp2Temperature						DisplayString,
				ommp101SfpPlusInputPower							DisplayString,
				ommp101SfpPlusOutputPower						DisplayString,
				ommp101SfpPlusBiasCurrent						DisplayString,
				ommp101SfpPlusSupplyVoltage						DisplayString,
				ommp101SfpPlusTemperature						DisplayString,
				ommp101OtnFecUncorrectedWords					DisplayString,
				ommp101OtnFecCorrectedBits						DisplayString,
				ommp101OtnFecZerosCorrectedBits					DisplayString,
				ommp101OtnFecOnesCorrectedBits					DisplayString,
				ommp101OtuBitInterleavedParityErrors					DisplayString,
				ommp101OtuBackwardErrorIndicationErrorCount				DisplayString,
				ommp101OtuErrorFreeSeconds						DisplayString,
				ommp101OtuErrorSeconds						DisplayString,
				ommp101OtuBackgroundBlockErrors					DisplayString,
				ommp101OtuSevereErrorSeconds						DisplayString,
				ommp101OtuUnavailableSeconds						DisplayString,
				ommp101OtuBackgroundBlockErrorRatio					DisplayString,
				ommp101OtuSevereErrorSecondsErrorRatio				DisplayString,
				ommp101OtuFarEndErrorFreeSeconds					DisplayString,
				ommp101OtuFarEndErrorSeconds						DisplayString,
				ommp101OtuFarEndBackgroundBlockErrors				DisplayString,
				ommp101OtuFarEndSevereErrorSeconds					DisplayString,
				ommp101OtuFarEndUnavailableSeconds					DisplayString,
				ommp101OtuFarEndBackgroundBlockErrorRatio				DisplayString,
				ommp101OtuFarEndSevereErrorSecondsErrorRatio				DisplayString,
				ommp101OtuErrorRatio							DisplayString,
				ommp101OtuBitErrorRate						DisplayString,
				ommp101OduBitInterleavedParityErrors					DisplayString,
				ommp101OduTcm1BitInterleavedParityErrors				DisplayString,
				ommp101OduTcm2BitInterleavedParityErrors				DisplayString,
				ommp101OduTcm3BitInterleavedParityErrors				DisplayString,
				ommp101OduTcm4BitInterleavedParityErrors				DisplayString,
				ommp101OduTcm5BitInterleavedParityErrors				DisplayString,
				ommp101OduTcm6BitInterleavedParityErrors				DisplayString,
				ommp101OduTcm1IncomingAlignmentErrorSeconds				DisplayString,
				ommp101OduBackwardErrorIndicationErrorCount				DisplayString,
				ommp101OduTcm1BackwardErrorIndicationErrorCount			DisplayString,
				ommp101OduTcm2BackwardErrorIndicationErrorCount			DisplayString,
				ommp101OduTcm3BackwardErrorIndicationErrorCount			DisplayString,
				ommp101OduTcm4BackwardErrorIndicationErrorCount			DisplayString,
				ommp101OduTcm5BackwardErrorIndicationErrorCount			DisplayString,
				ommp101OduTcm6BackwardErrorIndicationErrorCount			DisplayString,
				ommp101OduTcm1BackwardIncomingAlignmentErrorSeconds			DisplayString,
				ommp101OduDelayMeasurement						DisplayString,
				ommp101OduErrorFreeSeconds						DisplayString,
				ommp101OduErrorSeconds						DisplayString,
				ommp101OduBackgroundBlockErrors					DisplayString,
				ommp101OduSevereErrorSeconds						DisplayString,
				ommp101OduUnavailableSeconds						DisplayString,
				ommp101OduBackgroundBlockErrorRatio					DisplayString,
				ommp101OduSevereErrorSecondsErrorRatio				DisplayString,
				ommp101OduFarEndErrorFreeSeconds					DisplayString,
				ommp101OduFarEndErrorSeconds						DisplayString,
				ommp101OduFarEndBackgroundBlockErrors				DisplayString,
				ommp101OduFarEndSevereErrorSeconds					DisplayString,
				ommp101OduFarEndUnavailableSeconds					DisplayString,
				ommp101OduFarEndBackgroundBlockErrorRatio				DisplayString,
				ommp101OduFarEndSevereErrorSecondsErrorRatio				DisplayString,
				ommp101SdhRsB1BitInterleavedParityErrors				DisplayString,
				ommp101SdhMsB2BitInterleavedParityErrors				DisplayString,
				ommp101SdhMsRemoteErrorIndicationErrorCount				DisplayString,
				ommp101SdhErrorFreeSeconds						DisplayString,
				ommp101SdhErrorSeconds						DisplayString,
				ommp101SdhBackgroundBlockErrors					DisplayString,
				ommp101SdhSevereErrorSeconds						DisplayString,
				ommp101SdhUnavailableSeconds						DisplayString,
				ommp101SdhErrorSecondsErrorRatio					DisplayString,
				ommp101SdhBackgroundBlockErrorRatio					DisplayString,
				ommp101SdhSevereErrorSecondsErrorRatio					DisplayString,
				ommp101EthernetTerminatedFramesTransmitted				DisplayString,		
				ommp101EthernetTerminatedFramesReceived					DisplayString,		
				ommp101EthernetTerminatedVlanTaggedFramesTransmitted			DisplayString,		
				ommp101EthernetTerminatedVlanTaggedFramesReceived			DisplayString,		
				ommp101EthernetTerminatedUnicastFramesTransmitted			DisplayString,		
				ommp101EthernetTerminatedUnicastFramesReceived				DisplayString,				
				ommp101EthernetTerminatedBroadcastFramesTransmitted			DisplayString,		
				ommp101EthernetTerminatedBroadcastFramesReceived			DisplayString,				
				ommp101EthernetTerminatedMulticastFramesTransmitted			DisplayString,		
				ommp101EthernetTerminatedMulticastFramesReceived			DisplayString,				
				ommp101EthernetTerminatedOverSizeFramesTransmitted			DisplayString,
				ommp101EthernetTerminatedOverSizeFramesReceived				DisplayString,		
				ommp101EthernetTerminatedUnderSizeFramesTransmitted			DisplayString,
				ommp101EthernetTerminatedUnderSizeFramesReceived			DisplayString,		
				ommp101EthernetTerminatedFrameCheckSequenceErrorsTransmitted		DisplayString,		
				ommp101EthernetTerminatedFrameCheckSequenceErrorsReceived		DisplayString,				
				ommp101EthernetTerminatedControlFramesTransmitted			DisplayString,		
				ommp101EthernetTerminatedControlFramesReceived				DisplayString,				
				ommp101EthernetStatsPkts64OctsTransmitted				DisplayString,		
				ommp101EthernetStatsPkts64OctsReceived					DisplayString,				
				ommp101EthernetStatsPkts65to127OctsTransmitted				DisplayString,		
				ommp101EthernetStatsPkts65to127OctsReceived				DisplayString,				
				ommp101EthernetStatsPkts128to255OctsTransmitted				DisplayString,		
				ommp101EthernetStatsPkts128to255OctsReceived				DisplayString,				
				ommp101EthernetStatsPkts256to511OctsTransmitted				DisplayString,		
				ommp101EthernetStatsPkts256to511OctsReceived				DisplayString,				
				ommp101EthernetStatsPkts512to1023OctsTransmitted			DisplayString,		
				ommp101EthernetStatsPkts512to1023OctsReceived				DisplayString,				
				ommp101EthernetStatsPkts1024to1518OctsTransmitted			DisplayString,		
				ommp101EthernetStatsPkts1024to1518OctsReceived				DisplayString,				
				ommp101EthernetStatsPkts1519toMaxOctsTransmitted			DisplayString,		
				ommp101EthernetStatsPkts1519toMaxOctsReceived				DisplayString,				
				ommp101EthernetStatsJabberTransmitted					DisplayString,		
				ommp101EthernetStatsJabberReceived					DisplayString,				
				ommp101EthernetStatsFragmentsTransmitted				DisplayString,
				ommp101EthernetStatsFragmentsReceived					DisplayString,
				ommp101EthernetPauseControlFramesTransmitted				DisplayString,
				ommp101EthernetPauseControlFramesReceived				DisplayString,
				ommp101PerformanceTableRowStatus					RowStatus
			}	           

	ommp101Cfp2InputPower OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the current Input power(dbm) received at the port
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:
			eg: -9.0
			-----------------------------"
	::= { ommp101PerformanceEntry 1 }

	ommp101Cfp2OutputPower OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the current Output power(dbm) transmitted at the port
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:
			eg: -0.6
			-----------------------------"
	::= { ommp101PerformanceEntry 2 }

	ommp101Cfp2SupplyVoltage OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the Supply Voltage of the port
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 3.3
			-----------------------------"
	::= { ommp101PerformanceEntry 3 }

	ommp101Cfp2Temperature OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the temperature(degree celcius) of the transmitter
			at  the port
			-----------------------------
			ommp101InterfaceNumber:
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 33.35
			-----------------------------"
	::= { ommp101PerformanceEntry 4 }

	ommp101SfpPlusInputPower OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the current Input power(dbm) received at the port
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:
			eg: -9.0
			-----------------------------"
	::= { ommp101PerformanceEntry 5 }

	ommp101SfpPlusOutputPower OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the current Output power(dbm) transmitted at the port
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:
			eg: -6.0
			-----------------------------"
	::= { ommp101PerformanceEntry 6 }

	ommp101SfpPlusBiasCurrent OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the bias current(mA) thats transmitted at the port
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:
			eg: 55
			-----------------------------"
	::= { ommp101PerformanceEntry 7 }

	ommp101SfpPlusSupplyVoltage OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the Supply Voltage of the port
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:
			eg: 3.3
			-----------------------------"
	::= { ommp101PerformanceEntry 8 }

	ommp101SfpPlusTemperature OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"Gives the temperature(degree celcius) of the transmitter
			at the port
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			-----------------------------
			Values:
			eg: 33.35
			-----------------------------"
	::= { ommp101PerformanceEntry 9 }

	ommp101OtnFecUncorrectedWords OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic,
			OTU Uncorrected Word Error Counter counts the number of
			FEC errored code words that could not be corrected.
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp101PerformanceEntry 10 }

	ommp101OtnFecCorrectedBits OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic,
			OTU Corrected Bit Error Counter counts the number of
			FEC error bits that could be corrected(sum of ones
			corrected and zeros corrected bits).
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 1234
			-----------------------------"
	::= { ommp101PerformanceEntry 11 }

	ommp101OtnFecZerosCorrectedBits OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"For port configured with OTU2 traffic,
			OTU Zero Corrected Bits Error Counter counts the number
			of FEC error bits that could be corrected from
			one to zero value(Expected 0 but received as 1).
			-----------------------------
			ommp101InterfaceNumber:
			1 to 10 - CLIENT-1 to CLIENT-10
			11 - LINE PORT
			-----------------------------
			Values:
			eg: 1234

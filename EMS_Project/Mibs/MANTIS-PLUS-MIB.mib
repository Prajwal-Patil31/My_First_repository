--*****************************************************************************
--					UTL MANTIS PLUS MIB
--*****************************************************************************

MANTIS-PLUS-MIB DEFINITIONS ::= BEGIN
 
		IMPORTS
		RowStatus			FROM STANDARD-MIB

		DisplayString			FROM RFC1213-MIB       

		OBJECT-IDENTITY, 
		NOTIFICATION-TYPE, 
		MODULE-IDENTITY, 
		Integer32, 
		Unsigned32, 
		IpAddress, 
		TimeTicks			FROM SNMPv2-SMI

		OBJECT-TYPE			FROM RFC-1212

		MODULE-COMPLIANCE, 
		OBJECT-GROUP, 
		NOTIFICATION-GROUP		FROM SNMPv2-CONF
		
		node, 
		rack, 
		subRack, 
		slot 				FROM SCC-MIB

		enterprises 			FROM RFC1155-SMI		
	;

	utl   MODULE-IDENTITY
            LAST-UPDATED    	"1807130630Z"
            ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
            CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
            DESCRIPTION     	"MIB module for UTL 2U DWDM."
            REVISION 	    	"1807130630Z"
            DESCRIPTION    	 "MIB module for mantis Card."
            ::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
            STATUS  current
            DESCRIPTION "UTL R and D."
            ::= { utl 1 }

	dwdm 				OBJECT IDENTIFIER	::=   { utlrnd 1 }
	indus				OBJECT IDENTIFIER	::=   { dwdm 1 }
	mantisPlus 			OBJECT IDENTIFIER 	::=   { indus 191 }

	mantisPlusCardGeneralDetails 	OBJECT IDENTIFIER 	::=   { mantisPlus 1 }	
	mantisPlusConfiguration 	OBJECT IDENTIFIER 	::=   { mantisPlus 2 }
	mantisPlusAlarm 		OBJECT IDENTIFIER 	::=   { mantisPlus 3 }
	mantisPlusPerformance 		OBJECT IDENTIFIER 	::=   { mantisPlus 4 }

	mantisPlusAlarmQuery 		OBJECT IDENTIFIER 	::=   { mantisPlusAlarm 1 }	
	mantisPlusAlarmsNotification 	OBJECT IDENTIFIER 	::=   { mantisPlusAlarm 2 }	
	
--*****************************************************************************
--			MANTIS PLUS CARD GENERAL DETAILS
--*****************************************************************************	

	mantisPlusCardGeneralDetailsTable OBJECT-TYPE
			SYNTAX  SEQUENCE OF  MantisPlusCardGeneralDetailsTableEntry
			MAX-ACCESS  not-accessible
	      	STATUS  current
	      	DESCRIPTION
					"we can set/get card details "
	      	::= { mantisPlusCardGeneralDetails 1 }
		
	mantisPlusCardGeneralDetailsTableEntry OBJECT-TYPE
			SYNTAX  MantisPlusCardGeneralDetailsTableEntry 
			MAX-ACCESS  not-accessible
			STATUS  current
			DESCRIPTION 
        			""
				INDEX   { node, rack , subRack , slot ,mantisPlusDirectionNo, mantisPlusPortType, mantisPlusChannelNo }
				::= { mantisPlusCardGeneralDetailsTable 1 }

	MantisPlusCardGeneralDetailsTableEntry  ::= 
		SEQUENCE 
		{
			mantisPlusDirectionNo	 				INTEGER,
			mantisPlusPortType					INTEGER,
			mantisPlusChannelNo					INTEGER,
			mantisPlusEepromCardId					INTEGER,
			mantisPlusEepromCardName				DisplayString,
			mantisPlusEepromPartCode				DisplayString,
			mantisPlusEepromCardSerialNumber			DisplayString,
			mantisPlusEepromHardwareExternalReleaseVersion		DisplayString,
			mantisPlusSoftwareExternalReleaseVersion		DisplayString,
			mantisPlusEepromHardwareInternalReleaseVersion		DisplayString,
			mantisPlusSoftwareInternalReleaseVersion		DisplayString,
			mantisPlusEepromCardUidNumber				DisplayString,
			mantisPlusEepromCardEui48Number				DisplayString,
			mantisPlusEepromCardEui64Number				DisplayString,
			mantisPlusCardRootFileSystemVersion			DisplayString,
			mantisPlusCardInstallationDate				DisplayString,
			mantisPlusCardCommissionDate				DisplayString,
			mantisPlusCardRunningTime				DisplayString,
			mantisPlusCardRestartCount				INTEGER,
			mantisPlusBackPlaneCommunication			DisplayString,
			mantisPlusConsoleCommunication				DisplayString,
			mantisPlusChannelsSupported				INTEGER,
			mantisPlusPortsSupported				INTEGER,
			mantisPlusDirection					INTEGER,
			mantisPlusCardGeneralDetailsTableRowStatus		RowStatus
		}


	mantisPlusDirectionNo OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
				"Set direction number of the Mantis Plus Card, Maximum Direction Supports Upto 9,
			possible Values : 1 to 4"

			::= { mantisPlusCardGeneralDetailsTableEntry 1 }

	mantisPlusPortType OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
				"set wss module direction type, Either it may be Input or Output Type.
			possible values : 1 -> Input Type , 2 -> Output Type "

			::= { mantisPlusCardGeneralDetailsTableEntry 2 }

	mantisPlusChannelNo  OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
				"set channel number,
			possible Values : 1 to 80"

			::= { mantisPlusCardGeneralDetailsTableEntry 3 }

	mantisPlusEepromCardId OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card id from EEPROM,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : 2 "

			::= {  mantisPlusCardGeneralDetailsTableEntry 4 }
              
	mantisPlusEepromCardName OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card name from EEPROM,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : mantisPlus "

			::= {  mantisPlusCardGeneralDetailsTableEntry 5 }

	mantisPlusEepromPartCode OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card part code from EEPROM,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : mantisPlus "

			::= {  mantisPlusCardGeneralDetailsTableEntry 6 }

	mantisPlusEepromCardSerialNumber OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
				" This property get / set the information about MANTIS 
				 Card's Serial Number.
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : UTL-NFS-A-09-16-MANTISPLUS-12345 "

			::= {  mantisPlusCardGeneralDetailsTableEntry 7 }

	mantisPlusEepromHardwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card Hardware Exernal release version from EEPROM,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : 1.0 "

			::= {  mantisPlusCardGeneralDetailsTableEntry 8 }

	mantisPlusSoftwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card Software Exernal release version from EEPROM,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : 2.0 "

			::= {  mantisPlusCardGeneralDetailsTableEntry 9 }

	mantisPlusEepromHardwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card Hardware Internal release version from EEPROM,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : 1.0 "

			::= {  mantisPlusCardGeneralDetailsTableEntry 10 }

	mantisPlusSoftwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card Software Internal release version from EEPROM,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : 2.0 "

			::= {  mantisPlusCardGeneralDetailsTableEntry 11 }

	mantisPlusEepromCardUidNumber OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card Uid number from EEPROM,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values :  "
			::= {  mantisPlusCardGeneralDetailsTableEntry 12 }

	mantisPlusEepromCardEui48Number OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card Eui48 number from EEPROM,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values :  "

			::= {  mantisPlusCardGeneralDetailsTableEntry 13 }

	mantisPlusEepromCardEui64Number OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card Eui64 number from EEPROM,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values :  "

			::= {  mantisPlusCardGeneralDetailsTableEntry 14 }
			
	mantisPlusCardRootFileSystemVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card's Root File System Version
			-----------------------------
			mantisPlusDirectionNo	: 0
			mantisPlusPortType	: 0
			mantisPlusChannelNo	: 0
			-----------------------------
			Value:
		      	eg: 8
			-----------------------------"
		::= { mantisPlusCardGeneralDetailsTableEntry 15 }

	mantisPlusCardInstallationDate OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
				"
			To get the card's installation date in dd/mm/yyyy format,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			--------------------------------- 
			"

			::= {  mantisPlusCardGeneralDetailsTableEntry 24 }

	mantisPlusCardCommissionDate OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
				"
			To get the card's Commission date in dd/mm/yyyy format,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------  
			"

			::= {  mantisPlusCardGeneralDetailsTableEntry 25 }

	mantisPlusCardRunningTime OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			" 
			To get the duration of time for which the card is operational/running.
			Value eg: 3d 2h 1m
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			"

			::= {  mantisPlusCardGeneralDetailsTableEntry 26 }

	mantisPlusCardRestartCount OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card Restart Count,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			"

			::= {  mantisPlusCardGeneralDetailsTableEntry 27 }

	mantisPlusBackPlaneCommunication OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card BackPlane Communication value,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : rs232 "

			::= {  mantisPlusCardGeneralDetailsTableEntry 35 }

	mantisPlusConsoleCommunication OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get card Console Communication value,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : Ethernet "

			::= {  mantisPlusCardGeneralDetailsTableEntry 36 }


	mantisPlusChannelsSupported OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get channels supported by the mantisPlus Card ,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Value :  80 "

			::= {  mantisPlusCardGeneralDetailsTableEntry 37 }

	mantisPlusPortsSupported OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get ports supported by the mantisPlus Card  ,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Value :  4  "

			::= {  mantisPlusCardGeneralDetailsTableEntry 38 }

	mantisPlusDirection	OBJECT-TYPE
		SYNTAX	INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get direction number of mantisPlus card ,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Value : 1 to 4 "

			::= {  mantisPlusCardGeneralDetailsTableEntry 39 }

	mantisPlusCardGeneralDetailsTableRowStatus OBJECT-TYPE
		SYNTAX		RowStatus
		MAX-ACCESS	read-write
		STATUS		current
		DESCRIPTION
			"This is MIB realted property,
			NOT to be considered as a card property"

			::= { mantisPlusCardGeneralDetailsTableEntry 40 }
			
--*****************************************************************************
--		 	 CONFIGURATION Table
--*****************************************************************************              
              

	mantisPlusCardConfigurationTable OBJECT-TYPE
		SYNTAX  SEQUENCE OF  MantisPlusCardConfigurationTableEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
				"we can set/get channel configuration "

			::= { mantisPlusConfiguration 1 }

	mantisPlusCardConfigurationTableEntry OBJECT-TYPE
		SYNTAX  MantisPlusCardConfigurationTableEntry 
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION 
				""
			INDEX   { node, rack , subRack , slot , mantisPlusDirectionNo, mantisPlusPortType, mantisPlusChannelNo }
			::= { mantisPlusCardConfigurationTable 1 }
	
	MantisPlusCardConfigurationTableEntry  ::= 
		SEQUENCE 
		{
			mantisPlusChannelPort 					INTEGER,
			mantisPlusChannelState 					INTEGER,
			mantisPlusAttenuation 					DisplayString,
			mantisPlusWssInputVoltageOfModule			DisplayString,
			mantisPlusWssTemperatureOfModule			DisplayString,
			mantisPlusMinValidAttn					DisplayString,
			mantisPlusMaxValidAttn					DisplayString,
			mantisPlusChannelMode 					INTEGER,
			mantisPlusTargetPower					DisplayString,
			mantisPlusStepSize					DisplayString,
			mantisPlusStepDelay	 				DisplayString,
			mantisPlusPowerTolerance	 			DisplayString,
			mantisPlusInsertionLossCorrectionVal			DisplayString,
			mantisPlusMinValidPower					DisplayString,
			mantisPlusMaxValidPower					DisplayString,
			mantisPlusAlarmInhibitVal    				DisplayString,
			mantisPlusCardSoftwareUpgrade				DisplayString,
			mantisPlusCardSoftReset					DisplayString,
			mantisPlusCardDefaultFactoryReset			DisplayString,
			mantisPlusFactChannelPort				INTEGER,
			mantisPlusFactChannelState				INTEGER,
			mantisPlusFactAttenuation				DisplayString,
			mantisPlusFactChannelMode				INTEGER,
			mantisPlusFactStepSize					DisplayString,
			mantisPlusFactStepDelay					DisplayString,
			mantisPlusFactPowerTolerance				DisplayString,
			mantisPlusFactInsertionLossCorrectionVal		DisplayString,
			mantisPlusFactMinValidAttenuation			DisplayString,
			mantisPlusFactMaxValidAttenuation			DisplayString,
			mantisPlusFactMinValidPower				DisplayString,
			mantisPlusFactMaxValidPower				DisplayString,
			mantisPlusFactMinStepSize				DisplayString,
			mantisPlusFactMaxStepSize				DisplayString,
			mantisPlusFactMinStepDelay				DisplayString,
			mantisPlusFactMaxStepDelay				DisplayString,
			mantisPlusFactMaxPowerTolerance				DisplayString,
			mantisPlusFactMaxInsertionLossCorrectionVal		DisplayString,
			mantisPlusFactCardType					DisplayString,
			mantisPlusWssElectricalPowerOutofRangeInhibit		INTEGER,
			mantisPlusWssTemperatureOutofRangeInhibit		INTEGER,
			mantisPlusWssCommunicationErrorInhibit			INTEGER,
			mantisPlusGpioExpanderChipErrorInhibit			INTEGER,
			mantisPlusOcmCommunicationErrorInhibit			INTEGER,
			mantisPlusChannelPowerAlarmStateInhibit			INTEGER,
			mantisPlusWssElectricalPowerOutofRangeSeverity		DisplayString,
			mantisPlusWssTemperatureOutofRangeSeverity		DisplayString,
			mantisPlusWssCommunicationErrorSeverity			DisplayString,
			mantisPlusGpioExpanderChipErrorSeverity			DisplayString,
			mantisPlusOcmCommunicationErrorSeverity			DisplayString,
			mantisPlusChannelPowerAlarmStateSeverity		DisplayString,
			mantisPlusSyncSystemTimeWithNtpServer				DisplayString,
			mantisPlusSyncRtcWithNtpServer						DisplayString,
			mantisPlusSyncRtcWithSystemTime						DisplayString,
			mantisPlusUpdateGivenTimeIntoSystem					DisplayString,
			mantisPlusUpdateGivenTimeIntoRtc					DisplayString,
			mantisPlusSystemTimeAndRtcTime						DisplayString,
			mantisPlusConfigurationTableRowStatus			RowStatus
		}

	mantisPlusChannelPort OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
				"set/get channel Port, switching channel from one port to another port 
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 1-80
			---------------------------------
			possible Values : 1 to 4"

			::= {  mantisPlusCardConfigurationTableEntry 1 }


	mantisPlusChannelState OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
				"set/get channel State, channel blocking and unblocking
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 1-80
			---------------------------------
			possible Values : 0 -> Channel Block, 1 -> Channel Un-Block"

			::= {  mantisPlusCardConfigurationTableEntry 2 }

	mantisPlusAttenuation OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
				"set/get attenuation of a channel,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 1-80
			---------------------------------
			possible Values : 0.0 to 15.0  "

			::= {  mantisPlusCardConfigurationTableEntry 3 }

	mantisPlusWssInputVoltageOfModule  OBJECT-TYPE
		SYNTAX DisplayString (SIZE (0..255))
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
				"get wss Input Voltage Of Module,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			possible Value : 4.8"

			::= { mantisPlusCardConfigurationTableEntry 4 }
		
	mantisPlusWssTemperatureOfModule   OBJECT-TYPE
		SYNTAX DisplayString (SIZE (0..255))
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
				"get wss Temperature Of Module,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			possible Values :  -5 to +65"

			::= { mantisPlusCardConfigurationTableEntry 5 }


	mantisPlusMinValidAttn OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get minimum valid attinuation,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			possible Value :  0 "

			::= { mantisPlusCardConfigurationTableEntry 6 }

	mantisPlusMaxValidAttn OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get maximum valid Attinuation,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			possible Value :  15 "

			::= { mantisPlusCardConfigurationTableEntry 7 }

	mantisPlusChannelMode OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
				"set/get channel Mode,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 1-80
			---------------------------------
			possible Values : 0 -> Attenuation Mode , 1 -> Power Mode "

			::= {  mantisPlusCardConfigurationTableEntry 11 }

	mantisPlusTargetPower OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
				"set/get target Power of a channel, Target Power can be Set only when channel is in Power Mode.
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 1-80
			---------------------------------
			possible Values : -40 to +4 "

			::= {  mantisPlusCardConfigurationTableEntry 12 }
   

	mantisPlusStepSize OBJECT-TYPE
		SYNTAX DisplayString (SIZE (0..255))
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
				"get/set step Size,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			possible Values : 0.1 to 2.0"

			::= { mantisPlusCardConfigurationTableEntry 13 }

	mantisPlusStepDelay OBJECT-TYPE
		SYNTAX DisplayString (SIZE (0..255))
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
				"get/set step Delay ,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			possible Values : 1.0 to 2.0"

			::= { mantisPlusCardConfigurationTableEntry 14 }

	mantisPlusPowerTolerance OBJECT-TYPE
		SYNTAX DisplayString (SIZE (0..255))
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
				"get/set power Tolerance ,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			possible Values : 0 to 2.0"

			::= { mantisPlusCardConfigurationTableEntry 15 }


	mantisPlusInsertionLossCorrectionVal OBJECT-TYPE
		SYNTAX DisplayString (SIZE (0..255))
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
				"get/set insertion Loss Correction Value,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			possible Values : 0 to 4"

			::= { mantisPlusCardConfigurationTableEntry 16 }

	mantisPlusMinValidPower  OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get minimum valid power ,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			possible Value :  -40 "

			::= { mantisPlusCardConfigurationTableEntry 17 }
           
	mantisPlusMaxValidPower OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get maximum valid power ,
			---------------------------------
			mantisPlusDirectionNo : 0
			mantisPlusPortType		: 0
			mantisPlusChannelNo	: 0
			---------------------------------
			possible Value :  4 "

			::= {  mantisPlusCardConfigurationTableEntry 18 }

   	mantisPlusAlarmInhibitVal   OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-write

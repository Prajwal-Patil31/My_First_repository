--*****************************************************************************
--		 	 ALARM Table
--*****************************************************************************              
              
	mantisPlusAlarmQueryTable OBJECT-TYPE
		SYNTAX  SEQUENCE OF MantisPlusAlarmQueryEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
				"we can get alarm status "
	
		::= { mantisPlusAlarmQuery 1 }

	mantisPlusAlarmQueryEntry OBJECT-TYPE
		SYNTAX  MantisPlusAlarmQueryEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION 
				""
			INDEX   { node, rack , subRack , slot ,mantisPlusDirectionNo, mantisPlusPortType, mantisPlusChannelNo }
			::= { mantisPlusAlarmQueryTable 1 }
	
	MantisPlusAlarmQueryEntry ::= 
		SEQUENCE 
		{
			mantisPlusWssElectricalPowerOutofRange		DisplayString,
			mantisPlusWssTemperatureOutofRange		DisplayString,
			mantisPlusWssCommunicationError			DisplayString,
			mantisPlusGpioExpanderChipError			DisplayString,
			mantisPlusOcmCommunicationError			DisplayString,
			mantisPlusChannelPowerAlarmState		DisplayString,
			mantisPlusAlarmQueryTableRowStatus		RowStatus
		}
	

	mantisPlusWssElectricalPowerOutofRange OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get wss Electrical Power Out of Range Alarm Value,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : 0 -> Alarm Absent, 1 -> Alarm Present "

			::= { mantisPlusAlarmQueryEntry 1 }
              
 	mantisPlusWssTemperatureOutofRange OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get wss Temperature Out of Range Alarm Value,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			Values :
			If Alarm is Present - Date and Time Stamp
			    	eg:2017-5-18,9:47:20.0,+5:30
			If Alarm is Absent  - 0 "
	
			::= { mantisPlusAlarmQueryEntry 2 }     
              
	mantisPlusWssCommunicationError OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION

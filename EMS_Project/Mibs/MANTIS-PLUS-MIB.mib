              		::= { mantisPlusAlarmQueryEntry 7 }
   
        
--*****************************************************************************
--		 	 PERFORMANCE Table
--*****************************************************************************                         
                            
     
  	mantisPlusPerformanceQueryTable OBJECT-TYPE
		SYNTAX  SEQUENCE OF MantisPlusPerformanceQueryEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION
				"we can get card performance"

		::= { mantisPlusPerformance 1 }

	mantisPlusPerformanceQueryEntry OBJECT-TYPE
		SYNTAX  MantisPlusPerformanceQueryEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION 
				""

			INDEX   { node, rack , subRack , slot, mantisPlusDirectionNo, mantisPlusPortType, mantisPlusChannelNo }
			::= { mantisPlusPerformanceQueryTable 1 }

	MantisPlusPerformanceQueryEntry ::= 
		SEQUENCE 
		{
			mantisPlusCurrentPower			DisplayString,
			mantisPlusWavelength			DisplayString,
			mantisPlusFrequency			DisplayString,
			mantisPlusCompositePower	 	DisplayString,
			mantisPlusAveragePower	 		DisplayString,
			mantisPlusMaxPower	 		DisplayString,
			mantisPlusMinPower		 	DisplayString,
			mantisPlusPowerDiff	 		DisplayString,
			mantisPlusMaxPowerChNo	 		INTEGER,
			mantisPlusMinPowerChNo	 		INTEGER,
			mantisPlusChannelsPresent	 	INTEGER,
			mantisPlusPresenceStatus	 	INTEGER,
			mantisPlusPerformanceTableRowStatus	RowStatus
			
		}
	
	mantisPlusCurrentPower OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get current Power of a Channel, 
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 1 to 80
			---------------------------------
			Possible Values : -10 "

			::= { mantisPlusPerformanceQueryEntry 1 } 

	mantisPlusWavelength OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get wavelength of a Channel, 
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 1-80
			---------------------------------
			Possible Values : 1529.94 "

			::= {  mantisPlusPerformanceQueryEntry 2 }

	mantisPlusFrequency OBJECT-TYPE
		SYNTAX  DisplayString (SIZE (0..255))
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get frequency of a Channel, 
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 1 to 80
			---------------------------------
			Possible Values : 191.6 "

			::= {  mantisPlusPerformanceQueryEntry 3 }
              
	mantisPlusCompositePower OBJECT-TYPE
		SYNTAX DisplayString (SIZE (0..255))
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
				"get composite Power Value,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : 2 "	

			::= { mantisPlusPerformanceQueryEntry 4 }

	mantisPlusAveragePower OBJECT-TYPE
		SYNTAX DisplayString (SIZE (0..255))
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
				"get average Power Value
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : 1 "

		::= { mantisPlusPerformanceQueryEntry 5 }

	mantisPlusMaxPower OBJECT-TYPE
		SYNTAX DisplayString (SIZE (0..255))
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
				"get maximum power of a Channel, 
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : + 4 "

			::= { mantisPlusPerformanceQueryEntry 6 }

	mantisPlusMinPower OBJECT-TYPE
		SYNTAX DisplayString (SIZE (0..255))
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
				"get minimum power of a Channel, 
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : -40 "

			::= { mantisPlusPerformanceQueryEntry 7 }

	mantisPlusPowerDiff OBJECT-TYPE
		SYNTAX DisplayString (SIZE (0..255))
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
				"get power difference between minimum and maximum power values
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : 50 dB "

		::= { mantisPlusPerformanceQueryEntry 8 }         
	
	mantisPlusMaxPowerChNo OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get Channel Number of maximum Power , 
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : 1 to 80 "

			::= { mantisPlusPerformanceQueryEntry 9 }               

	mantisPlusMinPowerChNo OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get Channel Number of minimum Power , 
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : 1 to 80 "
			::= { mantisPlusPerformanceQueryEntry 10 }              

      			           
	mantisPlusChannelsPresent OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get Number of channels Present in the Card , 
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			Possible Values : 1 to 80 "

			::= {  mantisPlusPerformanceQueryEntry 11 }  	
              
	mantisPlusPresenceStatus   OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get particular channel Presence Status,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 1  to 80
			---------------------------------
			Possible Values : 0 -> Channel Absent, 1 -> Channel Present "

			::= {  mantisPlusPerformanceQueryEntry 12 }


	mantisPlusPerformanceTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
                      "	This is MIB realted property,
			NOT to be considered as a card property"
              		::= { mantisPlusPerformanceQueryEntry 13 } 
 
 --*****************************************************************************

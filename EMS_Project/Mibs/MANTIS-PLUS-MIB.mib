			If Alarm is Present - Date and Time Stamp
			    	eg:2017-5-18,9:47:20.0,+5:30
			If Alarm is Absent  - 0 "

			::= { mantisPlusAlarmQueryEntry 3 }    
           
              
	mantisPlusGpioExpanderChipError OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get gpio Expander Chip Error Alarm Value,
			---------------------------------
			mantisPlusDirectionNo : 1
			mantisPlusPortType		: 2
			mantisPlusChannelNo	: 0
			---------------------------------
			Values :
			If Alarm is Present - Date and Time Stamp
			    	eg:2017-5-18,9:47:20.0,+5:30
			If Alarm is Absent  - 0 "

			::= { mantisPlusAlarmQueryEntry 4 }            
             
   	mantisPlusOcmCommunicationError OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
				"get ocm Communication Error Alarm Value,
			---------------------------------

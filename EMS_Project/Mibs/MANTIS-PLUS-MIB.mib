		}
		STATUS  current
		DESCRIPTION
				"This traps is sent when channel Power Alarm State alarm state changes"

			::= { mantisPlusAlarmsNotification 6 }                                           
   
--*****************************************************************************
     		                     
	snmpCurrentNotificationsGroup NOTIFICATION-GROUP
		NOTIFICATIONS 
		{ 
			mantisPlusWssElectricalPowerOutofRangeTrap, 
			mantisPlusWssTemperatureOutofRangeTrap, 
			mantisPlusWssCommunicationErrorTrap, 	
			mantisPlusGpioExpanderChipErrorTrap, 
			mantisPlusOcmCommunicationErrorTrap, 
			mantisPlusChannelPowerAlarmStateTrap
		}

		STATUS current
		DESCRIPTION
				"The UTL DWDM current notifications group"
			::= { mantisPlus 5 }
 

				msaPaEdfaLowOperatingCurrentAlarmThresholdMinimumValue			DisplayString,
				msaPaEdfaLowOperatingCurrentAlarmThresholdMaximumValue			DisplayString,
				msaPaEdfaHighOperatingCurrentWarningThreshold				DisplayString,
				msaPaEdfaHighOperatingCurrentWarningThresholdMinimumValue		DisplayString,
				msaPaEdfaHighOperatingCurrentWarningThresholdMaximumValue		DisplayString,
				msaPaEdfaLowOperatingCurrentWarningThreshold				DisplayString,
				msaPaEdfaLowOperatingCurrentWarningThresholdMinimumValue		DisplayString,
				msaPaEdfaLowOperatingCurrentWarningThresholdMaximumValue		DisplayString,
				msaPaEdfaHighTECCurrentAlarmThreshold					DisplayString,
				msaPaEdfaHighTECCurrentAlarmThresholdMinimumValue			DisplayString,

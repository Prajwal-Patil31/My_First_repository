				msaPaEdfaHighTemperatureAlarmThresholdMaximumValue			DisplayString,
				msaPaEdfaLowTemperatureAlarmThreshold					DisplayString,
				msaPaEdfaLowTemperatureAlarmThresholdMinimumValue			DisplayString,
				msaPaEdfaLowTemperatureAlarmThresholdMaximumValue			DisplayString,
				msaPaEdfaHighTemperatureWarningThreshold				DisplayString,

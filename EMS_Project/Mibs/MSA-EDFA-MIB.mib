				msaPaEdfaLowTECCurrentAlarmThresholdMaximumValue			DisplayString,
				msaPaEdfaHighTECCurrentWarningThreshold					DisplayString,
				msaPaEdfaHighTECCurrentWarningThresholdMinimumValue			DisplayString,
				msaPaEdfaHighTECCurrentWarningThresholdMaximumValue			DisplayString,
				msaPaEdfaLowTECCurrentWarningThreshold					DisplayString,
				msaPaEdfaLowTECCurrentWarningThresholdMinimumValue			DisplayString,
				msaPaEdfaLowTECCurrentWarningThresholdMaximumValue			DisplayString,
				msaPaEdfaVoaHighInputPowerAlarmThreshold				DisplayString,
				msaPaEdfaVoaHighInputPowerAlarmThresholdMinimumValue			DisplayString,
				msaPaEdfaVoaHighInputPowerAlarmThresholdMaximumValue			DisplayString,
				msaPaEdfaVoaLowInputPowerAlarmThreshold					DisplayString,
				msaPaEdfaVoaLowInputPowerAlarmThresholdMinimumValue			DisplayString,
				msaPaEdfaVoaLowInputPowerAlarmThresholdMaximumValue			DisplayString,
				msaPaEdfaVoaHighInputPowerWarningThreshold				DisplayString,
				msaPaEdfaVoaHighInputPowerWarningThresholdMinimumValue			DisplayString,
				msaPaEdfaVoaHighInputPowerWarningThresholdMaximumValue			DisplayString,
				msaPaEdfaVoaLowInputPowerWarningThreshold				DisplayString,
				msaPaEdfaVoaLowInputPowerWarningThresholdMinimumValue			DisplayString,
				msaPaEdfaVoaLowInputPowerWarningThresholdMaximumValue			DisplayString,

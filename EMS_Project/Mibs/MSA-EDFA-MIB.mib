--*****************************************************************************
--				UTL MSA EDFA MIB
--*****************************************************************************

MSA-EDFA-MIB DEFINITIONS ::= BEGIN
 
		IMPORTS
		RowStatus				FROM STANDARD-MIB

		DisplayString				FROM RFC1213-MIB       

		OBJECT-IDENTITY, 
		NOTIFICATION-TYPE, 
		MODULE-IDENTITY, 
		Integer32, 
		Unsigned32, 
		IpAddress, 
		TimeTicks				FROM SNMPv2-SMI

		OBJECT-TYPE				FROM RFC-1212

		MODULE-COMPLIANCE, 
		OBJECT-GROUP, 
		NOTIFICATION-GROUP			FROM SNMPv2-CONF
		
		node, 
		rack, 
		subRack, 
		slot 					FROM SCC-MIB

		enterprises 				FROM RFC1155-SMI		

	;

	utl   	MODULE-IDENTITY
		LAST-UPDATED    	"1807130630Z"
		ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
		CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
		DESCRIPTION     	"MIB module for UTL DWDM."
		REVISION 	    	"1807130630Z"

		DESCRIPTION    	 	"MIB module for MSA EDFA Card."

		::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
		STATUS  current

		DESCRIPTION "UTL R and D."

		::= { utl 1 }

	dwdm 				OBJECT IDENTIFIER	::=   { utlrnd 1 }
	indus 				OBJECT IDENTIFIER	::=   { dwdm 1 }
	msaEdfa 			OBJECT IDENTIFIER 	::=   { indus 142 }

	msaEdfaCardGeneralDetails 	OBJECT IDENTIFIER 	::=   { msaEdfa 1 }
	msaEdfaConfiguration 		OBJECT IDENTIFIER 	::=   { msaEdfa 2 }
	msaEdfaAlarm 			OBJECT IDENTIFIER 	::=   { msaEdfa 3 }
	msaEdfaPerformance 		OBJECT IDENTIFIER 	::=   { msaEdfa 4 }

	msaEdfaAlarmQuery 		OBJECT IDENTIFIER 	::=   { msaEdfaAlarm 1 }
	msaEdfaAlarmNotification 	OBJECT IDENTIFIER 	::=   { msaEdfaAlarm 2 }
	
--*****************************************************************************
--			MSA EDFA CARD GENERAL DETAILS
--*****************************************************************************

	msaEdfaCardGeneralDetailsTable OBJECT-TYPE
		SYNTAX  	SEQUENCE OF MsaPaBaEdfaCardGeneralDetailsEntry
		MAX-ACCESS	not-accessible
		STATUS		current

		DESCRIPTION
		 " we can get MSA EDFA card general details "

		::= { msaEdfaCardGeneralDetails 1 }

	msaEdfaCardGeneralDetailsEntry OBJECT-TYPE
		SYNTAX  	MsaPaBaEdfaCardGeneralDetailsEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION 
		 "Enter node rack, subrack, slot and msaEdfaInterface numbers"

		INDEX   { node, rack, subRack, slot, msaEdfaInterface }

		::= { msaEdfaCardGeneralDetailsTable 1 }

	MsaPaBaEdfaCardGeneralDetailsEntry ::=
		SEQUENCE {
				msaEdfaInterface					INTEGER,
				msaEdfaEepromCardId					INTEGER,
				msaEdfaEepromCardName					DisplayString,
				msaEdfaEepromPartCode					DisplayString,
				msaEdfaEepromCardSerialNumber				DisplayString,
				msaEdfaEepromHardwareExternalReleaseVersion		DisplayString,
				msaEdfaSoftwareExternalReleaseVersion			DisplayString,
				msaEdfaEepromHardwareInternalReleaseVersion		DisplayString,
				msaEdfaSoftwareInternalReleaseVersion			DisplayString,
				msaEdfaEepromCardUidNumber				DisplayString,
				msaEdfaEepromCardEUI48Number				DisplayString,
				msaEdfaEepromCardEUI64Number				DisplayString,
				msaEdfaEepromModuleType					DisplayString,
				msaEdfaInstallationDate					DisplayString,
				msaEdfaCommissionDate					DisplayString,
				msaEdfaCardRunningTime					DisplayString,
				msaEdfaCardRestartCount					INTEGER,

			   	msaPaEdfaModuleVendorName	                        DisplayString,
				msaPaEdfaModuleSerialNumber		                INTEGER,		
				msaPaEdfaModuleNumberOfChannelsSupported		INTEGER,
				msaPaEdfaModuleNumberOfPumpSupported                    INTEGER,			
				msaPaEdfaModuleMaxGainSupported				DisplayString,
				msaPaEdfaModuleSaturationOutputPowerSupported		DisplayString,
				msaPaEdfaModuleVoaPresenceStatus			INTEGER,				
				
				msaBaEdfaModuleVendorName	                        DisplayString,
				msaBaEdfaModuleSerialNumber			        INTEGER,	
				msaBaEdfaModuleNumberOfChannelsSupported	        INTEGER,		
				msaBaEdfaModuleNumberOfPumpSupported		        INTEGER,		
				msaBaEdfaModuleMaxGainSupported			        DisplayString,
				msaBaEdfaModuleSaturationOutputPowerSupported	        DisplayString,
				msaBaEdfaModuleVoaPresenceStatus                	INTEGER,				

				msaEdfaDirection					INTEGER,
				msaEdfaCardGeneralDetailsTableRowStatus			RowStatus
			}	
	
	msaEdfaInterface 	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	not-accessible
		STATUS  	current
		DESCRIPTION	
			"msa edfa interface number, should be 0 always"

		::= { msaEdfaCardGeneralDetailsEntry 1 }

	msaEdfaEepromCardId OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " Tells the card ID of the MSA EDFA card, present in the EEPROM "

		::= { msaEdfaCardGeneralDetailsEntry 2 }

	msaEdfaEepromCardName OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the card name of the MSA EDFA card, present in the EEPROM "

		::= { msaEdfaCardGeneralDetailsEntry 3 }

	msaEdfaEepromPartCode OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the part code of the MSA EDFA card, present in the EEPROM "

		::= { msaEdfaCardGeneralDetailsEntry 4 }

	msaEdfaEepromCardSerialNumber OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS		current

		DESCRIPTION
		 " This property get / set the information about MSA EDFA 
		 Card's Serial Number.
		-----------------------------
		Values:
		eg: 123456
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 5 }

	msaEdfaEepromHardwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Hardware External Release Version. This detail 
		 will be displayed to the customer. This version will increment 
		 only if there are significant architectural changes in the product.
		-----------------------------
		Value:
		eg: 0.1
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 6 }

	msaEdfaSoftwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Software External Release Version.  This detail 
		 will be displayed to the customer. This version will increment 
		 only if there are significant architectural changes in the product.
		-----------------------------
		Value:
		eg: 0.1
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 7 }

	msaEdfaEepromHardwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Hardware Internal Release Version. This detail 
		 is used for development purposes only. It differs from the external 
		 hardware version.
		-----------------------------
		Value:
		eg: 4.1
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 8 }

	msaEdfaSoftwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Software Internal Release Version.  This detail 
		 is used for development purposes only. It differs from the external 
		 software version.
		-----------------------------
		Value:
		eg: 5.1
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 9 }

	msaEdfaEepromCardUidNumber OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the Card Unique Identifier It is a 4 byte address used to 
		 uniquely identify a card.
		------------------------------
		Value:
	      	eg: 12345678
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 10 }

	msaEdfaEepromCardEUI48Number OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the Card EUI-48 Number. It’s a 6 byte address used to 
		 uniquely identify a card.
		-----------------------------
		Value:
	      	eg: 0004A3123456
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 11 }

	msaEdfaEepromCardEUI64Number OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the Card EUI-64 Number. It’s a 8 byte address
		used to uniquely identify a card.
		-----------------------------
		Value:
	      	eg: 0004A31234567890
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 12 }	

	msaEdfaEepromModuleType OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the EDFA Module Type. It represents the EDFA
		module that is connected in card.
		-----------------------------
		Value:
	      	eg: pa_edfa or ba_edfa
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 13 }

	msaEdfaInstallationDate OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS		current

		DESCRIPTION
		 " To get/set the card's installation date in dd/mm/yyyy format.
		-----------------------------
		Value:
	      	eg: 12/03/2016
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 14 }

	msaEdfaCommissionDate OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS		current

		DESCRIPTION
		 " To get/set the card's commission date in  dd/mm/yyyy format.
		-----------------------------
		Value:
	      	eg: 20/03/2016
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 15 }

	msaEdfaCardRunningTime OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the duration of time for which the card is operational/running.
		-----------------------------
		Values:
	      	eg: 3d 2h 1m
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 16 }

	msaEdfaCardRestartCount OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the number of times the card has been soft reset. This value 
		 will get reset to 0 on factory reset.
		-----------------------------
		Values:
	      	eg: 10
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 17 }	

	msaPaEdfaModuleVendorName OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get MSA PA EDFA card module vendor name.
		-----------------------------
		Values:
	      	eg: ACCELINK
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 18 }

	msaPaEdfaModuleSerialNumber OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get MSA PA EDFA card module serial number.
		-----------------------------
		Values:
	      	eg: 12345
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 19 }

	msaPaEdfaModuleNumberOfChannelsSupported OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get MSA PA EDFA card supports how many number of channels.
		-----------------------------
		Values:
	      	eg: 30
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 20 }

	msaPaEdfaModuleNumberOfPumpSupported OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get MSA PA EDFA card supports how many number of pumps.
		-----------------------------
		Values:
	      	eg: 2
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 21 }

	msaPaEdfaModuleMaxGainSupported OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get MSA PA EDFA card supports maximum gain supported.
		-----------------------------
		Values:
	      	eg: 25.0
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 22 }

	msaPaEdfaModuleSaturationOutputPowerSupported OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get MSA PA EDFA card supports saturation power.
		-----------------------------
		Values:
	      	eg: 19.0
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 23 }

	msaPaEdfaModuleVoaPresenceStatus	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  read-only
		STATUS  	current
		DESCRIPTION	" to get MSA PA EDFA inbuilt voa presence status.
		-----------------------------
		Values:
		1 - VOA present 
		0 - VOA absent
		-----------------------------"
		::= { msaEdfaCardGeneralDetailsEntry 24 }

	msaBaEdfaModuleVendorName OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get MSA BA EDFA card module vendor name.
		-----------------------------
		Values:
	      	eg: ACCELINK
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 25 }

	msaBaEdfaModuleSerialNumber OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get MSA BA EDFA card module serial number.
		-----------------------------
		Values:
	      	eg: 12345
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 26 }

	msaBaEdfaModuleNumberOfChannelsSupported OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get MSA BA EDFA card supports how many number of channels.
		-----------------------------
		Values:
	      	eg: 30
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 27 }

	msaBaEdfaModuleNumberOfPumpSupported OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get MSA BA EDFA card supports how many number of pumps.
		-----------------------------
		Values:
	      	eg: 2
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 28 }

	msaBaEdfaModuleMaxGainSupported OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get MSA BA EDFA card supports maximum gain supported.
		-----------------------------
		Values:
	      	eg: 25.0
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 29 }

	msaBaEdfaModuleSaturationOutputPowerSupported OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get MSA BA EDFA card supports saturation power.
		-----------------------------
		Values:
	      	eg: 19.0
		-----------------------------"

		::= { msaEdfaCardGeneralDetailsEntry 30 }

	msaBaEdfaModuleVoaPresenceStatus	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  read-only
		STATUS  	current
		DESCRIPTION	" to get MSA BA EDFA inbuilt voa presence status.
		-----------------------------
		Values:
		1 - VOA present 
		0 - VOA absent
		-----------------------------"
		::= { msaEdfaCardGeneralDetailsEntry 31 }

	
	msaEdfaDirection	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current
		DESCRIPTION	
		" to get MSA EDFA card Direction.
		-----------------------------
		Values:
		1 - Direction 1
		2 - Direction 2
		3 - Direction 3
		4 - Direction 4
		-----------------------------"
		::= { msaEdfaCardGeneralDetailsEntry 32 }
		
	msaEdfaCardGeneralDetailsTableRowStatus OBJECT-TYPE
	      SYNTAX      RowStatus
	      MAX-ACCESS  read-write
	      STATUS      current
	      DESCRIPTION
		      "	This is MIB realted property,
			NOT to be considered as a card property"
	      ::= { msaEdfaCardGeneralDetailsEntry 33 }
		
--*****************************************************************************
--			MSA EDFA CONFIGURATION
--***************************************************************************** 

	msaEdfaConfigurationTable OBJECT-TYPE
		SYNTAX  	SEQUENCE OF MsaPaBaEdfaConfigurationEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION
		 " we can get MSA EDFA configuration details "

		::= { msaEdfaConfiguration 1 }

		msaEdfaConfigurationEntry OBJECT-TYPE
		SYNTAX  	MsaPaBaEdfaConfigurationEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION  
		 "Enter node rack, subrack, slot and msaEdfaInterface numbers"

		INDEX   { node, rack, subRack, slot, msaEdfaInterface }

		::= { msaEdfaConfigurationTable 1 }

	MsaPaBaEdfaConfigurationEntry ::= 
		SEQUENCE {

					
				msaEdfaCardSoftReset							INTEGER,
				msaEdfaCardDefaultFactoryReset						INTEGER,
				msaEdfaAlarmMonitoringStatus						INTEGER,
				msaEdfaSystemTimeAndRtcTime						DisplayString,
				msaEdfaSyncRtcWithNtpServer						DisplayString,
				msaEdfaSyncRtcWithSystemTime						INTEGER,
				msaEdfaSyncSystemTimeWithNtpServer					DisplayString,
				msaEdfaUpdateGivenTimeIntoRtc						DisplayString,
				msaEdfaUpdateGivenTimeIntoSystem					DisplayString,
				msaPaEdfaModulePumpLaserStatus						INTEGER,
				msaPaEdfaModuleAutomaticLaserShutdownStatusForStage1			INTEGER,
				msaPaEdfaModuleOperatingMode						DisplayString,
				msaPaEdfaModuleGainInAutomaticGainControlMode				DisplayString,
				msaPaEdfaModuleGainTilt	 						DisplayString,
				msaPaEdfaModuleOpticalOutputPowerInAutomaticPowerControlMode			DisplayString,
				msaPaEdfaModulePump1OperatingCurrentInAutomaticCurrentControlMode	DisplayString,
				msaPaEdfaModuleVariableOpticalAttenuatorAttenuation			DisplayString,
				msaPaEdfaModuleResetOpticalAmplifier					INTEGER,
				msaBaEdfaModulePumpLaserStatus						INTEGER,
				msaBaEdfaModuleAutomaticLaserShutdownStatusForStage1			INTEGER,
				msaBaEdfaModuleOperatingMode						DisplayString,
				msaBaEdfaModuleOpticalOutputPowerInAutomaticPowerControlMode			DisplayString,
				msaBaEdfaModulePump1OperatingCurrentInAutomaticCurrentControlMode	DisplayString,
				msaBaEdfaModuleVariableOpticalAttenuatorAttenuation			DisplayString,
				msaBaEdfaModuleResetOpticalAmplifier					INTEGER,
				msaPaEdfaOpticalInputPowerFailureAlarmThreshold				DisplayString,
				msaPaEdfaOpticalInputPowerFailureAlarmThresholdMinimumValue		DisplayString,
				msaPaEdfaOpticalInputPowerFailureAlarmThresholdMaximumValue		DisplayString,
				msaPaEdfaHighOpticalInputPowerAlarmThreshold				DisplayString,
				msaPaEdfaHighOpticalInputPowerAlarmThresholdMinimumValue		DisplayString,
				msaPaEdfaHighOpticalInputPowerAlarmThresholdMaximumValue		DisplayString,
				msaPaEdfaLowOpticalInputPowerAlarmThreshold				DisplayString,
				msaPaEdfaLowOpticalInputPowerAlarmThresholdMinimumValue			DisplayString,
				msaPaEdfaLowOpticalInputPowerAlarmThresholdMaximumValue			DisplayString,
				msaPaEdfaHighOpticalInputPowerWarningThreshold				DisplayString,
				msaPaEdfaHighOpticalInputPowerWarningThresholdMinimumValue		DisplayString,
				msaPaEdfaHighOpticalInputPowerWarningThresholdMaximumValue		DisplayString,
				msaPaEdfaLowOpticalInputPowerWarningThreshold				DisplayString,
				msaPaEdfaLowOpticalInputPowerWarningThresholdMinimumValue		DisplayString,
				msaPaEdfaLowOpticalInputPowerWarningThresholdMaximumValue		DisplayString,
				msaPaEdfaHighOpticalOutputPowerWarningThreshold				DisplayString,
				msaPaEdfaHighOpticalOutputPowerWarningThresholdMinimumValue		DisplayString,
				msaPaEdfaHighOpticalOutputPowerWarningThresholdMaximumValue		DisplayString,
				msaPaEdfaLowOpticalOutputPowerWarningThreshold				DisplayString,
				msaPaEdfaLowOpticalOutputPowerWarningThresholdMinimumValue		DisplayString,
				msaPaEdfaLowOpticalOutputPowerWarningThresholdMaximumValue		DisplayString,
				msaPaEdfaOpticalOutputPowerFailureAlarmThreshold			DisplayString,
				msaPaEdfaOpticalOutputPowerFailureAlarmThresholdMinimumValue		DisplayString,
				msaPaEdfaOpticalOutputPowerFailureAlarmThresholdMaximumValue		DisplayString,
				msaPaEdfaHighOpticalOutputPowerAlarmThreshold				DisplayString,
				msaPaEdfaHighOpticalOutputPowerAlarmThresholdMinimumValue		DisplayString,
				msaPaEdfaHighOpticalOutputPowerAlarmThresholdMaximumValue		DisplayString,

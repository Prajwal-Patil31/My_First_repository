msaPaEdfaOpticalInputPowerFailureAlarm  		OBJECT-TYPE
		SYNTAX  				DisplayString		
		MAX-ACCESS  				read-only
		STATUS  				current
		DESCRIPTION
							"the user can get the current status of the 
							Input Power Failure status. Whenever no receive 
							power is detected, this alarm 
							will be raised and if receive power is detected,then  
							this alarm will be cleared. 			
							--------------------------------------------------------------------
							InterfaceNumber:
							Always 0
							--------------------------------------------------------------------
							Get response:
							If Alarm is Present - Date and Time Stamp
								eg:2017-5-18,9:47:20.0,+5:30
							If Alarm is Absent  - 0
							--------------------------------------------------------------------"
               	
		::= { msaEdfaAlarmQueryEntry 1 }

msaPaEdfaOpticalOutputPowerFailureAlarm  		OBJECT-TYPE
		SYNTAX  				DisplayString		
		MAX-ACCESS  				read-only
		STATUS  				current
		DESCRIPTION
							"the user can get the current status of the 
							Output Power Failure status. Whenever the transmit
							laser is OFF, this alarm 
							will be raised and if transmit power is ON,then  
							this alarm will be cleared. 			
							--------------------------------------------------------------------
							InterfaceNumber:
							Always 0
							--------------------------------------------------------------------
							Get response:
							If Alarm is Present - Date and Time Stamp
								eg:2017-5-18,9:47:20.0,+5:30
							If Alarm is Absent  - 0
							--------------------------------------------------------------------"
               	
		::= { msaEdfaAlarmQueryEntry 2 }

msaPaEdfaLowOpticalInputPowerAlarm  			OBJECT-TYPE
		SYNTAX  				DisplayString		
		MAX-ACCESS  				read-only
		STATUS  				current
		DESCRIPTION
							"the user can get the current status of the 
							Low Input Power Alarm status. Whenever the receive 
							power is lesser then the Low input power Alarm threshold, 
							this alarm will be raised and else it will be in cleared 								state			
							--------------------------------------------------------------------
							InterfaceNumber:
							Always 0
							--------------------------------------------------------------------
							Get response:
							If Alarm is Present - Date and Time Stamp
								eg:2017-5-18,9:47:20.0,+5:30
							If Alarm is Absent  - 0
							--------------------------------------------------------------------"
               	
		::= { msaEdfaAlarmQueryEntry 3 }

msaPaEdfaLowOpticalInputPowerWarning  			OBJECT-TYPE
		SYNTAX  				DisplayString		
		MAX-ACCESS  				read-only
		STATUS  				current
		DESCRIPTION

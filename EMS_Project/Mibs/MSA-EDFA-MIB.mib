	msaEdfaCardSoftReset OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-write
		STATUS  	current

		DESCRIPTION
		"Valid only as a SET command.
		Reboots the Card, Reconfigures the Card 
		i.e All Configuration Parameter	like Laser State,
		thresholds, operating mode & gain will be restored to 
		previous state.
		-----------------------------
		Values:
		Dont care, any value
		eg: 0
		-----------------------------"

		::= { msaEdfaConfigurationEntry 1 }		
	
	msaEdfaCardDefaultFactoryReset OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-write
		STATUS  	current

		DESCRIPTION
		"Valid only as a SET command.
		Sets the Card To Factory Default State
		i.e All Configuration Parameter	like Laser State,
		thresholds, operating mode & gain will be set to 
		default state. "

		::= { msaEdfaConfigurationEntry 2 }

	msaEdfaAlarmMonitoringStatus OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-write
		STATUS  	current

		DESCRIPTION
		"This property sets or gets the card's Alarm
		monitoring state. Disabling card alarm monitoring 
		will not provide any alarms and performances
		information to the user.
		-----------------------------
		Values:
		1 - Card Alarm Monitoring is enabled
		0 - Card Alarm Monitoring is disabled
		-----------------------------"

		::= { msaEdfaConfigurationEntry 3 }

  	msaEdfaSystemTimeAndRtcTime	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-only
  		STATUS  		current
  		DESCRIPTION	 	" get the system time and time value present in RTC.
  						-----------------------------
						Interface : 0
						-----------------------------"
						
  		::= { msaEdfaConfigurationEntry 5 }
  		
  	msaEdfaSyncRtcWithNtpServer	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-write
  		STATUS  		current
  		DESCRIPTION	 	"When we want to manually sync the time value
  						present in RTC with the NTP server
  						we can use this OID. We can provide NTP server
  						ip address as a value to this OID and the time
  						will be synced to that particular server. 
  						If we are not providing NTP server IP address 
  						then the system will be synced with the NTP server 
  						which is already been registered with card. 
  						If both are absent then error message will be returned.
  						-----------------------------
						Interface : 0
						-----------------------------
						If we want to provide NTP server IP address then
						Value should be a valid IP address as shown below
						: 10.254.254.254
							
						If we don't want to provide NTP server address, then no
						need to pass any value. 
						---------------------------"
  						
  		::= { msaEdfaConfigurationEntry 6 }
  		
  	msaEdfaSyncRtcWithSystemTime	 OBJECT-TYPE
		SYNTAX  		INTEGER
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
  						present in RTC with the time value in linux kernel
  						we can use this OID. With this set operation, 
  						the time available with linux kernel will be updated
  						into RTC. The value should be :
  						1"
  						
  		::= { msaEdfaConfigurationEntry 7 }

	msaEdfaSyncSystemTimeWithNtpServer	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
					present in linux kernel with the NTP server
					we can use this OID. We can provide NTP server
					ip address as a value to this OID and the time
					will be synced to that particular server. 
					If we are not providing NTP server IP address 
					then the system will be synced with the NTP server 
					which is already been registered with card. 
					If both are absent then error message will be returned
					-----------------------------
						Interface : 0
					-----------------------------
						If we want to provide NTP server IP address then
						Value should be a valid IP address as shown below
						: 10.254.254.254
						
						If we don't want to provide NTP server address then no
						need to pass any value. 
					---------------------------"
  						
  		::= { msaEdfaConfigurationEntry 8 }

  	msaEdfaUpdateGivenTimeIntoRtc	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually update RTC time
  						with the user provided time, we can use this OID.
  						With OID we need to provide time value which we
  						want to update in RTC.
  						-----------------------------
						Interface : 0
						-----------------------------
						Value should be of given format:
						YYYY-MM-DD HH:MM:SS
						
						Example: 2019-03-31 15:20:44
						---------------------------"
						
  		::= { msaEdfaConfigurationEntry 9 }

  		  		
  	msaEdfaUpdateGivenTimeIntoSystem	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually update system time
  						with the user provided time, we can use this OID.
  						With OID we need to provide time value which we
  						want to update in the system.
  						-----------------------------
						Interface : 0
						-----------------------------
						Value should be of given format:
						YYYY-MM-DD H:M:S
						
						Example: 2019-03-31 15:20:44
						---------------------------"
						
  		::= { msaEdfaConfigurationEntry 10 }
  		  		
	msaPaEdfaModulePumpLaserStatus OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-write
		STATUS  	current

		DESCRIPTION
		 " to set/get MSA PA EDFA card pump laser status.
		-----------------------------
		Values:
		1 - Laser ON
		0 - Laser OFF
		-----------------------------"

		::= { msaEdfaConfigurationEntry 11 }

	msaPaEdfaModuleAutomaticLaserShutdownStatusForStage1 OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-write
		STATUS  	current

		DESCRIPTION
		 " to set/get MSA PA EDFA card automatic laser shutdown status 
		-----------------------------
		Values:
		1 - Automatic laser shutdown function ON
		0 - Automatic laser shutdown function OFF
		-----------------------------"

		::= { msaEdfaConfigurationEntry 12 }

	msaPaEdfaModuleOperatingMode	OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS  	current

		DESCRIPTION
		 "To set/get MSA PA EDFA card module operating mode.
		-----------------------------
		Values:
		APC - Automatic power control mode
		AGC - Automatic gain control mode
		ACC - Automatic current control mode
		-----------------------------"

		::= { msaEdfaConfigurationEntry 13 }
      
	msaPaEdfaModuleGainInAutomaticGainControlMode OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS  	current

		DESCRIPTION
		 " to set/get MSA PA EDFA card module gain in automatic gain control mode 
		-----------------------------
		Values:
		eg. : 15.5
		-----------------------------"

		::= { msaEdfaConfigurationEntry 14 }
  

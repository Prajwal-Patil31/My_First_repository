								eg:2017-5-18,9:47:20.0,+5:30
							If Alarm is Absent  - 0
							--------------------------------------------------------------------"
               	
		::= { msaEdfaAlarmQueryEntry 4 }

msaPaEdfaHighOpticalInputPowerAlarm  			OBJECT-TYPE
		SYNTAX  				DisplayString		

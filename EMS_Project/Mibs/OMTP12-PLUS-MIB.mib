	omtp12PlusAlarmQueryTable OBJECT-TYPE
		SYNTAX SEQUENCE OF Omtp12PlusAlarmQueryEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			"Contains Alarm queries of the OMTP12-PLUS card"
	
		::= { omtp12PlusAlarmQuery 1 }

	omtp12PlusAlarmQueryEntry OBJECT-TYPE
		SYNTAX Omtp12PlusAlarmQueryEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION 
			""
		
		INDEX   { node, rack , subRack , slot , omtp12PlusInterfaceNumber}
	
		::= { omtp12PlusAlarmQueryTable 1 }
		
	Omtp12PlusAlarmQueryEntry ::= 
		SEQUENCE {

--*****************************************************************************
--				    PERFORMANCE
--***************************************************************************** 	
	omtp12PlusPerformanceTable OBJECT-TYPE
		SYNTAX SEQUENCE OF Omtp12PlusPerformanceEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			"we can get performance details of the OMTP12-PLUS Card"
	
		::= { omtp12PlusPerformance 1 }

	omtp12PlusPerformanceEntry OBJECT-TYPE
		SYNTAX Omtp12PlusPerformanceEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION 
			""
	
		INDEX   { node, rack , subRack , slot , omtp12PlusInterfaceNumber}
	
		::= { omtp12PlusPerformanceTable 1 }

		Omtp12PlusPerformanceEntry ::= 
			SEQUENCE {
					omtp12PlusXfpInputPower                                     		DisplayString,
				        omtp12PlusXfpOutputPower                                    		DisplayString,
				        omtp12PlusXfpBiasCurrent                                    		DisplayString,
				        omtp12PlusXfpSupplyVoltage                                  		DisplayString,
				        omtp12PlusXfpTemperature                                    		DisplayString,
				        omtp12PlusOtnFecUncorrectedWords                            		DisplayString,
				        omtp12PlusOtnFecCorrectedBits                              		DisplayString,       
				        omtp12PlusOtnFecZerosCorrectedBits                          		DisplayString,
				        omtp12PlusOtnFecOnesCorrectedBits                           		DisplayString,
				        omtp12PlusOtuBitInterleavedParityErrors                     		DisplayString,
				        omtp12PlusOtuIncomingAlignmentErrorSeconds                  		DisplayString,
				        omtp12PlusOtuBackwardErrorIndicationErrorCount                  	DisplayString,
				        omtp12PlusOtuBackwardIncomingAlignmentErrorSeconds          		DisplayString,
				        omtp12PlusOtuErrorFreeSeconds						DisplayString,
				        omtp12PlusOtuErrorSeconds						DisplayString,
				        omtp12PlusOtuBackgroundBlockErrors					DisplayString,
				        omtp12PlusOtuSevereErrorSeconds						DisplayString,

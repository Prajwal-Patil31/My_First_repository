--*****************************************************************************
--				    DIAGNOSTICS
--*****************************************************************************        

	omtp12PlusDiagnosticsTable OBJECT-TYPE
	      SYNTAX  SEQUENCE OF Omtp12PlusDiagnosticsEntry
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION
                      "Category contains properties that are used for debugging
                      card software"
		::= { omtp12PlusDiagnostics 1 }	

	omtp12PlusDiagnosticsEntry   OBJECT-TYPE
              SYNTAX  Omtp12PlusDiagnosticsEntry 
              MAX-ACCESS  not-accessible
              STATUS  current
              DESCRIPTION 
              	""
		INDEX   { node, rack , subRack , slot , omtp12PlusInterfaceNumber }
		::= { omtp12PlusDiagnosticsTable 1 }
	
	Omtp12PlusDiagnosticsEntry ::= 
		SEQUENCE {
				omtp12PlusAccessCortinaRegister			INTEGER,
				omtp12PlusCollectCortinaRegisterDump			INTEGER,
				omtp12PlusCollectCortinaModulebGpllRxLockStatus		DisplayString,
				omtp12PlusCollectCortinaModulebGpllTxLockStatus		DisplayString,
				omtp12PlusCollectCortinaModulebTxSerdesLockStatus	DisplayString,
				omtp12PlusCollectCortinaModulebTxSerdesVcoTunedValue	DisplayString,
				omtp12PlusCollectCortinaModulebXfiCupllLockStatus	DisplayString,
				omtp12PlusCollectCortinaModulebAllClockLockStatus	OCTET STRING,
				omtp12PlusDiagnosticTableRowStatus			RowStatus
			}
			
	omtp12PlusAccessCortinaRegister OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-write
		STATUS  current
		DESCRIPTION
			"Sets/gets the value of any cortina register
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg:
			example of cortina register - 76071076
			value - 1
			-----------------------------"
	::= { omtp12PlusDiagnosticsEntry 1 }	
	
	omtp12PlusCollectCortinaRegisterDump OBJECT-TYPE
		SYNTAX  INTEGER
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"create register dump of all cortina register
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
                     	This query will create registe dump in card's 
			root directory
			-----------------------------"
	::= { omtp12PlusDiagnosticsEntry 2 }	

	omtp12PlusCollectCortinaModulebGpllRxLockStatus OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads GPLL Rx clock lock status for all slices
			 of module B
			 Expected value : should be 0x00049 to indicate 
			 Value is locked
			 The following register will be read:
			 0x00c59, 0x00c99, 0x00cd9, 0x00d19
			 The register that will be read is GPLLX1_SDS_COMMON_TXLOCKD0_INTSTATUS
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp12PlusDiagnosticsEntry 3 }	
	
	omtp12PlusCollectCortinaModulebGpllTxLockStatus OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads GPLL Tx clock lock status for all slices
			 of module B
			 Expected value : should be 0x00049 to indicate 
			 Value is locked
			 The following register will be read:
			 0x00d59, 0x00d99, 0x00dd9, 0x00e19
			 The register that will be read is GPLLX1_SDS_COMMON_TXLOCKD0_INTSTATUS
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp12PlusDiagnosticsEntry 4 }

	omtp12PlusCollectCortinaModulebTxSerdesLockStatus OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads Tx serdes clock lock status for all slices
			 of module B
			 Expected value : should be 0x00049 to indicate 
			 Value is locked
			 The following register will be read:
			 0x0303d, 0x0343d, 0x0383d, 0x03c3d
			 The register that will be read is 
			 XFI32X1_SDS_XFI32X1_SDS_COMMON_TXLOCKD0_INTSTATUS
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp12PlusDiagnosticsEntry 5 }	
	
	omtp12PlusCollectCortinaModulebTxSerdesVcoTunedValue OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads Tx serdes VCO tuning value for all slices
			 of module B
			 Expected value : Value when correctly tuned should not 
			 be near extremes of 0x3F or 0x00
			 The following register will be read:
			 0x03031, 0x03431, 0x03831, 0x03c31
			 The register that will be read is XFI32X1_SDS_XFI32X1_SDS_COMMON_TXVCO0_STATUS
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp12PlusDiagnosticsEntry 6 }	

	omtp12PlusCollectCortinaModulebXfiCupllLockStatus OBJECT-TYPE
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads XFI CUPLL Lock status for all slices
			 of module B
			 Expected value : should be 0x00049 to indicate Value is locked 
			 The following register will be read:
			 0x1b438, 0x1b478, 0x1b4b8, 0x1b4f8
			 The register that will be read is XFI_CUPLL_LOCKDET_INTSTATUS
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp12PlusDiagnosticsEntry 7 }	

	omtp12PlusCollectCortinaModulebAllClockLockStatus OBJECT-TYPE
		SYNTAX  OCTET STRING
		MAX-ACCESS  read-only
		STATUS  current
		DESCRIPTION
			"reads Lock status of following clocks:
			 GPLL Rx/Tx, Tx serdes, Tx Serdes VCO tuned value and XFI CUPLLfor all slices
			 of module B.
			 Expected value : should be 0x00049 to indicate Value is locked 
			 The following register will be read:
			 0x1b438, 0x1b478, 0x1b4b8, 0x1b4f8
			 The register that will be read is XFI_CUPLL_LOCKDET_INTSTATUS
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------"
	::= { omtp12PlusDiagnosticsEntry 8 }	

	omtp12PlusDiagnosticTableRowStatus OBJECT-TYPE
              SYNTAX      RowStatus
              MAX-ACCESS  read-write
              STATUS      current
              DESCRIPTION
			"*****************************
			This is MIB realted property,
			NOT to be considered as a card property
			*****************************"
	::= { omtp12PlusDiagnosticsEntry 9 }
        

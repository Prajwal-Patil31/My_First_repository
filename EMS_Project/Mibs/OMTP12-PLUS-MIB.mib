--*****************************************************************************
--			MIB FILE FOR THE OMTP12-PLUS CARD
--*****************************************************************************

	OMTP12-PLUS-MIB DEFINITIONS ::= BEGIN

	IMPORTS

	RowStatus                               FROM STANDARD-MIB
	DisplayString                           FROM RFC1213-MIB
	   
	OBJECT-IDENTITY, 
	NOTIFICATION-TYPE, 
	MODULE-IDENTITY, 
	Integer32, 
	Unsigned32,
	IpAddress,

	TimeTicks		                FROM SNMPv2-SMI
	OBJECT-TYPE                             FROM RFC-1212

	MODULE-COMPLIANCE, 
	OBJECT-GROUP, 
	NOTIFICATION-GROUP                      FROM SNMPv2-CONF

	node, 
	rack, 
	subRack, 
	slot                                    FROM SCC-MIB 

	enterprises                             FROM RFC1155-SMI		

	;

	utl   MODULE-IDENTITY
		LAST-UPDATED    	"1807130630Z"
		ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
		CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
		DESCRIPTION     	"MIB module for NFS."
		REVISION 	    	"1807130630Z"
		DESCRIPTION    	    	"MIB module for OMTP12-PLUS Card."
		::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
		STATUS  current
		DESCRIPTION "UTL Research and Development."
		::= { utl 1 }

	dwdm OBJECT IDENTIFIER				::=	{ utlrnd 1 }
	indus OBJECT IDENTIFIER				::=	{ dwdm 1 }
	omtp12Plus OBJECT IDENTIFIER 			::=	{ indus 73 }

	omtp12PlusCardGeneralDetails OBJECT IDENTIFIER	::=	{ omtp12Plus 1 }
	omtp12PlusConfiguration OBJECT IDENTIFIER	::=	{ omtp12Plus 2 }
	omtp12PlusAlarm OBJECT IDENTIFIER		::=	{ omtp12Plus 3 }
	omtp12PlusPerformance OBJECT IDENTIFIER		::=	{ omtp12Plus 4 }
	omtp12PlusDiagnostics OBJECT IDENTIFIER 	::=	{ omtp12Plus 5 }
	
	omtp12PlusAlarmQuery OBJECT IDENTIFIER		::=	{ omtp12PlusAlarm 1 }
	omtp12PlusAlarmNotification OBJECT IDENTIFIER	::=	{ omtp12PlusAlarm 2 }

--*****************************************************************************
--				   CARD GENERAL DETAILS
--*****************************************************************************

	omtp12PlusCardGeneralDetailsTable OBJECT-TYPE
		SYNTAX SEQUENCE OF Omtp12PlusCardGeneralDetailsEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			"Contains card general details' queries for the OMTP12-PLUS card"
		::= { omtp12PlusCardGeneralDetails 1 }

	omtp12PlusCardGeneralDetailsEntry OBJECT-TYPE
		SYNTAX Omtp12PlusCardGeneralDetailsEntry
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			""				  	
		INDEX   { node, rack , subRack , slot , omtp12PlusInterfaceNumber}
		::= { omtp12PlusCardGeneralDetailsTable 1 }

	Omtp12PlusCardGeneralDetailsEntry ::= 
		SEQUENCE { 
				omtp12PlusInterfaceNumber					INTEGER,
				omtp12PlusEepromCardId					        INTEGER,
				omtp12PlusEepromCardName					DisplayString,
				omtp12PlusEepromPartCode					DisplayString,
				omtp12PlusEepromCardSerialNumber				DisplayString,
				omtp12PlusEepromHardwareExternalReleaseVersion		        DisplayString,
				omtp12PlusSoftwareExternalReleaseVersion		        DisplayString,
				omtp12PlusEepromHardwareInternalReleaseVersion		        DisplayString,
				omtp12PlusSoftwareInternalReleaseVersion		        DisplayString,
				omtp12PlusEepromCardUidNumber			                DisplayString,
				omtp12PlusEepromCardEui48Number				        DisplayString,
				omtp12PlusEepromCardEui64Number				        DisplayString,
				omtp12PlusCardRootFileSystemVersion				DisplayString,
				omtp12PlusCardInstallationDate				        DisplayString,
				omtp12PlusCardCommissionDate				        DisplayString,
				omtp12PlusCardRunningTime					DisplayString,
				omtp12PlusCardRestartCount					INTEGER,
				omtp12PlusXfpReadyForOperation				        INTEGER,
				omtp12PlusXfpI2cCommunicationStatus				INTEGER,
				omtp12PlusXfpEepromPage					        INTEGER,
				omtp12PlusCheckCodeOfXfpEepromPage				INTEGER,
				omtp12PlusExtendedCheckCodeOfXfpEepromPage			INTEGER,
				omtp12PlusXfpVendorName					        DisplayString,
				omtp12PlusXfpVendorIeeeId					DisplayString,
				omtp12PlusXfpPartNumber					        DisplayString,
				omtp12PlusXfpSerialNumber					DisplayString,
				omtp12PlusXfpRevisionNumber					DisplayString,
				omtp12PlusXfpManufacturingDate				        DisplayString,
				omtp12PlusFixedXfpLaserWavelength				DisplayString,
				omtp12PlusXfpLaserWavelengthTolerance				DisplayString,
				omtp12PlusXfpWavelengthTunabilitySupported			INTEGER,
				omtp12PlusTunableXfpLaserWavelengthError			DisplayString,
				omtp12PlusTunableXfpLaserFrequencyError			        DisplayString,
				omtp12PlusTunableXfpLaserFirstFrequency			        DisplayString,
				omtp12PlusTunableXfpLaserLastFrequency			        DisplayString,
				omtp12PlusTunableXfpWavelengthGridSpacing			DisplayString,
				omtp12PlusXfpConnectorType					DisplayString,
				omtp12PlusXfpLinkLength					        DisplayString,
				omtp12PlusXfpCdrRateSupported				        INTEGER,
				omtp12PlusXfpSignalEncodingTypeSupported			INTEGER,
				omtp12PlusXfpTransceiverCodesSupported			        INTEGER,
				omtp12PlusXfpMaximumBitrateSupported			        DisplayString,
				omtp12PlusXfpMinimumBitrateSupported			        DisplayString,
				omtp12PlusXfpMaximumCaseTemperatureSupported		        INTEGER,
				omtp12PlusXfpMaximumPowerDissipationSupported			INTEGER,
				omtp12PlusXfpMaximumPowerDissipationSupportedAtPowerDownMode	INTEGER,
				omtp12PlusXfpMaximumCurrentLimitSupportedAtPlus5vSupply		INTEGER,
				omtp12PlusXfpMaximumCurrentLimitSupportedAtPlus3Point3vSupply	INTEGER,
				omtp12PlusXfpMaximumCurrentLimitSupportedAtPlus1Point8vSupply	INTEGER,
				omtp12PlusXfpMaximumCurrentLimitSupportedAtMinus5Point2vSupply	INTEGER,
				omtp12PlusXfpLineLoopbackSupported				INTEGER,
				omtp12PlusXfpXfiLoopbackSupported				INTEGER,
				omtp12PlusXfpOptionalVpsSupported				INTEGER,
				omtp12PlusXfpLaserDisableThroughI2cSupported			INTEGER,
				omtp12PlusXfpPowerDownThroughI2cSupported			INTEGER,
				omtp12PlusXfpVpsLvRegulatorModeSupported			INTEGER,
				omtp12PlusXfpVpsBypassedRegulatorModeSupported			INTEGER,
				omtp12PlusXfpActiveFecControlSupported				INTEGER,
				omtp12PlusXfpOptionalCmuModeSupported				INTEGER,
				omtp12PlusXfpFecBerSupported					INTEGER,
				omtp12PlusXfpReceivePowerMeasurementIsInOmaOrAverage		INTEGER,
				omtp12PlusXfpActiveWavelengthControlSupported			INTEGER,
				omtp12PlusXfpTransmitterIsCooledOrUncooled			INTEGER,
				omtp12PlusXfpReceiverTypeIsPinOrApd				INTEGER,
				omtp12PlusCardGeneralDetailsTableRowStatus			RowStatus
		}

	omtp12PlusInterfaceNumber OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS not-accessible
		STATUS current
		DESCRIPTION
			"Interface number represents the port number
			InterfaceNumber to port mapping is as follows:
			1 - CLIENT-1
			2 - LINE-1(Primary)
			3 - LINE-2(Secondary)
			-----------------------------
			For properties which do not apply on any interface,
			the interface number must be passed as 0
			-----------------------------"

		::= { omtp12PlusCardGeneralDetailsEntry 1 }
		
	omtp12PlusEepromCardId OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the card ID of the OMTP12-PLUS card, present in the EEPROM
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 2 }
		
	omtp12PlusEepromCardName OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the card name of the OMTP12-PLUS card, present in the EEPROM
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 3 }
		
	omtp12PlusEepromPartCode OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the part code of the OMTP12-PLUS card, present in the EEPROM
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 4 }
		
	omtp12PlusEepromCardSerialNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property get / set the information about 
			OMTP12-PLUS Card's Serial Number.
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 123456
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 5 }
		
	omtp12PlusEepromHardwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the Card's Hardware External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are significant
			architectural changes in the product
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 0.1
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 6 }
		
	omtp12PlusSoftwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the Card's Software External Release Version. 
			This detail will be displayed to the customer.
			This version will increment only if there are
			significant architectural changes in the product
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 0.1
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 7 }
		
	omtp12PlusEepromHardwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the Card's Hardware Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external hardware version.
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 4.1
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 8 }
		
	omtp12PlusSoftwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Gets the Card's Software Internal Release Version.
			This detail is used for development purposes only.
			It differs from the external software version.
		      	-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Values:
			eg: 5.1
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 9 }
		
	omtp12PlusEepromCardUidNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the Card Unique IDentifier. It is a 4 byte
			address used to uniquely identify a card.
			----------------------------
			omtp12PlusInterfaceNumber: 0
			------------------------------
			Values:
		      	eg: 12345678
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 10 }
		
	omtp12PlusEepromCardEui48Number OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-48 Number. It’s a 6 byte address
			used to uniquely identify a card.
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 0004A3123456
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 11 }
		
	omtp12PlusEepromCardEui64Number OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Tells the Card EUI-64 Number. It’s a 8 byte address
			used to uniquely identify a card.
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 0004A31234567890
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 12 }
		
        omtp12PlusCardRootFileSystemVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card's Root File System Version
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Value:
		      	eg: 8
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 13 }
		
	omtp12PlusCardInstallationDate OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Get the card's installation date in
			dd/mm/yyyy format
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 12/03/2016
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 21 }

	omtp12PlusCardCommissionDate OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Get the card's commission date in
			dd/mm/yyyy format
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 20/03/2016
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 22 }

	omtp12PlusCardRunningTime OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the duration of time for which the card is
			operational/running
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 3d 2h 1m
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 23 }
		
	omtp12PlusCardRestartCount OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Get the number of times the card has been soft reset.
			This value will get reset to 0 on factory reset.
			-----------------------------
			omtp12PlusInterfaceNumber: 0
			-----------------------------
			Values:
		      	eg: 10
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 24 }
		
	omtp12PlusXfpReadyForOperation OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"Module not ready indicates that the XFP
			has detected a condition that tells
			transmit or receive data is invalid.
			It shall consist of logical OR of the
			following signals:
			> Transmit Signal Conditioner Loss of Lock
			> Transmitter Laser Fault
			> Receiver Signal Conditioner Loss of Lock
			(Ref: INF-8077 2.4.1)
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:		
			1 - XFP is ready for operation 
			0 - XFP is not ready for operation
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 31 }
		
	omtp12PlusXfpI2cCommunicationStatus OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"Tells whether the XFP can be accessed
			on a single 2-wire interface bus or not.
			(Ref: INF-8077 2.4.2)
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			1 - Enable I2C communication for XFP
				i.e. the XFP responds to 2-wire serial
				communication commands.
			0 - Disable I2C communication for XFP
				i.e. the XFP will not respond to or
				acknowledge any 2-wire interface communication
				from the host.
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 32 }
		
	omtp12PlusXfpEepromPage OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-write
		STATUS current
		DESCRIPTION
			"This property sets/gets the XFP EEPROM page, 
			the value represents the XFP EEPROM page number.
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 33 }
		
	omtp12PlusCheckCodeOfXfpEepromPage OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides the XFP
			check code(checksum) value for bytes 128 to 190
			present in XFP EEPROM Page number 1. 
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 34 }
		
	omtp12PlusExtendedCheckCodeOfXfpEepromPage OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides the XFP
			extended check code(checksum) value for bytes 192 to 222
			present in XFP EEPROM Page number 1. 
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: 1(EEPROM Page number)
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 35 }
		
	omtp12PlusXfpVendorName OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides Vendor Name for given XFP. 
			The vendor name shall be the full name of the 
			corporation, a commonly accepted abbreviation of 
			the name of the corporation, the SCSI company code
			for the corporation, or the stock exchange code for
			the corporation.
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: WTD
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 36 }
		
	omtp12PlusXfpVendorIeeeId OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the IEEE company Identifier for
			the vendor of XFP. A value of all zero in the 3-byte
			field indicates that the Vendor OUI is unspecified.
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: 010
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 37 }
		
	omtp12PlusXfpPartNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the vendor part number or
			product name of the XFP. A value of all zero
			indicates that the vendor Part Number is unspecified.
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: FTRX-1811-2D2
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 38 }
		
	omtp12PlusXfpSerialNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides vendor serial number defining
			the vendor’s serial number for the XFP. A value of all
			zero in the 16-byte field indicates that the vendor
			serial number is unspecified.
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: KBG02CU
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 39 }
		
	omtp12PlusXfpRevisionNumber OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"The vendor revision number defining the vendor’s
			 product revision number. A value of all zero indicates
			 that the vendor revision number is unspecified
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: RT
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 40 }
		
	omtp12PlusXfpManufacturingDate OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the manufacturing date for 
			XFP. A value of 8-byte field in ASCII which represents
			year, month and date of each two bytes. 
			Extra two bytes may be blank
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: 160224
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 41 }
		
	omtp12PlusFixedXfpLaserWavelength OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides transmitter LASER wavelength(nm)
			of the XFP
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: 1310
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 42 }
		
	omtp12PlusXfpLaserWavelengthTolerance OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides XFP wavelength tolerance in GhZ
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: 0.02
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 43 }
		
	omtp12PlusXfpWavelengthTunabilitySupported OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides information whether the XFP
			supports wavelength tunability or not.
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			1 - XFP supports wavelength tunability
			0 - XFP not supports wavelength tunability
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 44 }

	omtp12PlusTunableXfpLaserWavelengthError OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides wavelength error in pm
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: 0.02
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 45 }
		
	omtp12PlusTunableXfpLaserFrequencyError OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the monitor of current frequency
			Error of XFP. Frequency error is reported in Ghz.
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: 0.03
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 46 }
		
	omtp12PlusTunableXfpLaserFirstFrequency OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the first LASER frequency of XFP.
			The two byte value is specified in units of THz.
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: 1529.45
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 47 }
		
	omtp12PlusTunableXfpLaserLastFrequency OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property defines the last laser frequency of XFP.
		 	 The two byte value is specified in units of THz.
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:			
			eg: 1563.45
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 48 }
		
	omtp12PlusTunableXfpWavelengthGridSpacing OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property gives difference in the wavelength
			between two channels In GhZ
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:
			eg: 50
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 49 }
		
	omtp12PlusXfpConnectorType OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides information of the XFP
			connector, value indicates the external connector
			provided on the XFP.
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:
			00h 	Unknown or unspecified
			01h 	SC
			02h 	Fibre Channel Style 1 copper connector
			03h 	Fibre Channel Style 2 copper connector
			04h 	BNC/TNC
			05h 	Fibre Channel coaxial headers
			06h 	FiberJack
			07h 	LC
			08h 	MT-RJ
			09h 	MU
			0Ah 	SG
			0Bh 	Optical pigtail
			0C-1Fh 	Reserved
			20h 	HSSDC II
			21h 	Copper Pigtail
			22h-7Fh Reserved
			80-FFh 	Vendor specific
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 50 }
		
	omtp12PlusXfpLinkLength OBJECT-TYPE
		SYNTAX DisplayString
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property provides link length suported by the XFP
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:
			eg: 80.00
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 51 }
		
	omtp12PlusXfpCdrRateSupported OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property indicates which rates are supported by
			the CDR present in XFP.
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:

			Return value 1-Byte represetation:
			Byte-1  CDR Rates
			Bit-7	9.95 Gb/s
			Bit-6	10.3 Gb/s
			Bit-5	10.5 Gb/s
			Bit-4	10.7 Gb/s
			Bit-3	11.1 Gb/s
			Bit-2	Reserved
			Bit-1	Dont care for this property
			Bit-0	Dont care for this property
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 52 }
		
	omtp12PlusXfpSignalEncodingTypeSupported OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"This property indicates the serial encoding mechanisms
			that are supported by the XFP.
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:

			Return value 1-Byte represetation:
			Byte-1  Encoding Type
			Bit-7	64B/66B          
			Bit-6	8B10B     	 	 
			Bit-5	SONET Scrambled  
			Bit-4	NRZ              
			Bit-3	RZ              
			Bit-2	Reserved        
			Bit-1	Reserved         
			Bit-0	Reserved 
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 53 }
		
	omtp12PlusXfpTransceiverCodesSupported OBJECT-TYPE
		SYNTAX INTEGER
		MAX-ACCESS read-only
		STATUS current
		DESCRIPTION
			"The identifier value specifies which transceiver
			codes are supported by the XFP
			-----------------------------
			omtp12PlusInterfaceNumber:
			1 - CLIENT-1
			2 - LINE-1
			3 - LINE-2
			-----------------------------
			Values:

			Return value 8-Byte represetation:
			---------------------------------------------------------------------------------------------------------------------------------------
				  Byte-1	  Byte-2	          Byte-3	  Byte-4	          Byte-5    Byte-6    Byte-7	        Byte-8
			---------------------------------------------------------------------------------------------------------------------------------------
			Bit-7	 10GBASE-SR	 1200-MX-SN-I        	 Reserved	 1000BASE-SX/1xFC MMF	 I-64.1r   S-64.1    L-64.1	       V-64.2a
			Bit-6	 10GBASE-LR	 1200-SM-LL-L	         Reserved	 1000BASE-LX/1xFC-SMF	 I-64.1	   S-64.2a   L-64.2a	       V-64.2b
			Bit-5	 10GBASE-ER	 Extended 1550 nm	 Reserved	 2xFC-MMF/2xFC-SMF	 I-64.2r   S-64.2b   L-64.2b	       V-64.3
			Bit-4	 10GBASE-LRM	 Intermediate 1300 nm	 Reserved	 OC-48-SR	         I-64.2	   S-64.3a   L-64.2c	       Reserved
			Bit-3	 10GBASE-SW	 Reserved	         Reserved	 OC-48-IR	         I-64.3	   S-64.3b   L-64.3	       Reserved
			Bit-2	 10GBASE-LW	 Reserved	         Reserved	 OC-48-LR	         I-64.5	   S-64.5a   G.959.1 P1L1-2D2  Reserved
			Bit-1	 10GBASE-EW	 Reserved	         Reserved	 Reserved	         Reserved  S-64.5b   Reserved	       Reserved
			Bit-0	 Reserved	 Reserved	         Reserved	 Reserved	         Reserved  Reserved  Reserved	       Reserved
			-----------------------------"
		::= { omtp12PlusCardGeneralDetailsEntry 54 }
		
	omtp12PlusXfpMaximumBitrateSupported OBJECT-TYPE

--*****************************************************************************
--				CONFIGURATION
--*****************************************************************************

        omtp12PlusConfigurationTable OBJECT-TYPE
                SYNTAX SEQUENCE OF Omtp12PlusConfigurationEntry
                MAX-ACCESS not-accessible
                STATUS current
                DESCRIPTION
                	"Contains configuration queries of the OMTP12-PLUS card"
                ::= { omtp12PlusConfiguration 1 }

	omtp12PlusConfigurationEntry OBJECT-TYPE
		SYNTAX  Omtp12PlusConfigurationEntry
		MAX-ACCESS  not-accessible
		STATUS  current
		DESCRIPTION 
			""
		INDEX   { node, rack , subRack , slot , omtp12PlusInterfaceNumber}
		::= { omtp12PlusConfigurationTable 1 }

	Omtp12PlusConfigurationEntry ::= 
		SEQUENCE { 
				omtp12PlusCardSoftwareUpgrade						DisplayString,
				omtp12PlusCardSignalMonitorState					INTEGER,
				omtp12PlusCardOpticalMonitorState					INTEGER,
				omtp12PlusCardSoftReset							INTEGER,
				omtp12PlusCardFactoryReset						INTEGER,
				omtp12PlusCardAccessStatus						INTEGER,
				omtp12PlusSyncSystemTimeWithNtpServer				DisplayString,
				omtp12PlusSyncRtcWithNtpServer						DisplayString,
				omtp12PlusSyncRtcWithSystemTime						DisplayString,
				omtp12PlusUpdateGivenTimeIntoSystem					DisplayString,
				omtp12PlusUpdateGivenTimeIntoRtc					DisplayString,
				omtp12PlusSystemTimeAndRtcTime						DisplayString,
				omtp12PlusApsLinePathSwitchingMode					INTEGER,
				omtp12PlusApsUserChoiceOfLinePath					INTEGER,
				omtp12PlusApsCurrentOperationalLinePath					INTEGER,
				omtp12PlusTrafficConfiguration						INTEGER,
				omtp12PlusLoopbackState							INTEGER,
				omtp12PlusPortSignalMonitorState					INTEGER,
				omtp12PlusPortOpticalMonitorState					INTEGER,
				omtp12PlusClearSignalPerformance					INTEGER,
				omtp12PlusAlsState							INTEGER,
				omtp12PlusAlsPulseRepetitionTime					INTEGER,
				omtp12PlusOtuFecConfiguration						INTEGER,
				omtp12PlusOtuSignalFailThreshold					INTEGER,
				omtp12PlusOtuSignalDegradeThreshold					INTEGER,
				omtp12PlusOtuAlarmIndicationSignalAlarmInsertion			INTEGER,
				omtp12PlusOtuSapiTransmitTraceMessage					DisplayString,
				omtp12PlusOtuDapiTransmitTraceMessage					DisplayString,
				omtp12PlusOtuOperatorSpecificTransmitTraceMessage			DisplayString,
				omtp12PlusOtuSapiExpectedTraceMessage					DisplayString,
				omtp12PlusOtuDapiExpectedTraceMessage					DisplayString,
				omtp12PlusOtuOperatorSpecificExpectedTraceMessage			DisplayString,
				omtp12PlusOtuSapiReceivedTraceMessage					DisplayString,
				omtp12PlusOtuDapiReceivedTraceMessage					DisplayString,
				omtp12PlusOtuOperatorSpecificReceivedTraceMessage			DisplayString,
				omtp12PlusOduSignalFailThreshold					INTEGER,
				omtp12PlusOduSignalDegradeThreshold					INTEGER,
				omtp12PlusOduAlarmIndicationSignalAlarmInsertion			INTEGER,
				omtp12PlusOduLockedDefectAlarmInsertion					INTEGER,
				omtp12PlusOduOpenConnectionIndicationAlarmInsertion			INTEGER,
				omtp12PlusOduSapiTransmitTraceMessage					DisplayString,
				omtp12PlusOduDapiTransmitTraceMessage					DisplayString,
				omtp12PlusOduOperatorSpecificTransmitTraceMessage			DisplayString,
				omtp12PlusOduSapiExpectedTraceMessage					DisplayString,
				omtp12PlusOduDapiExpectedTraceMessage					DisplayString,
				omtp12PlusOduOperatorSpecificExpectedTraceMessage			DisplayString,
				omtp12PlusOduSapiReceivedTraceMessage					DisplayString,
				omtp12PlusOduDapiReceivedTraceMessage					DisplayString,
				omtp12PlusOduOperatorSpecificReceivedTraceMessage			DisplayString,
				omtp12PlusOpuTransmitPayloadType					INTEGER,
				omtp12PlusOpuReceivedPayloadType					INTEGER,
				omtp12PlusSdhMsB2ExcessiveErrorThreshold				INTEGER,
				omtp12PlusSdhMsB2SignalDegradeThreshold					INTEGER,
				omtp12PlusWan10gMsB2ExcessiveErrorThreshold					INTEGER,
				omtp12PlusWan10gMsB2SignalDegradeThreshold				INTEGER,
				omtp12PlusTunableXfpLaserWavelength					INTEGER,
				omtp12PlusTunableXfpLaserChannelNumber					INTEGER,
				omtp12PlusXfpLaserState							INTEGER,
				omtp12PlusXfpReset							INTEGER,
				omtp12PlusXfpPowerDownMode						INTEGER,
				omtp12PlusXfpLineLoopback						INTEGER,
				omtp12PlusXfpXfiLoopback						INTEGER,
				omtp12PlusXfpAmplitudeThresholdOfReceiverForFecControl			INTEGER,
				omtp12PlusXfpPhaseInEyeDiagramForFecControl				INTEGER,
				omtp12PlusXfpSystemReportingBer						INTEGER,
				omtp12PlusXfpHighTemperatureAlarmThreshold				DisplayString,
				omtp12PlusXfpLowTemperatureAlarmThreshold				DisplayString,
				omtp12PlusXfpHighTemperatureWarningThreshold				DisplayString,
				omtp12PlusXfpLowTemperatureWarningThreshold				DisplayString,
				omtp12PlusXfpHighBiasCurrentAlarmThreshold				DisplayString,
				omtp12PlusXfpLowBiasCurrentAlarmThreshold				DisplayString,
				omtp12PlusXfpHighBiasCurrentWarningThreshold				DisplayString,
				omtp12PlusXfpLowBiasCurrentWarningThreshold				DisplayString,
				omtp12PlusXfpInputHighPowerAlarmThreshold				DisplayString,
				omtp12PlusXfpInputLowPowerAlarmThreshold				DisplayString,
				omtp12PlusXfpInputHighPowerWarningThreshold				DisplayString,
				omtp12PlusXfpInputLowPowerWarningThreshold				DisplayString,
				omtp12PlusXfpOutputHighPowerAlarmThreshold				DisplayString,
				omtp12PlusXfpOutputLowPowerAlarmThreshold				DisplayString,
				omtp12PlusXfpOutputHighPowerWarningThreshold				DisplayString,
				omtp12PlusXfpOutputLowPowerWarningThreshold				DisplayString,
				omtp12PlusXfpHighSupplyVoltageAlarmThreshold				DisplayString,
				omtp12PlusXfpLowSupplyVoltageAlarmThreshold				DisplayString,
				omtp12PlusXfpHighSupplyVoltageWarningThreshold				DisplayString,
				omtp12PlusXfpLowSupplyVoltageWarningThreshold				DisplayString,
				omtp12PlusXfpInputPowerFailureAlarmInhibit				INTEGER,
				omtp12PlusXfpOutputPowerFailureAlarmInhibit				INTEGER,
				omtp12PlusXfpHighTemperatureAlarmInhibit				INTEGER,
				omtp12PlusXfpLowTemperatureAlarmInhibit					INTEGER,
				omtp12PlusXfpHighTemperatureWarningInhibit				INTEGER,
				omtp12PlusXfpLowTemperatureWarningInhibit				INTEGER,
				omtp12PlusXfpHighBiasCurrentAlarmInhibit				INTEGER,
				omtp12PlusXfpLowBiasCurrentAlarmInhibit					INTEGER,
				omtp12PlusXfpHighBiasCurrentWarningInhibit				INTEGER,
				omtp12PlusXfpLowBiasCurrentWarningInhibit				INTEGER,
				omtp12PlusXfpInputHighPowerAlarmInhibit					INTEGER,
				omtp12PlusXfpInputLowPowerAlarmInhibit					INTEGER,
				omtp12PlusXfpInputHighPowerWarningInhibit				INTEGER,
				omtp12PlusXfpInputLowPowerWarningInhibit				INTEGER,
				omtp12PlusXfpOutputHighPowerAlarmInhibit				INTEGER,

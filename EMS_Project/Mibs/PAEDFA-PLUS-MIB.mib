				paEdfaPlusOpticalHighOutputPowerAlarmForStage2Inhibit					INTEGER,
				paEdfaPlusOpticalLowOutputPowerAlarmForStage1Inhibit					INTEGER,
				paEdfaPlusOpticalLowOutputPowerAlarmForStage2Inhibit					INTEGER,
				paEdfaPlusOpticalHighOutputPowerWarningForStage1Inhibit					INTEGER,
				paEdfaPlusOpticalHighOutputPowerWarningForStage2Inhibit					INTEGER,
				paEdfaPlusOpticalLowOutputPowerWarningForStage1Inhibit					INTEGER,
				paEdfaPlusOpticalLowOutputPowerWarningForStage2Inhibit					INTEGER,
				paEdfaPlusModuleHighTemperatureAlarmInhibit						INTEGER,
				paEdfaPlusModuleLowTemperatureAlarmInhibit						INTEGER,
				paEdfaPlusModuleHighTemperatureWarningInhibit						INTEGER,
				paEdfaPlusModuleLowTemperatureWarningInhibit						INTEGER,
				paEdfaPlusPump1HighTemperatureAlarmInhibit						INTEGER,
				paEdfaPlusPump2HighTemperatureAlarmInhibit						INTEGER,
				paEdfaPlusPump1LowTemperatureAlarmInhibit						INTEGER,
				paEdfaPlusPump2LowTemperatureAlarmInhibit						INTEGER,
				paEdfaPlusPump1HighTemperatureWarningInhibit						INTEGER,
				paEdfaPlusPump2HighTemperatureWarningInhibit						INTEGER,
				paEdfaPlusPump1LowTemperatureWarningInhibit						INTEGER,
				paEdfaPlusPump2LowTemperatureWarningInhibit						INTEGER,
				paEdfaPlusPump1HighOperatingCurrentAlarmInhibit						INTEGER,
				paEdfaPlusPump2HighOperatingCurrentAlarmInhibit						INTEGER,
				paEdfaPlusPump1LowOperatingCurrentAlarmInhibit						INTEGER,
				paEdfaPlusPump2LowOperatingCurrentAlarmInhibit						INTEGER,
				paEdfaPlusPump1HighOperatingCurrentWarningInhibit					INTEGER,
				paEdfaPlusPump2HighOperatingCurrentWarningInhibit					INTEGER,
				paEdfaPlusPump1LowOperatingCurrentWarningInhibit					INTEGER,
				paEdfaPlusPump2LowOperatingCurrentWarningInhibit					INTEGER,
				paEdfaPlusPump1HighThermoElectricCoolerCurrentAlarmInhibit				INTEGER,
				paEdfaPlusPump2HighThermoElectricCoolerCurrentAlarmInhibit				INTEGER,
				paEdfaPlusPump1LowThermoElectricCoolerCurrentAlarmInhibit				INTEGER,
				paEdfaPlusPump2LowThermoElectricCoolerCurrentAlarmInhibit				INTEGER,
				paEdfaPlusPump1HighThermoElectricCoolerCurrentWarningInhibit				INTEGER,
				paEdfaPlusPump2HighThermoElectricCoolerCurrentWarningInhibit				INTEGER,
				paEdfaPlusPump1LowThermoElectricCoolerCurrentWarningInhibit				INTEGER,
				paEdfaPlusPump2LowThermoElectricCoolerCurrentWarningInhibit				INTEGER,
				paEdfaPlusVariableOpticalAttenuatorHighInputPowerAlarmInhibit				INTEGER,
				paEdfaPlusVariableOpticalAttenuatorLowInputPowerAlarmInhibit				INTEGER,

--*****************************************************************************
--				UTL PA EDFA PLUS MIB
--*****************************************************************************

PAEDFA-PLUS-MIB DEFINITIONS ::= BEGIN
 
		IMPORTS
		RowStatus				FROM STANDARD-MIB

		DisplayString				FROM RFC1213-MIB       

		OBJECT-IDENTITY, 
		NOTIFICATION-TYPE, 
		MODULE-IDENTITY, 
		Integer32, 
		Unsigned32, 
		IpAddress, 
		TimeTicks				FROM SNMPv2-SMI

		OBJECT-TYPE				FROM RFC-1212

		MODULE-COMPLIANCE, 
		OBJECT-GROUP, 
		NOTIFICATION-GROUP			FROM SNMPv2-CONF
		
		node, 
		rack, 
		subRack, 
		slot 					FROM SCC-MIB

		enterprises 				FROM RFC1155-SMI		

	;

	utl   	MODULE-IDENTITY
		LAST-UPDATED    	"1807130630Z"
		ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
		CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
		DESCRIPTION     	"MIB module for UTL DWDM."
		REVISION 	    	"1807130630Z"

		DESCRIPTION    	 	"MIB module for PA EDFA Plus Card."

		::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
		STATUS  current

		DESCRIPTION "UTL R and D."

		::= { utl 1 }

	dwdm 				OBJECT IDENTIFIER	::=   { utlrnd 1 }
	indus 				OBJECT IDENTIFIER	::=   { dwdm 1 }
	paEdfaPlus 			OBJECT IDENTIFIER 	::=   { indus 141 }

	paEdfaPlusCardGeneralDetails 	OBJECT IDENTIFIER 	::=   { paEdfaPlus 1 }
	paEdfaPlusConfiguration 	OBJECT IDENTIFIER 	::=   { paEdfaPlus 2 }
	paEdfaPlusAlarm 		OBJECT IDENTIFIER 	::=   { paEdfaPlus 3 }
	paEdfaPlusPerformance 		OBJECT IDENTIFIER 	::=   { paEdfaPlus 4 }	

	paEdfaPlusAlarmQuery 		OBJECT IDENTIFIER 	::=   { paEdfaPlusAlarm 1 }
	paEdfaPlusAlarmNotification 	OBJECT IDENTIFIER 	::=   { paEdfaPlusAlarm 2 }

--*****************************************************************************
--			PA EDFA PLUS CARD GENERAL DETAILS
--*****************************************************************************

	paEdfaPlusCardGeneralDetailsTable OBJECT-TYPE
		SYNTAX  	SEQUENCE OF PaEdfaPlusCardGeneralDetailsEntry
		MAX-ACCESS	not-accessible
		STATUS		current

		DESCRIPTION
		 " we can get PA EDFA PLUS card general details "

		::= { paEdfaPlusCardGeneralDetails 1 }

	paEdfaPlusCardGeneralDetailsEntry OBJECT-TYPE
		SYNTAX  	PaEdfaPlusCardGeneralDetailsEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION 
		 "Enter node rack, subrack, slot and paEdfaPlusInterface numbers"

		INDEX   { node, rack, subRack, slot, paEdfaPlusInterface }

		::= { paEdfaPlusCardGeneralDetailsTable 1 }

	PaEdfaPlusCardGeneralDetailsEntry ::=
		SEQUENCE {
				paEdfaPlusInterface					INTEGER,
				paEdfaPlusEepromCardId					INTEGER,
				paEdfaPlusEepromCardName				DisplayString,
				paEdfaPlusEepromPartCode				DisplayString,
				paEdfaPlusEepromCardSerialNumber			DisplayString,
				paEdfaPlusEepromHardwareExternalReleaseVersion		DisplayString,
				paEdfaPlusSoftwareExternalReleaseVersion		DisplayString,
				paEdfaPlusEepromHardwareInternalReleaseVersion		DisplayString,
				paEdfaPlusSoftwareInternalReleaseVersion		DisplayString,
				paEdfaPlusEepromCardUidNumber				DisplayString,
				paEdfaPlusEepromCardEUI48Number				DisplayString,
				paEdfaPlusEepromCardEUI64Number				DisplayString,
				paEdfaPlusCardRootFileSystemVersion			DisplayString,
				paEdfaPlusInstallationDate				DisplayString,
				paEdfaPlusCommissionDate				DisplayString,
				paEdfaPlusCardRunningTime				DisplayString,
				paEdfaPlusCardRestartCount				INTEGER,
				paEdfaPlusModuleVendorName				DisplayString,
				paEdfaPlusModuleSerialNumber				DisplayString,
				paEdfaPlusNumberOfChannelsSupported			INTEGER,
				paEdfaPlusNumberOfPumpSupported				INTEGER,
				paEdfaPlusMaxGainSupported				DisplayString,
				paEdfaPlusSaturationOutputPowerSupported		DisplayString,
				paEdfaPlusMidStageAccessSupport				INTEGER,
				paEdfaPlusDirection					INTEGER,
				paEdfaPlusStage2VoaPresenceStatus			INTEGER,
				paEdfaPlusCardGeneralDetailsTableRowStatus		RowStatus
			}

	paEdfaPlusInterface 	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  not-accessible
		STATUS  	current
		DESCRIPTION	
			"pa edfa plus interface number, should be 0 always"

		::= { paEdfaPlusCardGeneralDetailsEntry 1 }

	paEdfaPlusEepromCardId OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " Tells the card ID of the PAEDFA-PLUS card, present in the EEPROM "

		::= { paEdfaPlusCardGeneralDetailsEntry 2 }

	paEdfaPlusEepromCardName OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the card name of the PAEDFA-PLUS card, present in the EEPROM "

		::= { paEdfaPlusCardGeneralDetailsEntry 3 }

	paEdfaPlusEepromPartCode OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the part code of the PAEDFA-PLUS card, present in the EEPROM "

		::= { paEdfaPlusCardGeneralDetailsEntry 4 }

	paEdfaPlusEepromCardSerialNumber OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS		current

		DESCRIPTION
		 " This property get / set the information about PAEDFA-PLUS 
		 Card's Serial Number.
		-----------------------------
		Values:
		eg: 123456
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 5 }

	paEdfaPlusEepromHardwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Hardware External Release Version. This detail 
		 will be displayed to the customer. This version will increment 
		 only if there are significant architectural changes in the product.
		-----------------------------
		Value:
		eg: 0.1
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 6 }

	paEdfaPlusSoftwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Software External Release Version.  This detail 
		 will be displayed to the customer. This version will increment 
		 only if there are significant architectural changes in the product.
		-----------------------------
		Value:
		eg: 0.1
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 7 }

	paEdfaPlusEepromHardwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Hardware Internal Release Version. This detail 
		 is used for development purposes only. It differs from the external 
		 hardware version.
		-----------------------------
		Value:
		eg: 4.1
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 8 }

	paEdfaPlusSoftwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Software Internal Release Version.  This detail 
		 is used for development purposes only. It differs from the external 
		 software version.
		-----------------------------
		Value:
		eg: 5.1
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 9 }

	paEdfaPlusEepromCardUidNumber OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the Card Unique Identifier It is a 4 byte address used to 
		 uniquely identify a card.
		------------------------------
		Value:
	      	eg: 12345678
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 10 }

	paEdfaPlusEepromCardEUI48Number OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the Card EUI-48 Number. It’s a 6 byte address used to 
		 uniquely identify a card.
		-----------------------------
		Value:
	      	eg: 0004A3123456
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 11 }

	paEdfaPlusEepromCardEUI64Number OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the Card EUI-64 Number. It’s a 8 byte address
		used to uniquely identify a card.
		-----------------------------
		Value:
	      	eg: 0004A31234567890
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 12 }
		
        paEdfaPlusCardRootFileSystemVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card's Root File System Version
			-----------------------------
			paEdfaPlusInterface: 0
			-----------------------------
			Value:
		      	eg: 8
			-----------------------------"
		::= { paEdfaPlusCardGeneralDetailsEntry 13 }

	paEdfaPlusInstallationDate OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS		current

		DESCRIPTION
		 " To get/set the card's installation date in dd/mm/yyyy format.
		-----------------------------
		Value:
	      	eg: 12/03/2016
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 21 }

	paEdfaPlusCommissionDate OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS		current

		DESCRIPTION
		 " To get/set the card's commission date in  dd/mm/yyyy format.
		-----------------------------
		Value:
	      	eg: 20/03/2016
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 22 }

	paEdfaPlusCardRunningTime OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the duration of time for which the card is operational/running.
		-----------------------------
		Values:
	      	eg: 3d 2h 1m
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 23 }

	paEdfaPlusCardRestartCount OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the number of times the card has been soft reset. This value 
		 will get reset to 0 on factory reset.
		-----------------------------
		Values:
	      	eg: 10
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 24 }

	paEdfaPlusModuleVendorName OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get PA EDFA PLUS card module vendor name.
		-----------------------------
		Values:
	      	eg: ACCELINK
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 31 }

	paEdfaPlusModuleSerialNumber OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get PA EDFA PLUS card module serial number.
		-----------------------------
		Values:
	      	eg: 12345
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 32 }

	paEdfaPlusNumberOfChannelsSupported OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get PA EDFA PLUS card supports how many number of channels.
		-----------------------------
		Values:
	      	eg: 30
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 33 }

	paEdfaPlusNumberOfPumpSupported OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get PA EDFA PLUS card supports how many number of pumps.
		-----------------------------
		Values:
	      	eg: 2
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 34 }

	paEdfaPlusMaxGainSupported OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get PA EDFA PLUS card supports maximum gain supported.
		-----------------------------
		Values:
	      	eg: 25.0
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 35 }

	paEdfaPlusSaturationOutputPowerSupported OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get PA EDFA PLUS card supports saturation power.
		-----------------------------
		Values:
	      	eg: 19.0
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 36 }

	paEdfaPlusMidStageAccessSupport OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get PA EDFA PLUS card supoort status of mid stage access.
		-----------------------------
		Values:
	      	1 - MSA supported
		0 - MSA not supported
		-----------------------------"

		::= { paEdfaPlusCardGeneralDetailsEntry 37 }
		
	paEdfaPlusDirection	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  read-only
		STATUS  	current
		DESCRIPTION	
		" to get BA EDFA card Direction.
		-----------------------------
		Values:
		1 - Direction 1
		2 - Direction 2
		3 - Direction 3
		4 - Direction 4
		-----------------------------"
		::= { paEdfaPlusCardGeneralDetailsEntry 38 }

	paEdfaPlusStage2VoaPresenceStatus	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  read-only
		STATUS  	current
		DESCRIPTION	" to get PA EDFA PLUS inbuilt voa presence status.
		-----------------------------
		Values:
		1 - VOA present stage 2
		0 - VOA absent
		-----------------------------"
		::= { paEdfaPlusCardGeneralDetailsEntry 39 }

	paEdfaPlusCardGeneralDetailsTableRowStatus OBJECT-TYPE
	      SYNTAX      RowStatus
	      MAX-ACCESS  read-write
	      STATUS      current
	      DESCRIPTION
		      "	This is MIB realted property,
			NOT to be considered as a card property"
	      ::= { paEdfaPlusCardGeneralDetailsEntry 40 }

--*****************************************************************************
--			PA EDFA PLUS CONFIGURATION
--***************************************************************************** 

	paEdfaPlusConfigurationTable OBJECT-TYPE
		SYNTAX  	SEQUENCE OF PaEdfaPlusConfigurationEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION
		 " we can get PA EDFA PLUS configuration details "

		::= { paEdfaPlusConfiguration 1 }
              
        paEdfaPlusConfigurationEntry OBJECT-TYPE
		SYNTAX  	PaEdfaPlusConfigurationEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION  
		 "Enter node rack, subrack, slot and paEdfaPlusInterface numbers"

		INDEX   { node, rack, subRack, slot, paEdfaPlusInterface }

		::= { paEdfaPlusConfigurationTable 1 }
	
	PaEdfaPlusConfigurationEntry ::= 
		SEQUENCE {
				paEdfaPlusCardSoftReset	 								INTEGER,
				paEdfaPlusCardDefaultFactoryReset							INTEGER,
				paEdfaPlusAlarmMonitoringStatus	 							INTEGER,
				paEdfaPlusManageUnmanageStatus								INTEGER,
				paEdfaPlusSyncSystemTimeWithNtpServer				DisplayString,
				paEdfaPlusSyncRtcWithNtpServer						DisplayString,
				paEdfaPlusSyncRtcWithSystemTime						DisplayString,
				paEdfaPlusUpdateGivenTimeIntoSystem					DisplayString,
				paEdfaPlusUpdateGivenTimeIntoRtc					DisplayString,
				paEdfaPlusSystemTimeAndRtcTime						DisplayString,
				paEdfaPlusVariableOpticalAttenuatorReset						INTEGER,
				paEdfaPlusPump1LaserStatus	 							INTEGER,
				paEdfaPlusPump2LaserStatus	 							INTEGER,
				paEdfaPlusAutomaticPowerReductionStatusForStage1					INTEGER,
				paEdfaPlusAutomaticPowerReductionStatusForStage2					INTEGER,
				paEdfaPlusAutomaticLaserShutdownStatusForStage1						INTEGER,
				paEdfaPlusAutomaticLaserShutdownStatusForStage2						INTEGER,
				paEdfaPlusModuleOperatingModeForStage1							DisplayString,
				paEdfaPlusModuleOperatingModeForStage2							DisplayString,
				paEdfaPlusModuleGainInAutomaticGainControlModeForStage1					DisplayString,
				paEdfaPlusModuleGainInAutomaticGainControlModeForStage2					DisplayString,

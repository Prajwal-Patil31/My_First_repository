				paEdfaPlusPump1OperatingCurrentInAutomaticCurrentControlMode				DisplayString,
				paEdfaPlusPump2OperatingCurrentInAutomaticCurrentControlMode				DisplayString,
				paEdfaPlusGainTilt	 								DisplayString,
				paEdfaPlusVariableOpticalAttenuatorAttenuationForStage2					DisplayString,
				paEdfaPlusOutputPowerLimitFunctionStatusInAutomaticGainControlModeForStage1		INTEGER,
				paEdfaPlusOutputPowerLimitFunctionStatusInAutomaticGainControlModeForStage2		INTEGER,
				paEdfaPlusOutputPowerLimitInAutomaticGainControlModeForStage1				DisplayString,
				paEdfaPlusOutputPowerLimitInAutomaticGainControlModeForStage2				DisplayString,
				paEdfaPlusAutomaticPowerReductionForStage1Threshold					DisplayString,
				paEdfaPlusAutomaticPowerReductionForStage2Threshold					DisplayString,
				paEdfaPlusOpticalInputPowerFailureAlarmForStage1Threshold				DisplayString,
				paEdfaPlusOpticalInputPowerFailureAlarmForStage2Threshold				DisplayString,
				paEdfaPlusOpticalHighInputPowerAlarmForStage1Threshold					DisplayString,

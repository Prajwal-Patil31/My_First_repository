				paEdfaPlusOpticalHighInputPowerAlarmForStage2Inhibit					INTEGER,
				paEdfaPlusOpticalLowInputPowerAlarmForStage1Inhibit	 				INTEGER,
				paEdfaPlusOpticalLowInputPowerAlarmForStage2Inhibit	 				INTEGER,
				paEdfaPlusOpticalHighInputPowerWarningForStage1Inhibit	 				INTEGER,
				paEdfaPlusOpticalHighInputPowerWarningForStage2Inhibit	 				INTEGER,
				paEdfaPlusOpticalLowInputPowerWarningForStage1Inhibit 					INTEGER,
				paEdfaPlusOpticalLowInputPowerWarningForStage2Inhibit 					INTEGER,
				paEdfaPlusOpticalOutputPowerFailureAlarmForStage1Inhibit				INTEGER,

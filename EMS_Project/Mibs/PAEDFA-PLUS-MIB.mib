				paEdfaPlusOpticalHighOutputPowerWarningForStage2Threshold				DisplayString,
				paEdfaPlusOpticalLowOutputPowerWarningForStage1Threshold				DisplayString,
				paEdfaPlusOpticalLowOutputPowerWarningForStage2Threshold				DisplayString,
				paEdfaPlusModuleHighTemperatureAlarmThreshold						DisplayString,
				paEdfaPlusModuleLowTemperatureAlarmThreshold						DisplayString,
				paEdfaPlusModuleHighTemperatureWarningThreshold						DisplayString,
				paEdfaPlusModuleLowTemperatureWarningThreshold						DisplayString,
				paEdfaPlusPump1HighTemperatureAlarmThreshold						DisplayString,
				paEdfaPlusPump2HighTemperatureAlarmThreshold						DisplayString,
				paEdfaPlusPump1LowTemperatureAlarmThreshold						DisplayString,
				paEdfaPlusPump2LowTemperatureAlarmThreshold						DisplayString,
				paEdfaPlusPump1HighTemperatureWarningThreshold						DisplayString,
				paEdfaPlusPump2HighTemperatureWarningThreshold						DisplayString,
				paEdfaPlusPump1LowTemperatureWarningThreshold						DisplayString,
				paEdfaPlusPump2LowTemperatureWarningThreshold						DisplayString,
				paEdfaPlusPump1HighOperatingCurrentAlarmThreshold					DisplayString,

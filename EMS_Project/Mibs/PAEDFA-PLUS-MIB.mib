				paEdfaPlusOpticalLowInputPowerWarningForStage1Threshold					DisplayString,
				paEdfaPlusOpticalLowInputPowerWarningForStage2Threshold					DisplayString,
				paEdfaPlusOpticalOutputPowerFailureAlarmForStage1Threshold				DisplayString,
				paEdfaPlusOpticalOutputPowerFailureAlarmForStage2Threshold				DisplayString,
				paEdfaPlusOpticalHighOutputPowerAlarmForStage1Threshold					DisplayString,
				paEdfaPlusOpticalHighOutputPowerAlarmForStage2Threshold					DisplayString,
				paEdfaPlusOpticalLowOutputPowerAlarmForStage1Threshold					DisplayString,
				paEdfaPlusOpticalLowOutputPowerAlarmForStage2Threshold					DisplayString,

--*****************************************************************************
--				PA EDFA PLUS PERFORMANCE
--***************************************************************************** 

	paEdfaPlusPerformanceTable OBJECT-TYPE
		SYNTAX  	SEQUENCE OF PaEdfaPlusPerformanceEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION
		 "we can get PA EDFA PLUS card performance details "

		::= { paEdfaPlusPerformance 1 }
	      
	paEdfaPlusPerformanceEntry OBJECT-TYPE
		SYNTAX  	PaEdfaPlusPerformanceEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION 
		 "Enter node rack, subrack, slot and paEdfaPlusInterface numbers"

		INDEX   { node, rack, subRack, slot, paEdfaPlusInterface }

		::= { paEdfaPlusPerformanceTable 1 }
	
	PaEdfaPlusPerformanceEntry ::= 
		SEQUENCE {
				paEdfaPlusModuleTemperature					DisplayString,
				paEdfaPlusInputPowerForStage1					DisplayString,
				paEdfaPlusInputPowerForStage2					DisplayString,
				paEdfaPlusOutputPowerForStage1					DisplayString,
				paEdfaPlusOutputPowerForStage2					DisplayString,
				paEdfaPlusAmplifiedSpontaneousEmmissionPowerForStage1		DisplayString,
				paEdfaPlusAmplifiedSpontaneousEmmissionPowerForStage2		DisplayString,
				paEdfaPlusSignalGainForStage1					DisplayString,
				paEdfaPlusSignalGainForStage2					DisplayString,
				paEdfaPlusSignalOutputPowerForStage1				DisplayString,
				paEdfaPlusSignalOutputPowerForStage2				DisplayString,
				paEdfaPlusPump1LaserPower					DisplayString,
				paEdfaPlusPump2LaserPower					DisplayString,
				paEdfaPlusPump1Temperature					DisplayString,
				paEdfaPlusPump2Temperature					DisplayString,
				paEdfaPlusPump1OperatingCurrent					DisplayString,
				paEdfaPlusPump2OperatingCurrent					DisplayString,
				paEdfaPlusPump1ThermoElectricCoolerCurrent			DisplayString,
				paEdfaPlusPump2ThermoElectricCoolerCurrent			DisplayString,
				paEdfaPlusPump1CoolingTemperature				DisplayString,
				paEdfaPlusPump2CoolingTemperature				DisplayString,
				paEdfaPlusVariableOpticalAttenuatorInputPower			DisplayString,
				paEdfaPlusVariableOpticalAttenuatorOutputPower			DisplayString,
				paEdfaPlusVariableOpticalAttenuatorActualAttenuation		DisplayString,
				paEdfaPlusPerformanceTableRowStatus				RowStatus
			}
	

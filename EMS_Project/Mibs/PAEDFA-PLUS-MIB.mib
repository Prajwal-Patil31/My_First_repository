--*****************************************************************************
--				PA EDFA PLUS ALARMS
--*****************************************************************************         
              
	paEdfaPlusAlarmQueryTable OBJECT-TYPE
		SYNTAX  	SEQUENCE OF PaEdfaPlusAlarmQueryEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION
		 "we can get PA EDFA PLUS card alarm details"

		::= { paEdfaPlusAlarmQuery 1 }
	      
	paEdfaPlusAlarmQueryEntry OBJECT-TYPE
		SYNTAX  	PaEdfaPlusAlarmQueryEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION
		 "Enter node rack, subrack, slot and paEdfaPlusInterface numbers"

		INDEX   { node, rack, subRack, slot, paEdfaPlusInterface }

		::= { paEdfaPlusAlarmQueryTable 1 }

	PaEdfaPlusAlarmQueryEntry ::= 
		SEQUENCE {
				paEdfaPlusOpticalInputPowerFailureAlarmForStage1 		DisplayString,
				paEdfaPlusOpticalInputPowerFailureAlarmForStage2 		DisplayString,
				paEdfaPlusOpticalHighInputPowerAlarmForStage1			DisplayString,
				paEdfaPlusOpticalHighInputPowerAlarmForStage2			DisplayString,
				paEdfaPlusOpticalLowInputPowerAlarmForStage1	 		DisplayString,
				paEdfaPlusOpticalLowInputPowerAlarmForStage2	 		DisplayString,
				paEdfaPlusOpticalHighInputPowerWarningForStage1	 		DisplayString,
				paEdfaPlusOpticalHighInputPowerWarningForStage2	 		DisplayString,
				paEdfaPlusOpticalLowInputPowerWarningForStage1 			DisplayString,
				paEdfaPlusOpticalLowInputPowerWarningForStage2 			DisplayString,
				paEdfaPlusOpticalOutputPowerFailureAlarmForStage1		DisplayString,
				paEdfaPlusOpticalOutputPowerFailureAlarmForStage2		DisplayString,
				paEdfaPlusOpticalHighOutputPowerAlarmForStage1			DisplayString,
				paEdfaPlusOpticalHighOutputPowerAlarmForStage2			DisplayString,
				paEdfaPlusOpticalLowOutputPowerAlarmForStage1			DisplayString,
				paEdfaPlusOpticalLowOutputPowerAlarmForStage2			DisplayString,
				paEdfaPlusOpticalHighOutputPowerWarningForStage1		DisplayString,
				paEdfaPlusOpticalHighOutputPowerWarningForStage2		DisplayString,
				paEdfaPlusOpticalLowOutputPowerWarningForStage1			DisplayString,
				paEdfaPlusOpticalLowOutputPowerWarningForStage2			DisplayString,
				paEdfaPlusModuleHighTemperatureAlarm				DisplayString,
				paEdfaPlusModuleLowTemperatureAlarm				DisplayString,
				paEdfaPlusModuleHighTemperatureWarning				DisplayString,
				paEdfaPlusModuleLowTemperatureWarning				DisplayString,
				paEdfaPlusPump1HighTemperatureAlarm				DisplayString,
				paEdfaPlusPump2HighTemperatureAlarm				DisplayString,
				paEdfaPlusPump1LowTemperatureAlarm				DisplayString,
				paEdfaPlusPump2LowTemperatureAlarm				DisplayString,
				paEdfaPlusPump1HighTemperatureWarning				DisplayString,
				paEdfaPlusPump2HighTemperatureWarning				DisplayString,
				paEdfaPlusPump1LowTemperatureWarning				DisplayString,
				paEdfaPlusPump2LowTemperatureWarning				DisplayString,
				paEdfaPlusPump1HighOperatingCurrentAlarm			DisplayString,
				paEdfaPlusPump2HighOperatingCurrentAlarm			DisplayString,
				paEdfaPlusPump1LowOperatingCurrentAlarm				DisplayString,
				paEdfaPlusPump2LowOperatingCurrentAlarm				DisplayString,
				paEdfaPlusPump1HighOperatingCurrentWarning			DisplayString,
				paEdfaPlusPump2HighOperatingCurrentWarning			DisplayString,
				paEdfaPlusPump1LowOperatingCurrentWarning			DisplayString,
				paEdfaPlusPump2LowOperatingCurrentWarning			DisplayString,
				paEdfaPlusPump1HighThermoElectricCoolerCurrentAlarm		DisplayString,
				paEdfaPlusPump2HighThermoElectricCoolerCurrentAlarm		DisplayString,
				paEdfaPlusPump1LowThermoElectricCoolerCurrentAlarm		DisplayString,
				paEdfaPlusPump2LowThermoElectricCoolerCurrentAlarm		DisplayString,
				paEdfaPlusPump1HighThermoElectricCoolerCurrentWarning		DisplayString,
				paEdfaPlusPump2HighThermoElectricCoolerCurrentWarning		DisplayString,
				paEdfaPlusPump1LowThermoElectricCoolerCurrentWarning		DisplayString,
				paEdfaPlusPump2LowThermoElectricCoolerCurrentWarning		DisplayString,
				paEdfaPlusVariableOpticalAttenuatorHighInputPowerAlarm 		DisplayString,
				paEdfaPlusVariableOpticalAttenuatorLowInputPowerAlarm 		DisplayString,
				paEdfaPlusVariableOpticalAttenuatorHighInputPowerWarning 	DisplayString,
				paEdfaPlusVariableOpticalAttenuatorLowInputPowerWarning 	DisplayString,
				paEdfaPlusInputOutOfRangeAlarm					DisplayString,
				paEdfaPlusOutputOutOfRangeAlarm					DisplayString,
				paEdfaPlusMidInOutOfRangeAlarm					DisplayString,
				paEdfaPlusMidOutOutOfRangeAlarm					DisplayString,			
				paEdfaPlusPumpBiasCurrentAlarm					DisplayString,
				paEdfaPlusPump1CoolingTemperatureAlarm				DisplayString,
				paEdfaPlusPump2CoolingTemperatureAlarm				DisplayString,
				paEdfaPlusPump1LaserPowerAlarm					DisplayString,
				paEdfaPlusPump2LaserPowerAlarm					DisplayString,
				paEdfaPlusAlarmQueryTableRowStatus				RowStatus
			}

	paEdfaPlusOpticalInputPowerFailureAlarmForStage1 OBJECT-TYPE
		SYNTAX  	DisplayString
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get PA EDFA PLUS card optical input power failure alarm status for stage 1.
		-----------------------------
		Values :
		If Alarm is Present - Date and Time Stamp
			    eg:2017-5-18,9:47:20.0,+5:30
		If Alarm is Absent  - 0
		-----------------------------"

		::= { paEdfaPlusAlarmQueryEntry 1 }	              


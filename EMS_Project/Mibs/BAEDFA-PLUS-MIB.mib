				baEdfaPlusModuleHighTemperatureWarningInhibit					INTEGER,
				baEdfaPlusModuleLowTemperatureWarningInhibit					INTEGER,
				baEdfaPlusPumpHighTemperatureAlarmInhibit					INTEGER,

				baEdfaPlusOpticalOutputPowerFailureAlarmSeverity				DisplayString,
				baEdfaPlusOpticalHighOutputPowerAlarmSeverity					DisplayString,
				baEdfaPlusOpticalLowOutputPowerAlarmSeverity					DisplayString,
				baEdfaPlusOpticalHighOutputPowerWarningSeverity					DisplayString,
				baEdfaPlusOpticalLowOutputPowerWarningSeverity					DisplayString,
				baEdfaPlusModuleHighTemperatureAlarmSeverity					DisplayString,
				baEdfaPlusModuleLowTemperatureAlarmSeverity					DisplayString,
				baEdfaPlusModuleHighTemperatureWarningSeverity					DisplayString,
				baEdfaPlusModuleLowTemperatureWarningSeverity					DisplayString,
				baEdfaPlusPumpHighTemperatureAlarmSeverity					DisplayString,
				baEdfaPlusPumpLowTemperatureAlarmSeverity					DisplayString,
				baEdfaPlusPumpHighTemperatureWarningSeverity					DisplayString,
				baEdfaPlusPumpLowTemperatureWarningSeverity					DisplayString,
				baEdfaPlusPumpHighOperatingCurrentAlarmSeverity					DisplayString,
				baEdfaPlusPumpLowOperatingCurrentAlarmSeverity					DisplayString,
				baEdfaPlusPumpHighOperatingCurrentWarningSeverity				DisplayString,
				baEdfaPlusPumpLowOperatingCurrentWarningSeverity				DisplayString,
				baEdfaPlusPumpHighThermoElectricCoolerCurrentAlarmSeverity			DisplayString,
				baEdfaPlusPumpLowThermoElectricCoolerCurrentAlarmSeverity			DisplayString,
				baEdfaPlusPumpHighThermoElectricCoolerCurrentWarningSeverity			DisplayString,
				baEdfaPlusPumpLowThermoElectricCoolerCurrentWarningSeverity			DisplayString,
				baEdfaPlusVariableOpticalAttenuatorHighInputPowerAlarmSeverity			DisplayString,
				baEdfaPlusVariableOpticalAttenuatorLowInputPowerAlarmSeverity			DisplayString,
				baEdfaPlusVariableOpticalAttenuatorHighInputPowerWarningSeverity		DisplayString,
				baEdfaPlusVariableOpticalAttenuatorLowInputPowerWarningSeverity			DisplayString,
				baEdfaPlusInputOutOfRangeAlarmSeverity						DisplayString,
				baEdfaPlusOutputOutOfRangeAlarmSeverity						DisplayString,
				baEdfaPlusPumpBiasCurrentAlarmSeverity						DisplayString,
				baEdfaPlusPumpCoolingTemperatureAlarmSeverity					DisplayString,
				baEdfaPlusPumpLaserPowerAlarmSeverity						DisplayString,
				baEdfaPlusCardSoftwareUpgrade							DisplayString,
				baEdfaPlusConfigurationTableRowStatus						RowStatus
			}

	baEdfaPlusCardSoftReset OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-write
		STATUS  	current

		DESCRIPTION
		"Valid only as a SET command.
		Reboots the Card, Reconfigures the Card 
		i.e All Configuration Parameter	like Laser State,
		thresholds, operating mode & gain will be restored to 
		previous state.
		-----------------------------
		Values:
		Dont care, any value
		eg: 0
		-----------------------------"

		::= { baEdfaPlusConfigurationEntry 1 }		
	
	baEdfaPlusCardDefaultFactoryReset OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-write
		STATUS  	current

		DESCRIPTION
		"Valid only as a SET command.
		Sets the Card To Factory Default State
		i.e All Configuration Parameter	like Laser State,
		thresholds, operating mode & gain will be set to 
		default state.
		-----------------------------
		Values:
		Dont care, any value
		eg: 0
		-----------------------------"

		::= { baEdfaPlusConfigurationEntry 2 }

	baEdfaPlusAlarmMonitoringStatus OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-write
		STATUS  	current

		DESCRIPTION
		"This property sets or gets the card's Alarm
		monitoring state. Disabling card alarm monitoring 
		will not provide any alarms and performances
		information to the user.
		-----------------------------
		Values:
		1 - Card Alarm Monitoring is enabled
		0 - Card Alarm Monitoring is disabled
		-----------------------------"

		::= { baEdfaPlusConfigurationEntry 3 }

	baEdfaPlusManageUnmanageStatus OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-write
		STATUS  	current

		DESCRIPTION
		 "This property will tell whether the card is 
		accessible from EMS/LCT or not. Turning off the
		accessbility to the card, will not allow the user
		to access any configuration, alarm or performance
		of the card and also turns off fast alarm
		triggering, global alarm led indication
		-----------------------------
		Values:
		1 - Card is accessible from EMS/LCT
		0 - Card is inaccessible from EMS/LCT
		-----------------------------"

		::= { baEdfaPlusConfigurationEntry 4 }

	baEdfaPlusSyncSystemTimeWithNtpServer	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
					present in linux kernel with the NTP server
					we can use this OID. We can provide NTP server
					ip address as a value to this OID and the time
					will be synced to that particular server. 
					If we are not providing NTP server IP address 
					then the system will be synced with the NTP server 
					which is already been registered with card. 
					If both are absent then error message will be returned
					-----------------------------
						Interface : 0
					-----------------------------
						If we want to provide NTP server IP address then
						Value should be a valid IP address as shown below
						: 192.168.21.25
						
						If we don't want to provide NTP server address then no
						need to pass any value. 
					---------------------------"
  						
  		::= { baEdfaPlusConfigurationEntry 5 }
  		
  	baEdfaPlusSyncRtcWithNtpServer	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
  						present in RTC with the NTP server
  						we can use this OID. We can provide NTP server
  						ip address as a value to this OID and the time
  						will be synced to that particular server. 
  						If we are not providing NTP server IP address 
  						then the system will be synced with the NTP server 
  						which is already been registered with card. 
  						If both are absent then error message will be returned.
  						-----------------------------
						Interface : 0
						-----------------------------
						If we want to provide NTP server IP address then
						Value should be a valid IP address as shown below
						: 192.168.21.25
							
						If we don't want to provide NTP server address, then no
						need to pass any value. 
						---------------------------"
  						
  		::= { baEdfaPlusConfigurationEntry 6 }
  		
  	baEdfaPlusSyncRtcWithSystemTime	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually sync the time value
  						present in RTC with the time value in linux kernel
  						we can use this OID. With this set operation, 
  						the time available with linux kernel will be updated
  						into RTC. It is not required to provide any value for 
  						this operation"
  						
  		::= { baEdfaPlusConfigurationEntry 7 }
  		
  	baEdfaPlusUpdateGivenTimeIntoSystem	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually update system time
  						with the user provided time, we can use this OID.
  						With OID we need to provide time value which we
  						want to update in the system.
  						-----------------------------
						Interface : 0
						-----------------------------
						Value should be of given format:
						YYYY-MM-DD H:M:S
						
						Example: 2017-10-31 15:20:44
						---------------------------"
						
  		::= { baEdfaPlusConfigurationEntry 8 }
  		
  	baEdfaPlusUpdateGivenTimeIntoRtc	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  	read-write
  		STATUS  		current
  		DESCRIPTION	 	" when we want to manually update RTC time
  						with the user provided time, we can use this OID.
  						With OID we need to provide time value which we
  						want to update in RTC.
  						-----------------------------
						Interface : 0
						-----------------------------
						Value should be of given format:
						YYYY-MM-DD H:M:S
						
						Example: 2017-10-31 15:20:44
						---------------------------"
						
  		::= { baEdfaPlusConfigurationEntry 9 }
  		
  	baEdfaPlusSystemTimeAndRtcTime	 OBJECT-TYPE
		SYNTAX  		DisplayString
  		MAX-ACCESS  		read-only
  		STATUS  		current
  		DESCRIPTION	 	" get the system time and time value present in RTC.
  						-----------------------------
						Interface : 0
						-----------------------------"
						
  		::= { baEdfaPlusConfigurationEntry 10 }


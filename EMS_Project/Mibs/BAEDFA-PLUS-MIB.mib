--***************************************************************************** 

	baEdfaPlusPerformanceTable OBJECT-TYPE
		SYNTAX  	SEQUENCE OF BaEdfaPlusPerformanceEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION
		 "we can get BA EDFA PLUS card performance details "

		::= { baEdfaPlusPerformance 1 }
	      
	baEdfaPlusPerformanceEntry OBJECT-TYPE
		SYNTAX  	BaEdfaPlusPerformanceEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION 
		 "Enter node rack, subrack, slot and baEdfaPlusInterface numbers"

		INDEX   { node, rack, subRack, slot, baEdfaPlusInterface }
		
		::= { baEdfaPlusPerformanceTable 1 }
	
	BaEdfaPlusPerformanceEntry ::= 
		SEQUENCE {
				baEdfaPlusModuleTemperature				DisplayString,
				baEdfaPlusInputPower					DisplayString,
				baEdfaPlusOutputPower					DisplayString,
				baEdfaPlusAmplifiedSpontaneousEmmissionPower		DisplayString,
				baEdfaPlusSignalGain					DisplayString,
				baEdfaPlusSignalOutputPower				DisplayString,
				baEdfaPlusPumpLaserPower				DisplayString,
				baEdfaPlusPumpTemperature				DisplayString,
				baEdfaPlusPumpOperatingCurrent				DisplayString,
				baEdfaPlusPumpThermoElectricCoolerCurrent		DisplayString,
				baEdfaPlusPumpCoolingTemperature			DisplayString,
				baEdfaPlusVariableOpticalAttenuatorInputPower		DisplayString,
				baEdfaPlusVariableOpticalAttenuatorOutputPower		DisplayString,
				baEdfaPlusVariableOpticalAttenuatorActualAttenuation	DisplayString,
				baEdfaPlusPerformanceTableRowStatus			RowStatus					
			}
	

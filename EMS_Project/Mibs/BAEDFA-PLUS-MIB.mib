		SEQUENCE {
				baEdfaPlusCardSoftReset								INTEGER,
				baEdfaPlusCardDefaultFactoryReset						INTEGER,

				baEdfaPlusAlarmMonitoringStatus	 						INTEGER,
				baEdfaPlusManageUnmanageStatus							INTEGER,
				
				baEdfaPlusSyncSystemTimeWithNtpServer				DisplayString,

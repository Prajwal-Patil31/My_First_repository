--*****************************************************************************
--				UTL BA EDFA PLUS MIB
--*****************************************************************************

BAEDFA-PLUS-MIB DEFINITIONS ::= BEGIN

		IMPORTS
		RowStatus			FROM STANDARD-MIB

		DisplayString			FROM RFC1213-MIB

		OBJECT-IDENTITY, 
		NOTIFICATION-TYPE, 
		MODULE-IDENTITY, 
		Integer32, 
		Unsigned32, 
		IpAddress, 
		TimeTicks			FROM SNMPv2-SMI

		OBJECT-TYPE			FROM RFC-1212

		MODULE-COMPLIANCE, 
		OBJECT-GROUP, 
		NOTIFICATION-GROUP		FROM SNMPv2-CONF
		
		node, 
		rack, 
		subRack, 
		slot 				FROM SCC-MIB

		enterprises 			FROM RFC1155-SMI		

	;

	utl   	MODULE-IDENTITY
		LAST-UPDATED		"1807130630Z"
		ORGANIZATION		"United Telecoms Limited, Bangalore-560048."
		CONTACT-INFO		"Website: http://www.utlindia.com."
		DESCRIPTION		"MIB module for UTL DWDM."
		REVISION 		"1807130630Z"

		DESCRIPTION		"MIB module for BA EDFA Plus Card."

		::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
		STATUS  current

		DESCRIPTION "UTL R and D."

		::= { utl 1 }

	dwdm				OBJECT IDENTIFIER	::=   { utlrnd 1 }
	indus				OBJECT IDENTIFIER	::=   { dwdm 1 }
	baEdfaPlus			OBJECT IDENTIFIER 	::=   { indus 131 }

	baEdfaPlusCardGeneralDetails	OBJECT IDENTIFIER 	::=   { baEdfaPlus 1 }
	baEdfaPlusConfiguration		OBJECT IDENTIFIER 	::=   { baEdfaPlus 2 }
	baEdfaPlusAlarm			OBJECT IDENTIFIER 	::=   { baEdfaPlus 3 }
	baEdfaPlusPerformance		OBJECT IDENTIFIER 	::=   { baEdfaPlus 4 }	

	baEdfaPlusAlarmQuery		OBJECT IDENTIFIER 	::=   { baEdfaPlusAlarm 1 }
	baEdfaPlusAlarmNotification	OBJECT IDENTIFIER 	::=   { baEdfaPlusAlarm 2 }

--*****************************************************************************
--			BA EDFA PLUS CARD GENERAL DETAILS
--*****************************************************************************

	baEdfaPlusCardGeneralDetailsTable OBJECT-TYPE 
		SYNTAX 		SEQUENCE OF BaEdfaPlusCardGeneralDetailsEntry
		MAX-ACCESS	not-accessible
		STATUS		current

		DESCRIPTION
		 " we can get BA EDFA PLUS card general details "

		::= { baEdfaPlusCardGeneralDetails 1 }

	baEdfaPlusCardGeneralDetailsEntry OBJECT-TYPE
		SYNTAX  	BaEdfaPlusCardGeneralDetailsEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION 
		 "Enter node rack, subrack, slot and baEdfaPlusInterface numbers"

		INDEX   { node, rack, subRack, slot, baEdfaPlusInterface }
		::= { baEdfaPlusCardGeneralDetailsTable 1 }

	BaEdfaPlusCardGeneralDetailsEntry ::=
		SEQUENCE {
				baEdfaPlusInterface							INTEGER,
				baEdfaPlusEepromCardId							INTEGER,
				baEdfaPlusEepromCardName						DisplayString,
				baEdfaPlusEepromPartCode						DisplayString,
				baEdfaPlusEepromCardSerialNumber					DisplayString,
				baEdfaPlusEepromHardwareExternalReleaseVersion				DisplayString,
				baEdfaPlusSoftwareExternalReleaseVersion				DisplayString,
				baEdfaPlusEepromHardwareInternalReleaseVersion				DisplayString,
				baEdfaPlusSoftwareInternalReleaseVersion				DisplayString,
				baEdfaPlusEepromCardUidNumber						DisplayString,
				baEdfaPlusEepromCardEUI48Number						DisplayString,
				baEdfaPlusEepromCardEUI64Number						DisplayString,
				baEdfaPlusCardRootFileSystemVersion					DisplayString,
				baEdfaPlusInstallationDate						DisplayString,
				baEdfaPlusCommissionDate						DisplayString,
				baEdfaPlusCardRunningTime						DisplayString,
				baEdfaPlusCardRestartCount						INTEGER,
				baEdfaPlusModuleVendorName						DisplayString,
				baEdfaPlusModuleSerialNumber						DisplayString,
				baEdfaPlusNumberOfChannelsSupported					INTEGER,
				baEdfaPlusNumberOfPumpSupported						INTEGER,
				baEdfaPlusMaxGainSupported						DisplayString,
				baEdfaPlusSaturationOutputPowerSupported				DisplayString,
				baEdfaPlusMidStageAccessSupport						INTEGER,
				baEdfaPlusDirection							INTEGER,
				baEdfaPlusVoaPresenceStatus						INTEGER,
				baEdfaPlusCardGeneralDetailsTableRowStatus				RowStatus
			}

	baEdfaPlusInterface 	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  not-accessible
		STATUS  	current
		DESCRIPTION	
			"ba edfa plus interface number should be 0 always"

		::= { baEdfaPlusCardGeneralDetailsEntry 1 }

	baEdfaPlusEepromCardId OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " Tells the card ID of the BAEDFA-PLUS card, present in the EEPROM "

		::= { baEdfaPlusCardGeneralDetailsEntry 2 }

	baEdfaPlusEepromCardName OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the card name of the BAEDFA-PLUS card, present in the EEPROM "

		::= { baEdfaPlusCardGeneralDetailsEntry 3 }

	baEdfaPlusEepromPartCode OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the part code of the BAEDFA-PLUS card, present in the EEPROM "

		::= { baEdfaPlusCardGeneralDetailsEntry 4 }

	baEdfaPlusEepromCardSerialNumber OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS		current

		DESCRIPTION
		 " This property get / set the information about BAEDFA-PLUS 
		 Card's Serial Number.
		-----------------------------
		Values:
		eg: 123456
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 5 }

	baEdfaPlusEepromHardwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Hardware External Release Version. This detail 
		 will be displayed to the customer. This version will increment 
		 only if there are significant architectural changes in the product.
		-----------------------------
		Value:
		eg: 0.1
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 6 }

	baEdfaPlusSoftwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Software External Release Version.  This detail 
		 will be displayed to the customer. This version will increment 
		 only if there are significant architectural changes in the product.
		-----------------------------
		Value:
		eg: 0.1
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 7 }

	baEdfaPlusEepromHardwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Hardware Internal Release Version. This detail 
		 is used for development purposes only. It differs from the external 
		 hardware version.
		-----------------------------
		Value:
		eg: 4.1
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 8 }

	baEdfaPlusSoftwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Software Internal Release Version.  This detail 
		 is used for development purposes only. It differs from the external 
		 software version.
		-----------------------------
		Value:
		eg: 5.1
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 9 }

	baEdfaPlusEepromCardUidNumber OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the Card Unique Identifier. It is a 4 byte address used to 
		 uniquely identify a card.
		------------------------------
		Value:
	      	eg: 12345678
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 10 }

	baEdfaPlusEepromCardEUI48Number OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the Card EUI-48 Number. It’s a 6 byte address used to 
		 uniquely identify a card.
		-----------------------------
		Value:
	      	eg: 0004A3123456
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 11 }

	baEdfaPlusEepromCardEUI64Number OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the Card EUI-64 Number. It’s a 8 byte address
		 used to uniquely identify a card.
		-----------------------------
		Value:
	      	eg: 0004A31234567890
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 12 }
		
        baEdfaPlusCardRootFileSystemVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card's Root File System Version
			-----------------------------
			baEdfaPlusInterface: 0
			-----------------------------
			Value:
		      	eg: 8
			-----------------------------"
		::= { baEdfaPlusCardGeneralDetailsEntry 13 }

	baEdfaPlusInstallationDate OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS		current

		DESCRIPTION
		 " To get the card's installation date in dd/mm/yyyy format.
		-----------------------------
		Value:
	      	eg: 12/03/2016
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 21 }

	baEdfaPlusCommissionDate OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS		current

		DESCRIPTION
		 " To get the card's commission date in  dd/mm/yyyy format.
		-----------------------------
		Value:
	      	eg: 20/03/2016
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 22 }

	baEdfaPlusCardRunningTime OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the duration of time for which the card is operational/running.
		-----------------------------
		Values:
	      	eg: 3d 2h 1m
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 23 }

	baEdfaPlusCardRestartCount OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the number of times the card has been soft reset. This value 
		 will get reset to 0 on factory reset.
		-----------------------------
		Values:
	      	eg: 10
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 24 }

	baEdfaPlusModuleVendorName OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get BA EDFA PLUS card module vendor name.
		-----------------------------
		Values:
	      	eg: ACCELINK
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 31 }

	baEdfaPlusModuleSerialNumber OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get BA EDFA PLUS card module serial number.
		-----------------------------
		Values:
	      	eg: 12345
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 32 }

	baEdfaPlusNumberOfChannelsSupported OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get BA EDFA PLUS card supports how many number of channels.
		-----------------------------
		Values:
	      	eg: 30
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 33 }

	baEdfaPlusNumberOfPumpSupported OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get BA EDFA PLUS card supports how many number of pumps.
		-----------------------------
		Values:
	      	eg: 2
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 34 }

	baEdfaPlusMaxGainSupported OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get BA EDFA PLUS card supports maximum gain supported.
		-----------------------------
		Values:
	      	eg: 25.0
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 35 }

	baEdfaPlusSaturationOutputPowerSupported OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get BA EDFA PLUS card supports saturation power.
		-----------------------------
		Values:
	      	eg: 19.0
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 36 }

	baEdfaPlusMidStageAccessSupport OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get BA EDFA PLUS card support status of mid stage access.
		-----------------------------
		Values:
	      	1 - MSA supported
		0 - MSA not supported
		-----------------------------"

		::= { baEdfaPlusCardGeneralDetailsEntry 37 }
		
	baEdfaPlusDirection	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  read-only
		STATUS  	current
		DESCRIPTION	" to get BA EDFA PLUS card Direction.
		-----------------------------
		Values:
		1 - Direction 1
		2 - Direction 2
		3 - Direction 3
		4 - Direction 4
		-----------------------------"
		::= { baEdfaPlusCardGeneralDetailsEntry 38 }

	baEdfaPlusVoaPresenceStatus	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  read-only
		STATUS  	current
		DESCRIPTION	" to get BA EDFA PLUS inbuilt voa presence status.
		-----------------------------
		Values:
		1 - VOA present 
		0 - VOA absent
		-----------------------------"
		::= { baEdfaPlusCardGeneralDetailsEntry 39 }
		
	baEdfaPlusCardGeneralDetailsTableRowStatus OBJECT-TYPE
		SYNTAX		RowStatus
		MAX-ACCESS	read-write
		STATUS		current
		DESCRIPTION
			"This is MIB realted property,
			NOT to be considered as a card property"

		::= { baEdfaPlusCardGeneralDetailsEntry 40 }

--*****************************************************************************
--			BA EDFA PLUS CONFIGURATION
--***************************************************************************** 

	baEdfaPlusConfigurationTable OBJECT-TYPE
		SYNTAX  	SEQUENCE OF BaEdfaPlusConfigurationEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION
		 " we can get BA EDFA PLUS configuration details "

		::= { baEdfaPlusConfiguration 1 }
              
        baEdfaPlusConfigurationEntry OBJECT-TYPE
		SYNTAX  	BaEdfaPlusConfigurationEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION 
		 "Enter node rack, subrack, slot and baEdfaPlusInterface numbers"

		INDEX   { node, rack, subRack, slot, baEdfaPlusInterface }
		
		::= { baEdfaPlusConfigurationTable 1 }
	

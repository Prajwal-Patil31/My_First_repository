				baEdfaPlusOpticalHighOutputPowerWarning				DisplayString,
				baEdfaPlusOpticalLowOutputPowerWarning				DisplayString,
				baEdfaPlusModuleHighTemperatureAlarm				DisplayString,
				baEdfaPlusModuleLowTemperatureAlarm				DisplayString,
				baEdfaPlusModuleHighTemperatureWarning				DisplayString,
				baEdfaPlusModuleLowTemperatureWarning				DisplayString,
				baEdfaPlusPumpHighTemperatureAlarm				DisplayString,

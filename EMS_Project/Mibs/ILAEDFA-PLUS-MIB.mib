	ilaEdfaPlusCardSoftwareUpgrade OBJECT-TYPE
		SYNTAX 		DisplayString
		MAX-ACCESS 	read-write
		STATUS 		current
		DESCRIPTION
			"Valid only as SET command.
			This property upgrades the software of the ILA-EDFA-PLUS card
			It takes the path of the software release as
			a value,
			ilaEdfaPlusInterface: 0
			Values:
			eg: /home/root/rel-2.0.0.tar.gz
			-----------------------------"

		::= { ilaEdfaPlusConfigurationEntry 280 }


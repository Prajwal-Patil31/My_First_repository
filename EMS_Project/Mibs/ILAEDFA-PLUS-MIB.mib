				ilaEdfaPlusPump1HighOperatingCurrentAlarmInhibit					INTEGER,
				ilaEdfaPlusPump2HighOperatingCurrentAlarmInhibit					INTEGER,
				ilaEdfaPlusPump1LowOperatingCurrentAlarmInhibit						INTEGER,
				ilaEdfaPlusPump2LowOperatingCurrentAlarmInhibit						INTEGER,
				ilaEdfaPlusPump1HighOperatingCurrentWarningInhibit					INTEGER,
				ilaEdfaPlusPump2HighOperatingCurrentWarningInhibit					INTEGER,
				ilaEdfaPlusPump1LowOperatingCurrentWarningInhibit					INTEGER,
				ilaEdfaPlusPump2LowOperatingCurrentWarningInhibit					INTEGER,
				ilaEdfaPlusPump1HighThermoElectricCoolerCurrentAlarmInhibit				INTEGER,
				ilaEdfaPlusPump2HighThermoElectricCoolerCurrentAlarmInhibit				INTEGER,
				ilaEdfaPlusPump1LowThermoElectricCoolerCurrentAlarmInhibit				INTEGER,

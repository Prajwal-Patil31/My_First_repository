				ilaEdfaPlusPump1CoolingTemperatureAlarm				DisplayString,
				ilaEdfaPlusPump2CoolingTemperatureAlarm				DisplayString,
				ilaEdfaPlusPump1LaserPowerAlarm					DisplayString,
				ilaEdfaPlusPump2LaserPowerAlarm					DisplayString,
				ilaEdfaPlusAlarmQueryTableRowStatus				RowStatus
			}

	ilaEdfaPlusOpticalInputPowerFailureAlarmForStage1 OBJECT-TYPE
		SYNTAX  	DisplayString
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION

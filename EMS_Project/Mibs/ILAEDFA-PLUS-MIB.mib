--*****************************************************************************
--				UTL ILA EDFA PLUS MIB
--*****************************************************************************

ILAEDFA-PLUS-MIB DEFINITIONS ::= BEGIN
 
		IMPORTS
		RowStatus				FROM STANDARD-MIB

		DisplayString				FROM RFC1213-MIB       

		OBJECT-IDENTITY, 
		NOTIFICATION-TYPE, 
		MODULE-IDENTITY, 
		Integer32, 
		Unsigned32, 
		IpAddress, 
		TimeTicks				FROM SNMPv2-SMI

		OBJECT-TYPE				FROM RFC-1212

		MODULE-COMPLIANCE, 
		OBJECT-GROUP, 
		NOTIFICATION-GROUP			FROM SNMPv2-CONF
		
		node, 
		rack, 
		subRack, 
		slot 					FROM SCC-MIB

		enterprises 				FROM RFC1155-SMI		

	;

	utl   	MODULE-IDENTITY
		LAST-UPDATED    	"1807130630Z"
		ORGANIZATION    	"United Telecoms Limited, Bangalore-560048."
		CONTACT-INFO    	"Website: http://www.utlindia.com."                                           
		DESCRIPTION     	"MIB module for UTL DWDM."
		REVISION 	    	"1807130630Z"

		DESCRIPTION    	 	"MIB module for ILA EDFA Plus Card."

		::= { enterprises 18036 }

	utlrnd  OBJECT-IDENTITY
		STATUS  current

		DESCRIPTION "UTL R and D."

		::= { utl 1 }

	dwdm 				OBJECT IDENTIFIER	::=   { utlrnd 1 }
	indus 				OBJECT IDENTIFIER	::=   { dwdm 1 }
	ilaEdfaPlus 			OBJECT IDENTIFIER 	::=   { indus 151 }

	ilaEdfaPlusCardGeneralDetails 	OBJECT IDENTIFIER 	::=   { ilaEdfaPlus 1 }
	ilaEdfaPlusConfiguration 	OBJECT IDENTIFIER 	::=   { ilaEdfaPlus 2 }
	ilaEdfaPlusAlarm 		OBJECT IDENTIFIER 	::=   { ilaEdfaPlus 3 }
	ilaEdfaPlusPerformance 		OBJECT IDENTIFIER 	::=   { ilaEdfaPlus 4 }	

	ilaEdfaPlusAlarmQuery 		OBJECT IDENTIFIER 	::=   { ilaEdfaPlusAlarm 1 }
	ilaEdfaPlusAlarmNotification 	OBJECT IDENTIFIER 	::=   { ilaEdfaPlusAlarm 2 }

--*****************************************************************************
--			ILA EDFA PLUS CARD GENERAL DETAILS
--*****************************************************************************

	ilaEdfaPlusCardGeneralDetailsTable OBJECT-TYPE
		SYNTAX  	SEQUENCE OF IlaEdfaPlusCardGeneralDetailsEntry
		MAX-ACCESS	not-accessible
		STATUS		current

		DESCRIPTION
		 " we can get ILA EDFA PLUS card general details "

		::= { ilaEdfaPlusCardGeneralDetails 1 }

	ilaEdfaPlusCardGeneralDetailsEntry OBJECT-TYPE
		SYNTAX  	IlaEdfaPlusCardGeneralDetailsEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION 
		 "Enter node rack, subrack, slot and ilaEdfaPlusInterface numbers"

		INDEX   { node, rack, subRack, slot, ilaEdfaPlusInterface }

		::= { ilaEdfaPlusCardGeneralDetailsTable 1 }

	IlaEdfaPlusCardGeneralDetailsEntry ::=
		SEQUENCE {
				ilaEdfaPlusInterface					INTEGER,
				ilaEdfaPlusEepromCardId					INTEGER,
				ilaEdfaPlusEepromCardName				DisplayString,
				ilaEdfaPlusEepromPartCode				DisplayString,
				ilaEdfaPlusEepromCardSerialNumber			DisplayString,
				ilaEdfaPlusEepromHardwareExternalReleaseVersion		DisplayString,
				ilaEdfaPlusSoftwareExternalReleaseVersion		DisplayString,
				ilaEdfaPlusEepromHardwareInternalReleaseVersion		DisplayString,
				ilaEdfaPlusSoftwareInternalReleaseVersion		DisplayString,
				ilaEdfaPlusEepromCardUidNumber				DisplayString,
				ilaEdfaPlusEepromCardEUI48Number			DisplayString,
				ilaEdfaPlusEepromCardEUI64Number			DisplayString,
				ilaEdfaPlusCardRootFileSystemVersion			DisplayString,
				ilaEdfaPlusInstallationDate				DisplayString,
				ilaEdfaPlusCommissionDate				DisplayString,
				ilaEdfaPlusCardRunningTime				DisplayString,
				ilaEdfaPlusCardRestartCount				INTEGER,
				ilaEdfaPlusModuleVendorName				DisplayString,
				ilaEdfaPlusModuleSerialNumber				DisplayString,
				ilaEdfaPlusNumberOfChannelsSupported			INTEGER,
				ilaEdfaPlusNumberOfPumpSupported			INTEGER,
				ilaEdfaPlusMaxGainSupported				DisplayString,
				ilaEdfaPlusSaturationOutputPowerSupported		DisplayString,
				ilaEdfaPlusMidStageAccessSupport			INTEGER,
				ilaEdfaPlusDirection					INTEGER,
				ilaEdfaPlusStage2VoaPresenceStatus			INTEGER,
				ilaEdfaPlusModuleType					INTEGER,
				ilaEdfaPlusCardGeneralDetailsTableRowStatus		RowStatus
			}

	ilaEdfaPlusInterface 	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  not-accessible
		STATUS  	current
		DESCRIPTION	
			"ila edfa plus interface number should be 0 always"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 1 }

	ilaEdfaPlusEepromCardId OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " Tells the card ID of the ILAEDFA-PLUS card, present in the EEPROM "

		::= { ilaEdfaPlusCardGeneralDetailsEntry 2 }

	ilaEdfaPlusEepromCardName OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the card name of the ILAEDFA-PLUS card, present in the EEPROM "

		::= { ilaEdfaPlusCardGeneralDetailsEntry 3 }

	ilaEdfaPlusEepromPartCode OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the part code of the ILAEDFA-PLUS card, present in the EEPROM "

		::= { ilaEdfaPlusCardGeneralDetailsEntry 4 }

	ilaEdfaPlusEepromCardSerialNumber OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS		current

		DESCRIPTION
		 " This property get / set the information about ILAEDFA-PLUS 
		 Card's Serial Number.
		-----------------------------
		Values:
		eg: 123456
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 5 }

	ilaEdfaPlusEepromHardwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Hardware External Release Version. This detail 
		 will be displayed to the customer. This version will increment 
		 only if there are significant architectural changes in the product.
		-----------------------------
		Value:
		eg: 0.1
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 6 }

	ilaEdfaPlusSoftwareExternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Software External Release Version.  This detail 
		 will be displayed to the customer. This version will increment 
		 only if there are significant architectural changes in the product.
		-----------------------------
		Value:
		eg: 0.1
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 7 }

	ilaEdfaPlusEepromHardwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Hardware Internal Release Version. This detail 
		 is used for development purposes only. It differs from the external 
		 hardware version.
		-----------------------------
		Value:
		eg: 4.1
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 8 }

	ilaEdfaPlusSoftwareInternalReleaseVersion OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the Card's Software Internal Release Version.  This detail 
		 is used for development purposes only. It differs from the external 
		 software version.
		-----------------------------
		Value:
		eg: 5.1
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 9 }

	ilaEdfaPlusEepromCardUidNumber OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the Card Unique Identifier It is a 4 byte address used to 
		 uniquely identify a card.
		------------------------------
		Value:
	      	eg: 12345678
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 10 }

	ilaEdfaPlusEepromCardEUI48Number OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the Card EUI-48 Number. It’s a 6 byte address used to 
		 uniquely identify a card.
		-----------------------------
		Value:
	      	eg: 0004A3123456
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 11 }

	ilaEdfaPlusEepromCardEUI64Number OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " Tells the Card EUI-64 Number. It’s a 8 byte address
		used to uniquely identify a card.
		-----------------------------
		Value:
	      	eg: 0004A31234567890
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 12 }
		
        ilaEdfaPlusCardRootFileSystemVersion OBJECT-TYPE		 
		SYNTAX  DisplayString
		MAX-ACCESS  read-only
		STATUS current
		DESCRIPTION
			"Tells the Card's Root File System Version
			-----------------------------
			ilaEdfaPlusInterface: 0
			-----------------------------
			Value:
		      	eg: 8
			-----------------------------"
		::= { ilaEdfaPlusCardGeneralDetailsEntry 13 }

	ilaEdfaPlusInstallationDate OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS		current

		DESCRIPTION
		 " To get the card's installation date in dd/mm/yyyy format.
		-----------------------------
		Value:
	      	eg: 12/03/2016
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 21 }

	ilaEdfaPlusCommissionDate OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-write
		STATUS		current

		DESCRIPTION
		 " To get the card's commission date in  dd/mm/yyyy format.
		-----------------------------
		Value:
	      	eg: 20/03/2016
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 22 }

	ilaEdfaPlusCardRunningTime OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the duration of time for which the card is operational/running.
		-----------------------------
		Values:
	      	eg: 3d 2h 1m
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 23 }

	ilaEdfaPlusCardRestartCount OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " To get the number of times the card has been soft reset. This value 
		 will get reset to 0 on factory reset.
		-----------------------------
		Values:
	      	eg: 10
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 24 }

	ilaEdfaPlusModuleVendorName OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get ILA EDFA PLUS card module vendor name.
		-----------------------------
		Values:
	      	eg: ACCELINK
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 31 }

	ilaEdfaPlusModuleSerialNumber OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get ILA EDFA PLUS card module serial number.
		-----------------------------
		Values:
	      	eg: 12345
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 32 }

	ilaEdfaPlusNumberOfChannelsSupported OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get ILA EDFA PLUS card supports how many number of channels.
		-----------------------------
		Values:
	      	eg: 30
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 33 }

	ilaEdfaPlusNumberOfPumpSupported OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get ILA EDFA PLUS card supports how many number of pumps.
		-----------------------------
		Values:
	      	eg: 2
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 34 }

	ilaEdfaPlusMaxGainSupported OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get ILA EDFA PLUS card supports maximum gain supported.
		-----------------------------
		Values:
	      	eg: 25.0
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 35 }

	ilaEdfaPlusSaturationOutputPowerSupported OBJECT-TYPE
		SYNTAX  	DisplayString (SIZE (0..255))
		MAX-ACCESS  	read-only
		STATUS		current

		DESCRIPTION
		 " to get ILA EDFA PLUS card supports saturation power.
		-----------------------------
		Values:
	      	eg: 19.0
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 36 }

	ilaEdfaPlusMidStageAccessSupport OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get ILA EDFA PLUS card supoort status of mid stage access.
		-----------------------------
		Values:
	      	1 - MSA supported
		0 - MSA not supported
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 37 }
		
	ilaEdfaPlusDirection	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  read-only
		STATUS  	current
		DESCRIPTION	
		" to get ILA EDFA card Direction.
		-----------------------------
		Values:
		1 - Direction 1
		2 - Direction 2
		3 - Direction 3
		4 - Direction 4
		-----------------------------"
		::= { ilaEdfaPlusCardGeneralDetailsEntry 38 }

	ilaEdfaPlusStage2VoaPresenceStatus	OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  read-only
		STATUS  	current
		DESCRIPTION	" to get ILA EDFA PLUS inbuilt voa presence status.
		-----------------------------
		Values:
		1 - VOA present stage 2
		0 - VOA absent
		-----------------------------"
		::= { ilaEdfaPlusCardGeneralDetailsEntry 39 }

	ilaEdfaPlusModuleType OBJECT-TYPE
		SYNTAX  	INTEGER
		MAX-ACCESS  	read-only
		STATUS  	current

		DESCRIPTION
		 " to get ILA EDFA PLUS card type (in Km).
		-----------------------------
		Values:
	      	eg: 40, 60, 80, 100 
		-----------------------------"

		::= { ilaEdfaPlusCardGeneralDetailsEntry 40 }

	ilaEdfaPlusCardGeneralDetailsTableRowStatus OBJECT-TYPE
	      SYNTAX      RowStatus
	      MAX-ACCESS  read-write
	      STATUS      current
	      DESCRIPTION
		      "	This is MIB realted property,
			NOT to be considered as a card property"
	      ::= { ilaEdfaPlusCardGeneralDetailsEntry 41 }

--*****************************************************************************
--			ILA EDFA PLUS CONFIGURATION
--***************************************************************************** 

	ilaEdfaPlusConfigurationTable OBJECT-TYPE
		SYNTAX  	SEQUENCE OF IlaEdfaPlusConfigurationEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION
		 " we can get ILA EDFA PLUS configuration details "

		::= { ilaEdfaPlusConfiguration 1 }
              
        ilaEdfaPlusConfigurationEntry OBJECT-TYPE
		SYNTAX  	IlaEdfaPlusConfigurationEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION 
		 "Enter node rack, subrack, slot and ilaEdfaPlusInterface numbers"

		INDEX   { node, rack, subRack, slot, ilaEdfaPlusInterface }

		::= { ilaEdfaPlusConfigurationTable 1 }
	
	IlaEdfaPlusConfigurationEntry ::= 
		SEQUENCE {
				ilaEdfaPlusCardSoftReset	 							INTEGER,
				ilaEdfaPlusCardDefaultFactoryReset							INTEGER,
				ilaEdfaPlusAlarmMonitoringStatus	 						INTEGER,
				ilaEdfaPlusManageUnmanageStatus								INTEGER,

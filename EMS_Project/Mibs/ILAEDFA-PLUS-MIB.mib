--*****************************************************************************
--				ILA EDFA PLUS ALARMS
--*****************************************************************************         
              
	ilaEdfaPlusAlarmQueryTable OBJECT-TYPE
		SYNTAX  	SEQUENCE OF IlaEdfaPlusAlarmQueryEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION
		 "we can get ILA EDFA PLUS card alarm details"

		::= { ilaEdfaPlusAlarmQuery 1 }
	      
	ilaEdfaPlusAlarmQueryEntry OBJECT-TYPE
		SYNTAX  	IlaEdfaPlusAlarmQueryEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION 
		 "Enter node rack, subrack, slot and ilaEdfaPlusInterface numbers"

		INDEX   { node, rack, subRack, slot, ilaEdfaPlusInterface }

		::= { ilaEdfaPlusAlarmQueryTable 1 }

	IlaEdfaPlusAlarmQueryEntry ::= 
		SEQUENCE {
				ilaEdfaPlusOpticalInputPowerFailureAlarmForStage1 		DisplayString,
				ilaEdfaPlusOpticalInputPowerFailureAlarmForStage2 		DisplayString,
				ilaEdfaPlusOpticalHighInputPowerAlarmForStage1			DisplayString,
				ilaEdfaPlusOpticalHighInputPowerAlarmForStage2			DisplayString,
				ilaEdfaPlusOpticalLowInputPowerAlarmForStage1	 		DisplayString,
				ilaEdfaPlusOpticalLowInputPowerAlarmForStage2	 		DisplayString,
				ilaEdfaPlusOpticalHighInputPowerWarningForStage1	 	DisplayString,
				ilaEdfaPlusOpticalHighInputPowerWarningForStage2	 	DisplayString,
				ilaEdfaPlusOpticalLowInputPowerWarningForStage1 		DisplayString,
				ilaEdfaPlusOpticalLowInputPowerWarningForStage2 		DisplayString,
				ilaEdfaPlusOpticalOutputPowerFailureAlarmForStage1		DisplayString,
				ilaEdfaPlusOpticalOutputPowerFailureAlarmForStage2		DisplayString,
				ilaEdfaPlusOpticalHighOutputPowerAlarmForStage1			DisplayString,
				ilaEdfaPlusOpticalHighOutputPowerAlarmForStage2			DisplayString,
				ilaEdfaPlusOpticalLowOutputPowerAlarmForStage1			DisplayString,
				ilaEdfaPlusOpticalLowOutputPowerAlarmForStage2			DisplayString,
				ilaEdfaPlusOpticalHighOutputPowerWarningForStage1		DisplayString,
				ilaEdfaPlusOpticalHighOutputPowerWarningForStage2		DisplayString,
				ilaEdfaPlusOpticalLowOutputPowerWarningForStage1		DisplayString,
				ilaEdfaPlusOpticalLowOutputPowerWarningForStage2		DisplayString,
				ilaEdfaPlusModuleHighTemperatureAlarm				DisplayString,
				ilaEdfaPlusModuleLowTemperatureAlarm				DisplayString,
				ilaEdfaPlusModuleHighTemperatureWarning				DisplayString,
				ilaEdfaPlusModuleLowTemperatureWarning				DisplayString,
				ilaEdfaPlusPump1HighTemperatureAlarm				DisplayString,
				ilaEdfaPlusPump2HighTemperatureAlarm				DisplayString,
				ilaEdfaPlusPump1LowTemperatureAlarm				DisplayString,
				ilaEdfaPlusPump2LowTemperatureAlarm				DisplayString,
				ilaEdfaPlusPump1HighTemperatureWarning				DisplayString,
				ilaEdfaPlusPump2HighTemperatureWarning				DisplayString,
				ilaEdfaPlusPump1LowTemperatureWarning				DisplayString,
				ilaEdfaPlusPump2LowTemperatureWarning				DisplayString,
				ilaEdfaPlusPump1HighOperatingCurrentAlarm			DisplayString,
				ilaEdfaPlusPump2HighOperatingCurrentAlarm			DisplayString,
				ilaEdfaPlusPump1LowOperatingCurrentAlarm			DisplayString,
				ilaEdfaPlusPump2LowOperatingCurrentAlarm			DisplayString,
				ilaEdfaPlusPump1HighOperatingCurrentWarning			DisplayString,
				ilaEdfaPlusPump2HighOperatingCurrentWarning			DisplayString,
				ilaEdfaPlusPump1LowOperatingCurrentWarning			DisplayString,
				ilaEdfaPlusPump2LowOperatingCurrentWarning			DisplayString,
				ilaEdfaPlusPump1HighThermoElectricCoolerCurrentAlarm		DisplayString,
				ilaEdfaPlusPump2HighThermoElectricCoolerCurrentAlarm		DisplayString,
				ilaEdfaPlusPump1LowThermoElectricCoolerCurrentAlarm		DisplayString,
				ilaEdfaPlusPump2LowThermoElectricCoolerCurrentAlarm		DisplayString,
				ilaEdfaPlusPump1HighThermoElectricCoolerCurrentWarning		DisplayString,
				ilaEdfaPlusPump2HighThermoElectricCoolerCurrentWarning		DisplayString,
				ilaEdfaPlusPump1LowThermoElectricCoolerCurrentWarning		DisplayString,
				ilaEdfaPlusPump2LowThermoElectricCoolerCurrentWarning		DisplayString,
				ilaEdfaPlusVariableOpticalAttenuatorHighInputPowerAlarm 	DisplayString,
				ilaEdfaPlusVariableOpticalAttenuatorLowInputPowerAlarm 		DisplayString,
				ilaEdfaPlusVariableOpticalAttenuatorHighInputPowerWarning 	DisplayString,

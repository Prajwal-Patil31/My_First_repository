--*****************************************************************************
--				ILA EDFA PLUS PERFORMANCE
--***************************************************************************** 

	ilaEdfaPlusPerformanceTable OBJECT-TYPE
		SYNTAX  	SEQUENCE OF IlaEdfaPlusPerformanceEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION
		 "we can get ILA EDFA PLUS card performance details "

		::= { ilaEdfaPlusPerformance 1 }
	      
	ilaEdfaPlusPerformanceEntry OBJECT-TYPE
		SYNTAX  	IlaEdfaPlusPerformanceEntry
		MAX-ACCESS  	not-accessible
		STATUS  	current

		DESCRIPTION 
		 "Enter node rack, subrack, slot and ilaEdfaPlusInterface numbers"

		INDEX   { node, rack, subRack, slot, ilaEdfaPlusInterface }

		::= { ilaEdfaPlusPerformanceTable 1 }
	
	IlaEdfaPlusPerformanceEntry ::= 
		SEQUENCE {
				ilaEdfaPlusModuleTemperature					DisplayString,
				ilaEdfaPlusInputPowerForStage1					DisplayString,
				ilaEdfaPlusInputPowerForStage2					DisplayString,
				ilaEdfaPlusOutputPowerForStage1					DisplayString,
				ilaEdfaPlusOutputPowerForStage2					DisplayString,
				ilaEdfaPlusAmplifiedSpontaneousEmmissionPowerForStage1		DisplayString,
				ilaEdfaPlusAmplifiedSpontaneousEmmissionPowerForStage2		DisplayString,
				ilaEdfaPlusSignalGainForStage1					DisplayString,
				ilaEdfaPlusSignalGainForStage2					DisplayString,
				ilaEdfaPlusSignalOutputPowerForStage1				DisplayString,
				ilaEdfaPlusSignalOutputPowerForStage2				DisplayString,
				ilaEdfaPlusPump1LaserPower					DisplayString,
				ilaEdfaPlusPump2LaserPower					DisplayString,
				ilaEdfaPlusPump1Temperature					DisplayString,
				ilaEdfaPlusPump2Temperature					DisplayString,
				ilaEdfaPlusPump1OperatingCurrent				DisplayString,
				ilaEdfaPlusPump2OperatingCurrent				DisplayString,
				ilaEdfaPlusPump1ThermoElectricCoolerCurrent			DisplayString,
				ilaEdfaPlusPump2ThermoElectricCoolerCurrent			DisplayString,
				ilaEdfaPlusPump1CoolingTemperature				DisplayString,
				ilaEdfaPlusPump2CoolingTemperature				DisplayString,
				ilaEdfaPlusVariableOpticalAttenuatorInputPower			DisplayString,
				ilaEdfaPlusVariableOpticalAttenuatorOutputPower			DisplayString,
				ilaEdfaPlusVariableOpticalAttenuatorActualAttenuation		DisplayString,
				ilaEdfaPlusPerformanceTableRowStatus				RowStatus
			}
	
